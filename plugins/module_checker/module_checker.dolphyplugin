__id__ = "module_checker"
__name__ = "Module Checker"
__version__ = "1.0.0"
__author__ = "Topzi"
__description__ = "Shows which hardware modules and functions are available on this phone"
__icon__ = "rounded:fact_check"
__library__ = False
__design_library__ = False
__dependencies__ = []
__permissions__ = []

import json


class ModuleChecker(BasePlugin):

    def on_plugin_load(self):
        self.add_module(
            title="Module Checker",
            description="Check available device modules",
            icon="fact_check",
            screen="main",
            section="PLUGINS"
        )

    # ---------- helpers ----------

    def _safe(self, fn, default=False):
        """Calls fn() and returns default if anything goes wrong
        (method missing in this Dolphy build, raised an exception, etc.)."""
        try:
            result = fn()
            if result is None:
                return default
            return result
        except Exception:
            return default

    def _has_service(self, service_id):
        """Best-effort check: the documentation has no public API to read the
        list of active provide_service(...) registrations of other plugins,
        so java_exports() is used here as an indirect signal — provider
        libraries usually export an object with a similar name. If a future
        Dolphy version adds api.listServices() or similar, replace this
        function with a direct call."""
        try:
            exports = self.java_exports()
            if exports and service_id.split(".")[0] in str(exports):
                return True
        except Exception:
            pass
        return False

    def _row(self, title, available, extra=""):
        """Builds one section row: if available == False,
        'No module' is shown at the top left."""
        children = []
        if not available:
            children.append(
                self.ui.text("No module", "labelSmall", color="error")
            )
        children.append(self.ui.text(title, "titleMedium"))
        if extra:
            children.append(self.ui.text(extra, "bodySmall", color="muted"))
        return self.ui.card(
            self.ui.column(children, spacing=4),
            padding=12
        )

    # ---------- capability checks ----------

    def check_nfc(self):
        device = self.api.getDevice()
        available = self._safe(lambda: json.loads(device.nfcCapabilitiesJson()).get("available"))
        if available is None:
            available = self._safe(lambda: self.api.getAndroid().hasFeature("android.hardware.nfc"))
        return available

    def check_ble(self):
        android = self.api.getAndroid()
        scanner = self._safe(lambda: android.btLeScannerAvailable())
        adv = self._safe(lambda: android.btLeAdvertiserAvailable())
        return bool(scanner or adv)

    def check_bt_classic(self):
        android = self.api.getAndroid()
        return self._safe(lambda: android.btIsEnabled() is not None) and self._safe(
            lambda: self.api.getAndroid().hasFeature("android.hardware.bluetooth")
        )

    def check_wifi(self):
        android = self.api.getAndroid()
        return self._safe(lambda: android.wifiIsEnabled() is not None) or self._safe(
            lambda: android.hasFeature("android.hardware.wifi")
        )

    def check_wifi_p2p(self):
        android = self.api.getAndroid()
        return self._safe(lambda: android.wifiIsP2pSupported())

    def check_ir(self):
        android = self.api.getAndroid()
        has_emitter = self._safe(lambda: android.irHasEmitter())
        # if there is no built-in IR port, check whether some plugin provides
        # one via provide_service("infrared.transmitter", ...)
        if not has_emitter:
            has_emitter = self._has_service("infrared.transmitter")
        return bool(has_emitter)

    def check_usb(self):
        android = self.api.getAndroid()
        devices_json = self._safe(lambda: android.usbDevicesJson(), default=None)
        if devices_json is None:
            return False
        return True  # method exists and ran — USB host API is available

    def check_camera(self):
        android = self.api.getAndroid()
        return self._safe(lambda: android.hasCamera())

    def check_location(self):
        android = self.api.getAndroid()
        return self._safe(lambda: android.locationIsEnabled() is not None)

    def check_sensors(self):
        android = self.api.getAndroid()
        sensors_json = self._safe(lambda: android.sensorsListJson(), default=None)
        if not sensors_json:
            return False
        try:
            data = json.loads(sensors_json)
            return bool(data)
        except Exception:
            return False

    def check_root(self):
        device = self.api.getDevice()
        return self._safe(lambda: device.rootAvailable())

    def check_shizuku(self):
        device = self.api.getDevice()
        return self._safe(lambda: device.shizukuAvailable())

    def check_nsd(self):
        # check network service discovery indirectly via Wi-Fi presence
        return self.check_wifi()

    # ---------- screen ----------

    def screen_main(self, ui, api, state):
        sections = [
            ("NFC", self.check_nfc, "Tag read/write, emulation"),
            ("Bluetooth LE", self.check_ble, "BLE scanning and advertising"),
            ("Bluetooth Classic", self.check_bt_classic, "Classic BT, RFCOMM"),
            ("Wi-Fi", self.check_wifi, "Network scanning, connection"),
            ("Wi-Fi Direct (P2P)", self.check_wifi_p2p, "Direct device-to-device connection"),
            ("Infrared port", self.check_ir, "IR signal transmission (or via a plugin)"),
            ("USB", self.check_usb, "Host mode, external devices"),
            ("Camera", self.check_camera, "Photo/video capture"),
            ("Location", self.check_location, "GPS/network location"),
            ("Sensors", self.check_sensors, "Accelerometer, gyroscope, etc."),
            ("Root", self.check_root, "Root access (Magisk etc.)"),
            ("Shizuku", self.check_shizuku, "Extended access via Shizuku"),
        ]

        rows = []
        for title, check_fn, extra in sections:
            available = self._safe(check_fn, default=False)
            rows.append(self._row(title, available, extra))

        return ui.scaffold(
            title="Module check",
            content=ui.lazy_column(
                [
                    ui.text(
                        "Status of this phone's hardware and system capabilities",
                        "bodyMedium",
                        color="muted"
                    ),
                    ui.spacer(height=8),
                ] + rows,
                padding=16,
                spacing=10
            )
        )
