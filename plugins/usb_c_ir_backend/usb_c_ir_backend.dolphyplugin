__id__ = "usb_c_ir_backend"
__name__ = "USB-C IR Backend"
__version__ = "1.0.4"
__author__ = "Pinaplast"
__description__ = "Стабильный backend для отправки штатных IR-сигналов через внешний USB-C IR-донгл, если он подключен. Если будут баги или ошибки, просьба скидывать их мне. Спасибо @LolkaMan за тест."
__icon__ = "rounded:usb"
__permissions__ = ["usb", "ir"]

import heapq
import threading
import time

from java import jclass, jarray, jbyte

# ---------------------------------------------------------------------------
# USB IR wire-protocol encoders.
# ---------------------------------------------------------------------------
class UnknownProtocolEncoder:
    name = "unknown"

    def encode(self, freq_hz, pattern):
        return None  # signals "can't encode" -> caller reports handled=False


class LegacyBulkStEncoder:
    name = "legacy_bulk_st"

    def __init__(self):
        self._e = 1
        self._f = 0

    def _next_e(self):
        self._e = self._e + 1 if self._e < 0x0F else 0x01
        return self._e

    def _next_f(self):
        self._f = self._f + 1 if self._f < 0x7F else 0x01
        return self._f

    def handshake_frames(self):
        return [bytes([0x02, 0x09, self._next_e(), 0x01, 0x01, 0x53, 0x54, self._next_f(), 0x53, 0x45, 0x4E])]

    def encode(self, freq_hz, pattern):
        if not pattern:
            return None

        normalized = [max(1, int(v)) for v in pattern]
        if len(normalized) % 2 == 0:
            tail = normalized[-1]
            normalized[-1] = tail - 3000 if tail > 3000 else 10

        payload = bytearray([0x53, 0x54, self._next_f(), 0x44, 0x00])
        for i, duration in enumerate(normalized):
            units = duration // 16
            if units <= 0:
                units = 1
            is_mark = i % 2 == 0
            while units > 0:
                chunk = min(units, 0x7F)
                units -= chunk
                payload.append(chunk | (0x80 if is_mark else 0x00))
        payload.extend([0x45, 0x4E])

        max_payload_per_frame = 0x38
        total = max(1, (len(payload) + max_payload_per_frame - 1) // max_payload_per_frame)
        e_value = self._next_e()
        frames = []
        offset = 0
        index = 1
        while offset < len(payload):
            take = min(max_payload_per_frame, len(payload) - offset)
            frame = bytearray([0x02, take + 3, e_value, total, index])
            frame.extend(payload[offset:offset + take])
            frames.append(bytes(frame))
            offset += take
            index += 1
        return frames


class ElkSmartBulkEncoder:
    name = "elksmart_bulk"
    strict_handshake = True
    wants_background_reader = False
    inter_frame_delay_ms = 2

    _IDENT_PREFIX = 0xFC
    _TYPE_D552 = (0x70, 0x01)
    _TYPE_D226 = (0x02, 0xAA)
    _ODD_PATTERN_TRAILING_GAP_US = 10000

    def __init__(self):
        self._subtype = None

    def open_handshake(self, connection, in_endpoint, out_endpoint, write_chunk, drain_in):
        drain_in(connection, in_endpoint, 80)
        identify = bytes([self._IDENT_PREFIX, self._IDENT_PREFIX, self._IDENT_PREFIX, self._IDENT_PREFIX])
        if not write_chunk(connection, out_endpoint, identify, 200):
            return False

        size = max(64, in_endpoint.getMaxPacketSize())
        resp = jarray(jbyte)([0] * size)
        deadline = time.time() + 0.45
        got = -1
        while time.time() < deadline:
            n = connection.bulkTransfer(in_endpoint, resp, size, 150)
            if n > 0:
                got = n
                break
        subtype = self._identify_subtype(resp, got)
        if subtype is None:
            return False
        self._subtype = subtype
        return True

    def _identify_subtype(self, resp, size):
        if size < 6:
            return None
        vals = [(int(resp[i]) & 0xFF) for i in range(6)]
        if vals[:4] != [self._IDENT_PREFIX] * 4:
            return None
        type_pair = (vals[4], vals[5])
        if type_pair == self._TYPE_D552:
            return "D552"
        if type_pair == self._TYPE_D226:
            return "D226"
        return None

    def encode(self, freq_hz, pattern):
        pulses = self._to_pulses(pattern)
        raw = self._compress_pulses(pulses)
        payload = self._encode_d226_payload(raw) if (self._subtype or "D552") == "D226" else raw

        f = int(freq_hz) + 0x7FFFF
        msg = bytearray([0xFF, 0xFF, 0xFF, 0xFF])
        msg.append(self._mangle_byte(f >> 8))
        msg.append(self._mangle_byte(f >> 16))
        msg.append(self._mangle_byte(f))
        msg.append(self._mangle_byte(len(payload) >> 8))
        msg.append(self._mangle_byte(len(payload)))
        msg.extend(payload)

        frames = []
        offset = 0
        while offset < len(msg):
            chunk = min(62, len(msg) - offset)
            frame = bytearray(msg[offset:offset + chunk])
            if chunk == 62:
                frame.append(self._checksum62(frame))
            frames.append(bytes(frame))
            offset += chunk
        return frames

    def post_transmit_delay_ms(self, pattern):
        total_us = 0
        for value in pattern:
            total_us += max(0, int(value))
        return max(80, int((total_us + 500) / 1000) + 25)

    def drain_after_transmit(self, connection, in_endpoint, drain_in):
        drain_in(connection, in_endpoint, 120)

    def _to_pulses(self, pattern):
        pulses = []
        i = 0
        while i < len(pattern):
            on_us = max(0, int(pattern[i]))
            off_us = max(0, int(pattern[i + 1])) if i + 1 < len(pattern) else self._ODD_PATTERN_TRAILING_GAP_US
            pulses.append((on_us, off_us))
            i += 2
        return pulses

    def _compress_pulses(self, pulses):
        if not pulses:
            return bytes()
        freq = {}
        for pulse in pulses:
            freq[pulse] = freq.get(pulse, 0) + 1
        sorted_pulses = sorted(freq.items(), key=lambda item: item[1], reverse=True)
        p1 = sorted_pulses[0][0]
        p2 = sorted_pulses[1][0] if len(sorted_pulses) > 1 else p1

        out = bytearray()
        self._compress_value_us(p2[0], out)
        self._compress_value_us(p2[1], out)
        self._compress_value_us(p1[0], out)
        self._compress_value_us(p1[1], out)
        out.extend([0xFF, 0xFF, 0xFF])
        for pulse in pulses:
            if pulse == p1:
                out.append(0x00)
            elif pulse == p2:
                out.append(0x01)
            else:
                self._compress_value_us(pulse[0], out)
                self._compress_value_us(pulse[1], out)
        return bytes(out)

    def _encode_d226_payload(self, raw):
        if not raw:
            return raw
        freq = [0] * 256
        for b in raw:
            freq[int(b) & 0xFF] += 1

        heap = []
        seq = 0
        for symbol, weight in enumerate(freq):
            if weight > 0:
                heapq.heappush(heap, (weight, seq, symbol, None, None))
                seq += 1
        if not heap:
            return raw
        while len(heap) > 1:
            left = heapq.heappop(heap)
            right = heapq.heappop(heap)
            heapq.heappush(heap, (left[0] + right[0], seq, None, left, right))
            seq += 1

        codes = []
        self._build_codes(heap[0], "", codes)
        codes.sort(key=lambda item: item[0])
        code_by_symbol = {symbol: bits for symbol, weight, bits in codes}

        out = bytearray()
        out.extend([(len(codes) >> 8) & 0xFF, len(codes) & 0xFF])
        for symbol, weight, bits in codes:
            out.extend([symbol & 0xFF, (weight >> 8) & 0xFF, weight & 0xFF])

        bit_string = "".join(code_by_symbol[int(b) & 0xFF] for b in raw)
        tail_bits = len(bit_string) % 8
        if tail_bits > 0:
            bit_string += "0" * (8 - tail_bits)
        out.append(tail_bits & 0xFF)
        for i in range(0, len(bit_string), 8):
            out.append(int(bit_string[i:i + 8], 2) & 0xFF)
        return bytes(out)

    def _build_codes(self, node, prefix, out):
        weight, seq, symbol, left, right = node
        if symbol is not None:
            out.append((symbol, weight, prefix or "0"))
            return
        self._build_codes(left, prefix + "0", out)
        self._build_codes(right, prefix + "1", out)

    def _compress_value_us(self, value_us, out):
        value_us = int(value_us)
        if value_us <= 2032:
            if value_us == 0 or value_us == 1:
                q = value_us
            else:
                q = int((value_us / 16.0) + 0.5)
            out.append(q & 0xFF)
            return
        v = value_us
        while True:
            b = v & 0x7F
            v >>= 7
            if v != 0:
                b |= 0x80
            if (b & 0xFF) == 0xFF:
                b = 0xFE
            out.append(b & 0xFF)
            if v == 0:
                break

    def _mangle_byte(self, v):
        value = int(v) & 0xFF
        reversed_bits = 0
        for _ in range(8):
            reversed_bits = (reversed_bits << 1) | (value & 1)
            value >>= 1
        return (~reversed_bits) & 0xFF

    def _checksum62(self, buf):
        total = 0
        for i in range(62):
            total += int(buf[i]) & 0xFF
        x = (total & 0xF0) | ((total >> 8) & 0x0F)
        return self._mangle_byte(x)


SUPPORTED_DONGLES = {
    (0x10C4, 0x8468): ("ZaZa Remote / Tiqiaa / Tview", LegacyBulkStEncoder),
    (0x045E, 0x8468): ("ZaZa Remote / Tiqiaa / Tview", LegacyBulkStEncoder),
    (0x045C, 0x0131): ("ElkSmart D552/D226 family", ElkSmartBulkEncoder),
    (0x045C, 0x0132): ("ElkSmart D552/D226 family", ElkSmartBulkEncoder),
    (0x045C, 0x0134): ("Ocrustar / ElkSmart D552/D226 family", ElkSmartBulkEncoder),
    (0x045C, 0x014A): ("ElkSmart D552/D226 family", ElkSmartBulkEncoder),
    (0x045C, 0x0184): ("ElkSmart D552/D226 family", ElkSmartBulkEncoder),
    (0x045C, 0x0195): ("ElkSmart D552/D226 family", ElkSmartBulkEncoder),
    (0x045C, 0x02AA): ("ElkSmart old model", ElkSmartBulkEncoder),
}

KNOWN_DONGLE_IDS = set(SUPPORTED_DONGLES.keys())


class UsbCIrBackend(BasePlugin):
    def on_plugin_load(self):
        self.add_module(
            title="USB-C IR Backend",
            description="External IR dongle status",
            icon="usb",
            screen="main",
            section="INFRARED",
        )

        self._usb_manager = None
        self._context = None
        self._device = None
        self._connection = None
        self._usb_interface = None
        self._out_endpoint = None
        self._in_endpoint = None
        self._endpoint_type = None
        self._dongle_name = None
        self._encoder = UnknownProtocolEncoder()
        self._tx_lock = threading.Lock()
        self._tx_count = 0
        self._reader_lock = threading.Lock()
        self._reader_thread = None
        self._read_until_at = 0

        self._log_lines = []
        self._stop_flag = threading.Event()
        self._last_missing_log_at = 0
        self._permission_request_at = {}

        self._context = self.api.getContext()
        UsbManager = jclass("android.hardware.usb.UsbManager")
        self._usb_manager = self._context.getSystemService("usb")

        # Registers this plugin as an alternative IR backend. Dolphy calls
        # service_infrared_transmitter_available() to decide whether to
        # offer this backend, and service_infrared_transmitter_transmit()
        # after action hooks but before the built-in ConsumerIrManager
        # fallback.
        self.provide_service("infrared.transmitter", 100)

        # Small non-intrusive status badge overlaid on the stock Infrared
        # screens (the IR home/list screens plus every actual remote
        # screen where Transmit is pressed), both reachable directly and
        # nested under "other/". Doesn't touch the underlying screen --
        # "fab" mode just draws a small icon in the bottom-end corner.
        ir_status_routes = [
            "ir_*", "other/ir_*",
            "tv_remote/*", "other/tv_remote/*",
            "universal_remote/*", "other/universal_remote/*",
            "user_ir_remote*", "other/user_ir_remote*",
            "flipper_remote/*", "other/flipper_remote/*",
        ]
        for route in ir_status_routes:
            self.hook_screen(route, "usb_status_badge", "fab", 50)

        self._poll_thread = threading.Thread(target=self._poll_loop, daemon=True)
        self._poll_thread.start()

        self._log("Plugin loaded, watching for USB IR dongle")

    def on_plugin_unload(self):
        self._stop_flag.set()
        self._release_usb()
        self._log("Plugin unloaded")

    # -- service provider: infrared.transmitter -----------------------------

    def service_infrared_transmitter_available(self, payload):
        return {"available": self._is_connected()}

    def service_infrared_transmitter_transmit(self, payload):
        if not self._is_connected():
            return {"handled": False}

        freq = int(payload["frequency"])
        pattern = [int(v) for v in payload["pattern"]]

        with self._tx_lock:
            if not self._is_connected():
                return {"handled": False}

            self._tx_count += 1
            encoded = self._encoder.encode(freq, pattern)
            if encoded is None:
                self._log(
                    "encoder '%s' could not encode signal (freq=%d, len=%d) "
                    "-- protocol not implemented yet" % (self._encoder.name, freq, len(pattern))
                )
                # Let the built-in ConsumerIrManager try instead of silently
                # pretending to have sent something.
                return {"handled": False}

            ok = self._usb_write(encoded)
            delay_ms = self._post_transmit_delay_ms(pattern)
            self._log(
                "USB queued %s (freq=%d, patLen=%d, frames=%d, bytes=%d, waitMs=%d)"
                % (
                    "ok" if ok else "FAILED",
                    freq,
                    len(pattern),
                    len(self._encoded_chunks(encoded)),
                    self._encoded_size(encoded),
                    delay_ms,
                )
            )
            if ok:
                time.sleep(delay_ms / 1000.0)
            else:
                self._release_usb()
                return {"handled": False, "ok": False}
            return {"handled": True, "ok": True}

    # -- USB lifecycle --------------------------------------------------------

    def _is_connected(self):
        return self._device is not None and self._connection is not None and self._out_endpoint is not None

    def _poll_loop(self):
        # Dolphy's plugin runtime doesn't give us a clean way to subclass
        # BroadcastReceiver from pure Python at runtime, so attach/detach
        # and permission-grant detection are done by polling instead of
        # listening for ACTION_USB_DEVICE_ATTACHED/DETACHED broadcasts.
        # This is simple and reliable, at the cost of a small delay
        # (checked every ~1.5s) rather than being instantaneous.
        while not self._stop_flag.is_set():
            try:
                self._scan_once()
            except Exception as e:
                self._log("poll error: %s" % e)
            self._stop_flag.wait(1.5)

    def _java_collection_to_list(self, java_collection):
        # Chaquopy doesn't reliably expose Python's iteration protocol for
        # every java.util.Collection implementation -- HashMap$Values from
        # getDeviceList().values() raised "object is not iterable" here.
        # toArray() gives a plain Java array, which Chaquopy always
        # supports through the Python sequence protocol; that's the most
        # robust conversion. Fall back to manual Iterator methods only if
        # toArray() itself isn't available for some reason.
        try:
            return list(java_collection.toArray())
        except Exception:
            result = []
            it = java_collection.iterator()
            while it.hasNext():
                result.append(it.next())
            return result

    def _scan_once(self, missing_log_force=False):
        device_list = self._usb_manager.getDeviceList()
        devices = self._java_collection_to_list(device_list.values())

        if self._device is not None:
            still_attached = any(d.getDeviceName() == self._device.getDeviceName() for d in devices)
            if not still_attached:
                self._log("Dongle detached: %s" % self._device.getDeviceName())
                self._release_usb()

        if self._device is not None:
            return  # already have a working device

        for dev in devices:
            vid = dev.getVendorId()
            pid = dev.getProductId()
            key = (vid, pid)
            if key not in KNOWN_DONGLE_IDS:
                continue

            if self._usb_manager.hasPermission(dev):
                self._open_device(dev)
                return
            else:
                self._request_permission(dev)
                # Don't block here; permission dialog is asynchronous.
                # A later poll tick will pick it up once hasPermission()
                # returns true (or the user dismisses/denies it).
                return

        self._log_dongle_missing(force=missing_log_force)

    def _request_permission(self, dev):
        device_key = dev.getDeviceName()
        now = time.time()
        if now - self._permission_request_at.get(device_key, 0) < 15:
            return
        self._permission_request_at[device_key] = now

        try:
            Intent = jclass("android.content.Intent")
            PendingIntent = jclass("android.app.PendingIntent")
            Build = jclass("android.os.Build")

            intent = Intent("com.dolphy.plugin.usb_c_ir_backend.USB_PERMISSION")
            intent.setPackage(self._context.getPackageName())
            flags = 0x08000000  # FLAG_UPDATE_CURRENT
            if Build.VERSION.SDK_INT >= 31:
                flags = flags | 0x02000000  # FLAG_MUTABLE, lets UsbManager attach permission extras
            pi = PendingIntent.getBroadcast(self._context, 0, intent, flags)
            self._usb_manager.requestPermission(dev, pi)
            self._log(
                "Requesting USB permission for %s vid=0x%04X pid=0x%04X"
                % (SUPPORTED_DONGLES[(dev.getVendorId(), dev.getProductId())][0], dev.getVendorId(), dev.getProductId())
            )
        except Exception as e:
            self._log("USB permission request failed: %s" % e)

    def _open_device(self, dev):
        UsbConstants = jclass("android.hardware.usb.UsbConstants")
        key = (dev.getVendorId(), dev.getProductId())
        profile = SUPPORTED_DONGLES.get(key)
        if profile is None:
            self._log("USB device is recognized but not supported for transmit: vid=0x%04X pid=0x%04X" % key)
            return

        dongle_name, encoder_class = profile
        claimed_interface = None
        claimed_out_endpoint = None
        claimed_in_endpoint = None
        endpoint_type = None
        for i in range(dev.getInterfaceCount()):
            intf = dev.getInterface(i)
            pair = self._find_endpoint_pair(intf, UsbConstants)
            if pair is not None:
                claimed_interface, claimed_out_endpoint, claimed_in_endpoint, endpoint_type = intf, pair[0], pair[1], pair[2]
                break

        if claimed_interface is None:
            self._log("Supported dongle has no paired bulk/interrupt IN+OUT endpoints: %s" % dev.getDeviceName())
            return

        conn = self._usb_manager.openDevice(dev)
        if conn is None:
            self._log("openDevice() failed for %s" % dev.getDeviceName())
            return

        if not conn.claimInterface(claimed_interface, True):
            self._log("claimInterface() failed for %s" % dev.getDeviceName())
            conn.close()
            return

        encoder = encoder_class()
        handshake_ok = self._run_open_handshake(conn, claimed_in_endpoint, claimed_out_endpoint, encoder)
        if not handshake_ok:
            self._log("USB handshake failed for %s" % dongle_name)
            if getattr(encoder, "strict_handshake", False):
                try:
                    conn.releaseInterface(claimed_interface)
                except Exception:
                    pass
                conn.close()
                return

        self._device = dev
        self._connection = conn
        self._usb_interface = claimed_interface
        self._out_endpoint = claimed_out_endpoint
        self._in_endpoint = claimed_in_endpoint
        self._endpoint_type = endpoint_type
        self._dongle_name = dongle_name
        self._encoder = encoder
        self._log(
            "%s ready: vid=0x%04X pid=0x%04X iface=%s out=%s in=%s type=%s protocol=%s"
            % (
                dongle_name,
                dev.getVendorId(),
                dev.getProductId(),
                claimed_interface.getId(),
                claimed_out_endpoint.getAddress(),
                claimed_in_endpoint.getAddress(),
                endpoint_type,
                self._encoder.name,
            )
        )
        self.refresh()

    def _find_endpoint_pair(self, intf, UsbConstants):
        def collect(endpoint_type, label):
            out_by_num = {}
            in_by_num = {}
            for e in range(intf.getEndpointCount()):
                ep = intf.getEndpoint(e)
                if ep.getType() != endpoint_type:
                    continue
                number = ep.getAddress() & 0x0F
                if ep.getDirection() == UsbConstants.USB_DIR_OUT:
                    out_by_num[number] = ep
                elif ep.getDirection() == UsbConstants.USB_DIR_IN:
                    in_by_num[number] = ep
            for number in sorted(set(out_by_num.keys()) & set(in_by_num.keys())):
                return out_by_num[number], in_by_num[number], label
            return None

        bulk_pair = collect(UsbConstants.USB_ENDPOINT_XFER_BULK, "bulk")
        if bulk_pair is not None:
            return bulk_pair
        return collect(UsbConstants.USB_ENDPOINT_XFER_INT, "interrupt")

    def _run_open_handshake(self, conn, in_endpoint, out_endpoint, encoder):
        try:
            if hasattr(encoder, "open_handshake"):
                return encoder.open_handshake(conn, in_endpoint, out_endpoint, self._write_chunk, self._drain_in_endpoint)

            self._drain_in_endpoint(conn, in_endpoint, 80)
            for frame in encoder.handshake_frames():
                if not self._write_chunk(conn, out_endpoint, frame, 250):
                    return False
            self._drain_in_endpoint(conn, in_endpoint, 250)
            return True
        except Exception as e:
            self._log("handshake error: %s" % e)
            return False

    def _drain_in_endpoint(self, conn, in_endpoint, timeout_ms):
        if conn is None or in_endpoint is None:
            return
        size = max(64, in_endpoint.getMaxPacketSize())
        buf = jarray(jbyte)([0] * size)
        deadline = time.time() + (timeout_ms / 1000.0)
        while time.time() < deadline:
            result = conn.bulkTransfer(in_endpoint, buf, size, 10)
            if result <= 0:
                break

    def _ensure_reader(self):
        with self._reader_lock:
            self._read_until_at = max(self._read_until_at, time.time() + 1.0)
            if self._reader_thread is not None and self._reader_thread.is_alive():
                return
            self._reader_thread = threading.Thread(target=self._reader_loop, daemon=True)
            self._reader_thread.start()

    def _reader_loop(self):
        while not self._stop_flag.is_set():
            if time.time() >= self._read_until_at:
                return
            conn = self._connection
            endpoint = self._in_endpoint
            if conn is None or endpoint is None:
                return
            try:
                size = max(64, endpoint.getMaxPacketSize())
                buf = jarray(jbyte)([0] * size)
                conn.bulkTransfer(endpoint, buf, size, 300)
            except Exception:
                time.sleep(0.005)
            time.sleep(0.001)

    def _release_usb(self):
        try:
            if self._connection is not None:
                if self._usb_interface is not None:
                    self._connection.releaseInterface(self._usb_interface)
                self._connection.close()
        except Exception as e:
            self._log("release error: %s" % e)
        finally:
            self._device = None
            self._connection = None
            self._usb_interface = None
            self._out_endpoint = None
            self._in_endpoint = None
            self._endpoint_type = None
            self._dongle_name = None
            self._encoder = UnknownProtocolEncoder()
            self._tx_count = 0
            self._read_until_at = 0
            self.refresh()

    def _post_transmit_delay_ms(self, pattern):
        if hasattr(self._encoder, "post_transmit_delay_ms"):
            return self._encoder.post_transmit_delay_ms(pattern)
        total_us = 0
        for value in pattern:
            try:
                total_us += max(0, int(value))
            except Exception:
                pass
        # The legacy dongle expects time to actually emit the IR waveform before
        # receiving the next command; universal remotes can otherwise overrun it.
        return max(25, int(total_us / 1000) + 2)

    def _encoded_chunks(self, encoded):
        if encoded is None or len(encoded) == 0:
            return []
        first = encoded[0]
        if isinstance(first, int):
            return [encoded]
        return list(encoded)

    def _encoded_size(self, encoded):
        return sum(len(chunk) for chunk in self._encoded_chunks(encoded))

    def _write_chunk(self, conn, endpoint, data_bytes, timeout_ms=400):
        signed = []
        for b in data_bytes:
            v = int(b) & 0xFF
            signed.append(v - 256 if v > 127 else v)
        java_bytes = jarray(jbyte)(signed)
        result = conn.bulkTransfer(endpoint, java_bytes, len(signed), timeout_ms)
        return result > 0

    def _usb_write(self, encoded):
        try:
            chunks = self._encoded_chunks(encoded)
            inter_frame_delay_ms = getattr(self._encoder, "inter_frame_delay_ms", 0)
            wants_reader = getattr(self._encoder, "wants_background_reader", True)
            for index, chunk in enumerate(chunks):
                if not self._write_chunk(self._connection, self._out_endpoint, chunk):
                    return False
                if wants_reader:
                    self._ensure_reader()
                if inter_frame_delay_ms > 0 and index + 1 < len(chunks):
                    time.sleep(inter_frame_delay_ms / 1000.0)
            if hasattr(self._encoder, "drain_after_transmit"):
                self._encoder.drain_after_transmit(self._connection, self._in_endpoint, self._drain_in_endpoint)
            return True
        except Exception as e:
            self._log("bulkTransfer threw: %s" % e)
            return False

    # -- logging / UI -----------------------------------------------------

    def _log_dongle_missing(self, force=False):
        now = time.time()
        if force or now - self._last_missing_log_at >= 15:
            self._last_missing_log_at = now
            self._log("Донгл не найден, продолжаю поиск")


    def _log(self, line):
        stamp = time.strftime("%H:%M:%S")
        self._log_lines.append("[%s] %s" % (stamp, line))
        if len(self._log_lines) > 100:
            self._log_lines = self._log_lines[-100:]
        self.refresh()

    def screen_usb_status_badge(self, ui, api, state):
        connected = self._is_connected()
        return ui.icon_button(
            "usb" if connected else "usb_off",
            lambda: self.navigate("main"),
        )

    def _manual_rescan(self):
        self._log("Manual rescan requested")
        try:
            self._scan_once(missing_log_force=True)
        except Exception as e:
            self._log("rescan error: %s" % e)
        self.refresh()

    def screen_tv_hack_warning(self, ui, api, state):
        return ui.scaffold(
            title="Взломать телевизор",
            content=ui.column(
                [
                    ui.card(
                        [
                            ui.text("Обязательно включи ВПН", "titleMedium"),
                            ui.button("ВПН включён", lambda: self.navigate("tv_hack_rickroll")),
                        ]
                    ),
                ],
                padding=16,
                spacing=12,
                fill_max_size=True,
            ),
        )

    def screen_tv_hack_rickroll(self, ui, api, state):
        return ui.scaffold(
            title="Взлом телевизора",
            content=ui.column(
                [
                    ui.webview(url="https://www.youtube.com/watch?v=dQw4w9WgXcQ", fill_max_size=True),
                ],
                padding=0,
                spacing=0,
                fill_max_size=True,
            ),
        )

    def screen_main(self, ui, api, state):
        connected = self._is_connected()
        if connected:
            status_text = "🟢 Dongle connected (vid=%s pid=%s)" % (
                self._device.getVendorId(),
                self._device.getProductId(),
            )
        else:
            status_text = "🔴 No USB-C IR dongle detected"

        proto_text = "Protocol: %s" % self._encoder.name
        if self._encoder.name == "unknown":
            proto_text += " (not implemented -- falls back to built-in IR)"

        return ui.scaffold(
            title="USB-C IR Backend",
            content=ui.column(
                [
                    ui.card(
                        [
                            ui.text(status_text, "titleSmall"),
                            ui.text(proto_text, "bodySmall", "muted"),
                            ui.button("Обновить", self._manual_rescan),
                            ui.button("Взломать телевизор", lambda: self.navigate("tv_hack_warning")),
                        ]
                    ),
                    ui.text("Recent log", "titleSmall"),
                    ui.log_panel("\n".join(self._log_lines[-40:]), max_height=300),

                    ui.text("Плагин стабильно работает. Если будут баги или ошибки - просьба скидывать @Pinaplast457", "bodySmall", "muted"),
                    ui.text("Спасибо @LolkaMan за тест", "bodySmall", "muted"),
                ],
                padding=16,
                spacing=12,
                fill_max_size=True,
            ),
        )
