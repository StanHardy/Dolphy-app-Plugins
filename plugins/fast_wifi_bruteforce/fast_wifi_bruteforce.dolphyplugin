        r"\s+(?P<rssi>-?\d+)"
        r"(?:\s*\([^)]*\))?"
        r"\s+(?P<age>\S+)"
        r"[ \t](?P<tail>.*)$"
    )
    FLAGS_SUFFIX = re.compile(r"(?P<flags>(?:\[[^\]\r\n]*\])+)\s*$")
    MAC_PREFIX = re.compile(r"^\s*(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}\b")

