class Cortex(BasePlugin):
    def on_plugin_load(self):
        self.add_module(
            title="Cortex",
            description="Created by h3rovnik",
            icon="palette",
            screen="main",
            section="PLUGINS"
        )
        self.input_text = ""
        self.output_text = ""
        self.active_font = "Capital"

    def _transform_text(self, text, font_name):
        if not text:
            return ""
        mapping = fonts.get(font_name, fonts["Capital"])
        result = []
        for ch in text:
            lower = ch.lower()
            if lower in mapping:
                result.append(mapping[lower])
            else:
                result.append(ch)
        return "".join(result)

    def _get_font_display(self, font_name):
        mapping = fonts.get(font_name, fonts["Capital"])
        result = []
        for ch in font_name:
            lower = ch.lower()
            if lower in mapping:
                result.append(mapping[lower])
            else:
                result.append(ch)
        return "".join(result)

    def screen_main(self, ui, api, state):
        if state is None:
            state = {}
        self.input_text = state.get("input", self.input_text)
        self.output_text = state.get("output", self.output_text)
        self.active_font = state.get("active_font", self.active_font)

        def update_input(new_text):
            self.input_text = new_text
            self.output_text = self._transform_text(new_text, self.active_font)
            self.refresh()

        def set_font(font_name):
            self.active_font = font_name
            self.output_text = self._transform_text(self.input_text, font_name)
            self.refresh()

        def copy_output():
            if self.output_text:
                api.getAndroid().clipboardSet(self.output_text)
                self.toast("Скопировано")
            else:
                self.toast("Нет текста")

        def clear_all():
            self.input_text = ""
            self.output_text = ""
            self.refresh()

        items = []

        row1 = ui.row([
            ui.button(self._get_font_display("Capital"), on_click=lambda: set_font("Capital"), style="filled" if self.active_font == "Capital" else "outlined"),
            ui.button(self._get_font_display("Flowing"), on_click=lambda: set_font("Flowing"), style="filled" if self.active_font == "Flowing" else "outlined"),
            ui.button(self._get_font_display("Coptic"), on_click=lambda: set_font("Coptic"), style="filled" if self.active_font == "Coptic" else "outlined")
        ], spacing=4)
        items.append(row1)

        row2 = ui.row([
            ui.button(self._get_font_display("Canada"), on_click=lambda: set_font("Canada"), style="filled" if self.active_font == "Canada" else "outlined"),
            ui.button(self._get_font_display("Gothic"), on_click=lambda: set_font("Gothic"), style="filled" if self.active_font == "Gothic" else "outlined"),
            ui.button(self._get_font_display("Greek"), on_click=lambda: set_font("Greek"), style="filled" if self.active_font == "Greek" else "outlined")
        ], spacing=4)
        items.append(row2)

        row3 = ui.row([
            ui.button(self._get_font_display("Chinese"), on_click=lambda: set_font("Chinese"), style="filled" if self.active_font == "Chinese" else "outlined"),
            ui.button(self._get_font_display("Runes"), on_click=lambda: set_font("Runes"), style="filled" if self.active_font == "Runes" else "outlined"),
            ui.button(self._get_font_display("Ethiopia"), on_click=lambda: set_font("Ethiopia"), style="filled" if self.active_font == "Ethiopia" else "outlined")
        ], spacing=4)
        items.append(row3)

        items.append(ui.text_field(value=self.input_text, label="Введите текст", on_change=update_input))

        items.append(ui.text(self.output_text if self.output_text else "Преобразованный текст", style="bodyMedium"))

        items.append(ui.row([
            ui.button("Копировать", on_click=copy_output, style="text"),
            ui.button("Очистить", on_click=clear_all, style="text")
        ], spacing=8))

        return ui.scaffold(
            title="Cortex",
            content=ui.column(items, padding=12, spacing=8)
        )