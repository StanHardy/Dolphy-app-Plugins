class Cortex(BasePlugin):
    def on_plugin_load(self):
        self.add_module(
            title="Cortex",
            description="Text styler created by @h3rovnik",
            icon="palette",
            screen="main",
            section="PLUGINS"
        )
        if self.get_setting("active_font") is None:
            self.set_setting("active_font", "Capital")
        if self.get_setting("input_text") is None:
            self.set_setting("input_text", "")
        if self.get_setting("output_text") is None:
            self.set_setting("output_text", "")

    def _transform_text(self, text, font_name):
        if not text:
            return ""
        mapping = fonts.get(font_name, fonts["Capital"])
        result = []
        for ch in text:
            if ch in mapping:
                result.append(mapping[ch])
            elif ch.lower() in mapping:
                result.append(mapping[ch.lower()])
            elif ch.upper() in mapping:
                result.append(mapping[ch.upper()])
            else:
                result.append(ch)
        return "".join(result)

    def _get_font_display(self, font_name):
        if font_name == "Wide":
            return "Text"
        return self._transform_text("Text", font_name)

    def set_font(self, font_name):
        self.set_setting("active_font", font_name)
        input_text = self.get_setting("input_text", "")
        self.set_setting("output_text", self._transform_text(input_text, font_name))
        self.refresh()

    def update_input(self, new_text):
        self.set_setting("input_text", new_text)
        active_font = self.get_setting("active_font", "Capital")
        self.set_setting("output_text", self._transform_text(new_text, active_font))
        self.refresh()

    def copy_output(self):
        output_text = self.get_setting("output_text", "")
        if output_text:
            self.api.getAndroid().clipboardSet(output_text)
            self.toast("Copied")
        else:
            self.toast("No text")

    def clear_all(self):
        self.set_setting("input_text", "")
        self.set_setting("output_text", "")
        self.refresh()

    def screen_main(self, ui, api, state):
        active_font = self.get_setting("active_font", "Capital")
        input_text = self.get_setting("input_text", "")
        output_text = self.get_setting("output_text", "")

        font_order = [
            "Capital", "Italic", "Sans", "Mono",
            "Math", "Gothic", "Fraktur", "Runes",
            "Script", "Flowing", "Bubble", "Circle",
            "Wide", "Greek", "Coptic", "Canada",
            "Chinese", "Ethio", "InvBreve", "RetroHook",
            "Vzmet", "Arrows", "Solidus", "AntiClock"
        ]
        
        rows = []
        for i in range(0, len(font_order), 4):
            chunk = font_order[i:i+4]
            row_btns = []
            for f_name in chunk:
                row_btns.append(
                    ui.button(
                        self._get_font_display(f_name),
                        on_click=partial(self.set_font, f_name),
                        style="filled" if active_font == f_name else "outlined"
                    )
                )
            rows.append(ui.row(row_btns, spacing=4))

        items = []
        for r in rows:
            items.append(r)
            
        items.append(ui.spacer(height=8))
        items.append(ui.text_field(value=input_text, label="Enter text", on_change=self.update_input))
        items.append(ui.text(output_text if output_text else "Converted text", style="bodyLarge"))
        
        items.append(ui.row([
            ui.button("Copy", on_click=self.copy_output, style="filled"),
            ui.button("Clear", on_click=self.clear_all, style="outlined")
        ], spacing=8))

        return ui.scaffold(
            title="Cortex",
            content=ui.column(items, padding=12, spacing=4)
        )