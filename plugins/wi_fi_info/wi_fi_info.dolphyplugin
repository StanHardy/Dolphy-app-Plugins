def get_vendor_fallback(ssid):
    if not ssid:
        return None
    ssid_upper = ssid.upper()
    for key, vendor in SSID_VENDOR_MAP.items():
        if key.upper() in ssid_upper:
            return vendor
    return None

def get_vendor(mac, ssid=None):
    if mac and mac != "unknown" and len(mac) >= 8:
        mac_upper = mac.upper().replace("-", ":").replace(".", ":")
        prefix = mac_upper[:8]
        vendor = OUI_DB.get(prefix)
        if vendor:
            return vendor
    if ssid:
        fallback = get_vendor_fallback(ssid)
        if fallback:
            return fallback
    return "Unknown"

def format_channel_width(cw):
    if cw == 1:
        return "20 MHz"
    elif cw == 2:
        return "40 MHz"
    elif cw == 3:
        return "80 MHz"
    elif cw == 4:
        return "160 MHz"
    elif cw == 5:
        return "320 MHz"
    else:
        return f"{cw} MHz"

def parse_capabilities(cap_str):
    if not cap_str:
        return "None"
    flags = []
    if "WPA2" in cap_str or "RSN" in cap_str:
        flags.append("WPA2")
    if "WPA" in cap_str and "WPA2" not in flags:
        flags.append("WPA")
    if "WPA3" in cap_str:
        flags.append("WPA3")
    if "WPS" in cap_str:
        flags.append("WPS")
    if "ESS" in cap_str:
        flags.append("Infrastructure")
    if "IBSS" in cap_str:
        flags.append("Ad-hoc")
    if "MFPC" in cap_str:
        flags.append("MFPC")
    if "MFPR" in cap_str:
        flags.append("MFPR")
    if "SAE" in cap_str:
        flags.append("SAE")
    if "OWE" in cap_str:
        flags.append("OWE")
    if not flags:
        return "Open" if "ESS" in cap_str else cap_str
    return ", ".join(flags)

def signal_quality_text(rssi, lang):
    if rssi >= -50:
        return "[Excellent]" if lang == "en" else "[Отличный]"
    elif rssi >= -70:
        return "[Good]" if lang == "en" else "[Хороший]"
    else:
        return "[Weak]" if lang == "en" else "[Слабый]"

def get_band(freq):
    if freq < 2500:
        return "2.4 GHz"
    elif freq < 6000:
        return "5 GHz"
    else:
        return "6 GHz"

class WifiInfo(BasePlugin):
    def __init__(self):
        super().__init__()
        self.networks = []
        self.scanning = False
        self.dot_counter = 0
        self.dot_timer = None
        self.scan_error = ""
        self.anim_state = 0
        self.anim_timer = None
        self.lang = "ru"

    def on_plugin_load(self):
        self.lang = self.get_setting("lang", "ru")
        self.add_module("Wi-Fi info", "Сканирует доступные Wi-Fi сети и показывает их параметры SSID, BSSID, RSSI, частота, канал, тип шифрования, ширину канала, производителя, имя оператора, центральную частоту, timestamp и дополнительные возможности сети.", "wifi", "main")
        self.check_permissions()
        self.start_animation()

    def start_animation(self):
        if self.anim_timer:
            self.anim_timer.cancel()
        self.anim_timer = threading.Timer(0.5, self._anim_loop)
        self.anim_timer.daemon = True
        self.anim_timer.start()

    def _anim_loop(self):
        self.anim_state = (self.anim_state + 1) % 16
        self.refresh()
        self.anim_timer = threading.Timer(0.5, self._anim_loop)
        self.anim_timer.daemon = True
        self.anim_timer.start()

    def check_permissions(self):
        android = self.api.getAndroid()
        if not android.hasPermission("android.permission.ACCESS_FINE_LOCATION"):
            self.scan_error = "Location permission required. Grant it in Android settings and refresh."
            self.refresh()

    def scan_networks(self):
        if self.scanning:
            return
        self.scanning = True
        self.scan_error = ""
        self.dot_counter = 0
        if self.dot_timer:
            self.dot_timer.cancel()
        self.dot_timer = threading.Timer(0.5, self._update_dots)
        self.dot_timer.daemon = True
        self.dot_timer.start()
        threading.Thread(target=self._scan_thread, daemon=True).start()

    def _update_dots(self):
        if not self.scanning:
            return
        self.dot_counter = (self.dot_counter + 1) % 4
        self.refresh()
        self.dot_timer = threading.Timer(0.5, self._update_dots)
        self.dot_timer.daemon = True
        self.dot_timer.start()

    def _scan_thread(self):
        try:
            device_api = self.api.getDevice()
            if not device_api.wifiIsEnabled():
                self.scan_error = "Wi-Fi is disabled. Please enable Wi-Fi and refresh."
                self.scanning = False
                if self.dot_timer:
                    self.dot_timer.cancel()
                self.refresh()
                return

            result_json = device_api.wifiScanResultsJson(200, None)
            if not result_json or result_json == "[]":
                device_api.wifiStartScan(True)
                time.sleep(6)
                result_json = device_api.wifiScanResultsJson(200, None)

            if not result_json or result_json == "[]":
                self.scan_error = "No networks found. Try again or check location permissions."
                self.networks = []
            else:
                data = json.loads(result_json)
                unique = {}
                for item in data:
                    bssid = item.get("bssid", "unknown")
                    if bssid == "unknown":
                        continue
                    if bssid not in unique or item.get("rssi", -100) > unique[bssid].get("rssi", -100):
                        unique[bssid] = item
                self.networks = []
                for bssid, item in unique.items():
                    ssid = item.get("ssid", "Hidden")
                    vendor = get_vendor(bssid, ssid)
                    freq = item.get("frequency", 0)
                    cw = item.get("channelWidth", 0)
                    cap = item.get("capabilities", "")
                    rssi = item.get("rssi", 0)
                    network = {
                        "ssid": ssid,
                        "bssid": bssid,
                        "vendor": vendor,
                        "rssi": rssi,
                        "frequency": freq,
                        "channel": item.get("channel", 0),
                        "capabilities_raw": cap,
                        "timestamp": item.get("timestamp", 0),
                        "centerFreq0": item.get("centerFreq0", 0),
                        "channelWidth": cw,
                        "operatorFriendlyName": item.get("operatorFriendlyName", ""),
                        "band": get_band(freq),
                        "channel_width_readable": format_channel_width(cw),
                        "encryption_readable": parse_capabilities(cap),
                        "signal_rssi": rssi,
                    }
                    self.networks.append(network)
                if len(self.networks) == 0:
                    self.scan_error = "No networks found."

        except Exception as e:
            self.scan_error = "Error: " + str(e)

        self.scanning = False
        if self.dot_timer:
            self.dot_timer.cancel()
        self.refresh()

    def toggle_lang(self):
        self.lang = "en" if self.lang == "ru" else "ru"
        self.set_setting("lang", self.lang)
        self.refresh()

    def screen_main(self, ui, api, state):
        if self.scanning:
            dots = "." * self.dot_counter
            status_text = f"Scanning{dots}" if self.lang == "en" else f"Сканирование{dots}"
        elif self.networks:
            status_text = "found" if self.lang == "en" else "найдено"
        else:
            status_text = "Press Refresh to scan" if self.lang == "en" else "Нажмите Обновить для сканирования"

        anim_texts = [
            "", ">", ">-", ">-<",
            "", ">", ">.", ">.<",
            "", ">", ">~", ">~<",
            "", ">", ">∆", ">∆<"
        ]
        anim_text = anim_texts[self.anim_state]

        children = []
        children.append(ui.text(f"Status {status_text}", "headlineSmall", color="#FFFFFF"))
        children.append(ui.text(anim_text, "bodyMedium", color="#AAAAAA"))
        networks_label = "Number of networks" if self.lang == "en" else "Количество сетей"
        children.append(ui.text(f"{networks_label} {len(self.networks)}", "bodyMedium", color="#FFFFFF"))

        if self.scan_error and not self.networks:
            children.append(ui.text(self.scan_error, "bodyMedium", color="#FF0000"))

        lang_label = "En" if self.lang == "ru" else "Ru"
        refresh_row = ui.row([
            ui.button("Refresh", self.scan_networks, style="tonal"),
            ui.button(lang_label, on_click=self.toggle_lang, style="tonal")
        ], spacing=8, fill_max_width=True)
        children.append(refresh_row)

        available_label = "Available networks" if self.lang == "en" else "Доступные сети"
        children.append(ui.text(available_label, "titleMedium", color="#FFFFFF"))

        for net in self.networks:
            ssid = net["ssid"]
            bssid = net["bssid"]
            vendor = net["vendor"]
            rssi = net["rssi"]
            freq = net["frequency"]
            ch = net["channel"]
            band = net["band"]
            cw_readable = net["channel_width_readable"]
            encryption = net["encryption_readable"]
            quality = signal_quality_text(rssi, self.lang)
            ts = net["timestamp"]
            cf0 = net.get("centerFreq0", 0)
            op_name = net.get("operatorFriendlyName", "")
            description = f"BSSID {bssid} | {vendor} | RSSI {rssi} dBm {quality} | {freq} MHz ({band}) | Ch {ch} | {encryption} | BW {cw_readable}"
            if cf0:
                description += f" | CF {cf0} MHz"
            if op_name:
                description += f" | {op_name}"
            if ts:
                description += f" | {ts}"
            card_content = ui.column([
                ui.text(ssid, "titleMedium", color="#FFFFFF"),
                ui.text(description, "bodySmall", color="#AAAAAA")
            ], padding=8)
            card = ui.card(card_content, padding=12)
            children.append(card)

        return ui.scaffold(
            title="Wi-Fi info",
            content=ui.lazy_column(children, padding=16, spacing=8)
        )

    def on_plugin_unload(self):
        self.scanning = False
        if self.dot_timer:
            self.dot_timer.cancel()
        if self.anim_timer:
            self.anim_timer.cancel()