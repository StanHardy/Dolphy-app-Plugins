__name__ = "Wi-Fi info"
__version__ = "1.0.0"
__author__ = "h3rovnik"
__icon__ = "rounded:wifi"
__description__ = "Сканирует доступные Wi-Fi сети и показывает их параметры SSID, BSSID, RSSI, частота, канал, тип шифрования, ширину канала, производителя, имя оператора, центральную частоту, timestamp и дополнительные возможности сети."
__permissions__ = ["files", "shell", "android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_COARSE_LOCATION", "android.permission.NEARBY_WIFI_DEVICES"]

