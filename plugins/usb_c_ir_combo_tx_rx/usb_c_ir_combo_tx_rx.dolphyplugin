__id__ = "usb_c_ir_combo"
__name__ = "USB-C IR Combo (TX+RX)"
__version__ = "1.0.0"
__author__ = "Vortyx"
__description__ = "Объединённый backend для внешнего USB-C IR-донгла: приём (запись сигналов, виртуальные пульты) и передача через ОДНО и то же USB-соединение, без конфликта интерфейса между двумя отдельными плагинами. TX-протоколы (кодировщики ElkSmart/ZaZa) основаны на usb_c_ir_backend."
__icon__ = "rounded:usb"
__permissions__ = ["usb", "ir"]

import heapq
import json
import os
import threading
import time

from java import jclass, jarray, jbyte

# ---------------------------------------------------------------------------
# TX: USB IR wire-protocol encoders (без изменений -- рабочий код).
# ---------------------------------------------------------------------------
class UnknownProtocolEncoder:
    name = "unknown"

    def encode(self, freq_hz, pattern):
        return None


class LegacyBulkStEncoder:
    name = "legacy_bulk_st"

    def __init__(self):
        self._e = 1
        self._f = 0

    def _next_e(self):
        self._e = self._e + 1 if self._e < 0x0F else 0x01
        return self._e

    def _next_f(self):
        self._f = self._f + 1 if self._f < 0x7F else 0x01
        return self._f

    def handshake_frames(self):
        return [bytes([0x02, 0x09, self._next_e(), 0x01, 0x01, 0x53, 0x54, self._next_f(), 0x53, 0x45, 0x4E])]

    def encode(self, freq_hz, pattern):
        if not pattern:
            return None

        normalized = [max(1, int(v)) for v in pattern]
        if len(normalized) % 2 == 0:
            tail = normalized[-1]
            normalized[-1] = tail - 3000 if tail > 3000 else 10

        payload = bytearray([0x53, 0x54, self._next_f(), 0x44, 0x00])
        for i, duration in enumerate(normalized):
            units = duration // 16
            if units <= 0:
                units = 1
            is_mark = i % 2 == 0
            while units > 0:
                chunk = min(units, 0x7F)
                units -= chunk
                payload.append(chunk | (0x80 if is_mark else 0x00))
        payload.extend([0x45, 0x4E])

        max_payload_per_frame = 0x38
        total = max(1, (len(payload) + max_payload_per_frame - 1) // max_payload_per_frame)
        e_value = self._next_e()
        frames = []
        offset = 0
        index = 1
        while offset < len(payload):
            take = min(max_payload_per_frame, len(payload) - offset)
            frame = bytearray([0x02, take + 3, e_value, total, index])
            frame.extend(payload[offset:offset + take])
            frames.append(bytes(frame))
            offset += take
            index += 1
        return frames


class ElkSmartBulkEncoder:
    name = "elksmart_bulk"
    strict_handshake = True
    wants_background_reader = False
    inter_frame_delay_ms = 2

    _IDENT_PREFIX = 0xFC
    _TYPE_D552 = (0x70, 0x01)
    _TYPE_D226 = (0x02, 0xAA)
    _ODD_PATTERN_TRAILING_GAP_US = 10000

    def __init__(self):
        self._subtype = None

    def open_handshake(self, connection, in_endpoint, out_endpoint, write_chunk, drain_in):
        drain_in(connection, in_endpoint, 80)
        identify = bytes([self._IDENT_PREFIX, self._IDENT_PREFIX, self._IDENT_PREFIX, self._IDENT_PREFIX])
        if not write_chunk(connection, out_endpoint, identify, 200):
            return False

        size = max(64, in_endpoint.getMaxPacketSize())
        resp = jarray(jbyte)([0] * size)
        deadline = time.time() + 0.45
        got = -1
        while time.time() < deadline:
            n = connection.bulkTransfer(in_endpoint, resp, size, 150)
            if n > 0:
                got = n
                break
        subtype = self._identify_subtype(resp, got)
        if subtype is None:
            return False
        self._subtype = subtype
        return True

    def _identify_subtype(self, resp, size):
        if size < 6:
            return None
        vals = [(int(resp[i]) & 0xFF) for i in range(6)]
        if vals[:4] != [self._IDENT_PREFIX] * 4:
            return None
        type_pair = (vals[4], vals[5])
        if type_pair == self._TYPE_D552:
            return "D552"
        if type_pair == self._TYPE_D226:
            return "D226"
        return None

    def encode(self, freq_hz, pattern):
        pulses = self._to_pulses(pattern)
        raw = self._compress_pulses(pulses)
        payload = self._encode_d226_payload(raw) if (self._subtype or "D552") == "D226" else raw

        f = int(freq_hz) + 0x7FFFF
        msg = bytearray([0xFF, 0xFF, 0xFF, 0xFF])
        msg.append(self._mangle_byte(f >> 8))
        msg.append(self._mangle_byte(f >> 16))
        msg.append(self._mangle_byte(f))
        msg.append(self._mangle_byte(len(payload) >> 8))
        msg.append(self._mangle_byte(len(payload)))
        msg.extend(payload)

        frames = []
        offset = 0
        while offset < len(msg):
            chunk = min(62, len(msg) - offset)
            frame = bytearray(msg[offset:offset + chunk])
            if chunk == 62:
                frame.append(self._checksum62(frame))
            frames.append(bytes(frame))
            offset += chunk
        return frames

    def post_transmit_delay_ms(self, pattern):
        total_us = 0
        for value in pattern:
            total_us += max(0, int(value))
        return max(80, int((total_us + 500) / 1000) + 25)

    def drain_after_transmit(self, connection, in_endpoint, drain_in):
        drain_in(connection, in_endpoint, 120)

    def _to_pulses(self, pattern):
        pulses = []
        i = 0
        while i < len(pattern):
            on_us = max(0, int(pattern[i]))
            off_us = max(0, int(pattern[i + 1])) if i + 1 < len(pattern) else self._ODD_PATTERN_TRAILING_GAP_US
            pulses.append((on_us, off_us))
            i += 2
        return pulses

    def _compress_pulses(self, pulses):
        if not pulses:
            return bytes()
        freq = {}
        for pulse in pulses:
            freq[pulse] = freq.get(pulse, 0) + 1
        sorted_pulses = sorted(freq.items(), key=lambda item: item[1], reverse=True)
        p1 = sorted_pulses[0][0]
        p2 = sorted_pulses[1][0] if len(sorted_pulses) > 1 else p1

        out = bytearray()
        self._compress_value_us(p2[0], out)
        self._compress_value_us(p2[1], out)
        self._compress_value_us(p1[0], out)
        self._compress_value_us(p1[1], out)
        out.extend([0xFF, 0xFF, 0xFF])
        for pulse in pulses:
            if pulse == p1:
                out.append(0x00)
            elif pulse == p2:
                out.append(0x01)
            else:
                self._compress_value_us(pulse[0], out)
                self._compress_value_us(pulse[1], out)
        return bytes(out)

    def _encode_d226_payload(self, raw):
        if not raw:
            return raw
        freq = [0] * 256
        for b in raw:
            freq[int(b) & 0xFF] += 1

        heap = []
        seq = 0
        for symbol, weight in enumerate(freq):
            if weight > 0:
                heapq.heappush(heap, (weight, seq, symbol, None, None))
                seq += 1
        if not heap:
            return raw
        while len(heap) > 1:
            left = heapq.heappop(heap)
            right = heapq.heappop(heap)
            heapq.heappush(heap, (left[0] + right[0], seq, None, left, right))
            seq += 1

        codes = []
        self._build_codes(heap[0], "", codes)
        codes.sort(key=lambda item: item[0])
        code_by_symbol = {symbol: bits for symbol, weight, bits in codes}

        out = bytearray()
        out.extend([(len(codes) >> 8) & 0xFF, len(codes) & 0xFF])
        for symbol, weight, bits in codes:
            out.extend([symbol & 0xFF, (weight >> 8) & 0xFF, weight & 0xFF])

        bit_string = "".join(code_by_symbol[int(b) & 0xFF] for b in raw)
        tail_bits = len(bit_string) % 8
        if tail_bits > 0:
            bit_string += "0" * (8 - tail_bits)
        out.append(tail_bits & 0xFF)
        for i in range(0, len(bit_string), 8):
            out.append(int(bit_string[i:i + 8], 2) & 0xFF)
        return bytes(out)

    def _build_codes(self, node, prefix, out):
        weight, seq, symbol, left, right = node
        if symbol is not None:
            out.append((symbol, weight, prefix or "0"))
            return
        self._build_codes(left, prefix + "0", out)
        self._build_codes(right, prefix + "1", out)

    def _compress_value_us(self, value_us, out):
        value_us = int(value_us)
        if value_us <= 2032:
            if value_us == 0 or value_us == 1:
                q = value_us
            else:
                q = int((value_us / 16.0) + 0.5)
            out.append(q & 0xFF)
            return
        v = value_us
        while True:
            b = v & 0x7F
            v >>= 7
            if v != 0:
                b |= 0x80
            if (b & 0xFF) == 0xFF:
                b = 0xFE
            out.append(b & 0xFF)
            if v == 0:
                break

    def _mangle_byte(self, v):
        value = int(v) & 0xFF
        reversed_bits = 0
        for _ in range(8):
            reversed_bits = (reversed_bits << 1) | (value & 1)
            value >>= 1
        return (~reversed_bits) & 0xFF

    def _checksum62(self, buf):
        total = 0
        for i in range(62):
            total += int(buf[i]) & 0xFF
        x = (total & 0xF0) | ((total >> 8) & 0x0F)
        return self._mangle_byte(x)


# ---------------------------------------------------------------------------
# RX: приёмные (learn-mode) декодеры. Интерфейс:
#   receiver.capture(conn, out_ep, in_ep, write_chunk, read_chunk, log, deadline_s)
#   -> {"freq": int, "pattern": [us, ...]}  либо исключение с текстом ошибки.
# ---------------------------------------------------------------------------
class UnknownReceiveProtocol:
    name = "unknown"
    supports_receive = False

    def capture(self, conn, out_ep, in_ep, write_chunk, read_chunk, log, deadline_s):
        raise NotImplementedError("Протокол устройства не определён")


