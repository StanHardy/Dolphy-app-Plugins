SUPPORTED_DONGLES = {
    (0x10C4, 0x8468): ("ZaZa Remote / Tiqiaa / Tview", LegacyBulkStEncoder, LegacyBulkStReceiver),
    (0x045E, 0x8468): ("ZaZa Remote / Tiqiaa / Tview", LegacyBulkStEncoder, LegacyBulkStReceiver),
    (0x045C, 0x0131): ("ElkSmart D552/D226 family", ElkSmartBulkEncoder, ElkSmartBulkReceiver),
    (0x045C, 0x0132): ("ElkSmart D552/D226 family", ElkSmartBulkEncoder, ElkSmartBulkReceiver),
    (0x045C, 0x0134): ("Ocrustar / ElkSmart D552/D226 family", ElkSmartBulkEncoder, ElkSmartBulkReceiver),
    (0x045C, 0x014A): ("ElkSmart D552/D226 family", ElkSmartBulkEncoder, ElkSmartBulkReceiver),
    (0x045C, 0x0184): ("ElkSmart D552/D226 family", ElkSmartBulkEncoder, ElkSmartBulkReceiver),
    (0x045C, 0x0195): ("ElkSmart D552/D226 family", ElkSmartBulkEncoder, ElkSmartBulkReceiver),
    (0x045C, 0x02AA): ("ElkSmart old model", ElkSmartBulkEncoder, ElkSmartBulkReceiver),
}

KNOWN_DONGLE_IDS = set(SUPPORTED_DONGLES.keys())

