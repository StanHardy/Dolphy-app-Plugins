def _unique_name(existing_names, base_name):
    if base_name not in existing_names:
        return base_name
    n = 2
    while "%s (%d)" % (base_name, n) in existing_names:
        n += 1
    return "%s (%d)" % (base_name, n)


def _slugify_filename(name):
    keep = [c if (c.isalnum() or c in "-_") else "_" for c in name]
    slug = "".join(keep).strip("_")
    return slug or "remote"


def _build_ir_file_content(remote):
    lines = ["Filetype: IR signals file", "Version: 1"]
    for b in remote["buttons"]:
        freq = b.get("freq") or 38000
        pattern = b.get("pattern", [])
        lines.append("#")
        lines.append("name: %s" % b["name"])
        lines.append("type: raw")
        lines.append("frequency: %d" % int(freq))
        lines.append("duty_cycle: 0.330000")
        lines.append("data: %s" % " ".join(str(int(v)) for v in pattern))
    lines.append("#")
    return "\n".join(lines) + "\n"


class UsbCIrCombo(BasePlugin):
    def on_plugin_load(self):
        self.add_module(
            title="USB-C IR Combo (TX+RX)",
            description="Приём и передача через один USB-C IR донгл",
            icon="usb",
            screen="main",
            section="INFRARED",
        )

        self._usb_manager = None
        self._context = None
        self._device = None
        self._connection = None
        self._usb_interface = None
        self._out_endpoint = None
        self._in_endpoint = None
        self._endpoint_type = None
        self._dongle_name = None

        self._encoder = UnknownProtocolEncoder()
        self._receiver = UnknownReceiveProtocol()

        # Общая блокировка: TX и RX используют один и тот же физический
        # провод/устройство, поэтому передача и запись не должны идти
        # одновременно -- иначе команды перемешаются на устройстве.
        self._usb_op_lock = threading.Lock()
        self._tx_count = 0
        self._reader_lock = threading.Lock()
        self._reader_thread = None
        self._read_until_at = 0

        self._log_lines = []
        self._stop_flag = threading.Event()
        self._last_missing_log_at = 0
        self._permission_request_at = {}

        self._capturing = False
        self._last_capture = None  # {"freq": int, "pattern": [us,...]}

        self._context = self.api.getContext()
        self._usb_manager = self._context.getSystemService("usb")

        # Регистрируем сервис передачи ИК для всего приложения (в т.ч. для
        # наших виртуальных пультов после импорта) -- как в исходном
        # usb_c_ir_backend.
        self.provide_service("infrared.transmitter", 100)

        ir_status_routes = [
            "ir_*", "other/ir_*",
            "tv_remote/*", "other/tv_remote/*",
            "universal_remote/*", "other/universal_remote/*",
            "user_ir_remote*", "other/user_ir_remote*",
            "flipper_remote/*", "other/flipper_remote/*",
        ]
        for route in ir_status_routes:
            self.hook_screen(route, "usb_status_badge", "fab", 50)

        # -- Виртуальные пульты (навигация внутри одного экрана) --
        self._view = "recorder"  # recorder | remotes | remote_detail | new_remote | add_button
        self._selected_remote_id = None
        self._library = self._load_library()
        self._save_library()

        self._poll_thread = threading.Thread(target=self._poll_loop, daemon=True)
        self._poll_thread.start()

        self._log("Combo plugin loaded (TX+RX on one connection)")

    def on_plugin_unload(self):
        self._stop_flag.set()
        self._release_usb()
        self._log("Plugin unloaded")

    # -- service provider: infrared.transmitter -----------------------------

    def service_infrared_transmitter_available(self, payload):
        return {"available": self._is_connected()}

    def service_infrared_transmitter_transmit(self, payload):
        if not self._is_connected():
            return {"handled": False}

        freq = int(payload["frequency"])
        pattern = [int(v) for v in payload["pattern"]]

        total_us = sum(max(0, v) for v in pattern)
        self._log(
            "TX request: freq=%d, samples=%d, total=%.3fs%s"
            % (
                freq, len(pattern), total_us / 1_000_000.0,
                " [ПОДОЗРИТЕЛЬНО ДЛИННЫЙ, обычно пульты <0.3s]" if total_us > 300_000 else "",
            )
        )

        with self._usb_op_lock:
            if not self._is_connected():
                return {"handled": False}

            self._tx_count += 1
            encoded = self._encoder.encode(freq, pattern)
            if encoded is None:
                self._log(
                    "encoder '%s' could not encode signal (freq=%d, len=%d)"
                    % (self._encoder.name, freq, len(pattern))
                )
                return {"handled": False}

            ok = self._usb_write(encoded)
            delay_ms = self._post_transmit_delay_ms(pattern)
            self._log(
                "USB TX %s (freq=%d, patLen=%d, frames=%d, bytes=%d, waitMs=%d)"
                % (
                    "ok" if ok else "FAILED",
                    freq,
                    len(pattern),
                    len(self._encoded_chunks(encoded)),
                    self._encoded_size(encoded),
                    delay_ms,
                )
            )
            if ok:
                time.sleep(delay_ms / 1000.0)
            else:
                self._release_usb()
                return {"handled": False, "ok": False}
            return {"handled": True, "ok": True}

    # -- USB lifecycle --------------------------------------------------------

    def _is_connected(self):
        return self._device is not None and self._connection is not None and self._out_endpoint is not None

    def _poll_loop(self):
        while not self._stop_flag.is_set():
            try:
                self._scan_once()
            except Exception as e:
                self._log("poll error: %s" % e)
            self._stop_flag.wait(1.5)

    def _java_collection_to_list(self, java_collection):
        try:
            return list(java_collection.toArray())
        except Exception:
            result = []
            it = java_collection.iterator()
            while it.hasNext():
                result.append(it.next())
            return result

    def _scan_once(self, missing_log_force=False):
        device_list = self._usb_manager.getDeviceList()
        devices = self._java_collection_to_list(device_list.values())

        if self._device is not None:
            still_attached = any(d.getDeviceName() == self._device.getDeviceName() for d in devices)
            if not still_attached:
                self._log("Dongle detached: %s" % self._device.getDeviceName())
                self._release_usb()

        if self._device is not None:
            return

        for dev in devices:
            key = (dev.getVendorId(), dev.getProductId())
            if key not in KNOWN_DONGLE_IDS:
                continue

            if self._usb_manager.hasPermission(dev):
                self._open_device(dev)
                return
            else:
                self._request_permission(dev)
                return

        self._log_dongle_missing(force=missing_log_force)

    def _request_permission(self, dev):
        device_key = dev.getDeviceName()
        now = time.time()
        if now - self._permission_request_at.get(device_key, 0) < 15:
            return
        self._permission_request_at[device_key] = now

        try:
            Intent = jclass("android.content.Intent")
            PendingIntent = jclass("android.app.PendingIntent")
            Build = jclass("android.os.Build")

            intent = Intent("com.dolphy.plugin.usb_c_ir_combo.USB_PERMISSION")
            intent.setPackage(self._context.getPackageName())
            flags = 0x08000000
            if Build.VERSION.SDK_INT >= 31:
                flags = flags | 0x02000000
            pi = PendingIntent.getBroadcast(self._context, 0, intent, flags)
            self._usb_manager.requestPermission(dev, pi)
            self._log(
                "Requesting USB permission for %s vid=0x%04X pid=0x%04X"
                % (SUPPORTED_DONGLES[(dev.getVendorId(), dev.getProductId())][0], dev.getVendorId(), dev.getProductId())
            )
        except Exception as e:
            self._log("USB permission request failed: %s" % e)

    def _open_device(self, dev):
        UsbConstants = jclass("android.hardware.usb.UsbConstants")
        key = (dev.getVendorId(), dev.getProductId())
        profile = SUPPORTED_DONGLES.get(key)
        if profile is None:
            self._log("USB device recognized but not supported: vid=0x%04X pid=0x%04X" % key)
            return

        dongle_name, encoder_class, receiver_class = profile
        claimed_interface = None
        claimed_out_endpoint = None
        claimed_in_endpoint = None
        endpoint_type = None
        for i in range(dev.getInterfaceCount()):
            intf = dev.getInterface(i)
            pair = self._find_endpoint_pair(intf, UsbConstants)
            if pair is not None:
                claimed_interface, claimed_out_endpoint, claimed_in_endpoint, endpoint_type = intf, pair[0], pair[1], pair[2]
                break

        if claimed_interface is None:
            self._log("Supported dongle has no paired IN+OUT endpoints: %s" % dev.getDeviceName())
            return

        conn = self._usb_manager.openDevice(dev)
        if conn is None:
            self._log("openDevice() failed for %s" % dev.getDeviceName())
            return

        if not conn.claimInterface(claimed_interface, True):
            self._log("claimInterface() failed for %s" % dev.getDeviceName())
            conn.close()
            return

        encoder = encoder_class()
        handshake_ok = self._run_open_handshake(conn, claimed_in_endpoint, claimed_out_endpoint, encoder)
        if not handshake_ok:
            self._log("USB handshake failed for %s" % dongle_name)
            if getattr(encoder, "strict_handshake", False):
                try:
                    conn.releaseInterface(claimed_interface)
                except Exception:
                    pass
                conn.close()
                return

        self._device = dev
        self._connection = conn
        self._usb_interface = claimed_interface
        self._out_endpoint = claimed_out_endpoint
        self._in_endpoint = claimed_in_endpoint
        self._endpoint_type = endpoint_type
        self._dongle_name = dongle_name
        self._encoder = encoder
        self._receiver = receiver_class()
        self._log(
            "%s ready: vid=0x%04X pid=0x%04X out=%s in=%s type=%s tx=%s rx=%s (rx supported=%s)"
            % (
                dongle_name, dev.getVendorId(), dev.getProductId(),
                claimed_out_endpoint.getAddress(), claimed_in_endpoint.getAddress(), endpoint_type,
                self._encoder.name, self._receiver.name, getattr(self._receiver, "supports_receive", False),
            )
        )
        self.refresh()

    def _find_endpoint_pair(self, intf, UsbConstants):
        def collect(endpoint_type, label):
            out_by_num = {}
            in_by_num = {}
            for e in range(intf.getEndpointCount()):
                ep = intf.getEndpoint(e)
                if ep.getType() != endpoint_type:
                    continue
                number = ep.getAddress() & 0x0F
                if ep.getDirection() == UsbConstants.USB_DIR_OUT:
                    out_by_num[number] = ep
                elif ep.getDirection() == UsbConstants.USB_DIR_IN:
                    in_by_num[number] = ep
            for number in sorted(set(out_by_num.keys()) & set(in_by_num.keys())):
                return out_by_num[number], in_by_num[number], label
            return None

        bulk_pair = collect(UsbConstants.USB_ENDPOINT_XFER_BULK, "bulk")
        if bulk_pair is not None:
            return bulk_pair
        return collect(UsbConstants.USB_ENDPOINT_XFER_INT, "interrupt")

    def _run_open_handshake(self, conn, in_endpoint, out_endpoint, encoder):
        try:
            if hasattr(encoder, "open_handshake"):
                return encoder.open_handshake(conn, in_endpoint, out_endpoint, self._write_chunk, self._drain_in_endpoint)
            for frame in encoder.handshake_frames():
                if not self._write_chunk(conn, out_endpoint, frame, 250):
                    return False
            self._drain_in_endpoint(conn, in_endpoint, 250)
            return True
        except Exception as e:
            self._log("handshake error: %s" % e)
            return False

    def _drain_in_endpoint(self, conn, in_endpoint, timeout_ms):
        if conn is None or in_endpoint is None:
            return
        size = max(64, in_endpoint.getMaxPacketSize())
        buf = jarray(jbyte)([0] * size)
        deadline = time.time() + (timeout_ms / 1000.0)
        while time.time() < deadline:
            result = conn.bulkTransfer(in_endpoint, buf, size, 10)
            if result <= 0:
                break

    def _ensure_reader(self):
        with self._reader_lock:
            self._read_until_at = max(self._read_until_at, time.time() + 1.0)
            if self._reader_thread is not None and self._reader_thread.is_alive():
                return
            self._reader_thread = threading.Thread(target=self._reader_loop, daemon=True)
            self._reader_thread.start()

    def _reader_loop(self):
        while not self._stop_flag.is_set():
            if time.time() >= self._read_until_at:
                return
            conn = self._connection
            endpoint = self._in_endpoint
            if conn is None or endpoint is None:
                return
            try:
                size = max(64, endpoint.getMaxPacketSize())
                buf = jarray(jbyte)([0] * size)
                conn.bulkTransfer(endpoint, buf, size, 300)
            except Exception:
                time.sleep(0.005)
            time.sleep(0.001)

    def _release_usb(self):
        try:
            if self._connection is not None:
                if self._usb_interface is not None:
                    self._connection.releaseInterface(self._usb_interface)
                self._connection.close()
        except Exception as e:
            self._log("release error: %s" % e)
        finally:
            self._device = None
            self._connection = None
            self._usb_interface = None
            self._out_endpoint = None
            self._in_endpoint = None
            self._endpoint_type = None
            self._dongle_name = None
            self._encoder = UnknownProtocolEncoder()
            self._receiver = UnknownReceiveProtocol()
            self._tx_count = 0
            self._read_until_at = 0
            self.refresh()

    def _post_transmit_delay_ms(self, pattern):
        if hasattr(self._encoder, "post_transmit_delay_ms"):
            return self._encoder.post_transmit_delay_ms(pattern)
        total_us = 0
        for value in pattern:
            try:
                total_us += max(0, int(value))
            except Exception:
                pass
        return max(25, int(total_us / 1000) + 2)

    def _encoded_chunks(self, encoded):
        if encoded is None or len(encoded) == 0:
            return []
        first = encoded[0]
        if isinstance(first, int):
            return [encoded]
        return list(encoded)

    def _encoded_size(self, encoded):
        return sum(len(chunk) for chunk in self._encoded_chunks(encoded))

    def _write_chunk(self, conn, endpoint, data_bytes, timeout_ms=400):
        signed = []
        for b in data_bytes:
            v = int(b) & 0xFF
            signed.append(v - 256 if v > 127 else v)
        java_bytes = jarray(jbyte)(signed)
        result = conn.bulkTransfer(endpoint, java_bytes, len(signed), timeout_ms)
        if result <= 0:
            self._log("bulkTransfer(OUT) raw result=%s for %d bytes" % (result, len(signed)))
        return result > 0

    def _read_chunk(self, size=64, timeout_ms=200):
        conn = self._connection
        ep = self._in_endpoint
        if conn is None or ep is None:
            return b""
        buf = jarray(jbyte)([0] * size)
        n = conn.bulkTransfer(ep, buf, size, timeout_ms)
        if n and n > 0:
            return bytes([int(buf[i]) & 0xFF for i in range(n)])
        return b""

    def _usb_write(self, encoded):
        try:
            chunks = self._encoded_chunks(encoded)
            inter_frame_delay_ms = getattr(self._encoder, "inter_frame_delay_ms", 0)
            wants_reader = getattr(self._encoder, "wants_background_reader", True)
            for index, chunk in enumerate(chunks):
                if not self._write_chunk(self._connection, self._out_endpoint, chunk):
                    return False
                if wants_reader:
                    self._ensure_reader()
                if inter_frame_delay_ms > 0 and index + 1 < len(chunks):
                    time.sleep(inter_frame_delay_ms / 1000.0)
            if hasattr(self._encoder, "drain_after_transmit"):
                self._encoder.drain_after_transmit(self._connection, self._in_endpoint, self._drain_in_endpoint)
            return True
        except Exception as e:
            self._log("bulkTransfer threw: %s" % e)
            return False

    # -- RX: запись сигнала -------------------------------------------------

    def start_capture(self):
        if not self._is_connected():
            self._log("Нет подключенного донгла")
            return False
        if not getattr(self._receiver, "supports_receive", False):
            self._log(
                "Протокол '%s' пока не поддерживает приём (learn mode не реализован)"
                % self._receiver.name
            )
            return False
        if self._capturing:
            return False

        self._capturing = True
        threading.Thread(target=self._capture_worker, daemon=True).start()
        return True

    def _capture_worker(self):
        try:
            self._log("Наведи пульт и нажми кнопку (таймаут 15s)")
            deadline = time.time() + 15.0

            # Общая блокировка с TX: пока идёт приём, передача через это же
            # устройство физически невозможна (донгл слушает внешний ИК).
            with self._usb_op_lock:
                parsed = self._receiver.capture(
                    conn=self._connection,
                    out_ep=self._out_endpoint,
                    in_ep=self._in_endpoint,
                    write_chunk=lambda data, timeout_ms=400: self._write_chunk(
                        self._connection, self._out_endpoint, data, timeout_ms
                    ),
                    read_chunk=self._read_chunk,
                    log=self._log,
                    deadline_s=deadline,
                )

            self._last_capture = parsed
            self._log(
                "Сигнал записан: freq=%s Hz, %d тайминг(ов)"
                % (parsed.get("freq"), len(parsed.get("pattern", [])))
            )
        except NotImplementedError as e:
            self._log("Протокол не поддерживает приём: %s" % e)
        except Exception as e:
            self._log("capture error: %s" % e)
        finally:
            self._capturing = False
            self.refresh()

    def is_capturing(self):
        return self._capturing

    def last_capture(self):
        return self._last_capture

    # -- Виртуальные пульты: хранилище ---------------------------------------

    def _library_path(self):
        files_dir = self._context.getFilesDir()
        return os.path.join(files_dir.getAbsolutePath(), "usb_c_ir_combo_library.json")

    def _load_library(self):
        path = self._library_path()
        try:
            if os.path.exists(path):
                with open(path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    if isinstance(data, dict) and "remotes" in data:
                        self._fix_broken_names(data)
                        return data
        except Exception as e:
            self._log_lines_safe_append("library load error: %s" % e)
        return {"remotes": []}

    def _fix_broken_names(self, data):
        changed = False
        used_names = []
        for r in data.get("remotes", []):
            if not r.get("name"):
                r["name"] = _unique_name(used_names, "Пульт")
                changed = True
            used_names.append(r["name"])

            used_btn_names = []
            for b in r.get("buttons", []):
                if not b.get("name"):
                    b["name"] = _unique_name(used_btn_names, "SIGNAL")
                    changed = True
                used_btn_names.append(b["name"])

        if changed:
            self._log_lines_safe_append("Восстановлены названия пультов/кнопок, повреждённые старым багом")

    def _log_lines_safe_append(self, line):
        if hasattr(self, "_log_lines"):
            self._log(line)

    def _save_library(self):
        path = self._library_path()
        try:
            tmp_path = path + ".tmp"
            with open(tmp_path, "w", encoding="utf-8") as f:
                json.dump(self._library, f, ensure_ascii=False)
            os.replace(tmp_path, path)
            return True
        except Exception as e:
            self._log("library save error: %s" % e)
            return False

    def _find_remote(self, remote_id):
        for r in self._library["remotes"]:
            if r["id"] == remote_id:
                return r
        return None

    def _create_remote(self, base_name):
        existing_names = [r["name"] for r in self._library["remotes"]]
        name = _unique_name(existing_names, base_name)
        remote = {
            "id": "remote_%d" % int(time.time() * 1000),
            "name": name,
            "buttons": [],
        }
        self._library["remotes"].append(remote)
        self._save_library()
        self._log("Создан пульт '%s'" % name)
        self._selected_remote_id = remote["id"]
        self._view = "remote_detail"
        self.refresh()

    def _delete_remote(self, remote_id):
        remote = self._find_remote(remote_id)
        if remote is None:
            return
        self._library["remotes"] = [r for r in self._library["remotes"] if r["id"] != remote_id]
        self._save_library()
        self._log("Пульт '%s' удалён" % remote["name"])
        self._selected_remote_id = None
        self._view = "remotes"
        self.refresh()

    def _add_button_to_remote(self, remote_id, base_name):
        remote = self._find_remote(remote_id)
        capture = self.last_capture()
        if remote is None or capture is None:
            self._log("Нет записанного сигнала для добавления")
            self._view = "remote_detail"
            self.refresh()
            return
        existing_names = [b["name"] for b in remote["buttons"]]
        name = _unique_name(existing_names, base_name)
        remote["buttons"].append({
            "name": name,
            "freq": capture.get("freq"),
            "pattern": capture.get("pattern", []),
        })
        self._save_library()
        self._log("Кнопка '%s' добавлена в пульт '%s'" % (name, remote["name"]))
        self._view = "remote_detail"
        self.refresh()

    def _delete_button(self, remote_id, button_name):
        remote = self._find_remote(remote_id)
        if remote is None:
            return
        remote["buttons"] = [b for b in remote["buttons"] if b["name"] != button_name]
        self._save_library()
        self._log("Кнопка '%s' удалена" % button_name)
        self._view = "remote_detail"
        self.refresh()

    def _export_remote_to_downloads(self, remote_id):
        remote = self._find_remote(remote_id)
        if remote is None or not remote["buttons"]:
            self._log("Нет кнопок для экспорта")
            self.refresh()
            return

        content = _build_ir_file_content(remote)
        filename = "%s.ir" % _slugify_filename(remote["name"])

        try:
            ContentValues = jclass("android.content.ContentValues")
            MediaStoreDownloads = jclass("android.provider.MediaStore$Downloads")
            String = jclass("java.lang.String")

            resolver = self._context.getContentResolver()

            existing_uri = None
            projection = jarray(String)(["_id"])
            selection = "_display_name=? AND relative_path=?"
            selection_args = jarray(String)([filename, "Download/Dolphy/"])
            cursor = resolver.query(
                MediaStoreDownloads.EXTERNAL_CONTENT_URI, projection, selection, selection_args, None
            )
            if cursor is not None:
                try:
                    if cursor.moveToFirst():
                        ContentUris = jclass("android.content.ContentUris")
                        row_id = cursor.getLong(0)
                        existing_uri = ContentUris.withAppendedId(MediaStoreDownloads.EXTERNAL_CONTENT_URI, row_id)
                finally:
                    cursor.close()

            if existing_uri is not None:
                uri = existing_uri
            else:
                cv = ContentValues()
                cv.put("_display_name", filename)
                cv.put("mime_type", "application/octet-stream")
                cv.put("relative_path", "Download/Dolphy")
                uri = resolver.insert(MediaStoreDownloads.EXTERNAL_CONTENT_URI, cv)

            if uri is None:
                self._log("Не удалось создать файл в Downloads (insert вернул null)")
                self.refresh()
                return

            data = content.encode("utf-8")
            signed = [(b - 256) if b > 127 else b for b in data]
            java_bytes = jarray(jbyte)(signed)

            stream = resolver.openOutputStream(uri, "wt")
            stream.write(java_bytes)
            stream.flush()
            stream.close()

            self._log(
                "Готово: Download/Dolphy/%s -- импортируй его в разделе "
                "'Универсальные пульты' так же, как rid_10001.ir" % filename
            )
        except Exception as e:
            self._log("export error: %s" % e)

        self.refresh()

    # -- Навигация между "экранами" внутри одного screen_main ---------------

    def _go_recorder(self):
        self._view = "recorder"
        self.refresh()

    def _go_remotes(self):
        self._view = "remotes"
        self.refresh()

    def _go_new_remote(self):
        self._view = "new_remote"
        self.refresh()

    def _open_remote(self, remote_id):
        self._selected_remote_id = remote_id
        self._view = "remote_detail"
        self.refresh()

    def _go_add_button(self):
        if self.last_capture() is None:
            self._log("Сначала запиши сигнал на вкладке 'Запись'")
            self.refresh()
            return
        self._view = "add_button"
        self.refresh()

    # -- logging / прочее -----------------------------------------------------

    def _log_dongle_missing(self, force=False):
        now = time.time()
        if force or now - self._last_missing_log_at >= 15:
            self._last_missing_log_at = now
            self._log("Донгл не найден, продолжаю поиск")

    def _log(self, line):
        stamp = time.strftime("%H:%M:%S")
        self._log_lines.append("[%s] %s" % (stamp, line))
        if len(self._log_lines) > 100:
            self._log_lines = self._log_lines[-100:]
        self.refresh()

    def screen_usb_status_badge(self, ui, api, state):
        connected = self._is_connected()
        return ui.icon_button(
            "usb" if connected else "usb_off",
            lambda: self.navigate("main"),
        )

    def _manual_rescan(self):
        self._log("Manual rescan requested")
        try:
            self._scan_once(missing_log_force=True)
        except Exception as e:
            self._log("rescan error: %s" % e)
        self.refresh()

    # -- UI -------------------------------------------------------------------

    def _render_recorder_view(self, ui):
        connected = self._is_connected()
        if connected:
            status_text = "🟢 %s подключен, tx=%s rx=%s" % (
                self._dongle_name, self._encoder.name, self._receiver.name
            )
        else:
            status_text = "🔴 Донгл не найден"

        capture = self.last_capture()
        if capture is not None:
            capture_text = "Последняя запись: %s Hz, %d тайминг(ов)" % (
                capture.get("freq"), len(capture.get("pattern", []))
            )
        else:
            capture_text = "Пока ничего не записано"

        capture_button_label = "Запись..." if self.is_capturing() else "Записать сигнал"

        buttons = [
            ui.text(status_text, "titleSmall"),
            ui.text("TX (передача) всегда доступен через штатное 'Отправить' в пультах", "bodySmall", "muted"),
            ui.text(capture_text, "bodySmall", "muted"),
            ui.button("Обновить", self._manual_rescan),
            ui.button(capture_button_label, self.start_capture),
        ]

        buttons.append(ui.button("📁 Виртуальные пульты", self._go_remotes))

        return ui.column(
            [
                ui.card(buttons),
                ui.text("Recent log", "titleSmall"),
                ui.log_panel("\n".join(self._log_lines[-40:]), max_height=300),
            ],
            padding=16,
            spacing=12,
            fill_max_size=True,
        )

    def _render_remotes_view(self, ui):
        remotes = self._library["remotes"]
        rows = [ui.text("Виртуальные пульты", "titleSmall")]

        if not remotes:
            rows.append(ui.text("Пока нет ни одного пульта", "bodySmall", "muted"))
        else:
            for r in remotes:
                label = "%s (%d кнопок)" % (r["name"], len(r["buttons"]))
                rows.append(ui.button(label, lambda *_a, rid=r["id"]: self._open_remote(rid)))

        rows.append(ui.button("➕ Новый пульт", self._go_new_remote))
        rows.append(ui.button("⬅ Назад к записи", self._go_recorder))

        return ui.column([ui.card(rows)], padding=16, spacing=12, fill_max_size=True)

    def _render_new_remote_view(self, ui):
        rows = [ui.text("Выбери тип пульта", "titleSmall")]
        for preset in REMOTE_NAME_PRESETS:
            rows.append(ui.button(preset, lambda *_a, p=preset: self._create_remote(p)))
        rows.append(ui.button("⬅ Отмена", self._go_remotes))

        return ui.column([ui.card(rows)], padding=16, spacing=12, fill_max_size=True)

    def _render_remote_detail_view(self, ui):
        remote = self._find_remote(self._selected_remote_id)
        if remote is None:
            self._view = "remotes"
            return self._render_remotes_view(ui)

        rows = [ui.text(remote["name"], "titleSmall")]

        if not remote["buttons"]:
            rows.append(ui.text("В этом пульте пока нет кнопок", "bodySmall", "muted"))
        else:
            for b in remote["buttons"]:
                pretty = BUTTON_NAME_LABELS.get(b["name"], b["name"])
                label = "%s — %s Hz, %d тайминг(ов)" % (pretty, b.get("freq"), len(b.get("pattern", [])))
                rows.append(ui.text(label, "bodySmall"))
                rows.append(ui.button("Удалить '%s'" % pretty, lambda *_a, bn=b["name"]: self._delete_button(remote["id"], bn)))

        capture = self.last_capture()
        add_label = "➕ Добавить записанный сигнал" if capture is not None else "➕ Добавить (сначала запиши сигнал)"
        rows.append(ui.button(add_label, self._go_add_button))

        if remote["buttons"]:
            rows.append(ui.button("📤 Экспортировать как .ir (в Downloads)", lambda *_a: self._export_remote_to_downloads(remote["id"])))

        rows.append(ui.button("🗑 Удалить весь пульт", lambda *_a: self._delete_remote(remote["id"])))
        rows.append(ui.button("⬅ К списку пультов", self._go_remotes))

        return ui.column([ui.card(rows)], padding=16, spacing=12, fill_max_size=True)

    def _render_add_button_view(self, ui):
        remote = self._find_remote(self._selected_remote_id)
        if remote is None:
            self._view = "remotes"
            return self._render_remotes_view(ui)

        rows = [ui.text("Название кнопки для '%s'" % remote["name"], "titleSmall")]
        for key, label in BUTTON_NAME_PRESETS:
            rows.append(ui.button(label, lambda *_a, k=key: self._add_button_to_remote(remote["id"], k)))
        rows.append(ui.button(
            "Другое (SIGNAL N)",
            lambda *_a: self._add_button_to_remote(remote["id"], "SIGNAL"),
        ))
        rows.append(ui.button("⬅ Отмена", lambda *_a: self._open_remote(remote["id"])))

        return ui.column([ui.card(rows)], padding=16, spacing=12, fill_max_size=True)

    def screen_main(self, ui, api, state):
        if self._view == "remotes":
            content = self._render_remotes_view(ui)
        elif self._view == "new_remote":
            content = self._render_new_remote_view(ui)
        elif self._view == "remote_detail":
            content = self._render_remote_detail_view(ui)
        elif self._view == "add_button":
            content = self._render_add_button_view(ui)
        else:
            content = self._render_recorder_view(ui)

        return ui.scaffold(title="USB-C IR Combo", content=content)
