class ElkSmartBulkReceiver:
    """
    Протокол чипсета ElkSmart (Ocrustar / ZaZa Remote / Tiqiaa TView), D226/D552.
    Источник: реверс-инжиниринг deadboy18/Ocrustar-USB-IR (MIT).

        Host  -> Device: FC FC FC FC
        Device-> Host:   FC FC FC FC XX YY
        Host  -> Device: FA FA FA FA
        Host  -> Device: FE FE FE FE                 (войти в learn mode)
        Device-> Host:   FE FE FE FE [len_hi][len_lo][raw_data...]
        Host  -> Device: FD FD FD FD                 (выйти из learn mode)

    raw_data -> тайминги (мкс): b*16 + carry, где 0xFF добавляет carry += 0xFF0.
    """
    name = "elksmart_bulk"
    supports_receive = True

    HANDSHAKE_TIMEOUT_MS = 500
    HANDSHAKE_RETRIES = 5
    DEFAULT_FREQ_HZ = 38000

    def _flush_stale_data(self, read_chunk, log):
        flushed = 0
        for _ in range(8):
            chunk = read_chunk(64, timeout_ms=30)
            if not chunk:
                break
            flushed += len(chunk)
        if flushed:
            log("Flushed %d stale bytes from IN endpoint" % flushed)

    @staticmethod
    def _hex(data):
        return " ".join("%02X" % b for b in data) if data else "(empty)"

    def _read_exact_prefixed(self, read_chunk, expect_prefix, deadline_s):
        buf = bytearray()
        prefix_len = len(expect_prefix)

        while time.time() < deadline_s:
            chunk = read_chunk(64, timeout_ms=200)
            if chunk:
                buf.extend(chunk)

            if len(buf) >= prefix_len + 2:
                if bytes(buf[:prefix_len]) != expect_prefix:
                    del buf[:1]
                    continue

                total_len = (buf[prefix_len] << 8) | buf[prefix_len + 1]
                header_len = prefix_len + 2
                while len(buf) < header_len + total_len and time.time() < deadline_s:
                    more = read_chunk(64, timeout_ms=200)
                    if more:
                        buf.extend(more)

                if len(buf) >= header_len + total_len:
                    return bytes(buf[header_len:header_len + total_len])
                return None

        return None

    def capture(self, conn, out_ep, in_ep, write_chunk, read_chunk, log, deadline_s):
        self._flush_stale_data(read_chunk, log)

        device_kind = None
        for attempt in range(self.HANDSHAKE_RETRIES):
            sent_ok = write_chunk(bytes([0xFC, 0xFC, 0xFC, 0xFC]), timeout_ms=self.HANDSHAKE_TIMEOUT_MS)
            resp = read_chunk(64, timeout_ms=self.HANDSHAKE_TIMEOUT_MS)
            log(
                "handshake attempt %d/%d: sent_ok=%s resp=%s"
                % (attempt + 1, self.HANDSHAKE_RETRIES, sent_ok, self._hex(resp))
            )
            if resp and len(resp) >= 6 and bytes(resp[:4]) == b"\xFC\xFC\xFC\xFC":
                device_kind = (resp[4], resp[5])
                break
            time.sleep(0.15)

        if device_kind is None:
            raise RuntimeError(
                "Устройство не ответило на handshake (FC FC FC FC) -- см. hex-дамп выше"
            )

        write_chunk(bytes([0xFA, 0xFA, 0xFA, 0xFA]), timeout_ms=self.HANDSHAKE_TIMEOUT_MS)
        log("Handshake OK, device_kind=0x%02X%02X" % device_kind)

        write_chunk(bytes([0xFE, 0xFE, 0xFE, 0xFE]), timeout_ms=self.HANDSHAKE_TIMEOUT_MS)

        try:
            raw = self._read_exact_prefixed(read_chunk, b"\xFE\xFE\xFE\xFE", deadline_s)
        finally:
            try:
                write_chunk(bytes([0xFD, 0xFD, 0xFD, 0xFD]), timeout_ms=self.HANDSHAKE_TIMEOUT_MS)
            except Exception:
                pass

        if raw is None:
            raise RuntimeError("Таймаут: сигнал от пульта не получен")

        timings = []
        carry = 0
        for b in raw:
            if b == 0xFF:
                carry += 0xFF0
            else:
                timings.append(b * 16 + carry)
                carry = 0

        if not timings:
            raise RuntimeError("Донгл вернул пустой сигнал")

        return {"freq": self.DEFAULT_FREQ_HZ, "pattern": timings}


