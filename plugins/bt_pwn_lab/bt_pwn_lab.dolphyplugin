    # ================================================================ SCREENS
    def screen_main(self, ui, api, state):
        try:
            caps = json.loads(str(api.getDevice().btCapabilitiesJson()))
        except Exception:
            caps = {}
        visible = self.visible()

        rows = []
        for d in visible:
            name = _dev_label(d)
            sub = "%s · %s dBm · %s" % (d.get("address", ""), d.get("rssi", "?"),
                                        d.get("chip", "?"))
            if _pick_name(d):
                sub += " · NAME"
            if d.get("vulns"):
                sub += " · VULN"
            if d.get("fp"):
                sub += " · FASTPAIR"
            rows.append(ui.function_row(name, sub, "bluetooth",
                                        on_click=self.cb_device(d)))
        if not rows:
            rows.append(ui.card([
                ui.icon("bluetooth_searching", 46),
                ui.text("No devices yet", "titleMedium"),
                ui.text("Tap «Start scan». Bluetooth and «Nearby devices» are required.",
                        "bodyMedium"),
            ]))

        return ui.scaffold(
            title="BT PWN Lab",
            content=ui.lazy_column([
                ui.card([
                    ui.row([
                        ui.icon("bluetooth", 34),
                        ui.column([
                            ui.text("Adapter", "titleLarge"),
                            ui.text("root: %s · tools: %d · names: %d"
                                    % (self.root_ok, len(self.tools),
                                       len(self.known_names)), "bodySmall"),
                        ], spacing=2),
                    ], spacing=12),
                    ui.row([
                        ui.chip("BT on" if caps.get("enabled") else "BT off",
                                bool(caps.get("enabled"))),
                        ui.chip("LE scanner" if caps.get("leScanner") else "no scanner",
                                bool(caps.get("leScanner"))),
                        ui.chip("%d found" % len(self.devices), False),
                    ], spacing=6),
                    ui.button("Stop scan" if self.scanning else "Start scan",
                              self.toggle_scan, fill_max_width=True),
                    ui.text(self.status, "bodySmall"),
                ]),
                ui.button_group([["all", "All"], ["named", "Names"],
                                 ["vuln", "Vulnerable"], ["race", "RACE"],
                                 ["fp", "FastPair"]],
                                self.filter, self.set_filter),
                ui.row([
                    ui.button("Vuln", self.open_vuln),
                    ui.button("Jammer", self.open_jammer),
                    ui.button("Keys", self.open_keys),
                ], spacing=8),
                ui.row([
                    ui.button("MAX JAM", self.open_max),
                    ui.button("WhisperPair", self.open_whisper),
                    ui.button("RACE", self.open_race),
                ], spacing=8),
                ui.row([
                    ui.button("Root Lab", self.open_lab),
                    ui.button("Terminal", self.open_term),
                ], spacing=8),
                ui.row([
                    ui.button("Names", self.open_names),
                    ui.button("Dolphy Jammer", self.open_dolphy_jammer),
                ], spacing=8),
                ui.text("%d devices" % len(visible), "titleMedium"),
                ui.segmented_list(rows),
                ui.button("Log", self.open_log, fill_max_width=True),
            ], padding=16, spacing=12, fill_max_size=True),
        )

    def screen_details(self, ui, api, state):
        d = self.selected or {}
        name = _dev_label(d)
        mac = d.get("address", "?")
        rssi = int(d.get("rssi", -127))
        chip = d.get("chip", "unknown")
        vulns = d.get("vulns", [])

        vrows = []
        for v in vulns:
            cve, fam, ver, cvss, vname, chips, impact, probe = v
            vrows.append(ui.settings_row("%s %s" % (cve, fam), vname, "bug_report"))
        if not vrows:
            vrows = [ui.settings_row("Vulnerabilities", "chip not identified", "info")]

        extra = []
        if d.get("fp"):
            extra = [
                ui.text("Fast Pair / WhisperPair", "titleMedium"),
                ui.segmented_list([
                    ui.settings_row("Fast Pair model", d.get("fpModel") or "?",
                                    "earbuds"),
                    ui.settings_row("CVE", "CVE-2025-36911 · forced pairing",
                                    "bug_report"),
                ]),
                ui.row([
                    ui.button("WhisperPair", self.whisper_attack),
                    ui.button("Bond spam", self.whisper_bond_spam),
                ], spacing=8),
                ui.button("Open Dolphy WhisperPair", self.open_dolphy_whisper,
                          fill_max_width=True),
            ]
        if d.get("race") or chip == "airoha":
            extra += [
                ui.text("Airoha RACE", "titleMedium"),
                ui.button("RACE probe (ch21 + GATT)", self.race_probe,
                          fill_max_width=True),
            ]

        return ui.scaffold(
            title=name,
            content=ui.lazy_column([
                ui.row([ui.icon_button("arrow_back", self.back)], spacing=8),
                ui.card([
                    ui.icon("bluetooth", 52),
                    ui.text(name, "headlineSmall"),
                    ui.text(mac, "bodyMedium"),
                    ui.linear_progress(max(0, min(100, (rssi + 100))) / 100.0),
                    ui.text("%d dBm · %s" % (rssi, _rssi_label(rssi)), "titleMedium"),
                ]),
                # v4.3: name
                ui.card([
                    ui.text("Device name", "titleLarge"),
                    ui.text(_pick_name(d) or "not advertised over the air",
                            "titleMedium" if _pick_name(d) else "bodyMedium"),
                    ui.text("Source: %s" % ("air/cache" if _pick_name(d) else "—"),
                            "bodySmall"),
                    ui.row([
                        ui.button("Read name (GATT)", self.read_name),
                        ui.button("Copy MAC", self.copy_mac),
                    ], spacing=8),
                    ui.text("Reads Device Information 0x180A → Device Name 0x2A00. "
                            "Android then caches the name and it will appear in scans.",
                            "bodySmall"),
                ]),
                ui.segmented_list([
                    ui.settings_row("Vendor", d.get("vendor", "?"), "business"),
                    ui.settings_row("Chip", chip, "memory"),
                    ui.settings_row("Model (GATT)", d.get("model") or "-", "devices"),
                    ui.settings_row("Manufacturer (GATT)", d.get("manuf") or "-",
                                    "factory"),
                    ui.settings_row("Connectable", "yes" if d.get("connectable") else "no",
                                    "link"),
                    ui.settings_row("TX power", str(d.get("txPower", 0)) + " dBm", "sensors"),
                    ui.settings_row("RACE", "yes" if d.get("race") else "no", "memory"),
                    ui.settings_row("FastPair", "yes" if d.get("fp") else "no", "earbuds"),
                    ui.settings_row("Advertisement type", str(d.get("advertisementType", "?")),
                                    "sensors"),
                ]),
                ui.text("Vulnerabilities", "titleMedium"),
                ui.segmented_list(vrows),
                ui.card([
                    ui.text("Services", "titleMedium"),
                    ui.log_panel("\n".join([str(x) for x in (d.get("serviceUuids") or [])])
                                 or "none", 120),
