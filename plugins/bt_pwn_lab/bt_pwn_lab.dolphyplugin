            rows = [ui.card([
                ui.icon("earbuds", 42),
                ui.text("No Fast Pair devices in the list", "titleMedium"),
                ui.text("Run a scan on the main screen and enable the FastPair filter.",
                        "bodyMedium"),
            ])]
        return ui.scaffold(
            title="WhisperPair",
            content=ui.lazy_column([
                ui.row([ui.icon_button("arrow_back", self.back)], spacing=8),
                ui.card([
                    ui.text("CVE-2025-36911 · Google Fast Pair", "titleLarge"),
                    ui.text("The accessory does not check pairing mode: the seeker writes "
                            "a KBP request to 0xFE2C1234, then finishes with a classic "
                            "bond. Average 10 s, range up to 14 m. The account key "
                            "in 0xFE2C1236 makes you the owner (Find Hub tracking).",
                            "bodySmall"),
                    ui.text("Target: %s" % (_dev_label(d) if self.selected else "—"),
                            "titleMedium"),
                    ui.row([
                        ui.button("WhisperPair attack", self.whisper_attack),
                        ui.button("Bond spam", self.whisper_bond_spam),
                    ], spacing=8),
                    ui.button("Open built-in WhisperPair", self.open_dolphy_whisper,
                              fill_max_width=True),
                ]),
                ui.text("Fast Pair in the air: %d" % len(fps), "titleMedium"),
                ui.segmented_list(rows),
                ui.card([
                    ui.text("Attack progress", "titleLarge"),
                    ui.log_panel("\n".join(self.whisper_log) or "not run yet", 200),
                ]),
            ], padding=16, spacing=12, fill_max_size=True),
        )

    def screen_race(self, ui, api, state):
        d = self.selected or {}
        return ui.scaffold(
            title="Airoha RACE",
            content=ui.lazy_column([
                ui.row([ui.icon_button("arrow_back", self.back)], spacing=8),
                ui.card([
                    ui.text("CVE-2025-20700 · 20701 · 20702", "titleLarge"),
                    ui.text("RACE: GATT 5052494d-… / dc405470-… (BLE) and RFCOMM ch21 "
                            "(Classic). Commands: build 0x1E08, bdaddr 0x0CD5, "
                            "ram 0x1680/0x1681. Chain: dump flash → link key → "
                            "phone impersonation.", "bodySmall"),
                    ui.text("Target: %s" % (_dev_label(d) if self.selected else "—"),
                            "titleMedium"),
                    ui.button("RACE probe", self.race_probe, fill_max_width=True),
                ]),
                ui.card([
                    ui.text("Probe progress", "titleLarge"),
                    ui.log_panel("\n".join(self.race_log) or "not run yet", 260),
                ]),
            ], padding=16, spacing=12, fill_max_size=True),
        )

    # ---------------------------------------------------------- ROOT LAB
    def screen_lab(self, ui, api, state):
        tl = ", ".join(sorted(self.tools.keys())) or "not found"
        return ui.scaffold(
            title="Root Lab · A13",
            content=ui.lazy_column([
                ui.row([ui.icon_button("arrow_back", self.back)], spacing=8),
                ui.card([
                    ui.text("BT stack", "titleLarge"),
                    ui.text("cmd bluetooth_manager -- the official path on Android 13 builds",
                            "bodySmall"),
                    ui.row([
                        ui.button("State", self.lab_bt_state),
                        ui.button("Toggle", self.lab_bt_toggle),
                        ui.button("Kill", self.lab_stack_kill),
                    ], spacing=8),
                ]),
                ui.card([
                    ui.text("Traffic capture", "titleLarge"),
                    ui.text("Snoop log: /data/misc/bluetooth/logs/btsnoop_hci.log "
                            "(Wireshark). Offload off = cleaner capture.", "bodySmall"),
                    ui.row([
                        ui.button("Snoop ON", self.lab_snoop_on),
                        ui.button("Snoop OFF", self.lab_snoop_off),
                    ], spacing=8),
                    ui.row([
                        ui.button("Offload off", self.lab_offload_off),
                        ui.button("Offload on", self.lab_offload_on),
                    ], spacing=8),
                    ui.row([
                        ui.button("Pull log", self.lab_pull_snoop),
                        ui.button("scan_always", self.lab_scan_always),
                    ], spacing=8),
                ]),
                ui.card([
                    ui.text("Props and MAC", "titleLarge"),
                    ui.text("resetprop -n edits even ro.* bypassing property_service.",
                            "bodySmall"),
                    ui.row([
                        ui.button("Props", self.lab_props),
                        ui.button("BT MAC", self.lab_btmac),
                    ], spacing=8),
                    ui.row([
                        ui.button("MAC random", self.lab_mac_random),
                        ui.button("GD stack", self.lab_gd_stack),
                    ], spacing=8),
                ]),
                ui.card([
                    ui.text("Root tooling", "titleLarge"),
                    ui.text("Tools: %s" % tl, "bodySmall"),
                    ui.row([
                        ui.button("Find tools", self.lab_tools),
                        ui.button("Magisk", self.lab_magisk),
                    ], spacing=8),
                    ui.row([
                        ui.button("SELinux 0", self.lab_selinux_perm),
                        ui.button("SELinux 1", self.lab_selinux_enforce),
                    ], spacing=8),
                ]),
                ui.card([
                    ui.text("Diagnostics", "titleLarge"),
                    ui.row([
                        ui.button("dumpsys", self.lab_dumpsys),
                        ui.button("logcat BT", self.lab_logcat),
                    ], spacing=8),
                    ui.button("Names", self.lab_names, fill_max_width=True),
                ]),
                ui.card([
                    ui.text("Output", "titleLarge"),
                    ui.log_panel("\n".join(self.lab_log[-160:]) or "empty", 300),
                ]),
            ], padding=16, spacing=12, fill_max_size=True),
        )

    # ------------------------------------------------- v4.3: names screen
    def screen_names(self, ui, api, state):
        named = [d for d in self.visible() if _pick_name(d)]
        rows = [ui.function_row(_dev_label(x),
                                "%s · %s" % (x.get("address"), x.get("vendor") or "?"),
                                "badge", on_click=self.cb_device(x)) for x in named]
        if not rows:
            rows = [ui.card([
                ui.icon("badge", 42),
                ui.text("No names yet", "titleMedium"),
                ui.text("A name appears if the device advertises it, if it is known "
                        "from bonded devices, or after «Read name» on the card.",
                        "bodyMedium"),
            ])]
        return ui.scaffold(
            title="Names",
            content=ui.lazy_column([
                ui.row([ui.icon_button("arrow_back", self.back)], spacing=8),
                ui.card([
                    ui.text("Known names: %d" % len(self.known_names), "titleMedium"),
                    ui.text("Bonded devices and bt_config.conf are pulled in automatically.",
                            "bodySmall"),
                    ui.button("Refresh list", self._refresh_known_names,
                              fill_max_width=True),
                ]),
                ui.text("Named: %d" % len(named), "titleMedium"),
                ui.segmented_list(rows),
                ui.card([
                    ui.text("How the name was obtained", "titleLarge"),
                    ui.log_panel("\n".join(self.name_log[-60:]) or "empty", 200),
                ]),
            ], padding=16, spacing=12, fill_max_size=True),
        )

    def show_adapter(self):
        self.log("--- hciconfig ---")
        for line in _sh("%s -a" % _tool("hciconfig")).splitlines()[:40]:
            self.log(line)
        self.navigate("log")

    def screen_keys(self, ui, api, state):
        rows = [ui.settings_row(r["name"], "%s · %s" % (r["mac"], r["key"][:24]), "vpn_key")
                for r in self.keys_rows]
        if not rows:
            rows = [ui.settings_row("No data", "tap «Read»", "info")]
        return ui.scaffold(
            title="Link Keys",
            content=ui.lazy_column([
                ui.row([ui.icon_button("arrow_back", self.back)], spacing=8),
                ui.button("Read bt_config.conf", self.load_keys, fill_max_width=True),
                ui.text("%d records" % len(self.keys_rows), "titleMedium"),
                ui.segmented_list(rows),
            ], padding=16, spacing=12, fill_max_size=True),
        )

    def screen_term(self, ui, api, state):
        quicks = [ui.button(label, (lambda c=cmd: self.term_quick(c)))
                  for label, cmd in self.QUICK]
        return ui.scaffold(
            title="Root Terminal",
            content=ui.lazy_column([
                ui.row([ui.icon_button("arrow_back", self.back)], spacing=8),
                ui.card([
                    ui.text_field(self.term_cmd, self.term_set, "command"),
                    ui.row([
                        ui.chip("root" if self.term_root else "shell",
                                self.term_root,
                                on_click=lambda: self.term_mode(
                                    "shell" if self.term_root else "root")),
                        ui.text("root: %s" % self.root_ok, "bodySmall"),
                    ], spacing=8),
                    ui.row([
                        ui.button("Run", self.term_run),
                        ui.button("Clear", self.term_clear),
                    ], spacing=8),
                ]),
                ui.card([
                    ui.text("Quick", "titleLarge"),
                    ui.row(quicks, spacing=6),
                ]),
                ui.log_panel("\n".join(self.term_lines[-300:]) or "empty", 380),
            ], padding=16, spacing=12, fill_max_size=True),
        )

    def screen_log(self, ui, api, state):
        return ui.scaffold(
            title="Log",
            content=ui.lazy_column([
                ui.row([ui.icon_button("arrow_back", self.back)], spacing=8),
                ui.log_panel("\n".join(self.log_lines[-200:]) or "empty", 420),
            ], padding=16, spacing=12, fill_max_size=True),
        )

    # ============================================ HOOK PANELS
    def screen_whisper_panel(self, ui, api, state):
        d = self.selected or {}
        return ui.card([
            ui.row([
                ui.icon("earbuds", 30),
                ui.column([
                    ui.text("BT PWN Lab · WhisperPair", "titleMedium"),
                    ui.text("CVE-2025-36911 · target: %s"
                            % (_dev_label(d) if self.selected else "—"), "bodySmall"),
                ], spacing=2),
            ], spacing=10),
            ui.row([
                ui.button("Attack", self.whisper_attack),
                ui.button("Bond spam", self.whisper_bond_spam),
                ui.icon_button("terminal", self.open_term),
            ], spacing=8),
        ])

    def screen_jam_fab(self, ui, api, state):
        return ui.icon_button("bolt", self.open_max)