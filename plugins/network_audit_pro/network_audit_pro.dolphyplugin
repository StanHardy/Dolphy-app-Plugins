import ssl


def _tls_context():
    # роутерный TLS почти всегда самоподписной: строгая проверка цепочки
    # убивает подключение, поэтому проверку отключаем осознанно
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    return ctx

