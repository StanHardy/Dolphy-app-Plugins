import ssl


def _tls_context():
    # router TLS is almost always self-signed: strict chain validation
    # would kill the connection, so verification is disabled deliberately
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    return ctx

