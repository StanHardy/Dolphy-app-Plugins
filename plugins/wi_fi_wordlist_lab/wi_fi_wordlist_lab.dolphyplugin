__name__ = "Wi-Fi Wordlist Lab"
__version__ = "2.4.0"
__author__ = "DCA"
__description__ = "SSID-aware WiFi wordlist generator"
__icon__ = "rounded:key"
__library__ = False
__design_library__ = False
__dependencies__ = []
__permissions__ = ["files", "clipboard"]

import re
import time
import itertools


