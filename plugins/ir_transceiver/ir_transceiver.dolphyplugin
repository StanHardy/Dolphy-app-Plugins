        elif tab == 6:
            adb_ready = not self._adb_busy
            tab_content = [
                ui.card([
                    ui.text("Wi-Fi пульт (ADB Android TV)", "titleSmall"),
                    ui.text("Сетевое управление ТВ и приставками по TCP/IP", "bodySmall", "muted"),
                    ui.text("ADB должен быть установлен на телефоне; на ТВ нужны отладка и разрешение подключения", "bodySmall", "muted"),
                    ui.text(self._adb_status, "bodySmall", "accent"),
                    ui.text_field(
                        value=self._adb_ip,
                        on_change=self._on_adb_ip_change,
                        label="IP ТВ и порт (192.168.1.50:5555)",
                        single_line=True,
                    ),
                    ui.row([
                        ui.button("Подключить", lambda: self._adb_shell_async("connect"), enabled=adb_ready),
                        ui.button("Power", lambda: self._adb_shell_async("shell input keyevent 26"), enabled=adb_ready),
                    ], spacing=6),
                    ui.button("Отключить ADB", lambda: self._adb_shell_async("disconnect"), enabled=adb_ready),
                    ui.divider(),
                    ui.text("Крестовина D-Pad", "labelMedium"),
                    ui.row([
                        ui.button("▲ Вверх", lambda: self._adb_shell_async("shell input keyevent 19"), enabled=adb_ready),
                    ], spacing=6),
                    ui.row([
                        ui.button("◀ Влево", lambda: self._adb_shell_async("shell input keyevent 21"), enabled=adb_ready),
                        ui.button("OK", lambda: self._adb_shell_async("shell input keyevent 66"), enabled=adb_ready),
                        ui.button("Вправо ▶", lambda: self._adb_shell_async("shell input keyevent 22"), enabled=adb_ready),
                    ], spacing=6),
                    ui.row([
                        ui.button("▼ Вниз", lambda: self._adb_shell_async("shell input keyevent 20"), enabled=adb_ready),
                    ], spacing=6),
                    ui.divider(),
                    ui.row([
                        ui.button("Vol +", lambda: self._adb_shell_async("shell input keyevent 24"), enabled=adb_ready),
                        ui.button("Vol -", lambda: self._adb_shell_async("shell input keyevent 25"), enabled=adb_ready),
                        ui.button("Mute", lambda: self._adb_shell_async("shell input keyevent 164"), enabled=adb_ready),
                    ], spacing=6),
                    ui.row([
                        ui.button("Назад", lambda: self._adb_shell_async("shell input keyevent 4"), enabled=adb_ready),
                        ui.button("Домой", lambda: self._adb_shell_async("shell input keyevent 3"), enabled=adb_ready),
                        ui.button("Меню", lambda: self._adb_shell_async("shell input keyevent 82"), enabled=adb_ready),
                    ], spacing=6),
                    ui.divider(),
                    ui.text("Запуск приложений", "labelMedium"),
                    ui.row([
                        ui.button("YouTube", lambda: self._adb_shell_async("shell monkey -p com.google.android.youtube.tv 1"), enabled=adb_ready),
                        ui.button("SmartTube", lambda: self._adb_shell_async("shell monkey -p com.liskovsoft.smarttubetv.beta 1"), enabled=adb_ready),
                        ui.button("Kodi", lambda: self._adb_shell_async("shell monkey -p org.xbmc.kodi 1"), enabled=adb_ready),
                    ], spacing=6),
                ], padding=10),
            ]

        elif tab == 7:
            tab_content = self._render_remote(ui)

        def _tab_button(label, index):
            is_active = (tab == index)
            prefix = "● " if is_active else ""
            return ui.button(f"{prefix}{label}", lambda: self._on_tab_select(index))

        navigation_menu = ui.card([
            ui.row([
                _tab_button("Адаптер", 0),
                _tab_button("Приёмник", 1),
                _tab_button("Библиотека", 2),
            ], spacing=6),
            ui.row([
                _tab_button("Импорт", 3),
                _tab_button("IR Finder", 4),
                _tab_button("Power", 5),
            ], spacing=6),
            ui.row([
                _tab_button("Мои пульты", 7),
                _tab_button("Wi-Fi ADB", 6),
            ], spacing=6),
        ], padding=8)
        all_items = [navigation_menu]
        all_items.extend(tab_content)
        all_items.append(ui.text(f"IR Transceiver v{__version__} by {__author__}", "labelSmall", "muted"))
        with self._library_lock:
            delete_index = self._library_index(self._confirm_delete_id)
            show_single_del = 0 <= delete_index < len(self._signal_library)
            delete_name = self._signal_library[delete_index].get("name", "?") if show_single_del else ""
            confirm_del_fn = (lambda ident: lambda: self._delete_signal_from_library(ident))(self._confirm_delete_id)
        show_clear_all = self._confirm_clear_all
        all_items.append(
            ui.alert_dialog(
                show=show_single_del,
                title="Удалить сигнал?",
                message=f"Удалить '{delete_name}' из библиотеки?",
                confirm_text="Удалить",
                dismiss_text="Отмена",
                on_confirm=confirm_del_fn,
                on_dismiss=self._cancel_dialog,
            )
        )
        all_items.append(
            ui.alert_dialog(
                show=show_clear_all,
                title="Очистить библиотеку?",
                message=f"Удалить все {len(self._signal_library)} сигналов?",
                confirm_text="Очистить всё",
                dismiss_text="Отмена",
                on_confirm=self._clear_all_library,
                on_dismiss=self._cancel_dialog,
            )
        )
        return ui.scaffold(
            title="IR Transceiver",
            content=ui.lazy_column(all_items, padding=8, spacing=6, fill_max_size=True),
            # [FLIP_SCREEN_FEATURE] Кнопка переворота в панели действий (TopBar Action) [TODO: REVIEW/FIX BUGS]
            actions=[
                ui.top_action("screen_rotation", self._toggle_screen_flip),
                ui.top_action("refresh", self._manual_rescan),
            ],
        )
