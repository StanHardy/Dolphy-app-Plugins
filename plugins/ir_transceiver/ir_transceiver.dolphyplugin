def _canonical_btn_name(name):
    norm = re.sub(r"[^a-zA-Z0-9_+\-]", "", str(name or "")).strip().lower()
    return _CANONICAL_BUTTON_MAP.get(norm, name)


def validate_signal(frequency, pattern):
    """Reject damaged mark/space sequences instead of dropping durations."""
    def integer(value):
        if isinstance(value, bool):
            raise ValueError("Boolean value instead of a number")
        if isinstance(value, int):
            return value
        if isinstance(value, str) and re.fullmatch(r"[0-9]+", value.strip()):
            return int(value)
        raise ValueError("Expected an integer")
    frequency = integer(frequency)
    if not 15000 <= frequency <= 70000:
        raise ValueError("Frequency must be 15000–70000 Hz")
    if not isinstance(pattern, (list, tuple)) or not 1 <= len(pattern) <= 8192:
        raise ValueError("Need 1–8192 pulses")
    durations = [integer(value) for value in pattern]
    if any(value <= 0 for value in durations) or sum(durations) > 5000000:
        raise ValueError("Pulses must be positive; signal no longer than 5 s")
    return frequency, durations


class SignalAddResult(int):
    """
    Result of adding a signal to the library:
    inherits int(1/0) for backward compatibility with `if result:`
    and provides an explicit `reason` attribute ('ok', 'duplicate', 'invalid', 'failed').
    """
    def __new__(cls, success, reason=""):
        obj = super().__new__(cls, 1 if success else 0)
        obj.success = bool(success)
        obj.reason = str(reason)
        return obj

    def __bool__(self):
        return self.success


