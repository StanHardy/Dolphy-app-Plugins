class _JavaPriorityQueue:
    def __init__(self):
        self._queue = []

    def offer(self, item):
        self._queue.append(item)
        self._sift_up(len(self._queue) - 1, item)

    def poll(self):
        if not self._queue:
            return None
        result = self._queue[0]
        last = self._queue.pop()
        if self._queue:
            self._sift_down(0, last)
        return result

    def _sift_up(self, k, value):
        while k > 0:
            parent = (k - 1) >> 1
            parent_value = self._queue[parent]
            if value.weight >= parent_value.weight:
                break
            self._queue[k] = parent_value
            k = parent
        self._queue[k] = value

    def _sift_down(self, k, value):
        half = len(self._queue) >> 1
        while k < half:
            child = (k << 1) + 1
            child_value = self._queue[child]
            right = child + 1
            if right < len(self._queue) and child_value.weight > self._queue[right].weight:
                child = right
                child_value = self._queue[child]
            if value.weight <= child_value.weight:
                break
            self._queue[k] = child_value
            k = child
        self._queue[k] = value

    def __len__(self):
        return len(self._queue)


class _TiqiaaWireCounters:
    def __init__(self):
        self._lock = threading.Lock()
        self._cmd_id = 0
        self._seq = 0

    def next_cmd_id(self):
        with self._lock:
            value = self._cmd_id + 1
            if value >= 0x10:
                value = 1
            self._cmd_id = value
            return value

    def next_seq(self):
        with self._lock:
            self._seq = self._seq + 1 if self._seq < 0x7F else 0x01
            return self._seq


_TIQIAA_COUNTERS = _TiqiaaWireCounters()
_TIQIAA_FREQ_TABLE = (
    38000, 37900, 37917, 36000, 40000, 39700, 35750, 36400, 36700, 37000,
    37700, 38380, 38400, 38462, 38740, 39200, 42000, 43600, 44000, 33000,
    33500, 34000, 34500, 35000, 40500, 41000, 41500, 42500, 43000, 45000,
)


class LegacyBulkStEncoder:
    name = "tiqiaa_bulk_st"
    strict_handshake = False
    wants_background_reader = True
    continuous_reader = False
    inter_frame_delay_ms = 0
    supports_learning = True
    _MODE_BYTES = (0x4C, 0x53, 0x52, 0x48, 0x4F, 0x4C, 0x43, 0x56)
    _MAX_CHUNK = 0x38

    def __init__(self):
        self._counters = _TIQIAA_COUNTERS
        self._last_freq_index = 0
        self._learn_seq = 0
        self._learn_env = 1

    def _next_e(self):
        return self._counters.next_cmd_id()

    def _next_f(self):
        return self._counters.next_seq()

    @staticmethod
    def _freq_index(freq_hz):
        try:
            wanted = int(freq_hz)
        except Exception:
            wanted = 38000
        if wanted < 1000:
            return 0
        return min(range(len(_TIQIAA_FREQ_TABLE)), key=lambda i: abs(_TIQIAA_FREQ_TABLE[i] - wanted))

    def _control_frame(self, command_byte=0x53):
        return bytes([
            0x02, 0x09, self._next_e(), 0x01, 0x01,
            0x53, 0x54, self._next_f(), command_byte & 0xFF, 0x45, 0x4E,
        ])

    def open_handshake(self, connection, in_endpoint, out_endpoint, write_chunk, drain_in, read_reply=None):
        drain_in(connection, in_endpoint, 80)
        ok = write_chunk(connection, out_endpoint, self._control_frame(0x53), 250)
        drain_in(connection, in_endpoint, 250)
        return bool(ok)

    def encode(self, freq_hz, pattern):
        if not pattern:
            return None
        p = [max(1, int(v)) for v in pattern]
        if len(p) % 2 == 0:
            tail = p[-1]
            p[-1] = tail - 3000 if tail > 3000 else 10
        freq_index = self._freq_index(freq_hz)
        self._last_freq_index = freq_index
        payload = bytearray([0x53, 0x54, self._next_f(), 0x44, freq_index & 0xFF])
        for i, duration in enumerate(p):
            units = int(duration) // 16
            if units <= 0:
                units = 1
            is_mark = (i % 2 == 0)
            while units > 0:
                chunk = min(units, 0x7F)
                units -= chunk
                payload.append(chunk | (0x80 if is_mark else 0x00))
        payload.extend([0x45, 0x4E])
        total = max(1, (len(payload) + self._MAX_CHUNK - 1) // self._MAX_CHUNK)
        if total > 0xFF:
            raise ValueError("Too many Tiqiaa USB frames")
        e_value = self._next_e()
        frames = []
        for index, offset in enumerate(range(0, len(payload), self._MAX_CHUNK), start=1):
            chunk = payload[offset:offset + self._MAX_CHUNK]
            frame = bytearray([0x02, len(chunk) + 3, e_value, total & 0xFF, index & 0xFF])
            frame.extend(chunk)
            frames.append(bytes(frame))
        return frames

    def post_transmit_delay_ms(self, pattern):
        total_us = sum(max(0, int(v)) for v in pattern)
        return max(2, total_us // 1000 + 2)

    def _next_learn_seq(self):
        self._learn_seq = (self._learn_seq + 1) & 0xFF
        if self._learn_seq == 0:
            self._learn_seq = 1
        return self._learn_seq

    def _next_learn_env(self):
        self._learn_env = self._learn_env + 1 if self._learn_env < 0x0F else 0x01
        return self._learn_env

    def _wrap_learning_payload(self, payload):
        payload = bytes(payload)
        total = max(1, (len(payload) + self._MAX_CHUNK - 1) // self._MAX_CHUNK)
        env = self._next_learn_env()
        frames = []
        for index, offset in enumerate(range(0, len(payload), self._MAX_CHUNK), start=1):
            chunk = payload[offset:offset + self._MAX_CHUNK]
            frames.append(bytes([0x02, len(chunk) + 3, env, total & 0xFF, index & 0xFF]) + chunk)
        return frames

    def _send_learning_mode(self, connection, out_endpoint, write_chunk, mode):
        if mode < 0 or mode >= len(self._MODE_BYTES):
            return False
        payload = bytes([0x53, 0x54, self._next_learn_seq(), self._MODE_BYTES[mode], 0x45, 0x4E])
        for frame in self._wrap_learning_payload(payload):
            if not write_chunk(connection, out_endpoint, frame, 400):
                return False
        return True

    @staticmethod
    def _read_learning_aggregate(connection, in_endpoint, timeout_ms):
        if not jarray or not jbyte:
            return None
        size = max(64, int(in_endpoint.getMaxPacketSize()))
        buf = jarray(jbyte)([0] * size)
        aggregate = bytearray()
        deadline = time.monotonic() + max(1, int(timeout_ms)) / 1000.0
        while time.monotonic() < deadline:
            remain = max(10, min(50, int((deadline - time.monotonic()) * 1000)))
            try:
                n = connection.bulkTransfer(in_endpoint, buf, size, remain)
            except Exception:
                n = -1
            if n <= 0:
                continue
            data = bytes(int(x) & 0xFF for x in buf[:n])
            if len(data) < 5 or data[0] != 0x01:
                continue
            chunk_len = (data[1] & 0xFF) - 3
            if chunk_len < 0 or chunk_len > 0x38 or 5 + chunk_len > len(data):
                continue
            if len(aggregate) + chunk_len > 0x4000:
                aggregate.clear()
                continue
            aggregate.extend(data[5:5 + chunk_len])
            final_chunk = chunk_len < 0x38 or data[3] == data[4]
            if final_chunk:
                return bytes(aggregate)
        return None

    @staticmethod
    def _parse_learning_frame(frame):
        raw = bytes(frame or b"")
        i = 0
        while i <= len(raw) - 7:
            if raw[i:i + 2] == b"ST":
                cmd = raw[i + 3]
                meta = raw[i + 4]
                j = i + 5
                while j < len(raw) - 1:
                    if raw[j:j + 2] == b"EN":
                        payload = raw[i + 5:j]
                        ch = chr(cmd)
                        if ch == "D":
                            return {"type": 5, "status": 2, "payload": raw[i:j + 2], "quality": 0, "meta": meta}
                        type_map = {"L": 0, "S": 1, "R": 2, "H": 3, "O": 4, "C": 6, "V": 7, "B": 8}
                        if ch in type_map:
                            return {
                                "type": type_map[ch],
                                "status": (meta >> 3) & 0x03,
                                "payload": payload,
                                "quality": 0,
                                "meta": meta,
                            }
                        break
                    j += 1
            i += 1
        return None

    def _wait_learning_parsed(self, connection, in_endpoint, timeout_ms, cancel_check):
        deadline = time.monotonic() + max(1, int(timeout_ms)) / 1000.0
        while time.monotonic() < deadline and not cancel_check():
            remain = max(1, min(500, int((deadline - time.monotonic()) * 1000)))
            frame = self._read_learning_aggregate(connection, in_endpoint, remain)
            if frame is None:
                continue
            parsed = self._parse_learning_frame(frame)
            if parsed is not None:
                return parsed
        return None

    @staticmethod
    def decode_tiqiaa_preview(frame):
        frame = bytes(frame or b"")
        if len(frame) < 8:
            return []
        body_end = len(frame) - 2
        if body_end <= 5:
            return []
        out = []
        current_polarity = bool(frame[5] & 0x80)
        units = frame[5] & 0x7F
        for b in frame[6:body_end]:
            polarity = bool(b & 0x80)
            value = b & 0x7F
            if polarity == current_polarity:
                units += value
            else:
                if units > 0:
                    out.append(max(1, units * 16))
                current_polarity = polarity
                units = value
        if units > 0:
            out.append(max(1, units * 16))
        if out and not bool(frame[5] & 0x80):
            out = out[1:]
        return out

    def learn_signal(self, connection, in_endpoint, out_endpoint, write_chunk, drain_in, cancel_check, timeout_s=8.0):
        drain_in(connection, in_endpoint, 100)
        current_state = 0
        if not self._send_learning_mode(connection, out_endpoint, write_chunk, 2):
            return None
        ack = self._wait_learning_parsed(connection, in_endpoint, 500, cancel_check)
        if ack is None:
            return None
        current_state = int(ack.get("status", 0))
        if current_state != 2:
            return None
        deadline = time.monotonic() + max(1.0, float(timeout_s))
        timed_out = False
        try:
            while time.monotonic() < deadline and not cancel_check():
                parsed = self._wait_learning_parsed(connection, in_endpoint, 750, cancel_check)
                if parsed is None:
                    continue
                current_state = int(parsed.get("status", current_state))
                if parsed.get("type") == 5 and parsed.get("payload"):
                    timings = self.decode_tiqiaa_preview(parsed["payload"])
                    if timings:
                        meta = int(parsed.get("meta", 0))
                        freq = _TIQIAA_FREQ_TABLE[meta] if meta < len(_TIQIAA_FREQ_TABLE) else 38000
                        return {"pattern": timings, "frequency": freq}
                    return None
            timed_out = (current_state == 2)
            return None
        finally:
            if (cancel_check() or timed_out) and current_state == 2:
                if self._send_learning_mode(connection, out_endpoint, write_chunk, 6):
                    self._wait_learning_parsed(connection, in_endpoint, 350, lambda: False)
            if current_state != 0:
                if self._send_learning_mode(connection, out_endpoint, write_chunk, 0):
                    self._wait_learning_parsed(connection, in_endpoint, 350, lambda: False)


class ElkSmartBulkEncoder:
    name = "elksmart_bulk"
    strict_handshake = True
    wants_background_reader = False
    inter_frame_delay_ms = 2
    supports_learning = True
    _IDENT_PREFIX = 0xFC
    _TOKEN_ACK = bytes([0xFA] * 4)
    _TYPE_D552 = (0x70, 0x01)
    _TYPE_D226 = (0x02, 0xAA)
    _ODD_PATTERN_TRAILING_GAP_US = 10000

    def __init__(self):
        self._subtype = None
        self.compat_mode = "android"

    def can_support_packet_size(self, packet_size):
        return packet_size >= 63

    def _identify_exchange(self, connection, in_endpoint, out_endpoint, write_chunk, drain_in, read_reply=None, send_ack=False):
        identify = bytes([self._IDENT_PREFIX] * 4)
        for attempt in range(3):
            drain_in(connection, in_endpoint, 80)
            if not write_chunk(connection, out_endpoint, identify, 250):
                continue
            stream = bytearray()
            deadline = time.monotonic() + 0.50
            while time.monotonic() < deadline and len(stream) < 64:
                if read_reply is not None:
                    part = read_reply(connection, in_endpoint, 160)
                    if part:
                        stream.extend(part)
                    else:
                        continue
                else:
                    if not jarray or not jbyte:
                        return False
                    size = max(64, int(in_endpoint.getMaxPacketSize()))
                    resp = jarray(jbyte)([0] * size)
                    try:
                        n = connection.bulkTransfer(in_endpoint, resp, size, 160)
                    except Exception:
                        n = -1
                    if n > 0:
                        stream.extend(bytes(int(x) & 0xFF for x in resp[:n]))
                    else:
                        continue
                subtype = self._identify_subtype_bytes(stream)
                if subtype is not None:
                    self._subtype = subtype
                    if send_ack:
                        if not write_chunk(connection, out_endpoint, self._TOKEN_ACK, 300):
                            return False
                    return True
            if attempt < 2:
                time.sleep(0.04)
        return False

    def open_handshake(self, connection, in_endpoint, out_endpoint, write_chunk, drain_in, read_reply=None):
        return self._identify_exchange(
            connection, in_endpoint, out_endpoint, write_chunk, drain_in, read_reply, send_ack=False
        )

    def authorize_for_learning(self, connection, in_endpoint, out_endpoint, write_chunk, drain_in, read_reply=None):
        return self._identify_exchange(
            connection, in_endpoint, out_endpoint, write_chunk, drain_in, read_reply, send_ack=True
        )

    def _identify_subtype_bytes(self, data):
        raw = bytes(data or b"")
        prefix = bytes([self._IDENT_PREFIX] * 4)
        idx = raw.find(prefix)
        if idx < 0 or idx + 6 > len(raw):
            return None
        type_pair = (raw[idx + 4], raw[idx + 5])
        if type_pair == self._TYPE_D552:
            return "D552"
        if type_pair == self._TYPE_D226:
            return "D226"
        return None

    def encode(self, freq_hz, pattern):
        pulses = self._to_pulses(pattern)
        raw = self._compress_pulses(pulses)
        payload = self._encode_d226_payload(raw) if (self._subtype or "D552") == "D226" else raw
        if len(payload) > 0xFFFF:
            raise ValueError(f"ElkSmart payload too large: {len(payload)} bytes")
        f = int(freq_hz) + 0x7FFFF
        msg = bytearray([0xFF, 0xFF, 0xFF, 0xFF])
        msg.append(_MANGLE_LUT[(f >> 8) & 0xFF])
        msg.append(_MANGLE_LUT[(f >> 16) & 0xFF])
        msg.append(_MANGLE_LUT[f & 0xFF])
        msg.append(_MANGLE_LUT[(len(payload) >> 8) & 0xFF])
        msg.append(_MANGLE_LUT[len(payload) & 0xFF])
        msg.extend(payload)
        frames = []
        offset = 0
        while offset < len(msg):
            chunk = min(62, len(msg) - offset)
            frame = bytearray(msg[offset:offset + chunk])
            if chunk == 62:
                frame.append(self._checksum62(frame))
            frames.append(bytes(frame))
            offset += chunk
        return frames

    def post_transmit_delay_ms(self, pattern):
        total_us = sum(max(0, int(v)) for v in pattern)
        return max(80, int((total_us + 500) / 1000) + 25)

    def drain_after_transmit(self, connection, in_endpoint, drain_in):
        drain_in(connection, in_endpoint, 120)

    def _to_pulses(self, pattern):
        pulses = []
        for i in range(0, len(pattern), 2):
            on_us = max(0, int(pattern[i]))
            off_us = max(0, int(pattern[i + 1])) if i + 1 < len(pattern) else self._ODD_PATTERN_TRAILING_GAP_US
            pulses.append((on_us, off_us))
        return pulses

    def _compress_pulses(self, pulses):
        if not pulses:
            return bytes()
        freq = {}
        for pulse in pulses:
            freq[pulse] = freq.get(pulse, 0) + 1
        ranked = sorted(freq.items(), key=lambda item: item[1], reverse=True)
        p1 = ranked[0][0]
        p2 = ranked[1][0] if len(ranked) > 1 else p1
        if self.compat_mode == "ocrustar_v15":
            ordered = sorted((p1, p2), key=lambda p: p[0] + p[1])
            pair0, pair1 = ordered[0], ordered[1]
        else:
            pair0, pair1 = p1, p2
        out = bytearray()
        self._compress_value_us(pair1[0], out)
        self._compress_value_us(pair1[1], out)
        self._compress_value_us(pair0[0], out)
        self._compress_value_us(pair0[1], out)
        out.extend([0xFF, 0xFF, 0xFF])
        for pulse in pulses:
            if pulse == pair0:
                out.append(0x00)
            elif pulse == pair1:
                out.append(0x01)
            else:
                self._compress_value_us(pulse[0], out)
                self._compress_value_us(pulse[1], out)
        return bytes(out)

    def _encode_d226_payload(self, raw):
        if not raw:
            return raw
        freq = [0] * 256
        for b in raw:
            freq[int(b) & 0xFF] += 1

        class Node:
            def __init__(self, weight, symbol=None, left=None, right=None):
                self.weight = weight
                self.symbol = symbol
                self.left = left
                self.right = right

        pq = _JavaPriorityQueue()
        for symbol in range(256):
            if freq[symbol] > 0:
                pq.offer(Node(weight=freq[symbol], symbol=symbol))
        if len(pq) == 0:
            return raw
        while len(pq) > 1:
            left = pq.poll()
            right = pq.poll()
            pq.offer(Node(weight=left.weight + right.weight, left=left, right=right))
        codes = []

        def walk(node, path=""):
            if node.symbol is not None:
                codes.append((node.symbol, node.weight, path or "0"))
                return
            walk(node.left, path + "0")
            walk(node.right, path + "1")

        walk(pq.poll(), "")
        codes.sort(key=lambda entry: entry[0])
        code_map = {sym: bits for sym, _, bits in codes}
        out = bytearray([(len(codes) >> 8) & 0xFF, len(codes) & 0xFF])
        for sym, weight, _ in codes:
            if weight > 0xFFFF:
                raise ValueError("Huffman weight overflow")
            out.extend([sym & 0xFF, (weight >> 8) & 0xFF, weight & 0xFF])
        bitstring = "".join(code_map[int(b) & 0xFF] for b in raw)
        remainder = len(bitstring) % 8
        pad_count = (8 - remainder) % 8
        if pad_count:
            bitstring += "0" * pad_count
        tail_meta = pad_count if self.compat_mode == "ocrustar_v15" else remainder
        out.append(tail_meta & 0xFF)
        for i in range(0, len(bitstring), 8):
            out.append(int(bitstring[i:i + 8], 2) & 0xFF)
        return bytes(out)

    def _compress_value_us(self, value_us, out):
        value_us = max(0, int(value_us))
        if self.compat_mode == "ocrustar_v15":
            if value_us <= 1:
                v = value_us
            else:
                v = int(value_us / 16.0 + 0.5)
        else:
            if value_us <= 2032:
                q = value_us if value_us in (0, 1) else int(value_us / 16.0 + 0.5)
                out.append(q & 0xFF)
                return
            v = value_us
        while True:
            b = v & 0x7F
            v >>= 7
            if v:
                b |= 0x80
            if (b & 0xFF) == 0xFF:
                b = 0xFE
            out.append(b & 0xFF)
            if not v:
                break

    def _checksum62(self, buf):
        total = sum(int(buf[i]) & 0xFF for i in range(62))
        x = (total & 0xF0) | ((total >> 8) & 0x0F)
        return _MANGLE_LUT[x & 0xFF]

    def decode_learned_signal(self, raw_bytes):
        timings = []
        carry = 0
        for b in raw_bytes:
            v = int(b) & 0xFF
            if v < 0xFF:
                timings.append(v * 16 + carry)
                carry = 0
            else:
                carry += 0xFF0
        return timings


class AudioIrTransmitter:
    _lock = threading.Lock()

    @staticmethod
    def transmit(frequency_hz, pattern_us, stereo=True):
        try:
            frequency_hz, pattern_us = validate_signal(frequency_hz, pattern_us)
        except ValueError:
            return False
        return AudioIrTransmitter._play_safe(frequency_hz, pattern_us, bool(stereo))

    @staticmethod
    def _play_safe(frequency_hz, pattern_us, stereo):
        with AudioIrTransmitter._lock:
            for sample_rate in (96000, 48000):
                if AudioIrTransmitter._play(frequency_hz, pattern_us, stereo, sample_rate):
                    return True
            return False

    @staticmethod
    def build_pcm(frequency_hz, pattern_us, stereo=True, sample_rate=48000):
        # Antiparallel LED adapters emit on both halves of the audio waveform.
        tone = frequency_hz / 2.0
        if tone >= sample_rate / 2.0:
            raise ValueError("Частота вне полосы аудиовыхода")
        pcm = []
        elapsed_us = 0
        emitted = 0
        increment = 2.0 * math.pi * tone / sample_rate
        for index, duration in enumerate(pattern_us):
            elapsed_us += duration
            target = int(round(elapsed_us * sample_rate / 1000000.0))
            is_mark = (index % 2 == 0)
            for frame in range(target - emitted):
                value = int(32000 * math.sin((emitted + frame) * increment)) if is_mark else 0
                pcm.append(value)
                if stereo:
                    pcm.append(-value)
            emitted = target
        return pcm

    @staticmethod
    def _play(frequency_hz, pattern_us, stereo, sample_rate):
        if not jclass or not jarray or not jshort:
            return False
        track = None
        try:
            AudioTrack = jclass("android.media.AudioTrack")
            AudioFormat = jclass("android.media.AudioFormat")
            AudioManager = jclass("android.media.AudioManager")
            AudioAttributesBuilder = jclass("android.media.AudioAttributes$Builder")
            AudioAttributes = jclass("android.media.AudioAttributes")
            AudioFormatBuilder = jclass("android.media.AudioFormat$Builder")
            pcm = AudioIrTransmitter.build_pcm(frequency_hz, pattern_us, stereo, sample_rate)

            if not pcm:
                return False
            short_arr = jarray(jshort)(pcm)
            channel_mask = AudioFormat.CHANNEL_OUT_STEREO if stereo else AudioFormat.CHANNEL_OUT_MONO
            attrs = (AudioAttributesBuilder()
                     .setUsage(AudioAttributes.USAGE_MEDIA)
                     .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
                     .build())
            fmt = (AudioFormatBuilder()
                   .setSampleRate(sample_rate)
                   .setChannelMask(channel_mask)
                   .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
                   .build())
            track = AudioTrack(attrs, fmt, len(pcm) * 2, AudioTrack.MODE_STATIC,
                               AudioManager.AUDIO_SESSION_ID_GENERATE)
            if track.getState() != AudioTrack.STATE_INITIALIZED:
                return False
            if track.write(short_arr, 0, len(pcm), AudioTrack.WRITE_BLOCKING) != len(pcm):
                return False
            track.play()
            time.sleep((sum(pattern_us) / 1000000.0) + 0.05)
            track.stop()
            return True
        except Exception:
            return False
        finally:
            if track is not None:
                try:
                    track.release()
                except Exception:
                    pass


class IrProtocolEngine:
    @staticmethod
    def encode_nec(hex_code, extended=False, carrier_hz=38222, repeat_full_frame=False):
        cleaned = str(hex_code).replace("0x", "").strip()
        val = int(cleaned, 16)
        if len(cleaned) <= 4 and not extended:
            addr = (val >> 8) & 0xFF
            cmd = val & 0xFF
            full_val = (addr << 24) | (((~addr) & 0xFF) << 16) | (cmd << 8) | ((~cmd) & 0xFF)
        elif len(cleaned) <= 6 and extended:
            addr = (val >> 8) & 0xFFFF
            cmd = val & 0xFF
            full_val = (addr << 16) | (cmd << 8) | ((~cmd) & 0xFF)
        else:
            full_val = val & 0xFFFFFFFF
        bits = f"{full_val:032b}"
        seq = [9000, 4500]
        for b in bits:
            seq.append(562)
            seq.append(1687 if b == '1' else 562)
        seq.append(562)
        used = sum(seq)
        seq.append(max(1, 108800 - used))
        if repeat_full_frame:
            seq.extend([9000, 4500])
            for b in bits:
                seq.append(562)
                seq.append(1687 if b == '1' else 562)
            seq.extend([562, 96000])
        else:
            seq.extend([9000, 2250, 562, 96000])
        return carrier_hz, seq

    @staticmethod
    def encode_sirc(command, address, bits_count=12):
        cmd = int(command) & 0x7F
        addr = int(address)
        cmd_bits = [(cmd >> i) & 1 for i in range(7)]
        addr_len = bits_count - 7
        addr_bits = [(addr >> i) & 1 for i in range(addr_len)]
        payload_bits = cmd_bits + addr_bits
        frames = []
        for _ in range(3):
            p = [2400, 600]
            for b in payload_bits:
                p.append(1200 if b else 600)
                p.append(600)
            p[-1] = max(1, 45000 - sum(p[:-1]))
            frames.extend(p)
        return 40000, frames

    @staticmethod
    def encode_rc5(address, command, toggle=0):
        addr = int(address) & 0x1F
        cmd = int(command) & 0x7F
        field = 0 if cmd >= 0x40 else 1
        cmd_low = cmd & 0x3F
        val = (1 << 13) | (field << 12) | ((toggle & 1) << 11) | (addr << 6) | cmd_low
        half_bits = []
        for i in range(13, -1, -1):
            bit = (val >> i) & 1
            half_bits.extend([0, 1] if bit else [1, 0])
        pulses = []
        curr = half_bits[0]
        length = 889
        for hb in half_bits[1:]:
            if hb == curr:
                length += 889
            else:
                pulses.append(length)
                curr = hb
                length = 889
        pulses.append(length)
        if half_bits[0] == 0:
            pulses = pulses[1:]
        used = sum(pulses)
        gap = max(1, 114000 - used)
        if len(pulses) % 2:
            pulses.append(gap)
        else:
            pulses[-1] += gap
        return 36000, pulses

    @staticmethod
    def encode_rc6(address, command, toggle=0):
        t = 444
        halves = [1] * 6 + [0] * 2

        def add_bit(bit, double=False):
            pair = [1, 0] if bit else [0, 1]
            width = 2 if double else 1
            halves.extend([pair[0]] * width + [pair[1]] * width)

        add_bit(1)
        for _ in range(3):
            add_bit(0)
        add_bit(toggle & 1, double=True)
        payload = ((int(address) & 0xFF) << 8) | (int(command) & 0xFF)
        for i in range(15, -1, -1):
            add_bit((payload >> i) & 1)
        pulses = []
        cur, n = halves[0], 1
        for h in halves[1:]:
            if h == cur:
                n += 1
            else:
                pulses.append(n * t)
                cur, n = h, 1
        pulses.append(n * t)
        if halves[0] == 0:
            pulses = pulses[1:]
        gap = max(1, 108000 - sum(pulses))
        if len(pulses) % 2:
            pulses.append(gap)
        else:
            pulses[-1] += gap
        return 36000, pulses

    @staticmethod
    def encode_recs80(address, command, extended=False, carrier_hz=38000):
        addr = int(address) & (0x0F if extended else 0x07)
        cmd = int(command) & (0x3F if extended else 0x1F)
        val = (1 << (10 if extended else 8)) | (addr << (6 if extended else 5)) | cmd
        bits_count = 11 if extended else 9
        p = [158, 3500]
        space_0 = 4800 if extended else 5060
        space_1 = 7200 if extended else 7590
        for i in range(bits_count - 1, -1, -1):
            b = (val >> i) & 1
            p.append(158)
            p.append(space_1 if b else space_0)
        p.extend([158, 45000])
        return carrier_hz, p

    @staticmethod
    def encode_rca(address, command):
        addr = int(address) & 0x0F
        cmd = int(command) & 0xFF
        val = (addr << 20) | (cmd << 12) | (((~addr) & 0x0F) << 8) | ((~cmd) & 0xFF)
        p = [4000, 4000]
        for i in range(23, -1, -1):
            b = (val >> i) & 1
            p.append(500)
            p.append(2000 if b else 1000)
        p.extend([500, 20000])
        return 56000, p

    @staticmethod
    def encode_pioneer(hex_code):
        val = int(str(hex_code).replace("0x", ""), 16) & 0xFFFFFFFF
        bits = f"{val:032b}"
        p = [8500, 4250]
        for b in bits:
            p.append(530)
            p.append(1600 if b == '1' else 530)
        p.extend([530, 25000])
        return 40000, p

    @staticmethod
    def encode_proton(address, command):
        addr = int(address) & 0xFF
        cmd = int(command) & 0xFF
        val = (addr << 8) | cmd
        bits = f"{val:016b}"
        p = [8000, 4000]
        for b in bits:
            p.append(500)
            p.append(1500 if b == '1' else 500)
        p.extend([500, 40000])
        return 38000, p

    @staticmethod
    def encode_f12_relaxed(address, command):
        addr = int(address) & 0x0F
        cmd = int(command) & 0xFF
        val = (addr << 8) | cmd
        bits = f"{val:012b}"
        p = [3200, 1600]
        for b in bits:
            p.append(400)
            p.append(1200 if b == '1' else 400)
        p.extend([400, 20000])
        return 38000, p

    @staticmethod
    def encode_nrc17(address, command, subaddress=0):
        val = ((int(address) & 0x0F) << 12) | ((int(subaddress) & 0x0F) << 8) | (int(command) & 0xFF)
        p = [500, 2500]
        for i in range(16, -1, -1):
            b = (val >> i) & 1 if i < 16 else 1
            if b:
                p.extend([500, 500])
            else:
                p.extend([500, 1000])
        p.extend([500, 30000])
        return 38000, p

    @staticmethod
    def encode_rcc(address, command, is_2026=False):
        addr = int(address) & 0xFF
        cmd = int(command) & 0xFF
        val = (addr << 8) | cmd
        bits = f"{val:016b}"
        header = [2000, 1000] if is_2026 else [1350, 450]
        mark = 400 if is_2026 else 450
        space_0 = 400 if is_2026 else 450
        space_1 = 800 if is_2026 else 900
        p = list(header)
        for b in bits:
            p.append(mark)
            p.append(space_1 if b == '1' else space_0)
        p.extend([mark, 25000])
        return 38000, p

    @staticmethod
    def encode_thomson7(address, command):
        val = ((int(address) & 0x0F) << 7) | (int(command) & 0x7F)
        bits = f"{val:011b}"
        p = [4500, 4500]
        for b in bits:
            p.append(500)
            p.append(4500 if b == '1' else 2000)
        p.extend([500, 35000])
        return 38000, p

    @staticmethod
    def encode_xsat(address, command):
        val = ((int(address) & 0xFF) << 8) | (int(command) & 0xFF)
        bits = f"{val:016b}"
        p = [8000, 4000]
        for b in bits:
            p.append(500)
            p.append(2000 if b == '1' else 1000)
        p.extend([500, 30000])
        return 38000, p

    @staticmethod
    def encode_samsung32(address, command):
        addr = int(address) & 0xFF
        cmd = int(command) & 0xFF
        bytes_to_send = [addr, addr, cmd, (~cmd) & 0xFF]
        bits = []
        for b in bytes_to_send:
            for i in range(8):
                bits.append((b >> i) & 1)
        p = [4500, 4500]
        for b in bits:
            p.append(560)
            p.append(1690 if b else 560)
        p.extend([560, 40000])
        return 38000, p

    @staticmethod
    def encode_samsung36(hex_code):
        val = int(str(hex_code).replace("0x", ""), 16)
        bits = f"{val:036b}"
        p = [4500, 4500]
        for b in bits[:16]:
            p.append(500)
            p.append(1500 if b == '1' else 500)
        p.extend([500, 4500])
        for b in bits[16:]:
            p.append(500)
            p.append(1500 if b == '1' else 500)
        p.extend([500, 59000])
        return 38000, p

    @staticmethod
    def encode_denon(hex_code):
        val = int(str(hex_code).replace("0x", ""), 16) & 0x1FFF
        frames = []
        for invert in (False, True):
            cur = (val ^ 0x03FF) if invert else val
            bits = f"{cur:013b}"
            p = []
            for b in bits:
                p.append(280)
                p.append(1720 if b == '1' else 860)
            p.extend([280, 43560])
            frames.extend(p)
        return 38000, frames

    @staticmethod
    def encode_sharp(hex_code):
        val = int(str(hex_code).replace("0x", ""), 16) & 0x1FFF
        frames = []
        for invert in (False, True):
            cur = (val ^ 0x03FF) if invert else val
            bits = f"{cur:013b}"
            p = []
            for b in bits:
                p.append(280)
                p.append(1720 if b == '1' else 860)
            p.extend([280, 40000])
            frames.extend(p)
        return 38000, frames

    @staticmethod
    def encode_jvc(hex_code):
        val = int(str(hex_code).replace("0x", ""), 16) & 0xFFFF
        bits = f"{val:016b}"
        p = [8400, 4200]
        for b in bits:
            p.append(525)
            p.append(1575 if b == '1' else 525)
        p.extend([525, 21000])
        return 38000, p

    @staticmethod
    def encode_kaseikyo(vendor_hex, data_hex):
        # Legacy Panasonic API: the complete 16+32-bit MSB-first hex frame.
        vendor = re.fullmatch(r"(?:0[xX])?([0-9a-fA-F]{4})", str(vendor_hex).strip())
        data = re.fullmatch(r"(?:0[xX])?([0-9a-fA-F]{8})", str(data_hex).strip())
        if not vendor or not data:
            raise ValueError("Panasonic: нужны 4 hex символа производителя и 8 символов данных")
        raw = bytes.fromhex(vendor[1] + data[1])
        wire = [int(f"{value:08b}"[::-1], 2) for value in raw]
        return IrProtocolEngine._kaseikyo_pattern(wire, 37000, 163296, 74736)

    @staticmethod
    def encode_kaseikyo_message(address, command):
        # Flipper parsed fields: id2/vendor16/genre4/genre4 and command10.
        if not 0 <= address < (1 << 26) or not 0 <= command < (1 << 10):
            raise ValueError("Kaseikyo: адрес 26 бит, команда 10 бит")
        vendor = (address >> 8) & 0xFFFF
        b0, b1 = vendor & 255, vendor >> 8
        parity = b0 ^ b1
        b2 = ((parity & 15) ^ (parity >> 4)) | (((address >> 4) & 15) << 4)
        b3 = (address & 15) | ((command & 15) << 4)
        b4 = (((address >> 24) & 3) << 6) | (command >> 4)
        return IrProtocolEngine._kaseikyo_pattern([b0, b1, b2, b3, b4, b2 ^ b3 ^ b4], 38000, 130000)

    @staticmethod
    def _kaseikyo_pattern(bytes_to_send, frequency, period, minimum_gap=1):
        vendor_parity = bytes_to_send[0] ^ bytes_to_send[1]
        vendor_parity = (vendor_parity & 15) ^ (vendor_parity >> 4)
        if (bytes_to_send[2] & 15) != vendor_parity or bytes_to_send[5] != (bytes_to_send[2] ^ bytes_to_send[3] ^ bytes_to_send[4]):
            raise ValueError("Kaseikyo/Panasonic: неверная контрольная сумма")
        p = [3456, 1728]
        for b in bytes_to_send:
            for i in range(8):
                bit = (b >> i) & 1
                p.append(432)
                p.append(1296 if bit else 432)
        p.append(432)
        p.append(max(1, minimum_gap, period - sum(p)))
        return frequency, p

    @staticmethod
    def detect_protocol(pattern, freq_hz=38000):
        if not pattern or len(pattern) < 6:
            return "Raw signal", 0
        p0, p1 = pattern[0], pattern[1]
        length = len(pattern)
        if 8000 <= p0 <= 9000 and 3800 <= p1 <= 4600 and length <= 40:
            return "JVC", 88
        if 8200 <= p0 <= 8800 and 4000 <= p1 <= 4500 and freq_hz >= 39500:
            return "Pioneer", 88
        if 8000 <= p0 <= 10000 and 4000 <= p1 <= 5000:
            return "NEC", 95
        if 3800 <= p0 <= 4300 and 3800 <= p1 <= 4300 and (freq_hz >= 50000 or length <= 54):
            return "RCA", 88
        if 4000 <= p0 <= 5000 and 4000 <= p1 <= 5000:
            return "Samsung32", 90
        if 2000 <= p0 <= 2800 and 400 <= p1 <= 800:
            return "SONY12", 95
        if 3000 <= p0 <= 4000 and 1500 <= p1 <= 2000:
            return "Kaseikyo", 90
        if 2400 <= p0 <= 2900 and 700 <= p1 <= 1000:
            return "RC6", 85
        units = [v for v in pattern if 700 <= v <= 1050]
        if len(units) >= length * 0.4:
            return "RC5", 80
        return "Raw signal", 50


class ProntoHexDecoder:
    @staticmethod
    def decode(pronto_str):
        cleaned = str(pronto_str).strip()
        tokens = cleaned.split()
        if len(tokens) < 6 or any(not re.fullmatch(r"[0-9a-fA-F]{4}", token) for token in tokens):
            return None
        words = []
        for t in tokens:
            try:
                words.append(int(t, 16))
            except ValueError:
                return None
        code_type = words[0]
        freq_word = words[1]
        if code_type != 0x0000 or freq_word <= 0:
            return None
        carrier_period_us = freq_word * 0.241246
        if carrier_period_us <= 0:
            return None
        freq_hz = int(round(1000000.0 / carrier_period_us))
        seq1_len = words[2]
        seq2_len = words[3]
        total_words = 4 + (seq1_len + seq2_len) * 2
        if len(words) != total_words or any(word == 0 for word in words[4:]):
            return None
        words_pool = words[4:total_words]
        once_words = words_pool[:seq1_len * 2]
        repeat_words = words_pool[seq1_len * 2:seq1_len * 2 + seq2_len * 2]
        target_words = once_words + repeat_words
        durations = []
        for w in target_words:
            us = int(round(w * carrier_period_us))
            durations.append(max(1, us))
        try:
            return validate_signal(freq_hz, durations)
        except ValueError:
            return None


class MultiFormatRemoteParser:
    MAX_TEXT_BYTES = 2000000

    @staticmethod
    def analyze(text):
        """Pure preview: accepted entries plus explicit per-entry warnings."""
        text = str(text or "").strip()
        result = {"format": "Неизвестный", "signals": [], "warnings": []}
        if not text:
            return result
        if len(text.encode("utf-8")) > MultiFormatRemoteParser.MAX_TEXT_BYTES:
            result["warnings"].append("Файл больше 2 МБ")
            return result

        def add(name, frequency, pattern, metadata=None):
            try:
                frequency, pattern = validate_signal(frequency, pattern)
                entry = {"name": str(name or "Signal")[:120], "frequency": frequency, "pattern": pattern,
                         "favorite": False, "group": ""}
                if metadata:
                    entry["favorite"] = metadata.get("favorite") is True
                    entry["group"] = str(metadata.get("group", ""))[:120]
                    if metadata.get("created"):
                        entry["created"] = str(metadata["created"])[:80]
                result["signals"].append(entry)
            except (ValueError, TypeError) as error:
                result["warnings"].append(f"{name}: {error}")

        try:
            if text.startswith(("{", "[")):
                result["format"] = "JSON"
                data = json.loads(text)
                if isinstance(data, dict) and "signals" in data:
                    if data.get("schema", "ir_transceiver") != "ir_transceiver" or data.get("version", 1) != 1:
                        raise ValueError("Неподдерживаемая версия резервной копии")
                    data = data["signals"]
                items = data if isinstance(data, list) else [data]
                for index, item in enumerate(items):
                    if not isinstance(item, dict) or "pattern" not in item:
                        result["warnings"].append(f"JSON #{index + 1}: нет массива pattern")
                        continue
                    add(item.get("name", "JSON_Signal"), item.get("frequency", 38000), item["pattern"], item)
            elif text.lower().startswith("<"):
                result["format"] = "IRPLUS XML"
                if "<!doctype" in text.lower() or "<!entity" in text.lower():
                    raise ValueError("XML с DTD/сущностями не поддерживается")
                root = ET.fromstring(text)
                if root.tag.lower() != "irplus":
                    raise ValueError("Ожидался корневой элемент irplus")
                for device in root.findall("device"):
                    fmt = device.get("format", "").upper()
                    for button in device.findall("button"):
                        name = button.get("label") or button.get("alt") or "IRPLUS_Btn"
                        payload = (button.text or "").strip()
                        pronto = ProntoHexDecoder.decode(payload)
                        if pronto:
                            add(name, *pronto, {"group": device.get("model", "")})
                        elif fmt == "RAW":
                            try:
                                pattern = [int(token) for token in payload.replace(",", " ").split()]
                                add(name, int(device.get("frequency", "38000")), pattern,
                                    {"group": device.get("model", "")})
                            except ValueError as error:
                                result["warnings"].append(f"{name}: {error}")
                        else:
                            result["warnings"].append(f"{name}: IRPLUS {fmt or 'без формата'} не поддерживается; нужен RAW или Pronto")
            elif "begin remote" in text.lower():
                result["format"] = "LIRC"
                MultiFormatRemoteParser._parse_lirc(text, add, result["warnings"])
            elif re.match(r"^name\s*:", text, re.M) or "Filetype: IR signals file" in text:
                result["format"] = "Flipper .ir"
                blocks = re.split(r"(?m)^\s*name\s*:", text)[1:]
                for block in blocks:
                    signal = {}
                    for line in ("name:" + block).splitlines():
                        if ":" in line and not line.lstrip().startswith("#"):
                            key, value = line.split(":", 1)
                            signal[key.strip().lower()] = value.strip()
                    name = signal.get("name", "Signal")
                    try:
                        if signal.get("type", "").lower() == "raw":
                            add(name, signal.get("frequency", "38000"),
                                [int(token) for token in signal.get("data", "").replace(",", " ").split()])
                        elif signal.get("type", "").lower() == "parsed":
                            addr = MultiFormatRemoteParser._parse_flipper_hex(signal.get("address", ""))
                            cmd = MultiFormatRemoteParser._parse_flipper_hex(signal.get("command", ""))
                            proto = signal.get("protocol", "").upper().replace("_", "")
                            if proto in ("NEC", "NEC2", "NECEXT", "NECX1", "NECX2"):
                                extended = proto in ("NECEXT", "NECX1", "NECX2")
                                command_limit = 65535 if proto == "NECEXT" else 255
                                if addr > (65535 if extended else 255) or cmd > command_limit:
                                    raise ValueError("Адрес/команда NEC вне диапазона")
                                reverse = lambda byte: int(f"{byte:08b}"[::-1], 2)
                                wire_addr = (reverse(addr & 255) << 8) | (reverse((addr >> 8) & 255) if extended else reverse((~addr) & 255))
                                wire_cmd = (reverse(cmd & 255) << 8) | reverse((cmd >> 8) & 255) if proto == "NECEXT" else (reverse(cmd) << 8) | reverse((~cmd) & 255)
                                code = (wire_addr << 16) | wire_cmd
                                frequency, pattern = IrProtocolEngine.encode_nec(f"{code:08X}",
                                    repeat_full_frame=proto in ("NEC2", "NECX2"))
                                add(name, frequency, pattern)
                            else:
                                frequency, pattern = MultiFormatRemoteParser._encode_flipper_parsed(proto, addr, cmd)
                                add(name, frequency, pattern)
                        else:
                            raise ValueError("Неизвестный type")
                    except (ValueError, TypeError) as error:
                        result["warnings"].append(f"{name}: {error}")
            else:
                result["format"] = "Pronto Hex"
                pronto = ProntoHexDecoder.decode(text)
                if pronto is None:
                    raise ValueError("Нужен полный модулированный Pronto 0000 или поддерживаемый файл")
                add("Pronto_Signal", *pronto)
        except RecursionError:
            result["signals"] = []
            result["warnings"].append("JSON содержит слишком глубокую вложенность")
        except (ValueError, TypeError, ET.ParseError) as error:
            result["warnings"].append(str(error))
        return result

    @staticmethod
    def parse(text):
        return [(entry["name"], entry["frequency"], entry["pattern"])
                for entry in MultiFormatRemoteParser.analyze(text)["signals"]]

    @staticmethod
    def _parse_lirc(text, add, warnings):
        for block in re.findall(r"begin\s+remote\b(.*?)end\s+remote\b", text, re.I | re.S):
            try:
                config = {}
                description = re.split(r"begin\s+(?:raw_codes|codes)\b", block, maxsplit=1, flags=re.I)[0]
                for line in description.splitlines():
                    parts = line.split("#", 1)[0].split()
                    if len(parts) > 1:
                        config[parts[0].lower()] = parts[1:]
                frequency = int(config.get("frequency", ["38000"])[0], 0)
                group = " ".join(config.get("name", []))
                raw = re.search(r"begin\s+raw_codes\b(.*?)end\s+raw_codes\b", block, re.I | re.S)
                if raw:
                    name = None
                    values = []
                    def flush_raw():
                        if name is not None:
                            try:
                                add(name, frequency, [int(token) for token in values], {"group": group})
                            except ValueError as error:
                                warnings.append(f"{name}: некорректные raw_codes ({error})")
                    for line in raw.group(1).splitlines():
                        tokens = line.split("#", 1)[0].split()
                        if not tokens:
                            continue
                        if tokens[0].lower() == "name":
                            flush_raw()
                            name = " ".join(tokens[1:]) or "Signal"
                            values = []
                        elif name is None:
                            warnings.append("LIRC raw_codes: интервалы без имени")
                        else:
                            values.extend(tokens)
                    flush_raw()
                    continue
                flags = set("".join(config.get("flags", [])).upper().split("|")) - {""}
                if flags - {"SPACE_ENC", "CONST_LENGTH"}:
                    raise ValueError("LIRC flags не поддерживаются: " + "|".join(sorted(flags)))
                unsupported = {"plead", "pre", "post", "foot", "toggle_bit", "toggle_bit_mask", "repeat_mask", "min_repeat"}
                present = sorted(unsupported.intersection(config))
                if present:
                    raise ValueError("LIRC параметры не поддерживаются: " + ", ".join(present))
                def number(key, default="0"):
                    return int(config.get(key, [default])[0], 0)
                def pair(key):
                    values = config.get(key, [])
                    if len(values) != 2:
                        raise ValueError(f"LIRC: нужны два значения {key}")
                    durations = [int(value, 0) for value in values]
                    if any(value <= 0 for value in durations):
                        raise ValueError(f"LIRC: {key} должен содержать положительные интервалы")
                    return durations
                bits = number("bits")
                pre_bits, post_bits = number("pre_data_bits"), number("post_data_bits")
                if not 1 <= bits <= 64 or not 0 <= pre_bits <= 64 or not 0 <= post_bits <= 64:
                    raise ValueError("LIRC: некорректное число бит")
                one, zero = pair("one"), pair("zero")
                header = pair("header") if "header" in config else []
                codes = re.search(r"begin\s+codes\b(.*?)end\s+codes\b", block, re.I | re.S)
                if not codes:
                    raise ValueError("LIRC: нет codes или raw_codes")
                for line in codes.group(1).splitlines():
                    parts = line.split("#", 1)[0].split()
                    if not parts:
                        continue
                    if len(parts) != 2:
                        warnings.append("LIRC: ожидались имя и один код")
                        continue
                    try:
                        code = int(parts[1], 0)
                        pre, post = number("pre_data"), number("post_data")
                        if not 0 <= code < (1 << bits) or not 0 <= pre < (1 << pre_bits) or not 0 <= post < (1 << post_bits):
                            raise ValueError("LIRC: код вне диапазона bits")
                        value = (((pre << bits) | code) << post_bits) | post
                        pattern = list(header)
                        for bit in range(pre_bits + bits + post_bits - 1, -1, -1):
                            pattern.extend(one if (value >> bit) & 1 else zero)
                        trail = number("ptrail")
                        if trail < 0:
                            raise ValueError("LIRC: отрицательный ptrail")
                        if trail:
                            pattern.append(trail)
                        gap = number("gap", "45000")
                        if "CONST_LENGTH" in flags:
                            gap -= sum(pattern)
                        if gap < 0:
                            raise ValueError("LIRC: отрицательный gap или период короче кадра")
                        if len(pattern) % 2:
                            pattern.append(max(1, gap))
                        else:
                            pattern[-1] += gap
                        add(parts[0], frequency, pattern, {"group": group})
                    except (ValueError, TypeError) as error:
                        warnings.append(f"{parts[0]}: {error}")
            except (ValueError, TypeError) as error:
                warnings.append(str(error))

    @staticmethod
    def _parse_flipper_hex(hex_str):
        s = str(hex_str or "").strip().replace(" ", "")
        if not s or not re.fullmatch(r"(?:[0-9a-fA-F]{2}){1,4}", s):
            raise ValueError("Некорректное hex поле Flipper")
        try:
            raw = bytes.fromhex(s)
            return int.from_bytes(raw, byteorder="little")
        except Exception:
            try:
                return int(s, 16)
            except Exception:
                raise ValueError("Некорректное hex поле Flipper")

    @staticmethod
    def _encode_flipper_parsed(protocol, address, command):
        widths = {
            "RC5": (5, 6), "RC5X": (5, 7), "RC6": (8, 8), "SAMSUNG32": (8, 8),
            "SIRC": (5, 7), "SONY": (5, 7), "SONY12": (5, 7), "SIRC12": (5, 7),
            "SONY15": (8, 7), "SIRC15": (8, 7), "SONY20": (13, 7), "SIRC20": (13, 7),
            "KASEIKYO": (26, 10),
        }
        if protocol not in widths:
            raise ValueError(f"Протокол {protocol} не поддерживается; используйте RAW")
        address_bits, command_bits = widths[protocol]
        if not 0 <= address < (1 << address_bits) or not 0 <= command < (1 << command_bits):
            raise ValueError(f"Адрес/команда {protocol} вне диапазона")
        if protocol in ("RC5", "RC5X"):
            return IrProtocolEngine.encode_rc5(address, command)
        if protocol == "RC6":
            return IrProtocolEngine.encode_rc6(address, command)
        if protocol == "SAMSUNG32":
            return IrProtocolEngine.encode_samsung32(address, command)
        if protocol == "KASEIKYO":
            return IrProtocolEngine.encode_kaseikyo_message(address, command)
        return IrProtocolEngine.encode_sirc(command, address, address_bits + 7)


_UNIVERSAL_POWER_CODES = [
