    class BasePlugin:
        def __init__(self):
            self.ui = None
            self.api = None
            self._mock_settings = {}
        def add_module(self, *args, **kwargs): pass
        def navigate(self, *args, **kwargs): pass
        def navigate_app(self, *args, **kwargs): pass
        def refresh(self): pass
        def get_setting(self, key, default=None): return getattr(self, "_mock_settings", {}).get(key, default)
        def set_setting(self, key, value):
            if not hasattr(self, "_mock_settings"): self._mock_settings = {}
            self._mock_settings[key] = value
        def toast(self, text): pass
        def hook_screen(self, *args, **kwargs): pass
        def hook_surface(self, *args, **kwargs): pass
        def provide_service(self, *args, **kwargs): pass
        def hook_action(self, *args, **kwargs): pass
        def shell(self, *args, **kwargs): return ""


