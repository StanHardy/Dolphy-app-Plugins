class UsbCIrBackend(BasePlugin):
    # --------------------------------------------------------------------------
    # Internationalization (i18n) & Tactile Feedback
    # --------------------------------------------------------------------------
    def _t(self, text, *args, **kwargs):
        """
        Возвращает локализованную строку для текущего языка (ru или en).
        """
        if not isinstance(text, str):
            return text
        lang = getattr(self, "_lang", "ru")
        trans = _I18N_MAP.get(text, text) if lang == "en" else text
        if kwargs:
            try:
                return trans.format(**kwargs)
            except Exception:
                return trans
        if args:
            try:
                return trans % args
            except Exception:
                return trans
        return trans

    _LOG_REGEX_RULES = [
        (re.compile(r"^Встроенный ИК TX:\s*(OK|FAIL)\s*\(([0-9]+)Hz,\s*([0-9]+)\s*имп\.\)", re.I),
         r"Built-in IR TX: \1 (\2Hz, \3 pulses)"),
        (re.compile(r"^Audio IR TX:\s*(OK|FAIL)\s*\(([0-9]+)Hz,\s*([0-9]+)\s*имп\.\)", re.I),
         r"Audio IR TX: \1 (\2Hz, \3 pulses)"),
        (re.compile(r"^TX:\s*(OK|FAIL)\s*\(([0-9]+)Hz,\s*([0-9]+)\s*имп\.\)", re.I),
         r"TX: \1 (\2Hz, \3 pulses)"),
        (re.compile(r"^Сохранено\s*([0-9]+);\s*дубликатов\s*([0-9]+)", re.I),
         r"Saved \1; duplicates \2"),
        (re.compile(r"^Сигнал\s*['\"]([^'\"]*)['\"]\s*удалён из библиотеки", re.I),
         r"Signal '\1' removed from library"),
        (re.compile(r"^💾\s*(.*?)\s*сохранён в\s*(.*)", re.I),
         r"💾 \1 saved to \2"),
        (re.compile(r"^Библиотека\s*#([0-9]+):\s*(.*)", re.I),
         r"Library #\1: \2"),
        (re.compile(r"^Не удалось прочитать библиотеку:\s*(.*?);\s*исходные данные сохранены", re.I),
         r"Failed to read library: \1; raw data saved"),
        (re.compile(r"^Ошибка сохранения библиотеки:\s*(.*)", re.I),
         r"Library save error: \1"),
        (re.compile(r"^Ошибка копирования:\s*(.*)", re.I),
         r"Copy error: \1"),
        (re.compile(r"^Ошибка встроенного ИК:\s*(.*)", re.I),
         r"Built-in IR error: \1"),
        (re.compile(r"^Сбой регистрации хуков:\s*(.*)", re.I),
         r"Hook registration failure: \1"),
        (re.compile(r"^Настройка изменена:\s*(.*?)\s*=\s*(.*)", re.I),
         r"Setting changed: \1 = \2"),
        (re.compile(r"^Ошибка доступа к USB сервису:\s*(.*)", re.I),
         r"USB service access error: \1"),
        (re.compile(r"^Сбой сканирования USB:\s*(.*)", re.I),
         r"USB scan failure: \1"),
        (re.compile(r"^Адаптер отключен:\s*(.*)", re.I),
         r"Adapter disconnected: \1"),
        (re.compile(r"^Запрос прав USB для\s*(.*?)\.\.\.", re.I),
         r"Requesting USB permissions for \1..."),
        (re.compile(r"^Ошибка запроса прав USB:\s*(.*)", re.I),
         r"USB permission request error: \1"),
        (re.compile(r"^Нет профиля протокола для VID:PID\s*(.*)", re.I),
         r"No protocol profile for VID:PID \1"),
        (re.compile(r"^Каналы USB не найдены:\s*(.*)", re.I),
         r"USB endpoints not found: \1"),
        (re.compile(r"^Не удалось открыть\s*(.*)", re.I),
         r"Failed to open \1"),
        (re.compile(r"^Ошибка передачи USB:\s*(.*)", re.I),
         r"USB transmit error: \1"),
        (re.compile(r"^Ошибка кодирования:\s*(.*)", re.I),
         r"Encoding error: \1"),
        (re.compile(r"^Запись Tiqiaa завершена:\s*([0-9]+)\s*имп\.\s*\((.*?)\)", re.I),
         r"Tiqiaa recording complete: \1 pulses (\2)"),
        (re.compile(r"^Запись ElkSmart завершена:\s*([0-9]+)\s*имп\.\s*\((.*?)\)", re.I),
         r"ElkSmart recording complete: \1 pulses (\2)"),
        (re.compile(r"^Сбой обучения:\s*(.*)", re.I),
         r"Learning failure: \1"),
        (re.compile(r"^Ошибка брутфорс кодирования:\s*(.*)", re.I),
         r"Brute-force encoding error: \1"),
        (re.compile(r"^---\s*Найдено USB устройств:\s*([0-9]+)\s*---", re.I),
         r"--- Found USB devices: \1 ---"),
        (re.compile(r"^VID:\s*(0x[0-9a-fA-F]+),\s*PID:\s*(0x[0-9a-fA-F]+)\s*\|\s*Права:\s*(Да|Нет|True|False)\s*\|\s*(.*)", re.I),
         lambda m: f"VID: {m.group(1)}, PID: {m.group(2)} | Permission: {'Yes' if m.group(3) in ('Да','True','true') else 'No'} | {m.group(4)}"),
        (re.compile(r"^Ошибка команды:\s*(.*)", re.I),
         r"Command error: \1"),
        (re.compile(r"^(.*?):\s*ошибка\s*(.*)", re.I),
         r"\1: error \2"),
        (re.compile(r"^(.*?):\s*остановлено\s*([0-9]+)/([0-9]+)", re.I),
         r"\1: stopped \2/\3"),
        (re.compile(r"^(.*?):\s*отправлено\s*([0-9]+)/([0-9]+)", re.I),
         r"\1: sent \2/\3"),
        (re.compile(r"^Некорректный сигнал:\s*(.*)", re.I),
         r"Invalid signal: \1"),
        (re.compile(r"^Импортировано\s*([0-9]+)\s*сигналов", re.I),
         r"Imported \1 signals"),
        (re.compile(r"^Код найден:\s*(.*)", re.I),
         r"Code found: \1"),
    ]

    def _translate_log(self, text):
        if not isinstance(text, str):
            return str(text)
        if getattr(self, "_lang", "ru") != "en":
            return text
        if text in _I18N_MAP:
            return _I18N_MAP[text]
        for pattern, repl in self._LOG_REGEX_RULES:
            if pattern.search(text):
                try:
                    return pattern.sub(repl, text)
                except Exception:
                    pass
        return text.replace(" имп.", " pulses").replace(" имп", " pulses")



    def _toggle_lang(self):
        """
        Мгновенно переключает язык интерфейса между RU и EN с сохранением в настройках.
        Также синхронно переводит весь журнал логов на выбранный язык.
        """
        self._lang = "en" if getattr(self, "_lang", "ru") == "ru" else "ru"
        self.set_setting("lang", self._lang)
        msg = "Язык: Русский" if self._lang == "ru" else "Language: English"
        try:
            self.toast(msg)
        except Exception:
            pass
        with self._refresh_lock:
            if hasattr(self, "_raw_log_entries") and self._raw_log_entries:
                self._log_lines.clear()
                for ts, raw in self._raw_log_entries:
                    self._log_lines.append(f"[{ts}] {self._translate_log(raw)}")
                self._log_cache_text = "\n".join(self._log_lines)
        self._refresh_ui()

    def _haptic_tick(self):
        """
        Тактильный виброотклик при нажатии на кнопки пультов (как в android-ir-blaster).
        Учитывает как локальную настройку плагина, так и системную настройку Android.
        """
        if not bool(self.get_setting("haptic_feedback", True)):
            return
        try:
            act = self._get_current_activity()
            ctx = (
                act.getApplicationContext()
                if act else
                self.api.getContext()
                if hasattr(self, "api") and hasattr(self.api, "getContext")
                else None
            )
            if ctx is None or jclass is None:
                return

            try:
                SettingsSystem = jclass("android.provider.Settings$System")
                enabled = SettingsSystem.getInt(
                    ctx.getContentResolver(),
                    getattr(SettingsSystem, "HAPTIC_FEEDBACK_ENABLED", "haptic_feedback_enabled"),
                    1
                )
                if int(enabled) == 0:
                    return
            except Exception:
                pass

            Context = jclass("android.content.Context")
            vibrator = ctx.getSystemService(Context.VIBRATOR_SERVICE)
            if vibrator and vibrator.hasVibrator():
                VibrationEffect = jclass("android.os.VibrationEffect")
                vibrator.vibrate(VibrationEffect.createOneShot(35, VibrationEffect.DEFAULT_AMPLITUDE))
        except Exception:
            pass

    _FINDER_PROTOS = [
        "NEC", "NEC2", "NECx1", "NECx2", "Sony12", "Sony15", "Sony20",
        "RC-5", "RC-6", "Samsung32", "Samsung36", "Denon", "Pioneer", "RCA", "Sharp"
    ]

    def __init__(self):
        super().__init__()
        self._usb_manager = None
        self._context = None
        self._device = None
        self._connection = None
        self._usb_interface = None
        self._out_endpoint = None
        self._in_endpoint = None
        self._dongle_name = None
        self._encoder = UnknownProtocolEncoder()
        self._state = DongleState.DISCONNECTED
        self._state_lock = threading.RLock()
        self._session_id = 0
        self._tx_lock = threading.RLock()
        self._learning_active = threading.Event()
        self._lang = "ru"
        self._screen_flipped = False
        self._stop_event = threading.Event()
        self._poll_thread = None
        self._reader_thread = None
        self._learning_thread = None
        self._read_until_at = 0.0
        self._reader_continuous = False
        self._reply_cond = threading.Condition()
        self._reply_queue = deque(maxlen=128)
        self._reply_abort = threading.Event()
        self._log_lines = deque(maxlen=80)
        self._raw_log_entries = deque(maxlen=80)
        self._log_cache_text = ""
        self._refresh_lock = threading.Lock()
        self._last_refresh_at = 0.0
        self._refresh_min_interval = 1.0
        self._pending_refresh_timer = None
        self._last_missing_log_at = 0.0
        self._permission_request_at = {}
        self._ignored_device_name = None
        self._learned_timings = []
        self._learned_frequency = 38000
        self._learned_status = "Ожидание"
        self._learned_protocol_guess = ""
        self._signal_name_input = ""
        self._learning_cancel_event = threading.Event()
        self._stats_lock = threading.Lock()
        self._tx_count = 0
        self._tx_success_count = 0
        self._tx_fail_streak = 0
        self._last_tx_info = "Нет передач"
        self._last_tx_at = 0.0
        self._connected_at = 0.0
        self._active_tab = 0
        self._signal_library = []
        self._library_lock = threading.RLock()
        self._library_search = ""
        self._favorites_only = False
        self._library_page = 0
        self._import_preview = None
        self._import_text = ""
        self._finder_running = False
        self._finder_thread = None
        self._finder_proto = "NEC"
        self._finder_prefix = "20DF"
        self._finder_current_code = 0
        self._finder_max_code = 255
        self._finder_delay_ms = 400
        self._finder_status = "Готов к запуску"
        self._finder_last_sent = ""
        self._finder_last_code = 0
        self._backoff_interval = 1.5
        self._backoff_fast_retries = 0
        self._confirm_delete_id = ""
        self._confirm_delete_name = None
        self._confirm_clear_all = False
        self._adb_ip = ""
        self._finder_cancel = threading.Event()
        self._power_cancel = threading.Event()
        self._power_thread = None
        self._power_running = False
        self._finder_hit = None
        self._jobs = queue.Queue(maxsize=12)
        self._job_lock = threading.Lock()
        self._job_thread = None
        self._adb_busy = False
        self._adb_status = "Нужны ADB на телефоне и разрешённое подключение на ТВ"
        self._remote_group = ""
        self._remote_page = 0
        self._edit_signal_id = None
        self._edit_signal_name = ""
        self._edit_signal_group = ""
