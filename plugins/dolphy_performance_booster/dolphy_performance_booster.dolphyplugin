__id__ = "import_boost"
__name__ = "Dolphy Performance Booster"
__version__ = "1.0.0"
__author__ = "Developer"
__icon__ = "rounded:speed"
__description__ = "Optimize Dolphy performance and leverage device resources via Shizuku"
__permissions__ = ["shizuku", "shell"]

import gc

class DolphyPerformanceBooster(BasePlugin):
    def on_plugin_load(self):
        self.add_module(
            title="Dolphy Booster",
            description="Resource and memory management, Shizuku optimization",
            icon="speed",
            screen="main",
            section="PLUGINS"
        )

    def screen_main(self, ui, api, state):
        device = api.getDevice()
        shizuku_avail = device.shizukuAvailable()
        shizuku_perm = device.shizukuHasPermission() if shizuku_avail else False

        status_text = "Available and active" if shizuku_perm else ("Running, no permission" if shizuku_avail else "Not running")

        cards = [
            ui.card([
                ui.text("Shizuku status", "titleMedium"),
                ui.spacer(4),
                ui.text(f"State: {status_text}", "bodyMedium"),
                ui.spacer(8),
                ui.button("Request Shizuku permission", self.request_shizuku, enabled=shizuku_avail)
            ]),
            ui.spacer(12),
            ui.card([
                ui.text("Basic optimization", "titleMedium"),
                ui.spacer(4),
                ui.text("Works without special permissions. Frees unused Python and garbage collector memory.", "bodySmall"),
                ui.spacer(8),
                ui.bounce_button("Clean Python memory", self.clean_python_memory)
            ]),
            ui.spacer(12),
            ui.card([
                ui.text("Maximum boost (Shizuku)", "titleMedium"),
                ui.spacer(4),
                ui.text("Removes Doze background restrictions, clears system caches and sets high process priority.", "bodySmall"),
                ui.spacer(8),
                ui.button("Activate turbo mode", self.apply_shizuku_boost, enabled=shizuku_perm, fill_max_width=True)
            ])
        ]

        return ui.scaffold(
            title="Performance Booster",
            content=ui.column(cards, padding=16, spacing=0, fill_max_size=True)
        )

    def request_shizuku(self):
        device = self.api.getDevice()
        if device.shizukuAvailable():
            device.shizukuRequestPermission()
            self.toast("Shizuku permission request sent")
        else:
            self.toast("Shizuku is not running")
        self.refresh()

    def clean_python_memory(self):
        gc.collect()
        self.toast("Python memory cleaned")
        self.refresh()

    def apply_shizuku_boost(self):
        device = self.api.getDevice()
        if not device.shizukuHasPermission():
            self.toast("Shizuku permission required")
            return

        pkg_name = "com.droid.dolphy"
        
        self.shizuku(f"dumpsys deviceidle whitelist +{pkg_name}")
        self.shizuku(f"cmd appops set {pkg_name} RUN_IN_BACKGROUND allow")
        self.shizuku("pm trim-caches 256M")
        
        gc.collect()
        
        self.toast("Maximum boost applied!")
        self.refresh()
