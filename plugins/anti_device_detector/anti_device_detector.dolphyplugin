__id__ = "anti_device_detector"
__name__ = "Anti Device Detector"
__version__ = "1.0.0"
__author__ = "(Dolphy User) L1tWin"
__icon__ = "rounded:visibility_off"
__description__ = "Device stealth mode: disables Bluetooth, Wi-Fi, NFC and location"
__permissions__ = []

class AntiDeviceDetector(BasePlugin):
    def on_plugin_load(self):
        self.add_module(
            title="Anti Device Detector",
            description="Lower visibility to scanners",
            icon="visibility_off",
            screen="main",
            section="PLUGINS"
        )

    def _android(self):
        return self.api.getAndroid()

    def _device(self):
        return self.api.getDevice()

    def _bt_enabled(self):
        try:
            return bool(self._android().btIsEnabled())
        except:
            return False

    def _wifi_enabled(self):
        try:
            return bool(self._android().wifiIsEnabled())
        except:
            return False

    def _disable_bt(self):
        try:
            a = self._android()
            a.btDisable()
            a.btSetName("Android")
        except:
            pass

    def _disable_wifi(self):
        try:
            self._android().wifiDisconnect()
        except:
            pass
        try:
            self.shell("svc wifi disable")
        except:
            try:
                self.shizuku("svc wifi disable")
            except:
                pass

    def _disable_nfc(self):
        try:
            self.shell("svc nfc disable")
        except:
            try:
                self.shizuku("svc nfc disable")
            except:
                pass

    def _disable_location(self):
        try:
            self.shell("settings put secure location_mode 0")
        except:
            try:
                self.shizuku("settings put secure location_mode 0")
            except:
                pass

    def _try_mac_spoof(self):
        try:
            d = self._device()
            if d.rootAvailable():
                d.rootMacSpoof("wlan0", "02:00:00:00:00:00", lambda r: None)
        except:
            pass

    def activate(self):
        self._disable_bt()
        self._disable_wifi()
        self._disable_nfc()
        self._disable_location()
        self._try_mac_spoof()
        self.set_setting("active", True)
        self.toast("Anti Device Detector enabled")
        self.refresh()

    def deactivate(self):
        self.set_setting("active", False)
        self.toast("Anti Device Detector disabled")
        self.refresh()

    def screen_main(self, ui, api, state):
        active = bool(self.get_setting("active", False))
        bt = self._bt_enabled()
        wifi = self._wifi_enabled()

        status = "ACTIVE" if active else "OFF"
        color = "error" if active else "success"

        def on_toggle():
            if active:
                self.deactivate()
            else:
                self.activate()

        return ui.scaffold(
            title="Anti Device Detector",
            content=ui.column([
                ui.card([
                    ui.text("Status", "titleMedium"),
                    ui.spacer(height=8),
                    ui.text(status, "headlineSmall", color=color),
                    ui.spacer(height=4),
                    ui.text("Disables Bluetooth, Wi-Fi, NFC and location", "bodySmall", color="muted")
                ], padding=16),

                ui.card([
                    ui.text("Current state", "titleMedium"),
                    ui.spacer(height=8),
                    ui.text("Bluetooth: " + ("on" if bt else "off"), "bodyMedium"),
                    ui.text("Wi-Fi: " + ("on" if wifi else "off"), "bodyMedium"),
                    ui.text("NFC: controlled via svc", "bodyMedium"),
                    ui.text("Location: controlled via settings", "bodyMedium")
                ], padding=16),

                ui.button(
                    "Disable" if active else "Enable",
                    on_toggle,
                    style="filled",
                    fill_max_width=True
                ),

                ui.spacer(height=8),
                ui.card([
                    ui.text("Important", "titleSmall"),
                    ui.spacer(height=6),
                    ui.text(
                        "Full invisibility is impossible. The plugin disables the main radios and lowers the chance of detection. Cellular networks and already installed apps may keep working. Root or Shizuku is recommended for svc/settings.",
                        "bodySmall",
                        color="muted"
                    )
                ], padding=16)
            ], padding=16, spacing=12)
        )
