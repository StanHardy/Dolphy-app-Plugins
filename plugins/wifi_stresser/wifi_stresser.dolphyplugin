    def _l2_once(self, idx):
        now = time.time()
        if now - self._last_l2_time < 1.5:
            return
        self._last_l2_time = now

        try:
            if self.has_shizuku:
                self.shizuku("cmd wifi start-scan")
            elif self.has_root:
                self.root("cmd wifi start-scan")
            with self.stats_lock:
                self.stats["l2"] += 1
        except Exception as e:
            self._record_error("L2 (Mixed)", e)

    def _l2_worker(self, idx):
        if not (self.has_root or self.has_shizuku):
            self.toast("❌ L2 requires Root or Shizuku!")
            self._log("L2 worker stopped: no privileges", "ERR")
            return

        cmd = "cmd wifi start-scan"
        while not self.stop_flag:
            try:
                if self.has_shizuku:
                    self.shizuku(cmd)
                elif self.has_root:
                    self.root(cmd)
                else:
                    self.shell(cmd)
                time.sleep(1.0)
                with self.stats_lock:
                    self.stats["l2"] += 1
                if not self.throttle_ignore:
                    time.sleep(0.05)
            except Exception as e:
                self._record_error("L2", e)
                break

    def on_plugin_unload(self):
        self._stop_stress()
        with self.sockets_lock:
            for sock in list(self.sockets):
                self._safe_close_socket(sock)
            self.sockets.clear()