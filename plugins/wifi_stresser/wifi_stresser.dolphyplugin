        )

    def _method_chip(self, ui, method, available):
        return ui.chip(
            method,
            selected=(self.method == method),
            on_click=lambda: self._set_method(method) if available else None
        )

    def _duration_chip(self, ui, duration_val, label):
        return ui.chip(
            label,
            selected=(self.duration == duration_val),
            on_click=lambda: self._set_duration(duration_val)
        )

    # ------------------- Extended guide for beginners and pros -------------------

    def screen_guide(self, ui, api, state):
        children = [
            ui.card([
                ui.text("📖 Detailed Knowledge Base (v3.0)", "titleMedium"),
                ui.text("A complete guide to security auditing and stress-testing routers", "bodySmall")
            ]),

            ui.card([
                ui.text("🎯 1. What is WiFi Stresser and what is it for?", "titleMedium"),
                ui.text(
                    "A specialized tool for testing the **resilience and protection of local routers** (Keenetic, OpenWrt, TP-Link, etc.). It helps you understand how the gateway reacts to network flooding, whether the built-in Anti-DoS filter kicks in, and whether the web interface survives the load.",
                    "bodySmall"
                )
            ]),

            ui.card([
                ui.text("🔌 2. How to choose the right port?", "titleMedium"),
                ui.text(
                    "The port decides which service on the router you will load:\n\n"
                    "• **Port 80 or 443 (HTTP/HTTPS):** The router web admin panel. Use it for the `HTTP`, `Connect`, `Hold`, `Slowloris` and `SlowBody` methods.\n"
                    "• **Port 53 (DNS):** The internal DNS resolver (`dnsmasq`). The main target for `UDP` and `DNS Flood`.\n"
                    "• **Port 1900 (UPnP):** The device auto-discovery service (`miniupnpd`). Tests the router's resilience to XML requests.\n\n"
                    "⚠️ *Note:* Modern routers may hide ports 80/443 from security scanners. If you know the admin panel IP for sure (e.g. `192.168.1.1`), just enter the port manually.",
                    "bodySmall"
                )
            ]),

            ui.card([
                ui.text("⚡ 3. Attack methods (vectors) explained", "titleMedium"),
                ui.text(
                    "• **UDP / DNS Flood:** Buries the router under junk packets and queries for non-existent sites, loading the CPU and network stack.\n"
                    "• **HTTP / Connect Flood:** A rapid barrage of connections to the web server to test the connection limit.\n"
                    "• **Slowloris / SlowBody:** Slow attacks. They deliberately keep sockets open, sending data one byte per second, which instantly exhausts the web server's free RAM limit.\n"
                    "• **Mixed (Combo):** A combined mode that merges all selected vectors for a comprehensive test.\n"
                    "• **Bypass 4.0:** Enable this mode to audit networks with **WPA3 Transition Mode** -- it dynamically varies headers, imitating mixed SAE-authentication traffic.",
                    "bodySmall"
                )
            ]),

            ui.card([
                ui.text("📊 4. Metrics and reports explained", "titleMedium"),
                ui.text(
                    "• **PPS (packets per second):** The current traffic generation rate of the phone.\n"
                    "• **Wi-Fi vitality:** A real-time link health indicator (from green to the «Coma» status).\n"
                    "• **JSON/CSV export:** On button press, reports are automatically saved on the phone to `/sdcard/Download/` for detailed analysis.",
                    "bodySmall"
                )
            ]),

            ui.card([
                ui.button(
                    "⬅️ Go back",
                    on_click=lambda: self.navigate("main"),
                    style="filled",
                    fill_max_width=True
                )
            ])
        ]

        return ui.scaffold(
            title="Audit guide",
            content=ui.column(children, padding=16, spacing=12)
        )

