    def _mixed_tcp_worker(self, idx):
        methods = self._get_mixed_tcp_methods()
        if not methods:
            return

        while not self.stop_flag:
            m = random.choice(methods)
            m(idx)
            time.sleep(0.005)

    def _mixed_udp_worker(self, idx):
        methods = self._get_mixed_udp_methods()
        if not methods:
            return

        while not self.stop_flag:
            m = random.choice(methods)
            for _ in range(random.randint(5, 10)):
                if self.stop_flag:
                    return
                m(idx)
            time.sleep(0.002)

