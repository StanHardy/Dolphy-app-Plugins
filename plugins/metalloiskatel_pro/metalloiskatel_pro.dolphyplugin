__id__ = "metal_detector"
__name__ = "Metal Detector PRO"
__version__ = "2.0"
__author__ = "@frostmench1k & @DobryyPIRATIK"
__icon__ = "rounded:sensors"
__description__ = "PRO radar for metal, hidden wiring, and listening devices with smart calibration"
__permissions__ = []

import json
import math
import threading
import time
from java import jclass, dynamic_proxy

_SensorEventListener = jclass("android.hardware.SensorEventListener")
_SensorManager = jclass("android.hardware.SensorManager")
_Sensor = jclass("android.hardware.Sensor")


class _MagneticListener(dynamic_proxy(_SensorEventListener)):
    def __init__(self, plugin):
        super().__init__()
        self._plugin = plugin

    def onSensorChanged(self, event):
        try:
            v = event.values
            arr = [float(v[i]) for i in range(len(v))]
        except Exception:
            return
        try:
            self._plugin._on_values(arr)
        except Exception:
            pass

    def onAccuracyChanged(self, sensor, accuracy):
        try:
            self._plugin._on_accuracy(int(accuracy))
        except Exception:
            pass


class MetalDetectorPro(BasePlugin):
    def on_plugin_load(self):
        self._lock = threading.Lock()
        self.running = False
        self.paused = False
        self.listener = None
        self.sensor = None
        self.sensor_manager = None
        self.sensor_kind = "mag"
        self.accuracy = 3
        self.tab_index = 0

        self.x = 0.0
        self.y = 0.0
        self.z = 0.0
        self.base_x = 0.0
        self.base_y = 0.0
        self.base_z = 0.0

        self.raw_magnitude = 0.0
        self.magnitude = 0.0
        self.prev_deviation = 0.0
        self.trend = 0.0
        self.max_magnitude = 0.0
        self.min_magnitude = 9999.0
        self.baseline = None
        self.deviation = 0.0
        self.signed_delta = 0.0
        self.ac_level = 0.0
        self.noise_floor = 0.8
        self.hit_count = 0

        self.calibrating = False
        self.calib_samples = []
        self.calib_target = 20

        self.recent_samples = []
        self.detected = False
        self.history = []
        self._last_ui_update = 0.0
        self._last_log_time = 0.0

        self.preset = str(self.get_setting("preset", "Normal"))
        self.threshold = float(self.get_setting("threshold", 15.0))
        self.vibrate_enabled = bool(self.get_setting("vibrate", True))
        self.sound_enabled = bool(self.get_setting("sound", False))
        self.smooth_enabled = bool(self.get_setting("smooth", True))
        self.wiring_mode = bool(self.get_setting("wiring_mode", False))
        self.auto_zero = bool(self.get_setting("auto_zero", False))
        self.notify_alert = bool(self.get_setting("notify_alert", False))

        self._worker_thread = None
        self._worker_stop = threading.Event()

        self.add_module(
            title="Metal Detector PRO 2.0",
            description="Metal, wiring, and listening devices | @frostmench1k",
            icon="sensors",
            screen="main",
            section="PLUGINS"
        )

        self.api.registerSettings("Metal Detector PRO 2.0", json.dumps([
            {"type": "slider", "key": "threshold", "title": "Trigger threshold (uT)",
             "min": 2, "max": 150, "default": 15, "steps": 147},
            {"type": "switch", "key": "vibrate", "title": "Tactile vibration (Geiger)", "default": True},
            {"type": "switch", "key": "sound", "title": "Audio radar", "default": False},
            {"type": "switch", "key": "smooth", "title": "Sensor noise filter", "default": True},
            {"type": "switch", "key": "wiring_mode", "title": "Hidden wiring detector", "default": False},
            {"type": "switch", "key": "auto_zero", "title": "Auto baseline adjust", "default": False}
        ]), 10)

    def on_setting_changed(self, payload):
        key = payload.get("key", "")
        value = payload.get("value")
        if key == "threshold":
            self.threshold = max(2.0, float(value))
        elif key == "vibrate":
            self.vibrate_enabled = bool(value)
        elif key == "sound":
            self.sound_enabled = bool(value)
        elif key == "smooth":
            self.smooth_enabled = bool(value)
        elif key == "wiring_mode":
            self.wiring_mode = bool(value)
        elif key == "auto_zero":
            self.auto_zero = bool(value)
        self._sync_worker()
        self.refresh()

    def on_plugin_disable(self):
        self.stop_scan()

    def on_plugin_unload(self):
        self.stop_scan()

    def _get_hot_cold_hint(self):
        if not self.running or self.calibrating:
            return "Waiting for the scan..."
        if self.paused:
            return "Screen paused (readings frozen)"
        if self.deviation < max(2.0, self.noise_floor * 1.5):
            return "Calm magnetic background"
        if self.trend > 0.6:
            return "HOT: You are approaching the target!"
        if self.trend < -0.6:
            return "COLD: You are moving away from the target"
        return "Stable hold over the target"

    def _classify_target(self):
        if not self.running:
            return "Radar off", "muted", "Tap «Start» to run the sensor"
        if self.paused:
            return "PAUSED (HOLD)", "warning", "Tap the pause icon above to resume"
        if self.calibrating:
            pct = int((len(self.calib_samples) / max(self.calib_target, 1)) * 100)
            return f"Zero calibration... {pct}%", "primary", "Keep the phone still and remove metal"

        if self.wiring_mode and self.ac_level >= 3.0:
            return "Hidden wiring / 50 Hz EMF!", "warning", "Alternating electromagnetic field detected"

        if self.deviation < self.threshold * 0.45:
            return "Clear (Normal background)", "success", self._get_hot_cold_hint()

        polarity = "North (+N)" if self.signed_delta >= 0 else "South (-S)"
        if self.deviation >= self.threshold * 4.0:
            dist = "TOUCHING: Strong magnet / Large steel"
            col = "error"
        elif self.deviation >= self.threshold * 2.0:
            dist = "CLOSE: Ferrous metal / Rebar"
            col = "error"
        elif self.deviation >= self.threshold:
            dist = "DETECTED: Metal or speaker"
            col = "error"
        else:
            dist = "WEAK SIGNAL: Small object / Far away"
            col = "warning"

        return dist, col, f"{self._get_hot_cold_hint()} | Pole: {polarity}"

    def _accuracy_label(self):
        if self.accuracy >= 3:
            return "Perfect (3/3)", "success"
        if self.accuracy == 2:
            return "Normal (2/3)", "warning"
        if self.accuracy == 1:
            return "Low (1/3) — wave the phone in a figure-eight!", "error"
        return "Misaligned (0/3) — a figure-eight rotation is required!", "error"

    def screen_main(self, ui, api, state):
        status_title, status_color, status_sub = self._classify_target()
        progress = min(self.deviation / max(self.threshold * 2.0, 1.0), 1.0)
        pinpoint = min(self.deviation / max(self.threshold * 4.0, 1.0), 1.0)

        top_actions = [
            ui.top_action("pause" if not self.paused else "play_arrow", self.toggle_pause),
            ui.top_action("my_location", self.start_smart_calibration),
            ui.top_action("share", self.export_and_share_log)
        ]

        tabs = ui.tabs(
            ["Radar", "Calibration", "Spectrum & Log", "Options"],
            selected=self.tab_index,
            on_select=self.select_tab
        )

        if self.tab_index == 0:
            page = self._tab_radar(ui, status_title, status_color, status_sub, progress, pinpoint)
        elif self.tab_index == 1:
            page = self._tab_calibration(ui)
        elif self.tab_index == 2:
            page = self._tab_spectrum(ui)
        else:
            page = self._tab_options(ui)

        return ui.scaffold(
            title="Metal Detector PRO 2.0",
            actions=top_actions,
            content=ui.column([
                tabs,
                page
            ], padding=14, spacing=10, fill_max_size=True)
        )

    def _tab_radar(self, ui, status_title, status_color, status_sub, progress, pinpoint):
        base_txt = "—" if self.baseline is None else f"{self.baseline:.1f}"
        presets = ["Bugs", "Coins", "Normal", "Large", "Wiring"]

        return ui.column([
            ui.card([
                ui.row([
                    ui.column([
                        ui.text(f"{self.magnitude:.1f} uT", "headlineLarge"),
                        ui.text(status_title, "titleMedium", color=status_color),
                        ui.text(status_sub, "bodySmall", color="muted")
                    ]),
                    ui.wavy_progress(progress=progress, size=80)
                ], spacing=12),
                ui.spacer(height=6),
                ui.text("Alarm level", "labelSmall", color="muted"),
                ui.linear_progress(progress=progress, fill_max_width=True),
                ui.spacer(height=4),
                ui.text("Pinpointer (Exact object epicenter)", "labelSmall", color="muted"),
                ui.linear_progress(progress=pinpoint, fill_max_width=True)
            ], padding=14),
            ui.card([
                ui.row([
                    ui.column([
                        ui.text("Deviation", "labelSmall", color="muted"),
                        ui.text(f"{self.signed_delta:+.1f}", "titleLarge",
                                color="error" if self.detected else "primary")
                    ]),
                    ui.column([
                        ui.text("Baseline (0)", "labelSmall", color="muted"),
                        ui.text(base_txt, "titleLarge")
                    ]),
                    ui.column([
                        ui.text("Peak (Max)", "labelSmall", color="muted"),
                        ui.text(f"{self.max_magnitude:.1f}", "titleLarge", color="warning")
                    ]),
                    ui.column([
                        ui.text("Finds", "labelSmall", color="muted"),
                        ui.text(f"{self.hit_count}", "titleLarge", color="success")
                    ])
                ], spacing=10),
                ui.divider(),
                ui.row([
                    ui.text(f"AC background: {self.ac_level:.2f} uT", "bodySmall",
                            color="warning" if self.ac_level >= 3.0 else "muted"),
                    ui.text(f"Threshold: {self.threshold:.0f} uT", "bodySmall", color="primary")
                ], spacing=8)
            ], padding=14),
            ui.button_group(presets, self.preset, self.select_preset),
            ui.row([
                ui.bounce_button("Stop" if self.running else "Start",
                                 self.toggle_scan, fill_max_width=True),
                ui.button("Smart zero", self.start_smart_calibration,
                          style="outlined", fill_max_width=True)
            ], spacing=8),
            ui.text("Authors: @frostmench1k & @DobryyPIRATIK | v2.0", "bodySmall", color="muted")
        ], spacing=10)

    def _tab_calibration(self, ui):
        acc_text, acc_color = self._accuracy_label()
        base_txt = "Not calibrated" if self.baseline is None else f"{self.baseline:.2f} uT"
        calib_progress = len(self.calib_samples) / max(float(self.calib_target), 1.0) if self.calibrating else 1.0

        return ui.column([
            ui.card([
                ui.text("Calibration wizard (Smart zero)", "titleMedium"),
                ui.text(f"System sensor accuracy: {acc_text}", "bodyMedium", color=acc_color),
                ui.spacer(height=4),
                ui.linear_progress(progress=calib_progress, fill_max_width=True),
                ui.spacer(height=4),
                ui.text(f"Baseline: {base_txt} | Noise: ±{self.noise_floor:.2f} uT", "bodySmall"),
                ui.text(f"Zero vector X/Y/Z: {self.base_x:.1f} / {self.base_y:.1f} / {self.base_z:.1f}", "bodySmall", color="muted"),
                ui.spacer(height=8),
                ui.row([
                    ui.button("Smart calibration", self.start_smart_calibration, fill_max_width=True),
                    ui.button("Reset peak", self.reset_stats, style="outlined", fill_max_width=False)
                ], spacing=8)
            ], padding=14),
            ui.card([
                ui.text("Proper calibration tips", "titleMedium"),
                ui.text("1. Remove any case with a magnetic ring (MagSafe) or clasp — it inflates the background from 48 to 200+ uT.", "bodySmall"),
                ui.text("2. Raise the phone in the air away from tables with metal legs, laptops, and power outlets.", "bodySmall"),
                ui.text("3. Smoothly wave the phone in a figure-eight (∞) path 4-5 times, flipping the body each pass.", "bodySmall"),
                ui.text("4. While searching, keep the phone at the same tilt angle (rotating the phone in space changes the projection of Earth's magnetic field onto the X/Y/Z axes).", "bodySmall"),
                ui.spacer(height=4),
                ui.switch(self.auto_zero, self.toggle_auto_zero,
                          title="Auto tilt compensation",
                          subtitle="Smoothly adjust the baseline during slow hand rotation")
            ], padding=14)
        ], spacing=10)

    def _tab_spectrum(self, ui):
        dx = self.x - self.base_x
        dy = self.y - self.base_y
        dz = self.z - self.base_z
        px = min(abs(dx) / 100.0, 1.0)
        py = min(abs(dy) / 100.0, 1.0)
        pz = min(abs(dz) / 100.0, 1.0)
        log_str = "\n".join(self.history) if self.history else "No finds yet. Tap «Start» and point the top edge of the phone at the surface to check."

        return ui.column([
            ui.card([
                ui.text("3D axes (Direction to target)", "titleMedium"),
                ui.text(f"X axis (Side edge): {self.x:.1f} uT (Δ {dx:+.1f})", "bodySmall"),
                ui.linear_progress(progress=px, fill_max_width=True),
                ui.text(f"Y axis (Top edge): {self.y:.1f} uT (Δ {dy:+.1f})", "bodySmall"),
                ui.linear_progress(progress=py, fill_max_width=True),
                ui.text(f"Z axis (Back / Screen): {self.z:.1f} uT (Δ {dz:+.1f})", "bodySmall"),
                ui.linear_progress(progress=pz, fill_max_width=True)
            ], padding=14),
            ui.card([
                ui.row([
                    ui.text(f"Find log ({len(self.history)})", "titleMedium"),
                    ui.button("Copy", self.copy_report, style="outlined"),
                    ui.button("Clear", self.clear_history, style="outlined")
                ], spacing=6),
                ui.log_panel(log_str, max_height=150)
            ], padding=14)
        ], spacing=10)

    def _tab_options(self, ui):
        return ui.column([
            ui.card([
                ui.slider(self.threshold, self.set_threshold, 2, 150,
                          f"Trigger threshold: {self.threshold:.0f} uT", 147),
                ui.switch(self.vibrate_enabled, self.toggle_vibrate,
                          title="Tactile Geiger",
                          subtitle="Vibration frequency and strength rise as you get closer"),
                ui.switch(self.sound_enabled, self.toggle_sound,
                          title="Audio radar",
                          subtitle="Tonal beeping that speeds up"),
                ui.switch(self.smooth_enabled, self.toggle_smooth,
                          title="Noise smoothing (Low-Pass)",
                          subtitle="Filters out random single sensor spikes"),
                ui.switch(self.wiring_mode, self.toggle_wiring,
                          title="Hidden wiring detector (50/60 Hz)",
                          subtitle="Analyzes high-frequency jitter of the magnetic field"),
                ui.switch(self.notify_alert, self.toggle_notify,
                          title="Find push notifications",
                          subtitle="Send a notification on a strong field spike")
            ], padding=12)
        ], spacing=10)

    def select_tab(self, idx):
        self.tab_index = int(idx)
        self.refresh()

    def toggle_pause(self):
        if not self.running:
            self.toast("Start the scan first")
            return
        self.paused = not self.paused
        self.toast("Screen frozen (Paused)" if self.paused else "Scan resumed")
        self.refresh()

    def select_preset(self, name):
        self.preset = str(name)
        self.set_setting("preset", self.preset)
        if self.preset == "Bugs":
            self.threshold = 6.0
            self.wiring_mode = True
        elif self.preset == "Coins":
            self.threshold = 9.0
            self.wiring_mode = False
        elif self.preset == "Normal":
            self.threshold = 15.0
            self.wiring_mode = False
        elif self.preset == "Large":
            self.threshold = 35.0
            self.wiring_mode = False
        elif self.preset == "Wiring":
            self.threshold = 12.0
            self.wiring_mode = True

        self.set_setting("threshold", self.threshold)
        self.set_setting("wiring_mode", self.wiring_mode)
        self.toast(f"Preset «{self.preset}»: threshold {self.threshold:.0f} uT")
        self.refresh()

    def toggle_scan(self):
        if self.running:
            self.stop_scan()
        else:
            self.start_scan()
        self.refresh()

    def start_scan(self):
        with self._lock:
            if self.running:
                return
            try:
                sm = self.api.getContext().getSystemService("sensor")
            except Exception:
                sm = None
            if sm is None:
                self.toast("Sensor service unavailable")
                return

            sensor = sm.getDefaultSensor(_Sensor.TYPE_MAGNETIC_FIELD)
            if sensor is not None:
                self.sensor_kind = "mag"
            else:
                sensor = sm.getDefaultSensor(_Sensor.TYPE_PROXIMITY)
                if sensor is not None:
                    self.sensor_kind = "prox"
                else:
                    self.toast("No magnetometer found on this device")
                    return

            listener = _MagneticListener(self)
            try:
                ok = sm.registerListener(listener, sensor, _SensorManager.SENSOR_DELAY_GAME)
            except Exception:
                ok = False

            if not ok:
                self.toast("Magnetometer connection error")
                return

            self.sensor_manager = sm
            self.listener = listener
            self.sensor = sensor
            self.running = True
            self.paused = False

        self._sync_worker()

    def stop_scan(self):
        self._stop_worker()
        with self._lock:
            if self.sensor_manager is not None and self.listener is not None:
                try:
                    self.sensor_manager.unregisterListener(self.listener)
                except Exception:
                    pass
            self.sensor_manager = None
            self.listener = None
            self.sensor = None
            self.running = False
            self.paused = False
            self.detected = False
            self.calibrating = False
        try:
            self.api.getAndroid().vibrateCancel()
        except Exception:
            pass

    def start_smart_calibration(self):
        if not self.running:
            self.start_scan()
        if not self.running:
            return
        self.paused = False
        self.calib_samples = []
        self.calibrating = True
        self.toast("Zero calibration... Hold the phone level")
        self.refresh()

    def reset_stats(self):
        self.max_magnitude = self.magnitude
        self.min_magnitude = self.magnitude if self.magnitude > 0 else 9999.0
        self.hit_count = 0
        self.deviation = 0.0
        self.detected = False
        self.toast("Stats and peaks reset")
        self.refresh()

    def clear_history(self):
        self.history = []
        self.hit_count = 0
        self.toast("Log cleared")
        self.refresh()

    def _build_report_text(self):
        return (
            f"Metal Detector PRO v2.0 (@frostmench1k)\n"
            f"Current field: {self.magnitude:.1f} uT | Baseline: {0.0 if self.baseline is None else self.baseline:.1f} uT\n"
            f"Deviation: {self.signed_delta:+.1f} uT | Maximum: {self.max_magnitude:.1f} uT\n"
            f"Vectors X/Y/Z: {self.x:.1f} / {self.y:.1f} / {self.z:.1f}\n"
            f"AC ripple: {self.ac_level:.2f} uT | Finds this session: {self.hit_count}\n"
            f"Trigger log:\n" + ("\n".join(self.history[-20:]) if self.history else "Empty")
        )

    def copy_report(self):
        try:
            self.api.getAndroid().clipboardSet(self._build_report_text())
            self.toast("Report copied to the clipboard")
        except Exception:
            self.toast("Failed to copy")

    def export_and_share_log(self):
        text = self._build_report_text()
        try:
            android = self.api.getAndroid()
            android.filesWrite("metal_scan_report.txt", text, False)
            android.shareText(text, "Metal Detector PRO 2.0 report")
        except Exception:
            self.copy_report()

    def _on_accuracy(self, acc):
        self.accuracy = acc

    def _on_values(self, values):
        if not values or not self.running or self.paused:
            return
        if self.sensor_kind == "mag" and len(values) >= 3:
            rx, ry, rz = float(values[0]), float(values[1]), float(values[2])
            raw = math.sqrt(rx * rx + ry * ry + rz * rz)
        else:
            rx, ry, rz = float(values[0]), 0.0, 0.0
            raw = abs(rx)

        self.raw_magnitude = raw

        if self.magnitude == 0.0 or not self.smooth_enabled:
            self.magnitude = raw
            self.x, self.y, self.z = rx, ry, rz
        else:
            alpha = 0.28
            self.magnitude = self.magnitude * (1.0 - alpha) + raw * alpha
            self.x = self.x * (1.0 - alpha) + rx * alpha
            self.y = self.y * (1.0 - alpha) + ry * alpha
            self.z = self.z * (1.0 - alpha) + rz * alpha

        if self.calibrating:
            self.calib_samples.append((self.magnitude, self.x, self.y, self.z))
            if len(self.calib_samples) >= self.calib_target:
                cnt = float(len(self.calib_samples))
                mags = [s[0] for s in self.calib_samples]
                avg_mag = sum(mags) / cnt
                self.baseline = avg_mag
                self.base_x = sum(s[1] for s in self.calib_samples) / cnt
                self.base_y = sum(s[2] for s in self.calib_samples) / cnt
                self.base_z = sum(s[3] for s in self.calib_samples) / cnt
                variance = sum((m - avg_mag) ** 2 for m in mags) / cnt
                self.noise_floor = max(0.3, math.sqrt(variance) * 2.2)
                self.max_magnitude = avg_mag
                self.min_magnitude = avg_mag
                self.deviation = 0.0
                self.signed_delta = 0.0
                self.calibrating = False
                self.calib_samples = []
                self.toast(f"Zero set: {self.baseline:.1f} uT")
            self._throttled_refresh(force=not self.calibrating)
            return

        if self.baseline is None:
            self.baseline = self.magnitude
            self.base_x, self.base_y, self.base_z = self.x, self.y, self.z
            self.max_magnitude = self.magnitude
            self.min_magnitude = self.magnitude

        if self.magnitude > self.max_magnitude:
            self.max_magnitude = self.magnitude
        if self.magnitude < self.min_magnitude:
            self.min_magnitude = self.magnitude

        self.recent_samples.append(raw)
        if len(self.recent_samples) > 16:
            self.recent_samples.pop(0)
        if len(self.recent_samples) >= 5:
            mean = sum(self.recent_samples) / float(len(self.recent_samples))
            var = sum((s - mean) ** 2 for s in self.recent_samples) / float(len(self.recent_samples))
            self.ac_level = math.sqrt(var)

        self.signed_delta = self.magnitude - self.baseline
        new_dev = abs(self.signed_delta)
        self.trend = self.trend * 0.7 + (new_dev - self.prev_deviation) * 0.3
        self.prev_deviation = new_dev
        self.deviation = new_dev

        if self.auto_zero and not self.detected and self.deviation < (self.threshold * 0.35):
            self.baseline = self.baseline * 0.994 + self.magnitude * 0.006
            self.base_x = self.base_x * 0.994 + self.x * 0.006
            self.base_y = self.base_y * 0.994 + self.y * 0.006
            self.base_z = self.base_z * 0.994 + self.z * 0.006

        was_detected = self.detected
        is_wire_hit = self.wiring_mode and (self.ac_level >= 3.0)
        self.detected = (self.deviation >= self.threshold) or is_wire_hit

        now = time.time()
        if self.detected and not was_detected:
            self.hit_count += 1

        if self.detected and (not was_detected or (now - self._last_log_time >= 3.5)):
            self._last_log_time = now
            stamp = time.strftime("%H:%M:%S")
            kind_tag = "Wiring" if is_wire_hit else ("Magnet/Steel" if self.deviation >= self.threshold * 2.0 else "Metal")
            pol = "+" if self.signed_delta >= 0 else "-"
            self.history.append(f"[{stamp}] #{self.hit_count} {kind_tag}: {self.magnitude:.1f} uT ({pol}{self.deviation:.1f})")
            if len(self.history) > 60:
                self.history.pop(0)

            if self.notify_alert and self.deviation >= self.threshold * 2.0:
                try:
                    self.api.getAndroid().notifyShow(
                        702,
                        "Metal Detector PRO 2.0",
                        f"Target detected #{self.hit_count}: {self.magnitude:.1f} uT",
                        "dolphy_plugins"
                    )
                except Exception:
                    pass

        self._throttled_refresh(force=(self.detected != was_detected))

    def _throttled_refresh(self, force=False):
        now = time.time()
        if force or (now - self._last_ui_update >= 0.14):
            self._last_ui_update = now
            try:
                self.refresh()
            except Exception:
                pass

    def _sync_worker(self):
        if self.running and (self.sound_enabled or self.vibrate_enabled):
            if self._worker_thread is None or not self._worker_thread.is_alive():
                self._worker_stop.clear()
                self._worker_thread = threading.Thread(target=self._feedback_loop, daemon=True)
                self._worker_thread.start()
        else:
            self._stop_worker()

    def _stop_worker(self):
        self._worker_stop.set()
        t = self._worker_thread
        if t is not None and t.is_alive():
            try:
                t.join(timeout=0.4)
            except Exception:
                pass
        self._worker_thread = None

    def _feedback_loop(self):
        while not self._worker_stop.is_set():
            if not self.running or self.calibrating or self.paused:
                time.sleep(0.1)
                continue

            dev = self.deviation
            if self.wiring_mode and self.ac_level >= 3.0:
                dev = max(dev, self.threshold * 1.3)

            floor = max(self.threshold * 0.25, self.noise_floor * 1.5)
            if dev < floor:
                time.sleep(0.08)
                continue

            intensity = min(dev / max(self.threshold * 2.0, 1.0), 1.0)
            interval = max(0.07, 0.52 - 0.43 * intensity)

            android = None
            try:
                android = self.api.getAndroid()
            except Exception:
                pass

            if android is not None:
                if self.sound_enabled:
                    tone = 26 if intensity > 0.75 else (25 if intensity > 0.4 else 24)
                    dur = 80 if intensity > 0.75 else 60
                    try:
                        android.audioTone(tone, dur)
                    except Exception:
                        pass

                if self.vibrate_enabled and (self.detected or intensity > 0.35):
                    vib_ms = int(25 + 65 * intensity)
                    try:
                        android.vibrate(vib_ms)
                    except Exception:
                        pass

            time.sleep(interval)

    def set_threshold(self, value):
        self.threshold = max(2.0, float(value))
        self.preset = "Custom"
        self.set_setting("threshold", self.threshold)

    def toggle_vibrate(self, value):
        self.vibrate_enabled = bool(value)
        self.set_setting("vibrate", self.vibrate_enabled)
        self._sync_worker()
        self.refresh()

    def toggle_sound(self, value):
        self.sound_enabled = bool(value)
        self.set_setting("sound", self.sound_enabled)
        self._sync_worker()
        self.refresh()

    def toggle_smooth(self, value):
        self.smooth_enabled = bool(value)
        self.set_setting("smooth", self.smooth_enabled)
        self.refresh()

    def toggle_wiring(self, value):
        self.wiring_mode = bool(value)
        self.set_setting("wiring_mode", self.wiring_mode)
        self.refresh()

    def toggle_auto_zero(self, value):
        self.auto_zero = bool(value)
        self.set_setting("auto_zero", self.auto_zero)
        self.refresh()

    def toggle_notify(self, value):
        self.notify_alert = bool(value)
        self.set_setting("notify_alert", self.notify_alert)
        self.refresh()